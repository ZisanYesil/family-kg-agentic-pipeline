@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_King_of_the_Wild_Horses> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Fred_Jackman> ;
    ex:hasDirector <http://example.org/entity/Fred_Jackman> .

<http://example.org/entity/Hollywood> a ex:Place .

<http://example.org/entity/Fred_Jackman> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Hollywood> .

