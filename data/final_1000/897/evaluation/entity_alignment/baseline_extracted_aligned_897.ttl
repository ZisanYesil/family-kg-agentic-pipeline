@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/The_King_of_the_Wild_Horses> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The King of the Wild Horses (1924 film)" ;
    onto:hasDirector <http://example.org/entity/Fred_Jackman> .

<http://example.org/entity/Fred_Jackman> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Fred Wood Jackman Sr." ;
    onto:hasDeathPlace <http://example.org/entity/Hollywood> ;
    skos:altLabel "Fred Jackman" .

<http://example.org/entity/Hollywood> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Hollywood, California" .

