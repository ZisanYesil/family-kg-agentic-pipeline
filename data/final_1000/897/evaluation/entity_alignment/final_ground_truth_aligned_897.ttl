@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_King_of_the_Wild_Horses a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Fred_Jackman ;
    ex:hasDirector entity:Fred_Jackman .

entity:Hollywood a ex:Place .

entity:Fred_Jackman a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace entity:Hollywood .

