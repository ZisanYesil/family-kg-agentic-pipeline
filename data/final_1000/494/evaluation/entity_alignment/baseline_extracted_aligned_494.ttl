@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Alan_IV_de_Rohan> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alan IV, Viscount of Rohan" ;
    onto:hasMother <http://example.org/entity/Constance_of_Penthièvre> .

<http://example.org/entity/Breton> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "Breton" .

<http://example.org/entity/Constance_of_Penthièvre> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Constance of Penthièvre" ;
    onto:hasNationality <http://example.org/entity/Breton> .

