@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Jiří_Baumruk> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1930-06-27"^^xsd:date ;
    ex:hasDeathDate "1989-11-23"^^xsd:date .

<http://example.org/entity/Mathias_Rosenblad> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1758-06-23"^^xsd:date ;
    ex:hasDeathDate "1847-09-04"^^xsd:date .

