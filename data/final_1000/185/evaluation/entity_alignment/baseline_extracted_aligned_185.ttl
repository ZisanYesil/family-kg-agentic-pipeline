@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Jiří_Baumruk> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jiří Baumruk" ;
    onto:hasBirthDate "1930-06-27"^^xsd:date ;
    onto:hasDeathDate "1989-11-23"^^xsd:date .

<http://example.org/entity/Mathias_Rosenblad> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mathias Rosenblad" ;
    onto:hasBirthDate "1758-06-23"^^xsd:date ;
    onto:hasDeathDate "1847-09-04"^^xsd:date .

