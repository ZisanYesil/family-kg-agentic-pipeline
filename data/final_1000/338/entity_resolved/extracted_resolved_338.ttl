@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_his_royal_highness_1932 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "His Royal Highness (1932 film)" ;
    onto:hasDirector data:person_f_w_thring .

data:person_f_w_thring a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "F. W. Thring" ;
    skos:altLabel "Francis William Thring" .

