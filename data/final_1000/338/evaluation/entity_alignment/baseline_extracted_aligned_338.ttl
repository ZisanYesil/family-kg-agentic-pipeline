@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/His_Royal_Highness> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "His Royal Highness (1932 film)" ;
    onto:hasDirector <http://example.org/entity/Francis_William_Thring> .

<http://example.org/entity/Francis_William_Thring> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "F. W. Thring" ;
    skos:altLabel "Francis William Thring" .

