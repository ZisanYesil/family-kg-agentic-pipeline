@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:His_Royal_Highness a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:F_W_Thring ;
    ex:hasDirector entity:F_W_Thring .

entity:Francis_William_Thring a ex:Agent,
        ex:Person ;
    ex:hasParent entity:F_W_Thring .

entity:F_W_Thring a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Francis_William_Thring .

