@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:gebhard_fugel a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gebhard Fugel" ;
    onto:hasBirthDate "1863-08-14"^^xsd:date ;
    onto:hasDeathDate "1939-02-26"^^xsd:date .

data:marcin_kasprzak a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Marcin Kasprzak" ;
    onto:hasBirthDate "1860-11-02"^^xsd:date ;
    onto:hasDeathDate "1905-09-08"^^xsd:date .

