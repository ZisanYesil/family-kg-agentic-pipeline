@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Gebhard_Fugel> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1863-08-14"^^xsd:date ;
    ex:hasDeathDate "1939-02-26"^^xsd:date .

<http://example.org/entity/Marcin_Kasprzak> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1860-11-02"^^xsd:date ;
    ex:hasDeathDate "1905-09-08"^^xsd:date .

