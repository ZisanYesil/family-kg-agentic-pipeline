@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/take_it_easy_hospital> a ex:Agent,
        ex:Organization ;
    ex:hasFounder <http://example.org/extracted/ash_koosha> .

<http://example.org/extracted/ash_koosha> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/extracted/iran>,
        <http://example.org/extracted/united_kingdom> ;
    ex:hasNationality <http://example.org/extracted/iran>,
        <http://example.org/extracted/united_kingdom> .

<http://example.org/extracted/iran> a ex:Country,
        ex:Place .

<http://example.org/extracted/united_kingdom> a ex:Country,
        ex:Place .

