@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Take_It_Easy_Hospital> a ex:Agent,
        ex:Organization ;
    ex:hasFounder <http://example.org/entity/Ash_Koosha> .

<http://example.org/entity/Ash_Koosha> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/British_Iranian>,
        <http://example.org/extracted/united_kingdom> ;
    ex:hasNationality <http://example.org/entity/British_Iranian>,
        <http://example.org/extracted/united_kingdom> .

<http://example.org/entity/British_Iranian> a ex:Country,
        ex:Place .

<http://example.org/extracted/united_kingdom> a ex:Country,
        ex:Place .

