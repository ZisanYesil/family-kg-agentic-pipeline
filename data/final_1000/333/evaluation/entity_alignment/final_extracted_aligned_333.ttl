@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Ernst_Bessey> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1877-02-20"^^xsd:date ;
    ex:hasDeathDate "1957-07-17"^^xsd:date .

<http://example.org/entity/Friedrich_Paschen> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1865-01-22"^^xsd:date ;
    ex:hasDeathDate "1947-02-25"^^xsd:date .

