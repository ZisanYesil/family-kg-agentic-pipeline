@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Ernst_Bessey> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ernst Bessey" ;
    onto:hasBirthDate "1877-02-20"^^xsd:date ;
    onto:hasDeathDate "1957-07-17"^^xsd:date ;
    skos:altLabel "Ernst Athearn Bessey" .

<http://example.org/entity/Friedrich_Paschen> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Friedrich Paschen" ;
    onto:hasBirthDate "1865-01-22"^^xsd:date ;
    onto:hasDeathDate "1947-02-25"^^xsd:date ;
    skos:altLabel "Louis Carl Heinrich Friedrich Paschen" .

