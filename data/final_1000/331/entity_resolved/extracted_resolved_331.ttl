@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:sweetly_youll_die_through_love a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Sweetly You'll Die Through Love" ;
    onto:hasDirector data:tulio_demicheli .

data:madrid_spain a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Madrid, Spain" ;
    skos:altLabel "Madrid" .

data:tulio_demicheli a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tulio Demicheli" ;
    onto:hasDeathPlace data:madrid_spain .

