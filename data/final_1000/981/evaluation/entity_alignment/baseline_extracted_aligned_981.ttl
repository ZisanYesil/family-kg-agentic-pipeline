@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:frederick_of_arborea a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Frederick of Arborea" ;
    onto:hasMother <http://example.org/entity/Eleanor_of_Arborea> ;
    skos:altLabel "Frederick" .

<http://example.org/entity/Eleanor_of_Arborea> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Eleanor of Arborea" ;
    skos:altLabel "Eleanor" .

