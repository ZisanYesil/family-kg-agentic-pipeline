@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:vujadin_boskov a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Vujadin Boškov" ;
    onto:hasBirthDate "1931-05-16"^^xsd:date ;
    onto:hasDeathDate "2014-04-27"^^xsd:date .

data:william_holaday a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William P. Holaday" ;
    onto:hasBirthDate "1882-12-14"^^xsd:date ;
    onto:hasDeathDate "1946-01-29"^^xsd:date .

