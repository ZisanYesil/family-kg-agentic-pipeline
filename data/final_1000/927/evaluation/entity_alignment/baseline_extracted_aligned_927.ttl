@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Pehla_Pehla_Pyaar> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Pehla Pehla Pyaar" ;
    onto:hasPublicationDate "2006"^^xsd:gYear .

<http://example.org/entity/The_Peak_Scaler> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Peak Scaler" ;
    onto:hasPublicationDate "1933"^^xsd:gYear .

