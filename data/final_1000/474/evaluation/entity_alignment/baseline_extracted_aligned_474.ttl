@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Dhoop_Kinare> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Dhoop Kinare" ;
    onto:hasCreator <http://example.org/entity/Haseena_Moin> .

<http://example.org/entity/Haseena_Moin> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Haseena Moin" ;
    onto:hasAwardReceived <http://example.org/entity/Pride_of_Performance> .

<http://example.org/entity/Pride_of_Performance> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Pride of Performance" .

