@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Dhoop_Kinare> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Haseena_Moin> .

<http://example.org/entity/Haseena_Moin> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/entity/Pride_of_Performance> .

<http://example.org/entity/Pride_of_Performance> a ex:Award .

