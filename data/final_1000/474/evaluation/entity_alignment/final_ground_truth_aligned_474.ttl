@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Dhoop_Kinare a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Haseena_Moin .

entity:Haseena_Moin a ex:Agent ;
    ex:hasAwardReceived entity:Pride_of_Performance .

entity:Pride_of_Performance a ex:Award .

