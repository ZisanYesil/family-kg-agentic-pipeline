@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Augustus_II_the_Strong> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Augustus II the Strong" ;
    onto:hasBirthDate "1670-05-12"^^xsd:date ;
    onto:hasDeathDate "1733-02-01"^^xsd:date ;
    onto:hasSon <http://example.org/entity/Maurice_de_Saxe> .

<http://example.org/entity/Maurice_de_Saxe> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Maurice de Saxe" ;
    onto:hasBirthDate "1696-10-28"^^xsd:date ;
    onto:hasDeathDate "1750-11-20"^^xsd:date .

