@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Gustav_Lindau> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gustav Lindau" ;
    onto:hasBirthDate "1866-05-02"^^xsd:date ;
    onto:hasDeathDate "1923-10-10"^^xsd:date ;
    skos:altLabel "Gustav Lindau" .

<http://example.org/entity/Nafija_Sarajlić> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nafija Sarajlić" ;
    onto:hasBirthDate "1893-10-03"^^xsd:date ;
    onto:hasDeathDate "1970-01-15"^^xsd:date ;
    skos:altLabel "Nafija Sarajlić",
        "née Hadžikarić" .

