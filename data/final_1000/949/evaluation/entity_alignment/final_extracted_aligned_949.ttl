@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Summer_Skin> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Leopoldo_Torre_Nilsson> ;
    ex:hasDirector <http://example.org/entity/Leopoldo_Torre_Nilsson> .

<http://example.org/entity/Leopoldo_Torres_Ríos> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Leopoldo_Torre_Nilsson> ;
    ex:hasSon <http://example.org/entity/Leopoldo_Torre_Nilsson> .

<http://example.org/entity/Leopoldo_Torre_Nilsson> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/entity/Leopoldo_Torres_Ríos> ;
    ex:isSonOf <http://example.org/entity/Leopoldo_Torres_Ríos> .

