@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Leopoldo_Torres_Ríos> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Leopoldo Torres Ríos" ;
    onto:hasSon <http://example.org/entity/Leopoldo_Torre_Nilsson> .

<http://example.org/entity/Summer_Skin> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Summer Skin" ;
    onto:hasDirector <http://example.org/entity/Leopoldo_Torre_Nilsson> .

<http://example.org/entity/Leopoldo_Torre_Nilsson> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Leopoldo Torre Nilsson" .

