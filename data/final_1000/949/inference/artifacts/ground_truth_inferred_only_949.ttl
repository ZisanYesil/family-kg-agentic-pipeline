@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Summer_Skin a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Leopoldo_Torre_Nilsson .

entity:Leopoldo_Torres_Ríos a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Leopoldo_Torre_Nilsson .

entity:Leopoldo_Torre_Nilsson a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Leopoldo_Torres_Ríos .

