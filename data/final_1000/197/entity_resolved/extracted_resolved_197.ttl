@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:album_dont_freak_me_out a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Don't Freak Me Out" ;
    onto:hasPublicationDate "1972"^^xsd:gYear .

data:album_love_war_barlowgirl a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Love & War" ;
    onto:hasPublicationDate "2009-09-08"^^xsd:date ;
    skos:altLabel "Love & War (BarlowGirl album)" .

