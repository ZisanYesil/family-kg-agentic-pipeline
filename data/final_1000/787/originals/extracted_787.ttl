@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:devils_lake_north_dakota a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Devils Lake (North Dakota)" ;
    onto:hasCountry data:united_states .

data:mcleod_lake_alberta a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "McLeod Lake (Alberta)" ;
    onto:hasCountry data:canada .

data:canada a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" .

