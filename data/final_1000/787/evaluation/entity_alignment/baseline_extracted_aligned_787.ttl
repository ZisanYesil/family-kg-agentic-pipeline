@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Devils_Lake_North_Dakota> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Devils Lake (North Dakota)" ;
    onto:hasCountry <http://example.org/entity/U_S> .

<http://example.org/entity/McLeod_Lake_Alberta> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "McLeod Lake (Alberta)" ;
    onto:hasCountry <http://example.org/entity/Canada> .

<http://example.org/entity/Canada> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" .

<http://example.org/entity/U_S> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" .

