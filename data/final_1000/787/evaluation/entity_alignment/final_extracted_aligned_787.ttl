@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Devils_Lake_North_Dakota> a ex:Place ;
    ex:hasCountry <http://example.org/entity/U_S> .

<http://example.org/entity/McLeod_Lake_Alberta> a ex:Place ;
    ex:hasCountry <http://example.org/entity/Canada> .

<http://example.org/entity/Canada> a ex:Country,
        ex:Place .

<http://example.org/entity/U_S> a ex:Country,
        ex:Place .

