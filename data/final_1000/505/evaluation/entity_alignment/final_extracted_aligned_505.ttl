@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/An_Ideal_Woman> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Jean_Durand> ;
    ex:hasDirector <http://example.org/entity/Jean_Durand> .

<http://example.org/entity/Goodbye_Emmanuelle> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/François_Leterrier> ;
    ex:hasDirector <http://example.org/entity/François_Leterrier> .

<http://example.org/entity/François_Leterrier> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/French> ;
    ex:hasNationality <http://example.org/entity/French> .

<http://example.org/entity/Jean_Durand> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/French> ;
    ex:hasNationality <http://example.org/entity/French> .

<http://example.org/entity/French> a ex:Country,
        ex:Place .

