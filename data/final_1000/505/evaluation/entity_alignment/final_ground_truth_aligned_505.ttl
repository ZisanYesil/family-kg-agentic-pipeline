@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:An_Ideal_Woman a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Jean_Durand ;
    ex:hasDirector entity:Jean_Durand .

entity:Goodbye_Emmanuelle a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:François_Leterrier ;
    ex:hasDirector entity:François_Leterrier .

entity:François_Leterrier a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:French ;
    ex:hasCountry entity:French .

entity:Jean_Durand a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:French ;
    ex:hasCountry entity:French .

entity:French a ex:Country,
        ex:Place .

