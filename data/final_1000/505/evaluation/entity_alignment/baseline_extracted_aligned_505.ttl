@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/An_Ideal_Woman> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "An Ideal Woman" ;
    onto:hasDirector <http://example.org/entity/Jean_Durand> .

<http://example.org/entity/Goodbye_Emmanuelle> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Goodbye Emmanuelle" ;
    onto:hasDirector <http://example.org/entity/François_Leterrier> .

<http://example.org/entity/François_Leterrier> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "François Leterrier" ;
    onto:hasNationality <http://example.org/entity/French> .

<http://example.org/entity/Jean_Durand> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jean Durand" ;
    onto:hasNationality <http://example.org/entity/French> .

<http://example.org/entity/French> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

