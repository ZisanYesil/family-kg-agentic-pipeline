@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:film_min_kone_er_uskyldig a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Min kone er uskyldig" ;
    onto:hasDirector data:person_johan_jacobsen .

data:person_johan_jacobsen a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Johan Jacobsen" .

