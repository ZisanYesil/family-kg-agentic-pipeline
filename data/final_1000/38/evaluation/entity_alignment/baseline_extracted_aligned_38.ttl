@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Min_kone_er_uskyldig> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Min kone er uskyldig" ;
    onto:hasDirector <http://example.org/entity/Johan_Jacobsen> .

<http://example.org/entity/Johan_Jacobsen> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Johan Jacobsen" .

