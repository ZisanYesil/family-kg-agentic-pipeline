@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:down_in_the_dm_song a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Down in the DM" ;
    onto:hasPublicationDate "2015-10-27"^^xsd:date .

data:welcome_to_st_tropez_song a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Welcome to St. Tropez" ;
    onto:hasPublicationDate "2011"^^xsd:gYear .

