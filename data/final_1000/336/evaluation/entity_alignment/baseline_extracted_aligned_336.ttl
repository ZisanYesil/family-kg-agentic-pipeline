@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Down_in_the_DM> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Down in the DM" ;
    onto:hasPublicationDate "2015-10-27"^^xsd:date .

<http://example.org/entity/Welcome_to_St_Tropez> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Welcome to St. Tropez" ;
    onto:hasPublicationDate "2011"^^xsd:gYear .

