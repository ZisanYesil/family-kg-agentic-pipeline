@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Lovers_1999_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Lovers (1999 film)" ;
    onto:hasDirector <http://example.org/entity/Jean_Marc_Barr> .

<http://example.org/entity/Pitch_Perfect_3> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Pitch Perfect 3" ;
    onto:hasDirector <http://example.org/entity/Trish_Sie> .

<http://example.org/entity/French> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

<http://example.org/entity/Jean_Marc_Barr> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jean-Marc Barr" ;
    onto:hasNationality <http://example.org/entity/American>,
        <http://example.org/entity/French> .

<http://example.org/entity/Trish_Sie> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Trish Sie" ;
    onto:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

