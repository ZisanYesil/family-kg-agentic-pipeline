@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Lovers_1999_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Jean_Marc_Barr> ;
    ex:hasDirector <http://example.org/entity/Jean_Marc_Barr> .

<http://example.org/entity/Pitch_Perfect_3> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Trish_Sie> ;
    ex:hasDirector <http://example.org/entity/Trish_Sie> .

<http://example.org/entity/French> a ex:Country,
        ex:Place .

<http://example.org/entity/Jean_Marc_Barr> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/American>,
        <http://example.org/entity/French> ;
    ex:hasNationality <http://example.org/entity/American>,
        <http://example.org/entity/French> .

<http://example.org/entity/Trish_Sie> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

