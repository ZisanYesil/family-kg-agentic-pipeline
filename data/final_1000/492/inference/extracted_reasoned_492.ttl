@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/lovers_1999> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/jean_marc_barr> ;
    ex:hasDirector <http://example.org/extracted/jean_marc_barr> .

<http://example.org/extracted/pitch_perfect_3> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/trish_sie> ;
    ex:hasDirector <http://example.org/extracted/trish_sie> .

<http://example.org/extracted/france> a ex:Country,
        ex:Place .

