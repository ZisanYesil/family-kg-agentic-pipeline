@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_Beautiful_Otero> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Richard_Pottier> ;
    ex:hasDirector <http://example.org/entity/Richard_Pottier> .

<http://example.org/entity/Le_Plessis_Bouchard> a ex:Place .

<http://example.org/entity/Richard_Pottier> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Le_Plessis_Bouchard> .

