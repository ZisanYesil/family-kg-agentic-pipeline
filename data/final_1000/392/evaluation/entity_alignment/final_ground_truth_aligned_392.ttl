@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Beautiful_Otero a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Richard_Pottier ;
    ex:hasDirector entity:Richard_Pottier .

entity:Le_Plessis_Bouchard a ex:Place .

entity:Richard_Pottier a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace entity:Le_Plessis_Bouchard .

