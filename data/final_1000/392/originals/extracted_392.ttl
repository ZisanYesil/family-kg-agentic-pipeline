@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_the_beautiful_otero a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Beautiful Otero" ;
    onto:hasDirector data:person_richard_pottier ;
    skos:altLabel "La bella Otero",
        "La belle Otero" .

data:person_richard_pottier a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Richard Pottier" ;
    onto:hasDeathPlace data:place_le_plessis_bouchard .

data:place_le_plessis_bouchard a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Le Plessis-Bouchard" .

