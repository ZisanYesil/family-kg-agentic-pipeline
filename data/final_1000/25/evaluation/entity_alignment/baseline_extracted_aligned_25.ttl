@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Ami_Neta_Hobo> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Ami Neta Hobo" ;
    onto:hasPublicationDate "2018-02-16"^^xsd:date .

<http://example.org/entity/Hood_of_the_Living_Dead> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Hood of the Living Dead" ;
    onto:hasPublicationDate "2005"^^xsd:gYear .

