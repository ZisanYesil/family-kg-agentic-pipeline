@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Lighter> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Miley_Cyrus> ;
    ex:hasPerformer <http://example.org/entity/Miley_Cyrus> .

<http://example.org/entity/Billy_Ray_Cyrus> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Miley_Cyrus> .

<http://example.org/entity/Miley_Cyrus> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Billy_Ray_Cyrus> ;
    ex:hasParent <http://example.org/entity/Billy_Ray_Cyrus> .

