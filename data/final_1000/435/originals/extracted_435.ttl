@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_forbidden_paradise a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Forbidden Paradise" ;
    onto:hasPublicationDate "1924"^^xsd:gYear .

data:film_vamping_venus a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Vamping Venus" ;
    onto:hasPublicationDate "1928-05-13"^^xsd:date .

