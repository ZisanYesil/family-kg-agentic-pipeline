@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Forbidden_Paradise> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Forbidden Paradise" ;
    onto:hasPublicationDate "1924"^^xsd:gYear .

<http://example.org/entity/Vamping_Venus> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Vamping Venus" ;
    onto:hasPublicationDate "1928-05-13"^^xsd:date .

