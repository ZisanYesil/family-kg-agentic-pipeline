@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:babe_paley a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Barbara \"Babe\" Cushing Mortimer Paley" ;
    onto:hasSpouse data:william_paley ;
    skos:altLabel "Babe Paley" .

data:cbs a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Columbia Broadcasting System" ;
    skos:altLabel "CBS" .

data:william_paley a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William Samuel Paley" ;
    onto:hasEmployer data:cbs ;
    skos:altLabel "William S. Paley" .

