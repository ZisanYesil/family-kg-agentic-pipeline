@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Carnic_Alps> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Carnic Alps" ;
    onto:hasCountry <http://example.org/entity/Austria>,
        <http://example.org/entity/Italy> .

<http://example.org/entity/Torre_del_Gran_San_Pietro> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Torre del Gran San Pietro" ;
    onto:hasCountry <http://example.org/entity/Italy> .

<http://example.org/entity/Austria> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Austria" .

<http://example.org/entity/Italy> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Italy" .

