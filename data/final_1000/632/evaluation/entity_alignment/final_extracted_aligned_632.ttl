@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Carnic_Alps> a ex:Place ;
    ex:hasCountry <http://example.org/entity/Austria>,
        <http://example.org/entity/Italy> .

<http://example.org/entity/Torre_del_Gran_San_Pietro> a ex:Place ;
    ex:hasCountry <http://example.org/entity/Italy> .

<http://example.org/entity/Austria> a ex:Country,
        ex:Place .

<http://example.org/entity/Italy> a ex:Country,
        ex:Place .

