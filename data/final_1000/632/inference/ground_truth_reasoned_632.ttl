@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Carnic_Alps ex:hasCountry entity:Austria,
        entity:Italy .

entity:Torre_del_Gran_San_Pietro ex:hasCountry entity:Italy .

entity:Austria a ex:Country,
        ex:Place .

entity:Italy a ex:Country,
        ex:Place .

