entity:Otto_Carlmar a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Edith_Carlmar .

entity:Edith_Carlmar a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Otto_Carlmar .

