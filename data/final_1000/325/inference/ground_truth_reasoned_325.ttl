@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Bedre_enn_sitt_rykte a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Edith_Carlmar ;
