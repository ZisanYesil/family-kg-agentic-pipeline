@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Bedre_enn_sitt_rykte> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Bedre enn sitt rykte" ;
    onto:hasDirector <http://example.org/entity/Edith_Carlmar> ;
    skos:altLabel "Bedre Enn Sitt Rykte" .

<http://example.org/entity/Edith_Carlmar> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Edith Carlmar" ;
    onto:hasSpouse <http://example.org/entity/Otto_Carlmar> .

<http://example.org/entity/Otto_Carlmar> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Otto Carlmar" .

