@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Jean_Grémillon a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1901-10-03"^^xsd:date ;
    ex:hasDeathDate "1959-11-25"^^xsd:date .

entity:Ángel_Recasens a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1938-03-04"^^xsd:date ;
    ex:hasDeathDate "2007-08-02"^^xsd:date .

