@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Jean_Grémillon> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jean Grémillon" ;
    onto:hasBirthDate "1901-10-03"^^xsd:date ;
    onto:hasDeathDate "1959-11-25"^^xsd:date .

<http://example.org/entity/Ángel_Recasens> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ángel Recasens" ;
    onto:hasBirthDate "1938-03-04"^^xsd:date ;
    onto:hasDeathDate "2007-08-02"^^xsd:date .

