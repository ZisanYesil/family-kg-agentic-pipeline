@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:manuel_antonio a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Manuel Antonio" ;
    onto:hasBirthDate "1900-07-12"^^xsd:date .

data:wilfred_macdonald a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Wilfred MacDonald" ;
    onto:hasBirthDate "1917-05-02"^^xsd:date .

