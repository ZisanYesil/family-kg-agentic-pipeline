@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Manuel_Antonio a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1900-07-12"^^xsd:date .

entity:Wilfred_MacDonald a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1917-05-02"^^xsd:date .

