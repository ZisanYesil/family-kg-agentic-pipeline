@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Cecile_of_France a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Pons .

entity:Bertrand_of_Toulouse a ex:Agent,
        ex:Person .

entity:Pons a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Bertrand_of_Toulouse .

