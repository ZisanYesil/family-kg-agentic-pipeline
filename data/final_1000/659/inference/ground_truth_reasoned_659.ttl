@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:A_Bullet_Is_Waiting a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:John_Farrow ;
    ex:hasDirector entity:John_Farrow .

entity:Maureen_O_Sullivan a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:John_Farrow .

entity:John_Farrow a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Maureen_O_Sullivan .

