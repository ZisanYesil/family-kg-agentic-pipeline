@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/A_Bullet_Is_Waiting> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/John_Farrow> ;
    ex:hasDirector <http://example.org/entity/John_Farrow> .

<http://example.org/entity/Maureen_O_Sullivan> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/John_Farrow> .

<http://example.org/entity/John_Farrow> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Maureen_O_Sullivan> .

