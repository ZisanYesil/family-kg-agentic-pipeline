@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/A_Bullet_Is_Waiting> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Bullet Is Waiting" ;
    onto:hasDirector <http://example.org/entity/John_Farrow> .

<http://example.org/entity/John_Farrow> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Farrow" ;
    onto:hasSpouse <http://example.org/entity/Maureen_O_Sullivan> .

<http://example.org/entity/Maureen_O_Sullivan> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Maureen O'Sullivan" .

