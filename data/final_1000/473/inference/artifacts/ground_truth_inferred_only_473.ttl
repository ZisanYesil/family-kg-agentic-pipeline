@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Thunder_on_the_Hill a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Hans_J_Salter .

entity:Austrian a ex:Country,
        ex:Place .

entity:Hans_J_Salter a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:Austrian .

