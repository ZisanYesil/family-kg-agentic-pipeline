@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Hans_J_Salter> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Austrian>,
        <http://example.org/extracted/united_states> ;
    ex:hasNationality <http://example.org/entity/Austrian>,
        <http://example.org/extracted/united_states> .

<http://example.org/entity/Austrian> a ex:Country,
        ex:Place .

<http://example.org/extracted/united_states> a ex:Country,
        ex:Place .

