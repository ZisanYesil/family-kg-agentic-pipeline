@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Hans_J_Salter> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hans J. Salter" ;
    onto:hasNationality <http://example.org/entity/Austrian>,
        data:united_states .

<http://example.org/entity/Austrian> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Austria" ;
    skos:altLabel "Austrian" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

