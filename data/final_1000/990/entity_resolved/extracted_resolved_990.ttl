@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:david_faurschou a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "David Faurschou" ;
    onto:hasBirthDate "1956-01-28"^^xsd:date .

data:osita_chidoka a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Osita Benjamin Chidoka" ;
    onto:hasBirthDate "1971-07-18"^^xsd:date ;
    skos:altLabel "Osita Chidoka" .

