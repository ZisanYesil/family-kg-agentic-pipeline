@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:choc%C3%B1acota_putina a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Chocñacota (Putina)" ;
    onto:hasCountry data:peru .

data:sillane a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Sillane" ;
    onto:hasCountry data:peru .

data:peru a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Peru" .

