@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Chocñacota_Putina> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Chocñacota (Putina)" ;
    onto:hasCountry <http://example.org/entity/Peru> .

<http://example.org/entity/Sillane> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Sillane" ;
    onto:hasCountry <http://example.org/entity/Peru> .

<http://example.org/entity/Peru> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Peru" .

