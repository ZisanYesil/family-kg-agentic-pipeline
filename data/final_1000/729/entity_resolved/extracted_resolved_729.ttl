@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_au_revoir_les_enfants a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Au revoir les enfants" ;
    onto:hasPublicationDate "1987"^^xsd:gYear ;
    skos:altLabel "Au Revoir Les Enfants" .

data:film_physical_jerks a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Physical Jerks" ;
    onto:hasPublicationDate "1997"^^xsd:gYear .

