@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Anup_Bhandari> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Anup Bhandari" ;
    onto:hasEducatedAt <http://example.org/entity/Vidya_Vikas_Institute_of_Engineering_Technology_VVIET> .

<http://example.org/entity/Rajaratha> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Rajaratha" .

<http://example.org/entity/Vidya_Vikas_Institute_of_Engineering_Technology_VVIET> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Vidya Vikas Institute of Engineering & Technology" .

