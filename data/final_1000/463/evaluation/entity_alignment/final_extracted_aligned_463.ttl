@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_Lady_Objects> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Erle_C_Kenton> ;
    ex:hasDirector <http://example.org/entity/Erle_C_Kenton> .

<http://example.org/entity/Parkinson> a ex:CauseOfDeath .

<http://example.org/entity/Erle_C_Kenton> a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath <http://example.org/entity/Parkinson> .

