@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/James_Roosevelt> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "James Roosevelt Roosevelt" ;
    onto:hasBrother <http://example.org/entity/Franklin_Delano_Roosevelt> .

<http://example.org/entity/Eleanor_Roosevelt> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Eleanor Roosevelt" .

<http://example.org/entity/Franklin_Delano_Roosevelt> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Franklin Delano Roosevelt" ;
    onto:hasSpouse <http://example.org/entity/Eleanor_Roosevelt> .

