@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Eleanor_Roosevelt> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Franklin_Delano_Roosevelt> .

<http://example.org/entity/James_Roosevelt> a ex:Agent,
        ex:Person ;
    ex:hasBrother <http://example.org/entity/Franklin_Delano_Roosevelt> ;
    ex:hasSibling <http://example.org/entity/Franklin_Delano_Roosevelt> .

<http://example.org/entity/Franklin_Delano_Roosevelt> a ex:Agent,
        ex:Person ;
    ex:hasSibling <http://example.org/entity/James_Roosevelt> ;
    ex:hasSpouse <http://example.org/entity/Eleanor_Roosevelt> ;
    ex:isBrotherOf <http://example.org/entity/James_Roosevelt> .

