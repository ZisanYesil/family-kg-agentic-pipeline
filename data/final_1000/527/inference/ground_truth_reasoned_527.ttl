@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Eleanor_Roosevelt a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Franklin_D_Roosevelt .

entity:Franklin_D_Roosevelt a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Eleanor_Roosevelt .

entity:Franklin_Delano_Roosevelt a ex:Agent,
        ex:Person ;
    ex:hasSibling entity:James_Roosevelt .

entity:James_Roosevelt a ex:Agent,
        ex:Person ;
    ex:hasSibling entity:Franklin_Delano_Roosevelt .

