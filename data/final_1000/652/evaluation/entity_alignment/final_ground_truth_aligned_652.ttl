@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Fernando_Bermúdez a ex:Agent,
        ex:Person ;
    ex:hasFather entity:Bermudo_Núñez ;
    ex:hasParent entity:Bermudo_Núñez .

entity:Oveco_Núñez a ex:Agent,
        ex:Person ;
    ex:hasSibling entity:Bermudo_Núñez .

entity:Bermudo_Núñez a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Fernando_Bermúdez ;
    ex:hasSibling entity:Oveco_Núñez .

