@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Fernando_Bermúdez> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/entity/Bermudo_Núñez> ;
    ex:isSonOf <http://example.org/entity/Bermudo_Núñez> .

<http://example.org/entity/Oveco_Núñez> a ex:Agent,
        ex:Person ;
    ex:hasBrother <http://example.org/entity/Bermudo_Núñez> ;
    ex:hasSibling <http://example.org/entity/Bermudo_Núñez> .

<http://example.org/entity/Bermudo_Núñez> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Fernando_Bermúdez> ;
    ex:hasSibling <http://example.org/entity/Oveco_Núñez> ;
    ex:hasSon <http://example.org/entity/Fernando_Bermúdez> ;
    ex:isBrotherOf <http://example.org/entity/Oveco_Núñez> .

