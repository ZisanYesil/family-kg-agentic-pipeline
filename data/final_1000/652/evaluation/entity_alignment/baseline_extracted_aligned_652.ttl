@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Oveco_Núñez> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Oveco Núñez" ;
    onto:hasBrother <http://example.org/entity/Bermudo_Núñez> .

<http://example.org/entity/Bermudo_Núñez> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bermudo Núñez" ;
    onto:hasSon <http://example.org/entity/Fernando_Bermúdez> .

<http://example.org/entity/Fernando_Bermúdez> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Fernando Bermúdez de Cea" .

