@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:secret_of_mountain_lake_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Secret of Mountain Lake" ;
    onto:hasPublicationDate "1954"^^xsd:gYear .

data:upstairs_and_downstairs_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Upstairs and Downstairs" ;
    onto:hasPublicationDate "1959"^^xsd:gYear .

