@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:chester_ray_benjamin a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Chester Ray Benjamin" ;
    onto:hasBirthDate "1923-01-23"^^xsd:date ;
    onto:hasDeathDate "2002-04-20"^^xsd:date .

data:ernest_duff a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ernest Duff" ;
    onto:hasBirthDate "1931-06-02"^^xsd:date ;
    onto:hasDeathDate "2016-05-27"^^xsd:date .

