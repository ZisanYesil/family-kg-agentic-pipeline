@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Karel_Zich> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Karel Zich" ;
    onto:hasBirthDate "1949-06-10"^^xsd:date ;
    onto:hasDeathDate "2004-07-13"^^xsd:date .

<http://example.org/entity/Werner_Mensching> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Werner Mensching" ;
    onto:hasBirthDate "1933-12-23"^^xsd:date ;
    onto:hasDeathDate "1997-06-21"^^xsd:date .

