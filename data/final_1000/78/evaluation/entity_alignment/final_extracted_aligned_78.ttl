@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Karel_Zich> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1949-06-10"^^xsd:date ;
    ex:hasDeathDate "2004-07-13"^^xsd:date .

<http://example.org/entity/Werner_Mensching> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1933-12-23"^^xsd:date ;
    ex:hasDeathDate "1997-06-21"^^xsd:date .

