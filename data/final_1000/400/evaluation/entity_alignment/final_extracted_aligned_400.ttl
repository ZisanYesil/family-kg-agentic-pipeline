@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Disgraced> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasCountryOfOrigin <http://example.org/entity/American> .

<http://example.org/entity/Two_in_a_Big_City> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/German> ;
    ex:hasCountryOfOrigin <http://example.org/entity/German> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/German> a ex:Country,
        ex:Place .

