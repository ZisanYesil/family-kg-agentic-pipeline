@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Disgraced a ex:Artifact ;
    ex:hasCountry entity:American .

entity:Two_in_a_Big_City a ex:Artifact ;
    ex:hasCountry entity:German .

entity:American a ex:Country,
        ex:Place .

entity:German a ex:Country,
        ex:Place .

