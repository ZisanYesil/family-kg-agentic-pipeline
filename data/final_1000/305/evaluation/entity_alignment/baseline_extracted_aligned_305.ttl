@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Margaret_Atwood_Once_in_August> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Margaret Atwood: Once in August" ;
    onto:hasDirector <http://example.org/entity/Michael_Rubbo> .

<http://example.org/entity/Michael_Rubbo> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Michael Rubbo" .

