@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:film_margaret_atwood_once_in_august a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Margaret Atwood: Once in August" ;
    onto:hasDirector data:person_michael_rubbo .

data:person_michael_rubbo a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Michael Rubbo" .

