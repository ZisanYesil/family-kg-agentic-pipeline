@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/The_To_Do_List> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The To Do List" ;
    onto:hasCountry <http://example.org/entity/American> .

<http://example.org/entity/The_Twelve_Chairs_1970_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Twelve Chairs (1970 film)" ;
    onto:hasCountry <http://example.org/entity/American> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

