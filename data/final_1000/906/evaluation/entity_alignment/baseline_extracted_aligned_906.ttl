@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/John_of_Lencastre_1st_Duke_of_Aveiro> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John of Lencastre" ;
    onto:hasSon <http://example.org/entity/George_of_Lencastre_2nd_Duke_of_Aveiro> ;
    skos:altLabel "1st Duke of Aveiro",
        "Dom John of Lencastre",
        "John of Lencastre",
        "João de Lencastre" .

<http://example.org/entity/George_of_Lencastre_2nd_Duke_of_Aveiro> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "George of Lencastre" ;
    skos:altLabel "George of Lencastre",
        "George of Lencastre, 2nd Duke of Aveiro",
        "Jorge de Lencastre" .

