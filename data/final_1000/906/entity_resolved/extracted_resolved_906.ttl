@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:john_of_lencastre_1st_duke_aveiro a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John of Lencastre" ;
    onto:hasSon data:george_of_lencastre_2nd_duke_aveiro ;
    skos:altLabel "1st Duke of Aveiro",
        "Dom John of Lencastre",
        "John of Lencastre",
        "João de Lencastre" .

data:george_of_lencastre_2nd_duke_aveiro a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "George of Lencastre" ;
    skos:altLabel "George of Lencastre",
        "George of Lencastre, 2nd Duke of Aveiro",
        "Jorge de Lencastre" .

