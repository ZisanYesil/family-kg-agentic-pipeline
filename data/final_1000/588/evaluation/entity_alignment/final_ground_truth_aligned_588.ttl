@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Prologue a ex:Agent,
        ex:Organization ;
    ex:hasFounder entity:James_B_Rhoads .

entity:James_B_Rhoads a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Sioux_City .

entity:Sioux_City a ex:Place .

