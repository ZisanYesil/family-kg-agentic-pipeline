@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/James_B_Rhoads> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "James B. Rhoads" ;
    onto:hasBirthPlace <http://example.org/entity/Sioux_City> .

data:prologue_magazine a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Prologue (magazine)" .

<http://example.org/entity/Sioux_City> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Sioux City, Iowa" .

