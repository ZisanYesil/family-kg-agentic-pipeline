@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Battle_of_Kosovo_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Battle of Kosovo" ;
    onto:hasPublicationDate "1989"^^xsd:gYear ;
    skos:altLabel "Battle of Kosovo" .

<http://example.org/entity/Quackser_Fortune_Has_a_Cousin_in_the_Bronx> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Quackser Fortune Has a Cousin in the Bronx" ;
    onto:hasPublicationDate "1970"^^xsd:gYear ;
    skos:altLabel "Quackser Fortune Has a Cousin in the Bronx" .

