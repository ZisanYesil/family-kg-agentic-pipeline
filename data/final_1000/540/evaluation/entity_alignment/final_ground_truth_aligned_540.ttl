@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:The_Save_the_Children_Fund_Film a ex:Artifact,
        ex:CreativeWork ;
    ex:hasProducer entity:Tony_Garnett .

entity:Time_Out_of_Mind_2014_film a ex:Artifact,
        ex:CreativeWork ;
    ex:hasProducer entity:Richard_Gere .

entity:Richard_Gere a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1949-08-31"^^xsd:date .

entity:Tony_Garnett a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1936-04-03"^^xsd:date .

