@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/The_Save_the_Children_Fund_Film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Save The Children Fund Film" ;
    onto:hasProducer <http://example.org/entity/Tony_Garnett> .

<http://example.org/entity/Time_Out_of_Mind_2014_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Time Out of Mind (2014 Film)" .

<http://example.org/entity/Tony_Garnett> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tony Garnett" ;
    onto:hasBirthDate "1936-04-03"^^xsd:date .

