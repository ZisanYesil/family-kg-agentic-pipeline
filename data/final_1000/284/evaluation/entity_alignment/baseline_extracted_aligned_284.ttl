@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Nikolai_Sheremetev> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nikolai Petrovich Sheremetev" ;
    onto:hasSon <http://example.org/entity/Dmitri_Nikolaevich_Sheremetev> ;
    skos:altLabel "Nikolai Petrovich Sheremetev" .

<http://example.org/entity/Dmitri_Nikolaevich_Sheremetev> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Dmitri Nikolaevich Sheremetev" ;
    skos:altLabel "Dmitri Nikolaevich Sheremetev" .

