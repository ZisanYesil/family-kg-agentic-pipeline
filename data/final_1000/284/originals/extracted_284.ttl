@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:nikolai_sheremetev a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nikolai Petrovich Sheremetev" ;
    onto:hasSon data:dmitri_sheremetev ;
    skos:altLabel "Nikolai Petrovich Sheremetev" .

data:dmitri_sheremetev a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Dmitri Nikolaevich Sheremetev" ;
    skos:altLabel "Dmitri Nikolaevich Sheremetev" .

