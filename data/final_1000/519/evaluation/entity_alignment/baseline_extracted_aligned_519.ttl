@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Education_in_Chemistry> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Education in Chemistry" ;
    onto:hasPublisher <http://example.org/entity/Royal_Society_of_Chemistry> .

<http://example.org/entity/Royal_Society_of_Chemistry> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Royal Society of Chemistry" ;
    onto:hasCountry <http://example.org/entity/United_Kingdom> .

<http://example.org/entity/United_Kingdom> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" .

