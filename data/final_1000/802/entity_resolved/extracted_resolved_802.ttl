@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:thep_kasattri a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Thep Kasattri" ;
    onto:hasFather data:maha_chakkraphat ;
    skos:altLabel "Thep Kasat Chao",
        "Thep Kasattri" .

data:maha_chakkraphat a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Maha Chakkraphat" ;
    skos:altLabel "Maha Chakkraphat" .

