@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Thep_Kasattri> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Thep Kasattri" ;
    onto:hasFather <http://example.org/entity/Maha_Chakkraphat> ;
    skos:altLabel "Thep Kasat Chao",
        "Thep Kasattri" .

<http://example.org/entity/Maha_Chakkraphat> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Maha Chakkraphat" ;
    skos:altLabel "Maha Chakkraphat" .

