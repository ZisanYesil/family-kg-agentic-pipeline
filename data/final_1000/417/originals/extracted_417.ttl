@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:catalpa_farm a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Catalpa Farm" ;
    onto:hasCountry data:united_states .

data:temple_adath_israel_owensboro a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Temple Adath Israel (Owensboro, Kentucky)" ;
    onto:hasCountry data:united_states ;
    skos:altLabel "Temple Adath Israel" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" .

