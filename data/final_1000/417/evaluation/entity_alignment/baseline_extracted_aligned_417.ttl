@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Catalpa_Farm> a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Catalpa Farm" ;
    onto:hasCountry <http://example.org/entity/United_States> .

<http://example.org/entity/Temple_Adath_Israel_Owensboro_Kentucky> a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Temple Adath Israel (Owensboro, Kentucky)" ;
    onto:hasCountry <http://example.org/entity/United_States> ;
    skos:altLabel "Temple Adath Israel" .

<http://example.org/entity/United_States> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" .

