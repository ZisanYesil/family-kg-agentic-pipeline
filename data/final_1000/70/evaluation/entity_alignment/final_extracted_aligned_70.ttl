@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Domenico_Cosselli> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1801-05-27"^^xsd:date ;
    ex:hasDeathDate "1855-11-09"^^xsd:date .

<http://example.org/entity/Neil_Lloyd_Macky> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1891-02-20"^^xsd:date ;
    ex:hasDeathDate "1981-10-04"^^xsd:date .

