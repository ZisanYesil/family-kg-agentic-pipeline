@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Domenico_Cosselli> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Domenico Cosselli" ;
    onto:hasBirthDate "1801-05-27"^^xsd:date ;
    onto:hasDeathDate "1855-11-09"^^xsd:date .

<http://example.org/entity/Neil_Lloyd_Macky> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Neil Lloyd Macky" ;
    onto:hasBirthDate "1891-02-20"^^xsd:date ;
    onto:hasDeathDate "1981-10-04"^^xsd:date .

