@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Auberon_Herbert> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Auberon Herbert" ;
    onto:hasFather <http://example.org/entity/Aubrey_Herbert> ;
    skos:altLabel "Auberon Mark Yvo Henry Molyneux Herbert" .

<http://example.org/entity/Aubrey_Herbert> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Aubrey Herbert" ;
    onto:hasBrother <http://example.org/entity/George_Herbert_5th_Earl_of_Carnarvon> ;
    skos:altLabel "Colonel The Honourable Aubrey Nigel Henry Molyneux Herbert" .

<http://example.org/entity/George_Herbert_5th_Earl_of_Carnarvon> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "George Herbert, 5th Earl of Carnarvon" ;
    skos:altLabel "George Herbert" .

