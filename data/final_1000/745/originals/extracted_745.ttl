@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:auberon_herbert_landowner a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Auberon Herbert" ;
    onto:hasFather data:aubrey_herbert ;
    skos:altLabel "Auberon Mark Yvo Henry Molyneux Herbert" .

data:aubrey_herbert a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Aubrey Herbert" ;
    onto:hasBrother data:george_herbert_5th_earl_of_carnarvon ;
    skos:altLabel "Colonel The Honourable Aubrey Nigel Henry Molyneux Herbert" .

data:george_herbert_5th_earl_of_carnarvon a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "George Herbert, 5th Earl of Carnarvon" ;
    skos:altLabel "George Herbert" .

