@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:ruth_m_kirk a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ruth M. Kirk" ;
    onto:hasBirthDate "1930-02-02"^^xsd:date ;
    onto:hasDeathDate "2011-06-17"^^xsd:date .

data:theron_strinden a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Theron Strinden" ;
    onto:hasBirthDate "1919-05-26"^^xsd:date ;
    onto:hasDeathDate "2011-03-03"^^xsd:date .

