@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Ruth_M_Kirk> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1930-02-02"^^xsd:date ;
    ex:hasDeathDate "2011-06-17"^^xsd:date .

<http://example.org/entity/Theron_Strinden> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1919-05-26"^^xsd:date ;
    ex:hasDeathDate "2011-03-03"^^xsd:date .

