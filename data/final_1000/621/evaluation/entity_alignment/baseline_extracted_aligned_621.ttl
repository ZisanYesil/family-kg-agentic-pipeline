@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/John_Palaiologos> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Palaiologos (son of Andronikos II)" ;
    onto:hasMother <http://example.org/entity/Irene_of_Montferrat> .

<http://example.org/entity/Irene_of_Montferrat> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Irene of Montferrat" ;
    onto:hasFather <http://example.org/entity/William_VII_Marquess_of_Montferrat> .

<http://example.org/entity/William_VII_Marquess_of_Montferrat> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William VII, Marquess of Montferrat" .

