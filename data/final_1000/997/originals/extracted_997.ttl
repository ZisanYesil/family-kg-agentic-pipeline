@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:francoise_dupuis a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Françoise Dupuis" ;
    onto:hasSpouse data:philippe_moureaux .

data:philippe_moureaux a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Philippe Moureaux" .

