@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Françoise_Dupuis a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Philippe_Moureaux .

entity:Molenbeek a ex:Place .

entity:Philippe_Moureaux a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace entity:Molenbeek ;
    ex:hasSpouse entity:Françoise_Dupuis .

