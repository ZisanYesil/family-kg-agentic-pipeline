@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Françoise_Dupuis> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Philippe_Moureaux> .

<http://example.org/entity/Philippe_Moureaux> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Françoise_Dupuis> .

