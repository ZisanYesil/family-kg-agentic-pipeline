@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Françoise_Dupuis> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Françoise Dupuis" ;
    onto:hasSpouse <http://example.org/entity/Philippe_Moureaux> .

<http://example.org/entity/Philippe_Moureaux> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Philippe Moureaux" .

