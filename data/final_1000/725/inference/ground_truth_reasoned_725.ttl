@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Riders_of_the_Plains a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Jacques_Jaccard ;
    ex:hasDirector entity:Jacques_Jaccard .

entity:Los_Angeles_California a ex:Place .

entity:Jacques_Jaccard a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace entity:Los_Angeles_California .

