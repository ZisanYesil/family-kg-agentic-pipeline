@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Riders_of_the_Plains> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Jacques_Jaccard> ;
    ex:hasDirector <http://example.org/entity/Jacques_Jaccard> .

<http://example.org/entity/Los_Angeles_California> a ex:Place .

<http://example.org/entity/Jacques_Jaccard> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Los_Angeles_California> .

