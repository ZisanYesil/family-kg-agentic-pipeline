@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Riders_of_the_Plains> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Riders of the Plains" ;
    onto:hasDirector <http://example.org/entity/Jacques_Jaccard> .

<http://example.org/entity/Jacques_Jaccard> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jacques Jaccard" ;
    onto:hasDeathPlace <http://example.org/entity/Los_Angeles_California> .

<http://example.org/entity/Los_Angeles_California> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Los Angeles, California" .

