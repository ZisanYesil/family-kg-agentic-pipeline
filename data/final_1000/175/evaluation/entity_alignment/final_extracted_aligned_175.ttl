@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Jeevan_Mukt> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Sudhendu_Roy> ;
    ex:hasDirector <http://example.org/entity/Sudhendu_Roy> .

<http://example.org/entity/Filmfare_Award> a ex:Award .

<http://example.org/entity/Sudhendu_Roy> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/entity/Filmfare_Award> .

