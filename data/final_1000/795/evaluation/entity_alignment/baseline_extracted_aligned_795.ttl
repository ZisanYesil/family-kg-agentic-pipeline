@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Gabrielle_Robinne> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gabrielle Robinne" ;
    onto:hasNationality <http://example.org/entity/French> ;
    skos:altLabel "Gabrielle Anna Charlotte Robinne" .

<http://example.org/entity/Nicolas_François_Vuillaume> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nicolas François Vuillaume" ;
    onto:hasNationality <http://example.org/entity/French> .

<http://example.org/entity/French> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

