@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/I_Will_I_Will_for_Now> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "I Will, I Will... for Now" ;
    onto:hasDirector <http://example.org/entity/Norman_Panama> .

<http://example.org/entity/Norman_Panama> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Norman Panama" ;
    onto:hasCauseOfDeath <http://example.org/entity/Parkinson> ;
    skos:altLabel "Norman Kaye Panama" .

<http://example.org/entity/Parkinson> a onto:CauseOfDeath,
        owl:NamedIndividual ;
    rdfs:label "complications of Parkinson's disease" .

