@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/I_Will_I_Will_for_Now> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Norman_Panama> ;
    ex:hasDirector <http://example.org/entity/Norman_Panama> .

<http://example.org/entity/Parkinson> a ex:CauseOfDeath .

<http://example.org/entity/Norman_Panama> a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath <http://example.org/entity/Parkinson> .

