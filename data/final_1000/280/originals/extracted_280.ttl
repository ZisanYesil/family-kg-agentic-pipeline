@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:i_will_i_will_for_now a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "I Will, I Will... for Now" ;
    onto:hasDirector data:norman_panama .

data:norman_panama a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Norman Panama" ;
    onto:hasCauseOfDeath data:parkinsons_complications ;
    skos:altLabel "Norman Kaye Panama" .

data:parkinsons_complications a onto:CauseOfDeath,
        owl:NamedIndividual ;
    rdfs:label "complications of Parkinson's disease" .

