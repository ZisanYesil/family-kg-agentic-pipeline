@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:I_Will_I_Will_for_Now a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Norman_Panama ;
    ex:hasDirector entity:Norman_Panama .

entity:Parkinson a ex:CauseOfDeath .

entity:Norman_Panama a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath entity:Parkinson .

