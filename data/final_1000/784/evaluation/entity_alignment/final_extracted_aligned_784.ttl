@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Talking_to_the_Moon> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasComposer <http://example.org/entity/Bruno_Mars> ;
    ex:hasCreator <http://example.org/entity/Bruno_Mars> .

<http://example.org/entity/Grammy_Award> a ex:Award .

<http://example.org/entity/Bruno_Mars> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/entity/Grammy_Award> .

