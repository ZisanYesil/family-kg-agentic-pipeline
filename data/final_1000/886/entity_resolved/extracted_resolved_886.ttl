@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:aethelred_mercia a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Æthelred of Mercia" ;
    onto:hasSon data:osric_hwicce,
        data:oswald_hwicce ;
    skos:altLabel "Æthelred" .

data:osric_hwicce a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Osric, brother of Oswald" ;
    skos:altLabel "Osric" .

data:oswald_hwicce a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Oswald, king of the Hwicce" ;
    skos:altLabel "Oswald" .

