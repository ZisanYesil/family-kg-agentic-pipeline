@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Starter_for_10_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Starter for 10" ;
    onto:hasCountry <http://example.org/entity/British> .

<http://example.org/entity/The_Urethra_Chronicles> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Urethra Chronicles" .

<http://example.org/entity/British> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

