@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_starter_for_10 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Starter for 10" ;
    onto:hasCountry data:country_united_kingdom .

data:film_urethra_chronicles a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Urethra Chronicles" .

data:country_united_kingdom a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

