@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Starter_for_10_film a ex:Artifact ;
    ex:hasCountry entity:British,
        entity:US ;
    ex:hasCountryOfOrigin entity:British,
        entity:US .

entity:The_Urethra_Chronicles a ex:Artifact ;
    ex:hasCountry entity:American ;
    ex:hasCountryOfOrigin entity:American .

entity:American a ex:Country,
        ex:Place .

entity:British a ex:Country,
        ex:Place .

entity:US a ex:Country,
        ex:Place .

