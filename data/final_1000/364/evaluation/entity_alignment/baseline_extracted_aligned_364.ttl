@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Joseph_Ruskin> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Joseph Ruskin" ;
    onto:hasBirthDate "1924-04-14"^^xsd:date ;
    onto:hasDeathDate "2013-12-28"^^xsd:date .

<http://example.org/entity/Nicolae_Colan> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nicolae Colan" ;
    onto:hasBirthDate "1893-11-28"^^xsd:date ;
    onto:hasDeathDate "1967-04-15"^^xsd:date .

