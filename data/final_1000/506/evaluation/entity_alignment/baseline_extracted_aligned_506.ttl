@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Hans_Albrecht_Hereditary_Prince_of_Schleswig_Holstein> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hans Albrecht, Hereditary Prince of Schleswig-Holstein" ;
    onto:hasMother <http://example.org/entity/Princess_Marie_Melita_of_Hohenlohe_Langenburg> ;
    skos:altLabel "Hans Albrecht, Hereditary Prince of Schleswig-Holstein-Sonderburg-Glücksburg" .

<http://example.org/entity/Ernst_II_Prince_of_Hohenlohe_Langenburg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ernst II, Prince of Hohenlohe-Langenburg" .

<http://example.org/entity/Princess_Marie_Melita_of_Hohenlohe_Langenburg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Princess Marie Melita of Hohenlohe-Langenburg" ;
    onto:hasFather <http://example.org/entity/Ernst_II_Prince_of_Hohenlohe_Langenburg> .

