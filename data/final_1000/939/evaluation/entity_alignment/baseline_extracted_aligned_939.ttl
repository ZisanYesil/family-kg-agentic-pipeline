@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/A_Lego_Brickumentary> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Lego Brickumentary" ;
    onto:hasCountryOfOrigin <http://example.org/entity/American>,
        <http://example.org/entity/Danish> ;
    skos:altLabel "Beyond the Brick: A Lego Brickumentary" .

<http://example.org/entity/The_Night_Sitter> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Night Sitter" ;
    onto:hasCountryOfOrigin <http://example.org/entity/American> .

<http://example.org/entity/Danish> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Denmark" ;
    skos:altLabel "Danish" .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

