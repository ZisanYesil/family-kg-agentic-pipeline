@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/A_Lego_Brickumentary> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/American>,
        <http://example.org/entity/Danish> ;
    ex:hasCountryOfOrigin <http://example.org/entity/American>,
        <http://example.org/entity/Danish> .

<http://example.org/entity/The_Night_Sitter> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasCountryOfOrigin <http://example.org/entity/American> .

<http://example.org/entity/Danish> a ex:Country,
        ex:Place .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

