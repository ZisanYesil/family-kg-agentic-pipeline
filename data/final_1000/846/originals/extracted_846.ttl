@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:do_frade_river a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Do Frade River" ;
    onto:hasCountry data:brazil .

data:vermelho_river_manuel_alves_grande a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Vermelho River (Manuel Alves Grande River)" ;
    onto:hasCountry data:brazil .

data:brazil a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Brazil" .

