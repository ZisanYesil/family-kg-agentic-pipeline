@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Do_Frade_River> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Do Frade River" ;
    onto:hasCountry <http://example.org/entity/Brazil> .

<http://example.org/entity/Vermelho_River_Manuel_Alves_Grande_River> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Vermelho River (Manuel Alves Grande River)" ;
    onto:hasCountry <http://example.org/entity/Brazil> .

<http://example.org/entity/Brazil> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Brazil" .

