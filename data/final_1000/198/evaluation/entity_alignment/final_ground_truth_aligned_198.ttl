@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Alibi_Bye_Bye a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Ben_Holmes ;
    ex:hasDirector entity:Ben_Holmes .

entity:Leave_It_to_the_Marines a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Sam_Newfield ;
    ex:hasDirector entity:Sam_Newfield .

entity:Ben_Holmes a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:American ;
    ex:hasCountry entity:American .

entity:Sam_Newfield a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:American ;
    ex:hasCountry entity:American .

entity:American a ex:Country,
        ex:Place .

