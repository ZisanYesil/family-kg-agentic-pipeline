@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Alibi_Bye_Bye> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Alibi Bye Bye" ;
    onto:hasDirector <http://example.org/entity/Ben_Holmes> .

<http://example.org/entity/Leave_It_to_the_Marines> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Leave It To The Marines" ;
    onto:hasDirector <http://example.org/entity/Sam_Newfield> .

<http://example.org/entity/Ben_Holmes> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ben Holmes" ;
    onto:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/Sam_Newfield> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sam Newfield" ;
    onto:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

