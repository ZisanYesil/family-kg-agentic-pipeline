@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_far_from_madding_crowd_2015 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Far From The Madding Crowd (2015 film)" ;
    onto:hasCountryOfOrigin data:country_united_kingdom .

data:film_island_of_doomed_men a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Island of Doomed Men" ;
    onto:hasCountryOfOrigin data:country_united_states .

data:country_united_kingdom a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

data:country_united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

