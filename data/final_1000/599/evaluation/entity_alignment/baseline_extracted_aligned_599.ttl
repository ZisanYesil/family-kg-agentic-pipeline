@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Far_from_the_Madding_Crowd_2015_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Far From The Madding Crowd (2015 film)" ;
    onto:hasCountryOfOrigin <http://example.org/entity/British> .

<http://example.org/entity/Island_of_Doomed_Men> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Island of Doomed Men" ;
    onto:hasCountryOfOrigin <http://example.org/entity/American> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

<http://example.org/entity/British> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

