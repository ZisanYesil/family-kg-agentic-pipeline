@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Iraj_Kiarostami> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1963-07-07"^^xsd:date ;
    ex:hasDeathDate "2015-08-06"^^xsd:date .

<http://example.org/entity/Joseph_Peyré> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1892-03-13"^^xsd:date ;
    ex:hasDeathDate "1968-12-26"^^xsd:date .

