@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Iraj_Kiarostami> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Iraj Kiarostami" ;
    onto:hasBirthDate "1963-07-07"^^xsd:date ;
    onto:hasDeathDate "2015-08-06"^^xsd:date .

<http://example.org/entity/Joseph_Peyré> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Joseph Peyré" ;
    onto:hasBirthDate "1892-03-13"^^xsd:date ;
    onto:hasDeathDate "1968-12-26"^^xsd:date .

