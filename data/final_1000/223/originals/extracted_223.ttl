@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:dos_patos_river_iva%C3%AD a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Dos Patos River (Ivaí River)" ;
    onto:hasCountry data:brazil ;
    skos:altLabel "Dos Patos River (Ivaí River)" .

data:jaguarizinho_river a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Jaguarizinho River" ;
    onto:hasCountry data:brazil ;
    skos:altLabel "Jaguarizinho River" .

data:brazil a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Brazil" ;
    skos:altLabel "Brazil" .

