@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Dos_Patos_River_Ivaí_River> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Dos Patos River (Ivaí River)" ;
    onto:hasCountry <http://example.org/entity/Brazil> ;
    skos:altLabel "Dos Patos River (Ivaí River)" .

<http://example.org/entity/Jaguarizinho_River> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Jaguarizinho River" ;
    onto:hasCountry <http://example.org/entity/Brazil> ;
    skos:altLabel "Jaguarizinho River" .

<http://example.org/entity/Brazil> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Brazil" ;
    skos:altLabel "Brazil" .

