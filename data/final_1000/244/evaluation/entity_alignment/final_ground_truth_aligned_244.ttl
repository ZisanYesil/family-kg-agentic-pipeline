@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Forget_About_the_World a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Gabrielle ;
    ex:hasPerformer entity:Gabrielle .

entity:Hackney a ex:Place .

entity:Gabrielle a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Hackney .

