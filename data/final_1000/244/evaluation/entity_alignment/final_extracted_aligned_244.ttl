@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Forget_About_the_World> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Gabrielle> ;
    ex:hasPerformer <http://example.org/entity/Gabrielle> .

<http://example.org/entity/Hackney> a ex:Place .

<http://example.org/entity/Gabrielle> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1969-07-19"^^xsd:date ;
    ex:hasBirthPlace <http://example.org/entity/Hackney> .

