@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Tannenberg_film a ex:Artifact ;
    ex:hasCountry entity:German .

entity:To_Kill_a_Dragon a ex:Artifact ;
    ex:hasCountry entity:German,
        entity:Soviet .

entity:Soviet a ex:Country,
        ex:Place .

entity:German a ex:Country,
        ex:Place .

