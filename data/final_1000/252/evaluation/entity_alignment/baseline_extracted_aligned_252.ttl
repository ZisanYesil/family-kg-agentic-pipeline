@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Tannenberg_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Tannenberg" ;
    onto:hasCountry <http://example.org/entity/German> .

<http://example.org/entity/To_Kill_a_Dragon> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "To Kill a Dragon" ;
    onto:hasCountry <http://example.org/entity/German> .

<http://example.org/entity/German> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Germany" ;
    skos:altLabel "German" .

