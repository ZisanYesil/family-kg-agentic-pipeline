@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:margaret_holles a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Margaret Holles, Duchess of Newcastle-upon-Tyne" ;
    onto:hasSpouse data:john_holles ;
    skos:altLabel "Margaret Holles" .

data:john_holles a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Holles, Earl of Clare" ;
    skos:altLabel "John Holles" .

