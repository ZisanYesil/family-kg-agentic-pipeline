@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Cry_Over_Me> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasComposer <http://example.org/entity/Diane_Warren> ;
    ex:hasCreator <http://example.org/entity/Diane_Warren> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/Diane_Warren> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasNationality <http://example.org/entity/American> .

