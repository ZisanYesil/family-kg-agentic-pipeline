@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:cry_over_me a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Cry Over Me" ;
    onto:hasComposer data:diane_warren ;
    skos:altLabel "Cry Over Me" .

data:diane_warren a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Diane Warren" ;
    onto:hasNationality data:united_states ;
    skos:altLabel "Diane Warren" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

