@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Boris_Prince_of_Turnovo a ex:Agent,
        ex:Person ;
    ex:hasFather entity:Kardam_Prince_of_Turnovo ;
    ex:hasParent entity:Kardam_Prince_of_Turnovo .

entity:Penn_State a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Kardam_Prince_of_Turnovo a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Boris_Prince_of_Turnovo ;
    ex:hasEducatedAt entity:Penn_State .

