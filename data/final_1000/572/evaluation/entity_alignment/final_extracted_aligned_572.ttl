@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Boris_Prince_of_Turnovo> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Kardam_Prince_of_Turnovo> ;
    ex:hasParent <http://example.org/entity/Kardam_Prince_of_Turnovo> .

<http://example.org/entity/Penn_State> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Kardam_Prince_of_Turnovo> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Boris_Prince_of_Turnovo> ;
    ex:hasEducatedAt <http://example.org/entity/Penn_State> .

