@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Baby_Face_Morgan a ex:Artifact,
        ex:CreativeWork ;
    ex:hasProducer entity:Jack_Schwarz .

entity:The_Seventh_Victim a ex:Artifact,
        ex:CreativeWork ;
    ex:hasProducer entity:Val_Lewton .

entity:Jack_Schwarz a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1896-12-19"^^xsd:date .

entity:Val_Lewton a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1904-05-07"^^xsd:date .

