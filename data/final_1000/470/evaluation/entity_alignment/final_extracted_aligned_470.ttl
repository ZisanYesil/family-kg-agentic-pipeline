@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Baby_Face_Morgan> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/Jack_Schwarz> .

<http://example.org/entity/The_Seventh_Victim> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/Val_Lewton> .

<http://example.org/entity/Jack_Schwarz> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1896-12-19"^^xsd:date .

<http://example.org/entity/Val_Lewton> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1904-05-07"^^xsd:date .

