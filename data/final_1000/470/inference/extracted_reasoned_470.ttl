@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_baby_face_morgan> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/extracted/person_jack_schwarz> .

<http://example.org/extracted/film_the_seventh_victim> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/extracted/person_val_lewton> .

<http://example.org/extracted/person_jack_schwarz> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1896-12-19"^^xsd:date .

<http://example.org/extracted/person_val_lewton> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1904-05-07"^^xsd:date .

