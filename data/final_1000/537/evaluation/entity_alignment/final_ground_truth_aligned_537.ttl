@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Bon_Bon_Buddy a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Billy_Murray ;
    ex:hasPerformer entity:Billy_Murray .

entity:Billy_Murray a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:United_States ;
    ex:hasCountry entity:United_States .

entity:United_States a ex:Country,
        ex:Place .

