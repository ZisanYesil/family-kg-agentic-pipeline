@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Straw_Hat a ex:Artifact,
        ex:CreativeWork ;
    ex:hasComposer entity:Isaac_Schwartz ;
    ex:hasCreator entity:Isaac_Schwartz .

entity:Siversky a ex:Place .

entity:Isaac_Schwartz a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace entity:Siversky .

