@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_Straw_Hat> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasComposer <http://example.org/entity/Isaac_Schwartz> ;
    ex:hasCreator <http://example.org/entity/Isaac_Schwartz> .

<http://example.org/entity/Siversky> a ex:Place .

<http://example.org/entity/Isaac_Schwartz> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Siversky> .

