@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Isaac_Schwartz> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Isaac Schwartz" ;
    onto:hasDeathPlace <http://example.org/entity/Siversky> ;
    skos:altLabel "Isaac Iosifovich Schwartz" .

<http://example.org/entity/The_Straw_Hat> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Straw Hat" .

<http://example.org/entity/Siversky> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Siversky" ;
    skos:altLabel "Siversky, near Saint Petersburg, Russian Federation" .

