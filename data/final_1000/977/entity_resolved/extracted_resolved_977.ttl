@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_a_bientot_1968 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "À bientôt, j'espère" ;
    onto:hasPublicationDate "1968"^^xsd:gYear .

data:film_gents_in_a_jam_1952 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Gents in a Jam" ;
    onto:hasPublicationDate "1952"^^xsd:gYear .

