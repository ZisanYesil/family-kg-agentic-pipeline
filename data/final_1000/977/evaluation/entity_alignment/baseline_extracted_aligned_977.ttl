@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Gents_in_a_Jam> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Gents in a Jam" ;
    onto:hasPublicationDate "1952"^^xsd:gYear .

<http://example.org/entity/À_bientôt_j_espère> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "À bientôt, j'espère" ;
    onto:hasPublicationDate "1968"^^xsd:gYear .

