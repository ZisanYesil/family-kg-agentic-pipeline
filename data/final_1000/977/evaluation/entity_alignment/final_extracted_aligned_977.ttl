@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Gents_in_a_Jam> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
