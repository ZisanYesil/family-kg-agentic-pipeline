@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Don_t_Knock_the_Ox> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Tony_Ianzelo> ;
    ex:hasDirector <http://example.org/entity/Tony_Ianzelo> .

<http://example.org/entity/Ryerson_University> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Tony_Ianzelo> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/Ryerson_University> .

