@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:eri_jabotinsky a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Eri Jabotinsky" ;
    onto:hasFather data:zeev_jabotinsky .

data:hunter_new_york a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Hunter, New York" .

data:zeev_jabotinsky a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ze'ev Jabotinsky" ;
    onto:hasDeathPlace data:hunter_new_york .

