@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Anubhav> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Basu_Bhattacharya> ;
    ex:hasDirector <http://example.org/entity/Basu_Bhattacharya> .

<http://example.org/entity/Rinki_Bhattacharya> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Basu_Bhattacharya> .

<http://example.org/entity/Basu_Bhattacharya> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Rinki_Bhattacharya> .

