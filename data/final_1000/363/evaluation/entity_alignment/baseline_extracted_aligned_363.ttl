@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Anubhav> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Anubhav (1971 film)" ;
    onto:hasDirector <http://example.org/entity/Basu_Bhattacharya> .

<http://example.org/entity/Basu_Bhattacharya> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Basu Bhattacharya" ;
    onto:hasSpouse <http://example.org/entity/Rinki_Bhattacharya> .

<http://example.org/entity/Rinki_Bhattacharya> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Rinki Bhattacharya" .

