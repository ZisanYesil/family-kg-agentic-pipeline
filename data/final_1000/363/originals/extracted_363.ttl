@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:film_anubhav_1971 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Anubhav (1971 film)" ;
    onto:hasDirector data:person_basu_bhattacharya .

data:person_basu_bhattacharya a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Basu Bhattacharya" ;
    onto:hasSpouse data:person_rinki_bhattacharya .

data:person_rinki_bhattacharya a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Rinki Bhattacharya" .

