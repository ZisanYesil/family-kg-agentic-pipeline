@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Labu_dan_Labi a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:P_Ramlee ;
