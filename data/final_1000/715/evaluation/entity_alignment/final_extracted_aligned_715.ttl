@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Labu_dan_Labi> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/P_Ramlee> ;
    ex:hasDirector <http://example.org/entity/P_Ramlee> .

<http://example.org/entity/Malaysia> a ex:Country,
        ex:Place .

<http://example.org/entity/P_Ramlee> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Malaysia> ;
    ex:hasNationality <http://example.org/entity/Malaysia> .

