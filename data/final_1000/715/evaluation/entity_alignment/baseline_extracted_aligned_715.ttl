@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Labu_dan_Labi> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Labu dan Labi" ;
    onto:hasDirector <http://example.org/entity/P_Ramlee> .

<http://example.org/entity/Malaysia> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Malaysia" ;
    skos:altLabel "Malaysian" .

<http://example.org/entity/P_Ramlee> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "P. Ramlee" ;
    onto:hasNationality <http://example.org/entity/Malaysia> .

