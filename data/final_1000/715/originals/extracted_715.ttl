@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:labu_dan_labi a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Labu dan Labi" ;
    onto:hasDirector data:p_ramlee .

data:malaysia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Malaysia" ;
    skos:altLabel "Malaysian" .

data:p_ramlee a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "P. Ramlee" ;
    onto:hasNationality data:malaysia .

