@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Sancho_Ramírez> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sancho Ramírez" ;
    onto:hasFather <http://example.org/entity/Ramiro_I_of_Aragon> .

<http://example.org/entity/Ramiro_I_of_Aragon> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ramiro I of Aragon" .

