@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:sancho_ramirez a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sancho Ramírez" ;
    onto:hasFather data:ramiro_i_of_aragon .

data:ramiro_i_of_aragon a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ramiro I of Aragon" .

