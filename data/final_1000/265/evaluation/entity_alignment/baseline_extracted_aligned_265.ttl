@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Mugain> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mugain" ;
    onto:hasSpouse <http://example.org/entity/Conchobar_mac_Nessa> .

<http://example.org/entity/Conchobar_mac_Nessa> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Conchobar mac Nessa" ;
    onto:hasMother <http://example.org/entity/Ness> .

<http://example.org/entity/Ness> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ness" .

