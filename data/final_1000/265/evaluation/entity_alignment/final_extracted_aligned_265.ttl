@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Mugain> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Conchobar_mac_Nessa> .

<http://example.org/entity/Conchobar_mac_Nessa> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Ness> ;
    ex:hasParent <http://example.org/entity/Ness> ;
    ex:hasSpouse <http://example.org/entity/Mugain> .

<http://example.org/entity/Ness> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Conchobar_mac_Nessa> .

