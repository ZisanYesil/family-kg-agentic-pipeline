@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Conchobar_mac_Nessa a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Ness ;
    ex:hasSpouse entity:Mugain .

entity:Mugain a ex:Agent,
        ex:Person .

entity:Ness a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Conchobar_mac_Nessa .

