@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:omar_rayo a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Omar Rayo" ;
    onto:hasBirthDate "1928-01-20"^^xsd:date ;
    onto:hasDeathDate "2010-06-07"^^xsd:date ;
    skos:altLabel "Omar Rayo Reyes" .

data:stefan_henze a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Stefan Henze" ;
    onto:hasBirthDate "1981-05-03"^^xsd:date ;
    onto:hasDeathDate "2016-08-15"^^xsd:date .

