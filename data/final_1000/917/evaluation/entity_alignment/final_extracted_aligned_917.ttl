@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Deathstalker_II> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Jim_Wynorski> ;
    ex:hasDirector <http://example.org/entity/Jim_Wynorski> .

<http://example.org/entity/New_York> a ex:Place .

<http://example.org/entity/Jim_Wynorski> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/New_York> .

