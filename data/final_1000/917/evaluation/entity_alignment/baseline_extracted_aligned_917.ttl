@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Deathstalker_II> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Deathstalker II" ;
    onto:hasDirector <http://example.org/entity/Jim_Wynorski> .

<http://example.org/entity/Jim_Wynorski> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jim Wynorski" ;
    onto:hasBirthPlace <http://example.org/entity/New_York> .

<http://example.org/entity/New_York> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Glen Cove, Long Island, New York" ;
    skos:altLabel "Glen Cove" .

