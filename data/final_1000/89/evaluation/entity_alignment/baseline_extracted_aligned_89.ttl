@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Grand_Duchess_Natalya_Alexeyevna_of_Russia> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Grand Duchess Natalya Alexeyevna of Russia" ;
    onto:hasSister <http://example.org/entity/Peter_II_of_Russia> ;
    skos:altLabel "Natalya Alexeyevna (1714–1728)" .

<http://example.org/entity/Charlotte_Christine_of_Brunswick_Lüneburg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Charlotte Christine of Brunswick-Lüneburg" .

<http://example.org/entity/Peter_II_of_Russia> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Peter II of Russia" ;
    onto:hasMother <http://example.org/entity/Charlotte_Christine_of_Brunswick_Lüneburg> ;
    skos:altLabel "Peter II Alexeyevich" .

