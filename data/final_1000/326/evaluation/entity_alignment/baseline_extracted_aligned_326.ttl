@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Watch_Me_Do> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Watch Me Do" ;
    onto:hasPerformer <http://example.org/entity/Meghan_Trainor> .

<http://example.org/entity/Grammy_Award> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Grammy Award" .

<http://example.org/entity/Meghan_Trainor> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Meghan Trainor" ;
    onto:hasAwardReceived <http://example.org/entity/Grammy_Award>,
        data:ascap_pop_music_award,
        data:billboard_music_award .

data:ascap_pop_music_award a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "ASCAP Pop Music Award" .

data:billboard_music_award a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Billboard Music Award" .

