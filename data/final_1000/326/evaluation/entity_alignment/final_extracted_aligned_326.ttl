@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Watch_Me_Do> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Meghan_Trainor> ;
    ex:hasPerformer <http://example.org/entity/Meghan_Trainor> .

<http://example.org/entity/Grammy_Award> a ex:Award .

<http://example.org/extracted/ascap_pop_music_award> a ex:Award .

<http://example.org/extracted/billboard_music_award> a ex:Award .

<http://example.org/entity/Meghan_Trainor> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/entity/Grammy_Award>,
        <http://example.org/extracted/ascap_pop_music_award>,
        <http://example.org/extracted/billboard_music_award> .

