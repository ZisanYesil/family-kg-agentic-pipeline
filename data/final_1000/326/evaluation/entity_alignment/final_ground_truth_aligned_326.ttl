@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Watch_Me_Do a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Meghan_Trainor ;
    ex:hasPerformer entity:Meghan_Trainor .

entity:Grammy_Award a ex:Award .

entity:Meghan_Trainor a ex:Agent ;
    ex:hasAwardReceived entity:Grammy_Award .

