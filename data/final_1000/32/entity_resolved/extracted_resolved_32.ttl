@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:adalberto_pereira_dos_santos a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Adalberto Pereira dos Santos" ;
    onto:hasBirthDate "1905-04-11"^^xsd:date ;
    onto:hasDeathDate "1984-04-02"^^xsd:date ;
    skos:altLabel "Adalberto Pereira dos Santos" .

data:louis_armand_constantin_de_rohan a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Louis-Armand-Constantin de Rohan" ;
    onto:hasBirthDate "1732-04-06"^^xsd:date ;
    onto:hasDeathDate "1794-07-27"^^xsd:date ;
    skos:altLabel "Louis- Armand- Constantin de Rohan",
        "Louis‑Armand‑Constantin de Rohan" .

