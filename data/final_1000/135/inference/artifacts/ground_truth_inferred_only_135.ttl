@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Chimalpopoca a ex:Agent,
        ex:Person ;
    ex:hasSibling entity:Tlacaelel .

entity:Tlilpotoncatzin a ex:Agent,
        ex:Person ;
