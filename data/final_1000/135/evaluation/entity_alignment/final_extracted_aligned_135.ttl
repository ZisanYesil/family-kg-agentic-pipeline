@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Tlilpotoncatzin> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Tlacaelel> ;
    ex:hasParent <http://example.org/entity/Tlacaelel> .

<http://example.org/entity/Chimalpopoca> a ex:Agent,
        ex:Person ;
    ex:hasSibling <http://example.org/entity/Tlacaelel> ;
    ex:isBrotherOf <http://example.org/entity/Tlacaelel> .

<http://example.org/extracted/moctezuma_i> a ex:Agent,
        ex:Person ;
    ex:hasSibling <http://example.org/entity/Tlacaelel> ;
    ex:isBrotherOf <http://example.org/entity/Tlacaelel> .

<http://example.org/entity/Tlacaelel> a ex:Agent,
        ex:Person ;
    ex:hasBrother <http://example.org/entity/Chimalpopoca>,
        <http://example.org/extracted/moctezuma_i> ;
    ex:hasChild <http://example.org/entity/Tlilpotoncatzin> ;
    ex:hasSibling <http://example.org/entity/Chimalpopoca>,
        <http://example.org/extracted/moctezuma_i> .

