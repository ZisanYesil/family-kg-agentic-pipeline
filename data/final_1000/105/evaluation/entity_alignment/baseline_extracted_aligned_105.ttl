@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/God_s_Ears> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "God's Ears" .

<http://example.org/entity/The_Keeper_of_the_Bees_1935_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Keeper of the Bees (1935 film)" ;
    onto:hasCountry <http://example.org/entity/American> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

