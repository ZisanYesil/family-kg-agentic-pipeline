@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Starsky_and_Hutch_on_Playboy_Island a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:George_McCowan ;
    ex:hasDirector entity:George_McCowan .

entity:emphysema a ex:CauseOfDeath .

entity:George_McCowan a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath entity:emphysema .

