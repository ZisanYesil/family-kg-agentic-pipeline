@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Starsky_and_Hutch_on_Playboy_Island> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/George_McCowan> ;
    ex:hasDirector <http://example.org/entity/George_McCowan> .

<http://example.org/entity/emphysema> a ex:CauseOfDeath .

<http://example.org/entity/George_McCowan> a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath <http://example.org/entity/emphysema> .

