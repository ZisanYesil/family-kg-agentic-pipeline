@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Nicholas_Richard_Michael_Eliot_9th_Earl_of_St_Germans> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nicholas Richard Michael Eliot, 9th Earl of St Germans" ;
    onto:hasFather <http://example.org/entity/Montague_Eliot_8th_Earl_of_St_Germans> ;
    skos:altLabel "Nicholas Eliot",
        "Nicholas Richard Michael Eliot" .

<http://example.org/entity/Granville_Eliot_7th_Earl_of_St_Germans> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Granville John Eliot, 7th Earl of St Germans" ;
    skos:altLabel "Granville Eliot" .

<http://example.org/entity/Montague_Eliot_8th_Earl_of_St_Germans> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Montague Charles Eliot, 8th Earl of St Germans" ;
    onto:hasBrother <http://example.org/entity/Granville_Eliot_7th_Earl_of_St_Germans> ;
    skos:altLabel "Montague Eliot" .

