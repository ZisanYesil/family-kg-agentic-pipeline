@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/One_But_a_Lion> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Gustaf_Molander> ;
    ex:hasDirector <http://example.org/entity/Gustaf_Molander> .

<http://example.org/entity/Helsingfors> a ex:Place .

<http://example.org/entity/Gustaf_Molander> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Helsingfors> .

