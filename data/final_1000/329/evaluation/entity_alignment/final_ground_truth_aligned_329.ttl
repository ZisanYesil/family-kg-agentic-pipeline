@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:One_But_a_Lion a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Gustaf_Molander ;
    ex:hasDirector entity:Gustaf_Molander .

entity:Helsingfors a ex:Place .

entity:Gustaf_Molander a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Helsingfors .

