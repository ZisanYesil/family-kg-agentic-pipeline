@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_one_but_a_lion a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "One, But a Lion!" ;
    onto:hasDirector data:person_gustaf_molander .

data:person_gustaf_molander a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gustaf Molander" ;
    onto:hasBirthPlace data:place_helsingfors .

data:place_helsingfors a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Helsingfors" ;
    skos:altLabel "Helsinki" .

