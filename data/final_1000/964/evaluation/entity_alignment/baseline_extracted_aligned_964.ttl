@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Louis_Jean_Marie_de_Bourbon> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Louis Jean Marie de Bourbon" ;
    onto:hasNationality <http://example.org/entity/France> ;
    onto:hasSon <http://example.org/entity/Louis_Alexandre_Prince_of_Lamballe> .

<http://example.org/entity/France> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

<http://example.org/entity/Louis_Alexandre_Prince_of_Lamballe> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Louis Alexandre de Bourbon" .

