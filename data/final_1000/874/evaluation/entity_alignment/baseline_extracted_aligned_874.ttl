@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Ilya_Tyapkin> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ilya Tyapkin" ;
    onto:hasBirthDate "1991-08-02"^^xsd:date .

<http://example.org/entity/Ralf_Wohlleben> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ralf Wohlleben" ;
    onto:hasBirthDate "1975-02-27"^^xsd:date .

