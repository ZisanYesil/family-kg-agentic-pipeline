@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Personalized_Medicine> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Personalized Medicine" ;
    onto:hasPublisher <http://example.org/entity/Future_Medicine> .

<http://example.org/entity/Future_Medicine> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Future Medicine" ;
    onto:hasCountry <http://example.org/entity/United_Kingdom> .

<http://example.org/entity/United_Kingdom> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "United Kingdom" .

