@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Personalized_Medicine> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher <http://example.org/entity/Future_Medicine> .

<http://example.org/entity/Future_Medicine> a ex:Agent,
        ex:Organization ;
    ex:hasCountry <http://example.org/entity/United_Kingdom> .

<http://example.org/entity/United_Kingdom> a ex:Country,
        ex:Place .

