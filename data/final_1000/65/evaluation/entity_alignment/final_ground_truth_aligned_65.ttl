@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Personalized_Medicine a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher entity:Future_Medicine .

entity:Future_Medicine a ex:Agent,
        ex:Organization ;
    ex:hasCountry entity:United_Kingdom .

entity:United_Kingdom a ex:Country,
        ex:Place .

