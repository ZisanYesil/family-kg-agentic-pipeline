@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:benjamin_nottingham_webster_1797 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Benjamin Nottingham Webster" ;
    onto:hasBirthDate "1797-09-03"^^xsd:date ;
    onto:hasDeathDate "1882-07-03"^^xsd:date ;
    skos:altLabel "Benjamin Nottingham Webster" .

data:jan_huchtenburg_1647 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jan van Huchtenburg" ;
    onto:hasBirthDate "1647-11-20"^^xsd:date ;
    onto:hasDeathDate "1733-07-02"^^xsd:date ;
    skos:altLabel "Jan van Huchtenburg" .

