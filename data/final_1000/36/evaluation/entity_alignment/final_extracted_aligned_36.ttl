@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Benjamin_Nottingham_Webster> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1797-09-03"^^xsd:date ;
    ex:hasDeathDate "1882-07-03"^^xsd:date .

<http://example.org/entity/Huchtenburg> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1647-11-20"^^xsd:date ;
    ex:hasDeathDate "1733-07-02"^^xsd:date .

