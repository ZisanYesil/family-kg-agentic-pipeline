@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:juwayriyya_bint_al_harith a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Juwayriyya bint al-Harith" ;
    onto:hasSpouse data:muhammad .

data:mecca a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Mecca" .

data:muhammad a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Muhammad" ;
    onto:hasBirthPlace data:mecca .

