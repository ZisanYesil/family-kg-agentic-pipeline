@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Juwayriya_bint_al_Harith> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Juwayriyya bint al-Harith" ;
    onto:hasSpouse <http://example.org/entity/Muhammad> .

<http://example.org/entity/Mecca> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Mecca" .

<http://example.org/entity/Muhammad> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Muhammad" ;
    onto:hasBirthPlace <http://example.org/entity/Mecca> .

