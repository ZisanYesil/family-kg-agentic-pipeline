@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:the_last_white_dishwasher a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Last White Dishwasher" ;
    onto:hasPublicationDate "2008"^^xsd:gYear .

