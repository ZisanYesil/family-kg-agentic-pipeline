@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/The_Last_White_Dishwasher> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Last White Dishwasher" ;
    onto:hasPublicationDate "2008"^^xsd:gYear .

<http://example.org/entity/The_Year_of_Spectacular_Men> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Year of Spectacular Men" ;
    onto:hasPublicationDate "2018-06-15"^^xsd:date .

