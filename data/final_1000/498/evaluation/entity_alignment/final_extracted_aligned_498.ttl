@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Augustus_Henry_Seward> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Frances_Adeline_Seward> ;
    ex:hasParent <http://example.org/entity/Frances_Adeline_Seward> .

<http://example.org/entity/Frances_Adeline_Seward> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1805-09-25"^^xsd:date ;
    ex:hasChild <http://example.org/entity/Augustus_Henry_Seward> ;
    ex:hasDeathDate "1865-06-21"^^xsd:date .

