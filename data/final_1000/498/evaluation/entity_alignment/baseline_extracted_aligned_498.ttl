@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Augustus_Henry_Seward> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Augustus Henry Seward" ;
    onto:hasMother <http://example.org/entity/Frances_Adeline_Seward> .

<http://example.org/entity/Frances_Adeline_Seward> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Frances Adeline Seward" ;
    onto:hasBirthDate "1805-09-25"^^xsd:date ;
    onto:hasDeathDate "1865-06-21"^^xsd:date ;
    skos:altLabel "Frances Adeline Miller Seward" .

