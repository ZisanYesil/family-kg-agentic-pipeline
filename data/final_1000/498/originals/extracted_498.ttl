@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:augustus_henry_seward a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Augustus Henry Seward" ;
    onto:hasMother data:frances_adeline_seward .

data:frances_adeline_seward a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Frances Adeline Seward" ;
    onto:hasBirthDate "1805-09-25"^^xsd:date ;
    onto:hasDeathDate "1865-06-21"^^xsd:date ;
    skos:altLabel "Frances Adeline Miller Seward" .

