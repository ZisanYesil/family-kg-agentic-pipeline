@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/augustus_henry_seward> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/extracted/frances_adeline_seward> ;
    ex:hasParent <http://example.org/extracted/frances_adeline_seward> .

<http://example.org/extracted/frances_adeline_seward> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1805-09-25"^^xsd:date ;
    ex:hasChild <http://example.org/extracted/augustus_henry_seward> ;
    ex:hasDeathDate "1865-06-21"^^xsd:date .

