@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/The_Good_Soldier_Schweik> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Good Soldier Schweik (1926 film)" ;
    onto:hasDirector <http://example.org/entity/Karel_Lamač> .

<http://example.org/entity/Hamburg_Germany> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Hamburg, Germany" .

<http://example.org/entity/Karel_Lamač> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Karel Lamač" ;
    onto:hasDeathPlace <http://example.org/entity/Hamburg_Germany> .

