@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Constantine_III_of_Scotland> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Cuilén> ;
    ex:hasParent <http://example.org/entity/Cuilén> .

<http://example.org/entity/Amlaíb> a ex:Agent,
        ex:Person ;
    ex:hasSibling <http://example.org/entity/Cuilén> ;
    ex:isBrotherOf <http://example.org/entity/Cuilén> .

<http://example.org/entity/Cuilén> a ex:Agent,
        ex:Person ;
    ex:hasBrother <http://example.org/entity/Amlaíb> ;
    ex:hasChild <http://example.org/entity/Constantine_III_of_Scotland> ;
    ex:hasSibling <http://example.org/entity/Amlaíb> .

