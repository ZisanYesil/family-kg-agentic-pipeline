@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Constantine_III_of_Scotland> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Constantine III of Scotland" ;
    onto:hasFather <http://example.org/entity/Cuilén> .

<http://example.org/entity/Amlaíb> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Amlaíb" .

<http://example.org/entity/Cuilén> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Cuilén" ;
    onto:hasBrother <http://example.org/entity/Amlaíb> .

