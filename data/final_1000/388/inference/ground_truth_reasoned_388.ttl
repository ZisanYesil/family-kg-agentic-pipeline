@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Things_Done_Changed a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Notorious_B_I_G ;
    ex:hasPerformer entity:Notorious_B_I_G .

entity:drive_by_shooting a ex:CauseOfDeath .

entity:Notorious_B_I_G a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath entity:drive_by_shooting .

