@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Things_Done_Changed> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Notorious_B_I_G> ;
    ex:hasPerformer <http://example.org/entity/Notorious_B_I_G> .

<http://example.org/entity/drive_by_shooting> a ex:CauseOfDeath .

<http://example.org/entity/Notorious_B_I_G> a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath <http://example.org/entity/drive_by_shooting> .

