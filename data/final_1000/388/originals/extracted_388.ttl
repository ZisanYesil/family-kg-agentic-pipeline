@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:things_done_changed a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Things Done Changed" ;
    onto:hasPerformer data:the_notorious_big .

data:drive_by_shooting a onto:CauseOfDeath,
        owl:NamedIndividual ;
    rdfs:label "drive-by shooting" .

data:the_notorious_big a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "The Notorious B.I.G." ;
    onto:hasCauseOfDeath data:drive_by_shooting .

