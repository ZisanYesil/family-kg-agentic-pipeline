@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Franz_Limmer> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Franz Limmer" ;
    onto:hasBirthDate "1808-10-02"^^xsd:date ;
    onto:hasDeathDate "1857-01-19"^^xsd:date .

<http://example.org/entity/Robert_Glen_Coe> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Robert Glen Coe" ;
    onto:hasBirthDate "1956-04-15"^^xsd:date ;
    onto:hasDeathDate "2000-04-19"^^xsd:date .

