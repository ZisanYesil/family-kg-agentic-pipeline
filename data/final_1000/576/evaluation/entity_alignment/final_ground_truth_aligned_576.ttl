@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Franz_Limmer a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1808-10-02"^^xsd:date ;
    ex:hasDeathDate "1857-01-19"^^xsd:date .

entity:Robert_Glen_Coe a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1956-04-15"^^xsd:date ;
    ex:hasDeathDate "2000-04-19"^^xsd:date .

