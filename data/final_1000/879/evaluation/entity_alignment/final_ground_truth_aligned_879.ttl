@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Saadia a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Albert_Lewin ;
    ex:hasDirector entity:Albert_Lewin .

entity:Harvard a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Albert_Lewin a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt entity:Harvard .

