@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Saadia> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Albert_Lewin> ;
    ex:hasDirector <http://example.org/entity/Albert_Lewin> .

<http://example.org/entity/Harvard> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Albert_Lewin> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/Harvard> .

