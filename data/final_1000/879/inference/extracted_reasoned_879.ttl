@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/film_saadia> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_albert_lewin> ;
    ex:hasDirector <http://example.org/extracted/person_albert_lewin> .

<http://example.org/extracted/institution_harvard_university> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/extracted/person_albert_lewin> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/extracted/institution_harvard_university> .

