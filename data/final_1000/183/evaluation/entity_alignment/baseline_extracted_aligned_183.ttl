@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Nippu> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Nippu" ;
    onto:hasDirector <http://example.org/entity/Gunasekhar> ;
    skos:altLabel "Nippu" .

<http://example.org/entity/Filmfare_Awards_South> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Filmfare Award for Best Director – Telugu" ;
    skos:altLabel "Filmfare Award for Best Director – Telugu" .

<http://example.org/entity/Gunasekhar> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gunasekhar" ;
    onto:hasAwardReceived <http://example.org/entity/Filmfare_Awards_South> ;
    skos:altLabel "Gunasekar",
        "Gunasekhar" .

