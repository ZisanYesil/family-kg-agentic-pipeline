@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Nippu> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Gunasekhar> ;
    ex:hasDirector <http://example.org/entity/Gunasekhar> .

<http://example.org/entity/Filmfare_Awards_South> a ex:Award .

<http://example.org/entity/Gunasekhar> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/entity/Filmfare_Awards_South> .

