@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:lee_mantle a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lee Mantle" ;
    onto:hasBirthDate "1851-12-13"^^xsd:date ;
    onto:hasDeathDate "1934-11-18"^^xsd:date .

data:silas_hardy a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Silas Hardy" ;
    onto:hasBirthDate "1867-04-30"^^xsd:date ;
    onto:hasDeathDate "1905-06-27"^^xsd:date .

