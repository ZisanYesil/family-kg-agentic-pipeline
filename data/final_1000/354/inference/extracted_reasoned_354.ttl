@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/when_you_were_mine_song> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasComposer <http://example.org/extracted/prince> ;
    ex:hasCreator <http://example.org/extracted/prince> .

<http://example.org/extracted/prince> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/extracted/united_states> ;
    ex:hasNationality <http://example.org/extracted/united_states> .

<http://example.org/extracted/united_states> a ex:Country,
        ex:Place .

