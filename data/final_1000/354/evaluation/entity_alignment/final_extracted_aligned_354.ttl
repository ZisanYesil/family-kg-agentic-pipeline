@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/When_You_Were_Mine> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasComposer <http://example.org/entity/Prince> ;
    ex:hasCreator <http://example.org/entity/Prince> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/Prince> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasNationality <http://example.org/entity/American> .

