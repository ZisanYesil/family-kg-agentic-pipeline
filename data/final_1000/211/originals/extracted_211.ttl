@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_long_vacations_of_36 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Long Vacations of 36" ;
    onto:hasPublicationDate "1976"^^xsd:gYear .

data:film_me_and_him a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Me and Him" ;
    onto:hasPublicationDate "1988"^^xsd:gYear .

