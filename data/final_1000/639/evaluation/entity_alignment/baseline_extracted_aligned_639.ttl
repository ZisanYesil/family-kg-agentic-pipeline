@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Amaya_School_of_Home_Industries> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Amaya School of Home Industries" ;
    onto:hasInception "1964-06-18"^^xsd:date .

<http://example.org/entity/Shonan_Institute_of_Technology_High_School> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Shonan Institute of Technology High School" ;
    onto:hasInception "1961"^^xsd:gYear .

