@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Queen_Insun> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Myeongjong_of_Joseon> .

<http://example.org/entity/Myeongjong_of_Joseon> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Queen_Munjeong> ;
    ex:hasParent <http://example.org/entity/Queen_Munjeong> ;
    ex:hasSpouse <http://example.org/entity/Queen_Insun> .

<http://example.org/entity/Queen_Munjeong> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Myeongjong_of_Joseon> .

