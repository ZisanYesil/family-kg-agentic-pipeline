@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Queen_Insun> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Queen Insun" ;
    onto:hasSpouse <http://example.org/entity/Myeongjong_of_Joseon> .

<http://example.org/entity/Myeongjong_of_Joseon> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Myeongjong of Joseon" ;
    onto:hasMother <http://example.org/entity/Queen_Munjeong> .

<http://example.org/entity/Queen_Munjeong> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Queen Munjeong" .

