@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Aquatic_Effect a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Sólveig_Anspach ;
    ex:hasDirector entity:Sólveig_Anspach .

entity:La_Fémis a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Sólveig_Anspach a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt entity:La_Fémis .

