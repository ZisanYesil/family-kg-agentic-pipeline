@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/The_Aquatic_Effect> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Aquatic Effect" ;
    onto:hasDirector <http://example.org/entity/Sólveig_Anspach> .

<http://example.org/entity/La_Fémis> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "La Fémis" .

<http://example.org/entity/Sólveig_Anspach> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sólveig Anspach" ;
    onto:hasEducatedAt <http://example.org/entity/La_Fémis> .

