@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_Aquatic_Effect> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Sólveig_Anspach> ;
    ex:hasDirector <http://example.org/entity/Sólveig_Anspach> .

<http://example.org/entity/La_Fémis> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Sólveig_Anspach> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/La_Fémis> .

