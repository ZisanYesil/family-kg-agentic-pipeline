@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Mad_Dogs_and_Englishmen_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Mad Dogs and Englishmen" ;
    onto:hasCountry <http://example.org/entity/British> .

<http://example.org/entity/The_Bond_Boy> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Bond Boy" ;
    onto:hasCountry <http://example.org/entity/American> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

<http://example.org/entity/British> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

