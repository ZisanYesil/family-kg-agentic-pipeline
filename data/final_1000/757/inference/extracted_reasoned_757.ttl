@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/saddle_rash> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/extracted/loren_bouchard> .

<http://example.org/extracted/loren_bouchard> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1969-10-10"^^xsd:date .

