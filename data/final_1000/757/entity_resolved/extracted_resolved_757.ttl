@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:saddle_rash a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Saddle Rash" ;
    onto:hasCreator data:loren_bouchard .

data:loren_bouchard a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Loren Bouchard" ;
    onto:hasBirthDate "1969-10-10"^^xsd:date .

