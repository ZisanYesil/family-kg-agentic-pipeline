@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Saddle_Rash> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Loren_Bouchard> .

<http://example.org/entity/Loren_Bouchard> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1969-10-10"^^xsd:date .

