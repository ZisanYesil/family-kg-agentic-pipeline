@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Gerhart_Gerry_Neugebauer> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Marcia_Neugebauer> .

<http://example.org/entity/Marcia_Neugebauer> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/New_York> ;
    ex:hasSpouse <http://example.org/entity/Gerhart_Gerry_Neugebauer> .

<http://example.org/entity/New_York> a ex:Place .

