@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Gerhart_Gerry_Neugebauer> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gerhart \"Gerry\" Neugebauer" ;
    onto:hasSpouse <http://example.org/entity/Marcia_Neugebauer> ;
    skos:altLabel "Gerry Neugebauer" .

<http://example.org/entity/Marcia_Neugebauer> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Marcia Neugebauer" ;
    onto:hasBirthPlace <http://example.org/entity/New_York> .

<http://example.org/entity/New_York> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "New York City" .

