@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Gerhart_Gerry_Neugebauer a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Marcia_Neugebauer .

entity:Marcia_Neugebauer a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:New_York ;
    ex:hasSpouse entity:Gerhart_Gerry_Neugebauer .

entity:New_York a ex:Place .

