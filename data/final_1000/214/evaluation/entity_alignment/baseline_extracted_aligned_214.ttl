@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Prince_Nikolaus_Wilhelm_of_Nassau> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Prince Nikolaus Wilhelm of Nassau" ;
    onto:hasMother <http://example.org/entity/Princess_Pauline_of_Württemberg> .

<http://example.org/entity/Princess_Pauline_of_Württemberg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Princess Pauline of Württemberg" ;
    onto:hasBirthPlace <http://example.org/entity/Stuttgart> .

<http://example.org/entity/Stuttgart> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Stuttgart" ;
    skos:altLabel "Stuttgart, Kingdom of Württemberg" .

