@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:invercargill_march a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Invercargill March" ;
    onto:hasComposer data:alex_lithgow .

data:alex_lithgow a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alex Lithgow" ;
    onto:hasNationality data:united_kingdom ;
    skos:altLabel "Alexander Frame Lithgow" .

data:united_kingdom a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "Scottish" .

