@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:I_See_You a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Leona_Lewis ;
    ex:hasPerformer entity:Leona_Lewis .

entity:London a ex:Place .

entity:Leona_Lewis a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:London .

