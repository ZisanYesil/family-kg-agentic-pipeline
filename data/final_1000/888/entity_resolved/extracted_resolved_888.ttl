@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:film_what_rats_wont_do a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "What Rats Won'T Do" ;
    onto:hasDirector data:person_alastair_reid .

data:person_alastair_reid a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alastair Reid" ;
    onto:hasDeathPlace data:place_stoke_st_gregory_somerset .

data:place_stoke_st_gregory_somerset a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Stoke St Gregory, Somerset" .

