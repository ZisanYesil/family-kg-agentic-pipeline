@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/What_Rats_Won_t_Do> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "What Rats Won'T Do" ;
    onto:hasDirector <http://example.org/entity/Alastair_Reid> .

<http://example.org/entity/Alastair_Reid> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alastair Reid" ;
    onto:hasDeathPlace <http://example.org/entity/Somerset> .

<http://example.org/entity/Somerset> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Stoke St Gregory, Somerset" .

