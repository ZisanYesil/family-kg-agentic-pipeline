@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:What_Rats_Won_t_Do a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Alastair_Reid ;
    ex:hasDirector entity:Alastair_Reid .

entity:Somerset a ex:Place .

entity:Alastair_Reid a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace entity:Somerset .

