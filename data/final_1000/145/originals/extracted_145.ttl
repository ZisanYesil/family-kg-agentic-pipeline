@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_if_dog_rabbit a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "If... Dog... Rabbit..." ;
    onto:hasCountry data:country_us .

data:film_the_clan_2015 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Clan (2015 film)" ;
    onto:hasCountry data:country_argentina .

data:country_argentina a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Argentina" ;
    skos:altLabel "Argentine" .

data:country_us a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

