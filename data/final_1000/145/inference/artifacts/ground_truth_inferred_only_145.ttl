@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:If_Dog_Rabbit a ex:Artifact ;
    ex:hasCountry entity:American .

entity:The_Clan_2015_film a ex:Artifact ;
    ex:hasCountry entity:Argentine .

entity:American a ex:Country,
        ex:Place .

entity:Argentine a ex:Country,
        ex:Place .

