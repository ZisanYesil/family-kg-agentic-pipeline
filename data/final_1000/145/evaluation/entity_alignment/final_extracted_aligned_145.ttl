@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/If_Dog_Rabbit> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/American> .

<http://example.org/entity/The_Clan_2015_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/Argentine> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/Argentine> a ex:Country,
        ex:Place .

