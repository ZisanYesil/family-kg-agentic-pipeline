@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Gas> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Henry_Chan> ;
    ex:hasDirector <http://example.org/entity/Henry_Chan> .

<http://example.org/entity/Primetime_Emmy_Award> a ex:Award .

<http://example.org/entity/Henry_Chan> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/entity/Primetime_Emmy_Award> .

