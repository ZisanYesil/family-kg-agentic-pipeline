@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Gas> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Gas (2004 film)" ;
    onto:hasDirector <http://example.org/entity/Henry_Chan> .

<http://example.org/entity/Henry_Chan> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Henry Chan" ;
    onto:hasAwardReceived <http://example.org/entity/Primetime_Emmy_Award> .

<http://example.org/entity/Primetime_Emmy_Award> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Primetime Emmy Award" .

