@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Gas a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Henry_Chan ;
    ex:hasDirector entity:Henry_Chan .

entity:Primetime_Emmy_Award a ex:Award .

entity:Henry_Chan a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived entity:Primetime_Emmy_Award .

