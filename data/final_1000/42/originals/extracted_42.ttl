@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:joanna_of_durazzo a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Joanna of Durazzo" ;
    onto:hasMother data:maria_of_calabria .

data:maria_of_calabria a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Maria of Calabria" .

