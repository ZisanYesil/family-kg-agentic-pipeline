@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Joanna_of_Durazzo> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Joanna of Durazzo" ;
    onto:hasMother <http://example.org/entity/Maria_of_Calabria> .

<http://example.org/entity/Maria_of_Calabria> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Maria of Calabria" .

