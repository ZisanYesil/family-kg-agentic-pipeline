@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_3096_days a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "3096 Days" ;
    onto:hasDirector data:person_sherry_hormann .

data:country_germany a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Germany" ;
    skos:altLabel "German" .

data:country_united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

data:person_sherry_hormann a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sherry Hormann" ;
    onto:hasNationality data:country_germany,
        data:country_united_states .

