@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/3096_Days> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "3096 Days" ;
    onto:hasDirector <http://example.org/entity/Sherry_Horman> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

<http://example.org/entity/Sherry_Horman> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sherry Hormann" ;
    onto:hasNationality <http://example.org/entity/American>,
        data:country_germany .

data:country_germany a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Germany" ;
    skos:altLabel "German" .

