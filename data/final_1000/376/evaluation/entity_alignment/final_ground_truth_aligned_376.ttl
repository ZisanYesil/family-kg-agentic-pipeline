@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Bellingham_Review a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher entity:Western_Washington_University .

entity:Western_Washington_University a ex:Agent,
        ex:Organization ;
    ex:hasInception "1893"^^xsd:gYear .

