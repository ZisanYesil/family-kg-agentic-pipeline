@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Bellingham_Review> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher <http://example.org/entity/Western_Washington_University> .

<http://example.org/entity/Western_Washington_University> a ex:Agent,
        ex:Organization ;
    ex:hasInception "1886"^^xsd:gYear .

