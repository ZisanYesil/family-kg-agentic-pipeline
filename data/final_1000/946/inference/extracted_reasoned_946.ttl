@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_crime_against_joe> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_lee_sholem> ;
    ex:hasDirector <http://example.org/extracted/person_lee_sholem> .

<http://example.org/extracted/film_vagabonderne_paa_bakkegarden> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_alice_ofredericks> ;
    ex:hasDirector <http://example.org/extracted/person_alice_ofredericks> .

<http://example.org/extracted/person_alice_ofredericks> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1968-02-18"^^xsd:date .

<http://example.org/extracted/person_lee_sholem> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2000-08-19"^^xsd:date .

