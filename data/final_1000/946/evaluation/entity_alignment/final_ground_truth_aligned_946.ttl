@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Crime_Against_Joe a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Lee_Sholem ;
    ex:hasDirector entity:Lee_Sholem .

entity:Vagabonderne_på_Bakkegården a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Alice_O_Fredericks ;
    ex:hasDirector entity:Alice_O_Fredericks .

entity:Alice_O_Fredericks a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1968-02-18"^^xsd:date .

entity:Lee_Sholem a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2000-08-19"^^xsd:date .

