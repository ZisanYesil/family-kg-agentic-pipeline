@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Crime_Against_Joe> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Lee_Sholem> ;
    ex:hasDirector <http://example.org/entity/Lee_Sholem> .

<http://example.org/entity/Vagabonderne_på_Bakkegården> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Alice_O_Fredericks> ;
    ex:hasDirector <http://example.org/entity/Alice_O_Fredericks> .

<http://example.org/entity/Alice_O_Fredericks> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1968-02-18"^^xsd:date .

<http://example.org/entity/Lee_Sholem> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2000-08-19"^^xsd:date .

