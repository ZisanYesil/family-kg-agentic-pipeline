@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Patricia_Ann_Davis> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Nancy_Davis_Reagan> ;
    ex:hasParent <http://example.org/entity/Nancy_Davis_Reagan> .

<http://example.org/entity/Nancy_Davis_Reagan> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Patricia_Ann_Davis> .

