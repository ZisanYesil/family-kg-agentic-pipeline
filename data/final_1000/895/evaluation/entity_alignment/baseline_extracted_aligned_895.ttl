@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Patricia_Ann_Davis> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Patti Davis" ;
    onto:hasMother <http://example.org/entity/Nancy_Davis_Reagan> ;
    skos:altLabel "Patricia Ann Davis" .

<http://example.org/entity/Nancy_Davis_Reagan> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nancy Reagan" ;
    skos:altLabel "Anne Frances Robbins",
        "Nancy Davis Reagan" .

