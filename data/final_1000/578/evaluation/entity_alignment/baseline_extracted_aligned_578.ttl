@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/The_Loves_of_Madame_Dubarry> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Loves of Madame Dubarry" ;
    onto:hasDirector <http://example.org/entity/Marcel_Varnel> ;
    skos:altLabel "I Give My Heart" .

<http://example.org/entity/Marcel_Varnel> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Marcel Varnel" ;
    onto:hasDeathPlace <http://example.org/entity/West_Sussex> .

<http://example.org/entity/West_Sussex> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Rake, West Sussex" .

