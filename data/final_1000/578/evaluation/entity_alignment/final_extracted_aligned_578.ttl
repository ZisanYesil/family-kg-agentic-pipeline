@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_Loves_of_Madame_Dubarry> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Marcel_Varnel> ;
    ex:hasDirector <http://example.org/entity/Marcel_Varnel> .

<http://example.org/entity/West_Sussex> a ex:Place .

<http://example.org/entity/Marcel_Varnel> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/West_Sussex> .

