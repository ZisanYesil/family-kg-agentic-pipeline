@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Dartmouth> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/John_Henry_Wright> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/Dartmouth> ;
    ex:hasSpouse <http://example.org/entity/Mary_Tappan_Wright> .

<http://example.org/entity/Mary_Tappan_Wright> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/John_Henry_Wright> .

