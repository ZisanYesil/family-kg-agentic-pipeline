@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Dartmouth a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:John_Henry_Wright a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Mary_Tappan_Wright .

entity:Mary_Tappan_Wright a ex:Agent,
        ex:Person .

