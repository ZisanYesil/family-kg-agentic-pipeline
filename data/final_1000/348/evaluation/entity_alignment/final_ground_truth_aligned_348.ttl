@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Beyond_Rangoon a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:John_Boorman ;
    ex:hasDirector entity:John_Boorman .

entity:Ryan_s_Daughter a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:David_Lean ;
    ex:hasDirector entity:David_Lean .

entity:David_Lean a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:British ;
    ex:hasCountry entity:British .

entity:John_Boorman a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:British ;
    ex:hasCountry entity:British .

entity:British a ex:Country,
        ex:Place .

