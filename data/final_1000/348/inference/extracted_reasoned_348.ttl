@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/film_beyond_rangoon> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_john_boorman> ;
    ex:hasDirector <http://example.org/extracted/person_john_boorman> .

<http://example.org/extracted/film_ryans_daughter> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_david_lean> ;
    ex:hasDirector <http://example.org/extracted/person_david_lean> .

<http://example.org/extracted/person_david_lean> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/extracted/country_united_kingdom> ;
    ex:hasNationality <http://example.org/extracted/country_united_kingdom> .

<http://example.org/extracted/person_john_boorman> a ex:Agent,
        ex:Person ;
