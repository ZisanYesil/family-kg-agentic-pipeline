@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/McGraw_Electric> a ex:Agent,
        ex:Organization ;
    ex:hasFounder <http://example.org/entity/Max_McGraw> .

<http://example.org/entity/Max_McGraw> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1883-02-01"^^xsd:date .

