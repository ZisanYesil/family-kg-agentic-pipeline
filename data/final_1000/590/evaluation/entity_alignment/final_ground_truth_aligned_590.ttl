@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:McGraw_Electric a ex:Agent,
        ex:Organization ;
    ex:hasFounder entity:Max_McGraw .

entity:Max_McGraw a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1883-02-01"^^xsd:date .

