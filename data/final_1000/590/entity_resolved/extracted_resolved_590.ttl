@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:mcgraw_electric a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "McGraw Electric" ;
    onto:hasFounder data:max_mcgraw ;
    skos:altLabel "McGraw Electric Company" .

data:max_mcgraw a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Max McGraw" ;
    onto:hasBirthDate "1883-02-01"^^xsd:date .

