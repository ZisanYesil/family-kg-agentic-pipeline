@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Emilio_Drake_1st_Marquess_of_Cañada_Honda> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Emilio Drake, 1st Marquess of Cañada Honda" ;
    onto:hasBirthDate "1855-01-27"^^xsd:date ;
    onto:hasDeathDate "1915-07-02"^^xsd:date ;
    skos:altLabel "Emilio María Juan Crisostomo Drake y de la Cerda" .

<http://example.org/entity/Franjo_Marković> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Franjo Marković" ;
    onto:hasBirthDate "1845-07-26"^^xsd:date ;
    onto:hasDeathDate "1914-09-15"^^xsd:date ;
    skos:altLabel "Franjo Marković" .

