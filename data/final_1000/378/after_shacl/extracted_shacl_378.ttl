@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:adolphe_berty a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Adolphe Berty" ;
    onto:hasBirthDate "1818-05-13"^^xsd:date ;
    onto:hasDeathDate "1867-08-18"^^xsd:date ;
    skos:altLabel "Boulet" .

data:hamlet_gonashvili a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hamlet Gonashvili" ;
    onto:hasBirthDate "1928-06-20"^^xsd:date ;
    onto:hasDeathDate "1985-07-25"^^xsd:date .

