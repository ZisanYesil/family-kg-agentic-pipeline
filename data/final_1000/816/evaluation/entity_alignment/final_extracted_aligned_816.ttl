@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Albert_Terrien_de_Lacouperie> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1844-11-23"^^xsd:date ;
    ex:hasDeathDate "1894-10-11"^^xsd:date .

<http://example.org/entity/Gustav_von_Hüfner> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1840-05-13"^^xsd:date ;
    ex:hasDeathDate "1908-03-14"^^xsd:date .

