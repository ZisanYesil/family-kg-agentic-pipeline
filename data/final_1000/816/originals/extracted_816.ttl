@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:albert_terrien_de_lacouperie a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Albert Terrien de Lacouperie" ;
    onto:hasBirthDate "1844-11-23"^^xsd:date ;
    onto:hasDeathDate "1894-10-11"^^xsd:date ;
    skos:altLabel "Albert Terrien de Lacouperie",
        "Albert Étienne Jean-Baptiste Terrien de Lacouperie" .

data:gustav_von_hufner a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gustav von Hüfner" ;
    onto:hasBirthDate "1840-05-13"^^xsd:date ;
    onto:hasDeathDate "1908-03-14"^^xsd:date ;
    skos:altLabel "Gustav von Hüfner" .

