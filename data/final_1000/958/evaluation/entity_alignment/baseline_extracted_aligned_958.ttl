@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Annanias_Mathe> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Annanias Mathe" ;
    onto:hasDeathDate "2016-12-27"^^xsd:date ;
    skos:altLabel "Ananias Mathe" .

<http://example.org/entity/Sigfrid_Jacobsson> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sigfrid Jacobsson" ;
    onto:hasDeathDate "1961-07-20"^^xsd:date .

