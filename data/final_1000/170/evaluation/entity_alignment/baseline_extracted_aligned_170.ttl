@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Cracked_Eggs_and_Noodles> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Cracked Eggs and Noodles" ;
    onto:hasPublicationDate "2005"^^xsd:gYear .

<http://example.org/entity/Do_Risos_e_Lagrimas> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Do Risos e Lagrimas" ;
    onto:hasPublicationDate "1926"^^xsd:gYear .

