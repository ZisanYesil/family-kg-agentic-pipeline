@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Sophia_I> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sophia I" ;
    onto:hasMother <http://example.org/entity/Theophanu> .

<http://example.org/entity/Theophanu> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Theophanu" .

