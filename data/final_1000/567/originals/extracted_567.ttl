@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:sophia_i_975 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sophia I" ;
    onto:hasMother data:theophanu_955 .

