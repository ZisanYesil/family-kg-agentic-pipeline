@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:ludwig_elsbett a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ludwig Elsbett" ;
    onto:hasBirthDate "1913-11-08"^^xsd:date ;
    onto:hasDeathDate "2003-03-28"^^xsd:date .

data:pamela_ann_rymer a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Pamela Ann Rymer" ;
    onto:hasBirthDate "1941-01-16"^^xsd:date ;
    onto:hasDeathDate "2011-09-21"^^xsd:date .

