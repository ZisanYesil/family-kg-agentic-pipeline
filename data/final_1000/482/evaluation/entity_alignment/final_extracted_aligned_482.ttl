@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Ludwig_Elsbett> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1913-11-08"^^xsd:date ;
    ex:hasDeathDate "2003-03-28"^^xsd:date .

<http://example.org/entity/Pamela_Ann_Rymer> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1941-01-16"^^xsd:date ;
    ex:hasDeathDate "2011-09-21"^^xsd:date .

