@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Curumsey_Damjee a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1844"^^xsd:gYear ;
    ex:hasDeathDate "1918"^^xsd:gYear .

entity:Octavius_Hammond a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1835-03-19"^^xsd:date ;
    ex:hasDeathDate "1908-08-22"^^xsd:date .

