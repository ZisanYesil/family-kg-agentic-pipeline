@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:curumsey_damjee a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Curumsey Damjee" ;
    onto:hasBirthDate "1844"^^xsd:gYear ;
    onto:hasDeathDate "1918"^^xsd:gYear ;
    skos:altLabel "Curumsey Damjee",
        "Karamsi Damji",
        "Kasamshi Damji" .

data:octavius_hammond a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Octavius Hammond" ;
    onto:hasBirthDate "1835-03-19"^^xsd:date ;
    onto:hasDeathDate "1908-08-22"^^xsd:date ;
    skos:altLabel "Octavius Hammond" .

