@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:i_was_here_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "I Was Here" ;
    onto:hasCountryOfOrigin data:estonia .

data:zelig_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Zelig" ;
    onto:hasCountryOfOrigin data:united_states .

data:estonia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Estonia" ;
    skos:altLabel "Estonian" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

