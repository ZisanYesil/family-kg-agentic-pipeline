@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/I_Was_Here_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/Estonia> ;
    ex:hasCountryOfOrigin <http://example.org/entity/Estonia> .

<http://example.org/entity/Zelig> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasCountryOfOrigin <http://example.org/entity/American> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/Estonia> a ex:Country,
        ex:Place .

