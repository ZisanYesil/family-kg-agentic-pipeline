@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/i_was_here_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/extracted/estonia> ;
    ex:hasCountryOfOrigin <http://example.org/extracted/estonia> .

<http://example.org/extracted/zelig_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/extracted/united_states> ;
    ex:hasCountryOfOrigin <http://example.org/extracted/united_states> .

<http://example.org/extracted/estonia> a ex:Country,
        ex:Place .

<http://example.org/extracted/united_states> a ex:Country,
        ex:Place .

