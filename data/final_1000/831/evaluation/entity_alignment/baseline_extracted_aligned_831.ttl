@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/A_Heart_Returns_Home> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Heart Returns Home" ;
    onto:hasCountryOfOrigin <http://example.org/entity/German> .

<http://example.org/entity/The_Manny> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Manny" ;
    onto:hasCountryOfOrigin <http://example.org/entity/German> .

<http://example.org/entity/German> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Germany" ;
    skos:altLabel "German",
        "West German" .

