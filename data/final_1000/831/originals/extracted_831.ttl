@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:a_heart_returns_home a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Heart Returns Home" ;
    onto:hasCountryOfOrigin data:germany .

data:the_manny a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Manny" ;
    onto:hasCountryOfOrigin data:germany .

data:germany a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Germany" ;
    skos:altLabel "German",
        "West German" .

