@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Humko_Deewana_Kar_Gaye> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Humko Deewana Kar Gaye" ;
    onto:hasDirector <http://example.org/entity/Raj_Kanwar> .

<http://example.org/entity/Raj_Kanwar> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Raj Kanwar" .

