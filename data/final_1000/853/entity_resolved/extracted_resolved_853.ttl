@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:film_humko_deewana_kar_gaye a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Humko Deewana Kar Gaye" ;
    onto:hasDirector data:person_raj_kanwar .

data:person_raj_kanwar a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Raj Kanwar" .

