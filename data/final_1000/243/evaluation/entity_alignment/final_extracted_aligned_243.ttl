@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Hard_Time_Loving_You> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Julian_Austin> ;
    ex:hasPerformer <http://example.org/entity/Julian_Austin> .

<http://example.org/entity/Sussex> a ex:Place .

<http://example.org/entity/Julian_Austin> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Sussex> .

