@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Hard_Time_Loving_You> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Hard Time Loving You" ;
    onto:hasPerformer <http://example.org/entity/Julian_Austin> .

<http://example.org/entity/Julian_Austin> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Julian Austin" ;
    onto:hasBirthPlace <http://example.org/entity/Sussex> .

<http://example.org/entity/Sussex> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Sussex, New Brunswick" .

