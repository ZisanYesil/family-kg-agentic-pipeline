@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Hard_Time_Loving_You a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Julian_Austin ;
    ex:hasPerformer entity:Julian_Austin .

entity:Sussex a ex:Place .

entity:Julian_Austin a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Sussex .

