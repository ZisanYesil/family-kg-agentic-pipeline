@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:film_shock_treatment_1964 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Shock Treatment (1964 film)" ;
    onto:hasDirector data:person_denis_sanders .

data:institution_ucla a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "UCLA" .

data:person_denis_sanders a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Denis Sanders" ;
    onto:hasEducatedAt data:institution_ucla .

