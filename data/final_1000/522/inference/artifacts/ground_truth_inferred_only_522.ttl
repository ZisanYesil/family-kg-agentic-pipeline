@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Shock_Treatment a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Denis_Sanders .

entity:UCLA a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Denis_Sanders a ex:Agent,
        ex:Person .

