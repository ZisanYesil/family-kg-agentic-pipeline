@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/film_shock_treatment_1964> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_denis_sanders> ;
    ex:hasDirector <http://example.org/extracted/person_denis_sanders> .

<http://example.org/extracted/institution_ucla> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/extracted/person_denis_sanders> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/extracted/institution_ucla> .

