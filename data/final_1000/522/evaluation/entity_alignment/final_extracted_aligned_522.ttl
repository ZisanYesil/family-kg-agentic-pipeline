@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Shock_Treatment> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Denis_Sanders> ;
    ex:hasDirector <http://example.org/entity/Denis_Sanders> .

<http://example.org/entity/UCLA> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Denis_Sanders> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/UCLA> .

