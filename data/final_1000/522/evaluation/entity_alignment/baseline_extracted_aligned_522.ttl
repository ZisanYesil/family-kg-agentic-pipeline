@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Shock_Treatment> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Shock Treatment (1964 film)" ;
    onto:hasDirector <http://example.org/entity/Denis_Sanders> .

<http://example.org/entity/Denis_Sanders> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Denis Sanders" ;
    onto:hasEducatedAt <http://example.org/entity/UCLA> .

<http://example.org/entity/UCLA> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "UCLA" .

