@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Ernest_William_Goodpasture> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ernest William Goodpasture" ;
    onto:hasBirthDate "1886-10-17"^^xsd:date .

<http://example.org/entity/Ramón_Corona> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ramón Corona" ;
    onto:hasBirthDate "1837-10-18"^^xsd:date .

