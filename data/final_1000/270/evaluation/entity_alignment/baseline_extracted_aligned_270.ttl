@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Dinky_Toys> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Dinky Toys" ;
    onto:hasInception "1934"^^xsd:gYear .

<http://example.org/entity/Tip_Top_Tailors> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Tip Top Tailors" ;
    onto:hasInception "1909"^^xsd:gYear .

