@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:dinky_toys a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Dinky Toys" ;
    onto:hasInception "1934"^^xsd:gYear .

data:tip_top_tailors a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Tip Top Tailors" ;
    onto:hasInception "1909"^^xsd:gYear .

