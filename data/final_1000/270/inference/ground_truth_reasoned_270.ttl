@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Dinky_Toys a ex:Agent,
        ex:Organization ;
    ex:hasInception "1934"^^xsd:gYear .

entity:Tip_Top_Tailors a ex:Agent,
        ex:Organization ;
    ex:hasInception "1909"^^xsd:gYear .

