@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/dinky_toys> a ex:Agent,
        ex:Organization ;
    ex:hasInception "1934"^^xsd:gYear .

<http://example.org/extracted/tip_top_tailors> a ex:Agent,
        ex:Organization ;
    ex:hasInception "1909"^^xsd:gYear .

