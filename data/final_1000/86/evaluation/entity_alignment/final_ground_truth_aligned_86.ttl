@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Tana a ex:Artifact,
        ex:CreativeWork ;
    ex:hasComposer entity:Çesk_Zadeja ;
    ex:hasCreator entity:Çesk_Zadeja .

entity:Shkodër a ex:Place .

entity:Çesk_Zadeja a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Shkodër .

