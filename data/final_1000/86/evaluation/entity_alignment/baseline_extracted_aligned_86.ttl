@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Tana> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Tana" .

<http://example.org/entity/Çesk_Zadeja> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Çesk Zadeja" ;
    onto:hasBirthPlace <http://example.org/entity/Shkodër> .

<http://example.org/entity/Shkodër> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Shkodër" .

