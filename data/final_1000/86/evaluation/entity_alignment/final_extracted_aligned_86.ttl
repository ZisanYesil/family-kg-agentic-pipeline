@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Tana> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasComposer <http://example.org/entity/Çesk_Zadeja> ;
    ex:hasCreator <http://example.org/entity/Çesk_Zadeja> .

<http://example.org/entity/Shkodër> a ex:Place .

<http://example.org/entity/Çesk_Zadeja> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Shkodër> .

