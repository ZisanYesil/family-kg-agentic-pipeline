@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:film_tana a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Tana" ;
    onto:hasComposer data:cesk_zadeja .

data:cesk_zadeja a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Çesk Zadeja" ;
    onto:hasBirthPlace data:place_shkoder .

data:place_shkoder a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Shkodër" .

