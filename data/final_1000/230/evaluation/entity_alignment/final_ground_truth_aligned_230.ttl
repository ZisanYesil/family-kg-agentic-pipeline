@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Muppets_on_Puppets a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Jim_Henson .

entity:Jim_Henson a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt entity:University_of_Maryland_College_Park .

entity:University_of_Maryland_College_Park a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

