@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/The_Muppets_on_Puppets> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "The Muppets on Puppets" ;
    onto:hasCreator <http://example.org/entity/Jim_Henson> .

<http://example.org/entity/Jim_Henson> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jim Henson" ;
    onto:hasEducatedAt <http://example.org/entity/University_of_Maryland_College_Park> .

<http://example.org/entity/University_of_Maryland_College_Park> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "University of Maryland, College Park" .

