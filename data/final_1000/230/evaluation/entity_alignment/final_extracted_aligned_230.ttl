@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_Muppets_on_Puppets> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Jim_Henson> .

<http://example.org/entity/Jim_Henson> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/University_of_Maryland_College_Park> .

<http://example.org/entity/University_of_Maryland_College_Park> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

