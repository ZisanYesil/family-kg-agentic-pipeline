@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:becassine_2018_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Bécassine (2018 film)" ;
    onto:hasCountry data:france .

data:smell_of_us_2014_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Smell Of Us" ;
    onto:hasCountry data:france .

data:france a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

