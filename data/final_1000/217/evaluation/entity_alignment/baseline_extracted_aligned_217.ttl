@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/H_M_Pulham_Esq> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "H. M. Pulham, Esq." ;
    onto:hasPublicationDate "1941"^^xsd:gYear .

<http://example.org/entity/The_Colour_of_Your_Lips> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Colour of Your Lips" ;
    onto:hasPublicationDate "2018"^^xsd:gYear .

