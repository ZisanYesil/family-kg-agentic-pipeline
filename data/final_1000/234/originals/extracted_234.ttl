@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:murrays_magazine a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Murray's Magazine" ;
    onto:hasPublicationDate "1887"^^xsd:gYear .

data:progetto_babele a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Progetto Babele" ;
    onto:hasPublicationDate "2002"^^xsd:gYear .

