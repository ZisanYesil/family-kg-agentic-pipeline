@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Tag_der_Freiheit_Unsere_Wehrmacht> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Tag der Freiheit: Unsere Wehrmacht" ;
    onto:hasDirector <http://example.org/entity/Leni_Riefenstahl> .

<http://example.org/entity/Leni_Riefenstahl> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Leni Riefenstahl" ;
    onto:hasBurialPlace <http://example.org/entity/Munich_Waldfriedhof> ;
    skos:altLabel "Helene Bertha Amalie \"Leni\" Riefenstahl" .

<http://example.org/entity/Munich_Waldfriedhof> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Munich Waldfriedhof" .

