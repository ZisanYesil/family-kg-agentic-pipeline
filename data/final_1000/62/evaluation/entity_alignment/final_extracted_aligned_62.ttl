@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Tag_der_Freiheit_Unsere_Wehrmacht> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Leni_Riefenstahl> ;
    ex:hasDirector <http://example.org/entity/Leni_Riefenstahl> .

<http://example.org/entity/Munich_Waldfriedhof> a ex:Place .

<http://example.org/entity/Leni_Riefenstahl> a ex:Agent,
        ex:Person ;
    ex:hasBurialPlace <http://example.org/entity/Munich_Waldfriedhof> .

