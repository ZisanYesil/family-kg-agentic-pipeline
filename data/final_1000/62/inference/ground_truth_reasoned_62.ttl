@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Tag_der_Freiheit_Unsere_Wehrmacht a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Leni_Riefenstahl ;
    ex:hasDirector entity:Leni_Riefenstahl .

entity:Munich_Waldfriedhof a ex:Place .

entity:Leni_Riefenstahl a ex:Agent,
        ex:Person ;
    ex:hasBurialPlace entity:Munich_Waldfriedhof .

