@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_cuatro a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "¡Cuatro!" ;
    onto:hasDirector data:tim_wheeler .

data:tim_wheeler a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tim Wheeler" ;
    onto:hasNationality data:united_kingdom ;
    skos:altLabel "Timothy James Arthur Wheeler" .

data:united_kingdom a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "Northern Irish" .

