@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Cuatro a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Tim_Wheeler .

entity:Northern_Irish a ex:Country,
        ex:Place .

entity:Tim_Wheeler a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:Northern_Irish .

