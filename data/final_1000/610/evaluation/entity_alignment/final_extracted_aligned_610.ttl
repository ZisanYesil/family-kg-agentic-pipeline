@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Cuatro> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Tim_Wheeler> ;
    ex:hasDirector <http://example.org/entity/Tim_Wheeler> .

<http://example.org/entity/Northern_Irish> a ex:Country,
        ex:Place .

<http://example.org/entity/Tim_Wheeler> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Northern_Irish> ;
    ex:hasNationality <http://example.org/entity/Northern_Irish> .

