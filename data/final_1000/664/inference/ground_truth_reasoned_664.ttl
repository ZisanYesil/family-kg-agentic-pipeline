@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Alden_B_Dow a ex:Agent,
        ex:Person ;
    ex:hasFather entity:Herbert_Henry_Dow ;
    ex:hasParent entity:Herbert_Henry_Dow .

entity:Case a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Herbert_Henry_Dow a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Alden_B_Dow ;
    ex:hasEducatedAt entity:Case .

