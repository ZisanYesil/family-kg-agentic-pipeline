@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Case> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Herbert_Henry_Dow> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/Case> ;
    ex:hasFather <http://example.org/entity/Alden_B_Dow> ;
    ex:hasParent <http://example.org/entity/Alden_B_Dow> .

<http://example.org/entity/Alden_B_Dow> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Herbert_Henry_Dow> .

