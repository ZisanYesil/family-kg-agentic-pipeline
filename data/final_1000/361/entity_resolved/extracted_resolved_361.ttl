@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_the_tunnel_1933 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Tunnel (1933 German-language film)" ;
    onto:hasDirector data:person_curtis_bernhardt ;
    skos:altLabel "The Tunnel" .

data:person_curtis_bernhardt a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Curtis Bernhardt" ;
    onto:hasBurialPlace data:place_forest_lawn_memorial_park_cemetery .

data:place_forest_lawn_memorial_park_cemetery a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Glendale's Forest Lawn Memorial Park Cemetery" ;
    skos:altLabel "Forest Lawn Memorial Park Cemetery" .

