@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Arabia a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Sophia .

entity:Byzantine_Empire a ex:Country,
        ex:Place .

entity:Sophia a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Arabia ;
    ex:hasCountry entity:Byzantine_Empire .

