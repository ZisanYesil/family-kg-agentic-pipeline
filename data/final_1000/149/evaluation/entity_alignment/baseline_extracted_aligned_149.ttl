@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Arabia> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Arabia" ;
    onto:hasMother <http://example.org/entity/Sophia> .

<http://example.org/entity/Sophia> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sophia" ;
    skos:altLabel "Aelia Sophia",
        "Sophia (empress)" .

