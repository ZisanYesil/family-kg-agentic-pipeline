@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Arabia> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Sophia> ;
    ex:hasParent <http://example.org/entity/Sophia> .

<http://example.org/entity/Sophia> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Arabia> .

