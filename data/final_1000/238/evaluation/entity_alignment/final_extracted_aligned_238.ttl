@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Passion> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Utada_Hikaru> ;
    ex:hasPerformer <http://example.org/entity/Utada_Hikaru> .

<http://example.org/entity/Keiko_Fuji> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Utada_Hikaru> .

<http://example.org/entity/Utada_Hikaru> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Keiko_Fuji> ;
    ex:hasParent <http://example.org/entity/Keiko_Fuji> .

