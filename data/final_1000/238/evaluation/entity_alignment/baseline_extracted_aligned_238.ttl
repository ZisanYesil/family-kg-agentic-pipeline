@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Passion> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Passion (Utada Hikaru song)" ;
    onto:hasPerformer <http://example.org/entity/Utada_Hikaru> ;
    skos:altLabel "Passion" .

<http://example.org/entity/Keiko_Fuji> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Keiko Fuji" .

<http://example.org/entity/Utada_Hikaru> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Utada Hikaru" ;
    onto:hasMother <http://example.org/entity/Keiko_Fuji> ;
    skos:altLabel "Hikaru Utada",
        "Utada" .

