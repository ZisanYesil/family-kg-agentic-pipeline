@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/City_Industrial_Complex> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "City Industrial Complex" ;
    onto:hasCountry <http://example.org/entity/Iran> ;
    skos:altLabel "City Industrial Complex" .

<http://example.org/entity/Karju> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Karju" ;
    onto:hasCountry <http://example.org/entity/Iran> ;
    skos:altLabel "Karju" .

<http://example.org/entity/Iran> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Iran" ;
    skos:altLabel "Iran" .

