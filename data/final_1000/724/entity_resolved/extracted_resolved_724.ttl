@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:city_industrial_complex a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "City Industrial Complex" ;
    onto:hasCountry data:iran ;
    skos:altLabel "City Industrial Complex" .

data:karju a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Karju" ;
    onto:hasCountry data:iran ;
    skos:altLabel "Karju" .

data:iran a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Iran" ;
    skos:altLabel "Iran" .

