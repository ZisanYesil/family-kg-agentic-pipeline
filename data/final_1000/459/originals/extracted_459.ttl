@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:peter_ii a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Peter II, Count of Saint-Pol" ;
    onto:hasMother data:jeanne_de_bar ;
    skos:altLabel "Peter II" .

data:jeanne_de_bar a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jeanne de Bar, Countess of Marle and Soissons" ;
    skos:altLabel "Jeanne de Bar" .

