@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Peter_II_Count_of_Saint_Pol> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Peter II, Count of Saint-Pol" ;
    onto:hasMother <http://example.org/entity/Jeanne_de_Bar_Countess_of_Marle_and_Soissons> ;
    skos:altLabel "Peter II" .

<http://example.org/entity/Jeanne_de_Bar_Countess_of_Marle_and_Soissons> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jeanne de Bar, Countess of Marle and Soissons" ;
    skos:altLabel "Jeanne de Bar" .

