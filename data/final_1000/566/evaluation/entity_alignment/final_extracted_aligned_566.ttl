@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/George_Southall> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1907-07-17"^^xsd:date ;
    ex:hasDeathDate "1993-05-02"^^xsd:date .

<http://example.org/entity/Lawrence_S_Margolis> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1935-03-13"^^xsd:date ;
    ex:hasDeathDate "2017-01-18"^^xsd:date .

