@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/George_Southall> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Montford George Southall" ;
    onto:hasBirthDate "1907-07-17"^^xsd:date ;
    onto:hasDeathDate "1993-05-02"^^xsd:date ;
    skos:altLabel "George Southall" .

<http://example.org/entity/Lawrence_S_Margolis> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lawrence S. Margolis" ;
    onto:hasBirthDate "1935-03-13"^^xsd:date ;
    onto:hasDeathDate "2017-01-18"^^xsd:date .

