@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Mikey_Arroyo> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mikey Arroyo" ;
    onto:hasMother <http://example.org/entity/Gloria_Macapagal_Arroyo> ;
    skos:altLabel "Juan Miguel Macapagal Arroyo" .

data:ateneo_de_manila_university a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Ateneo de Manila University" .

<http://example.org/entity/Gloria_Macapagal_Arroyo> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gloria Macapagal Arroyo" ;
    skos:altLabel "Gloria Macapagal-Arroyo",
        "Maria Gloria Macaraeg Macapagal-Arroyo" .

