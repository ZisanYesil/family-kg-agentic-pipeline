@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Everyday_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Everyday (film)" ;
    onto:hasCountry <http://example.org/entity/British> .

<http://example.org/entity/Seven_Sinners_1936_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Seven Sinners (1936 film)" ;
    onto:hasCountry <http://example.org/entity/British> .

<http://example.org/entity/British> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

