@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:everyday_2012_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Everyday (film)" ;
    onto:hasCountry data:united_kingdom .

data:seven_sinners_1936_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Seven Sinners (1936 film)" ;
    onto:hasCountry data:united_kingdom .

data:united_kingdom a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

