@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Musharrif_al_Dawla> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Musharrif al-Dawla" ;
    onto:hasFather <http://example.org/entity/Baha_al_Dawla> ;
    skos:altLabel "Abu 'Ali",
        "Musharrif al-Dawla" .

<http://example.org/entity/Adud_al_Dawla> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Adud al-Dawla" ;
    skos:altLabel "'Adud al-Dawla",
        "Adud al-Dawla",
        "Fannā Khusraw",
        "Panāh Khusraw" .

<http://example.org/entity/Baha_al_Dawla> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Baha al-Dawla" ;
    onto:hasFather <http://example.org/entity/Adud_al_Dawla> ;
    skos:altLabel "Abu Nasr Firuz Kharshadh",
        "Baha al-Dawla" .

