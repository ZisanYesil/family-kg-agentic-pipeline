@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Badi_al_Zaman_Mirza_Safavi> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Badi-al Zaman Mirza Safavi" ;
    onto:hasSpouse <http://example.org/entity/Pari_Khan_Khanum> .

<http://example.org/entity/Pari_Khan_Khanum> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Pari Khan Khanum" ;
    onto:hasMother <http://example.org/entity/Sultan_Agha_Khanum> .

<http://example.org/entity/Sultan_Agha_Khanum> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sultan-Agha Khanum" .

