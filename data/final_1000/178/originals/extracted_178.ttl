@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:badi_al_zaman_mirza_safavi a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Badi-al Zaman Mirza Safavi" ;
    onto:hasSpouse data:pari_khan_khanum .

data:pari_khan_khanum a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Pari Khan Khanum" ;
    onto:hasMother data:sultan_agha_khanum .

data:sultan_agha_khanum a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sultan-Agha Khanum" .

