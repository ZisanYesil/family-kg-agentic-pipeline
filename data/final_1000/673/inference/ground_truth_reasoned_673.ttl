@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Union_Sulphur_Company a ex:Agent,
        ex:Organization ;
    ex:hasFounder entity:Herman_Frasch .

entity:Herman_Frasch a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Oberrot .

entity:Oberrot a ex:Place .

