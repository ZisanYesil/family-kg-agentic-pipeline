@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Union_Sulphur_Company> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Union Sulphur Company" ;
    onto:hasFounder <http://example.org/entity/Herman_Frasch> .

<http://example.org/entity/Herman_Frasch> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Herman Frasch" ;
    onto:hasBirthPlace <http://example.org/entity/Oberrot> .

<http://example.org/entity/Oberrot> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Oberrot bei Gaildorf, Württemberg" .

