@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Union_Sulphur_Company> a ex:Agent,
        ex:Organization ;
    ex:hasFounder <http://example.org/entity/Herman_Frasch> .

<http://example.org/entity/Herman_Frasch> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Oberrot> .

<http://example.org/entity/Oberrot> a ex:Place .

