@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Gunnar_Wiklund> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1935-08-17"^^xsd:date ;
    ex:hasDeathDate "1989-09-29"^^xsd:date .

<http://example.org/entity/Jean_Rodolphe_Perronet> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1708-10-27"^^xsd:date ;
    ex:hasDeathDate "1794-02-27"^^xsd:date .

