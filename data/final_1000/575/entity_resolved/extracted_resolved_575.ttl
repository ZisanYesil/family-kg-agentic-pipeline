@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:gunnar_wiklund a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gunnar Wiklund" ;
    onto:hasBirthDate "1935-08-17"^^xsd:date ;
    onto:hasDeathDate "1989-09-29"^^xsd:date .

data:jean_rodolphe_perronet a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jean-Rodolphe Perronet" ;
    onto:hasBirthDate "1708-10-27"^^xsd:date ;
    onto:hasDeathDate "1794-02-27"^^xsd:date .

