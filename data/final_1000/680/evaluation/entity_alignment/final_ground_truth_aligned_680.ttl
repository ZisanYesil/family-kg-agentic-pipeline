@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Four_Eyed_Monsters a ex:Artifact ;
    ex:hasCountry entity:American ;
    ex:hasCountryOfOrigin entity:American .

entity:Joseph_and_the_Amazing_Technicolor_Dreamcoat_film a ex:Artifact ;
    ex:hasCountry entity:British ;
    ex:hasCountryOfOrigin entity:British .

entity:American a ex:Country,
        ex:Place .

entity:British a ex:Country,
        ex:Place .

