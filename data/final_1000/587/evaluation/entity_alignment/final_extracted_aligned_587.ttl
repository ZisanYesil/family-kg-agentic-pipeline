@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Griha_Pravesh> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Basu_Bhattacharya> ;
    ex:hasDirector <http://example.org/entity/Basu_Bhattacharya> .

<http://example.org/entity/Aditya_Bhattacharya> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/entity/Basu_Bhattacharya> ;
    ex:isSonOf <http://example.org/entity/Basu_Bhattacharya> .

<http://example.org/extracted/anwesha_arya> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/entity/Basu_Bhattacharya> ;
    ex:isDaughterOf <http://example.org/entity/Basu_Bhattacharya> .

<http://example.org/extracted/chimmu> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/entity/Basu_Bhattacharya> ;
    ex:isDaughterOf <http://example.org/entity/Basu_Bhattacharya> .

<http://example.org/entity/Basu_Bhattacharya> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Aditya_Bhattacharya>,
        <http://example.org/extracted/anwesha_arya>,
        <http://example.org/extracted/chimmu> ;
    ex:hasDaughter <http://example.org/extracted/anwesha_arya>,
        <http://example.org/extracted/chimmu> ;
    ex:hasSon <http://example.org/entity/Aditya_Bhattacharya> .

