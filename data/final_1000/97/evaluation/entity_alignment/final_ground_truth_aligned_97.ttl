@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Betty_Lago a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Rio_de_Janeiro ;
    ex:hasSpouse entity:Eduardo_Conde .

entity:Eduardo_Conde a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Betty_Lago .

entity:Rio_de_Janeiro a ex:Place .

