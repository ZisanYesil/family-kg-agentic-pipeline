@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Betty_Lago> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Rio_de_Janeiro> ;
    ex:hasSpouse <http://example.org/entity/Eduardo_Conde> .

<http://example.org/entity/Eduardo_Conde> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Betty_Lago> .

<http://example.org/entity/Rio_de_Janeiro> a ex:Place .

