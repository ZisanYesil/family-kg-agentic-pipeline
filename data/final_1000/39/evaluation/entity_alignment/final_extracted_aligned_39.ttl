@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Die_Abfahrer> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Adolf_Winkelmann> ;
    ex:hasDirector <http://example.org/entity/Adolf_Winkelmann> .

<http://example.org/entity/Dortmund_University_of_Applied_Sciences_and_Arts> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Adolf_Winkelmann> a ex:Agent,
        ex:Person ;
    ex:hasEmployer <http://example.org/entity/Dortmund_University_of_Applied_Sciences_and_Arts> .

