@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Die_Abfahrer> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Die Abfahrer" ;
    onto:hasDirector <http://example.org/entity/Adolf_Winkelmann> .

<http://example.org/entity/Dortmund_University_of_Applied_Sciences_and_Arts> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Dortmund University of Applied Sciences and Arts" .

<http://example.org/entity/Adolf_Winkelmann> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Adolf Winkelmann" .

