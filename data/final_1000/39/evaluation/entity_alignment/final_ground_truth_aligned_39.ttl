@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Die_Abfahrer a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Adolf_Winkelmann ;
    ex:hasDirector entity:Adolf_Winkelmann .

entity:Dortmund_University_of_Applied_Sciences_and_Arts a ex:Agent,
        ex:Organization .

entity:Adolf_Winkelmann a ex:Agent,
        ex:Person ;
    ex:hasEmployer entity:Dortmund_University_of_Applied_Sciences_and_Arts .

