@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:die_abfahrer a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Die Abfahrer" ;
    onto:hasDirector data:adolf_winkelmann .

data:dortmund_university_of_applied_sciences_and_arts a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Dortmund University of Applied Sciences and Arts" .

data:adolf_winkelmann a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Adolf Winkelmann" .

