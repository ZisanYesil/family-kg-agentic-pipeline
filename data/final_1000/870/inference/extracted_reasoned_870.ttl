@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/a_gathering_of_eagles> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/delbert_mann> ;
    ex:hasDirector <http://example.org/extracted/delbert_mann> .

<http://example.org/extracted/september_affair> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/william_dieterle> ;
    ex:hasDirector <http://example.org/extracted/william_dieterle> .

<http://example.org/extracted/delbert_mann> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1920-01-30"^^xsd:date ;
    ex:hasDeathDate "2007-11-11"^^xsd:date .

<http://example.org/extracted/william_dieterle> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1893-07-15"^^xsd:date ;
    ex:hasDeathDate "1972-12-09"^^xsd:date .

