@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/A_Gathering_of_Eagles> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Gathering of Eagles" ;
    onto:hasDirector <http://example.org/entity/Delbert_Mann> .

<http://example.org/entity/September_Affair> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "September Affair" ;
    onto:hasDirector <http://example.org/entity/William_Dieterle> .

<http://example.org/entity/Delbert_Mann> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Delbert Mann" ;
    onto:hasBirthDate "1920-01-30"^^xsd:date ;
    onto:hasDeathDate "2007-11-11"^^xsd:date ;
    skos:altLabel "Delbert Martin Mann Jr." .

<http://example.org/entity/William_Dieterle> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William Dieterle" ;
    onto:hasBirthDate "1893-07-15"^^xsd:date ;
    onto:hasDeathDate "1972-12-09"^^xsd:date .

