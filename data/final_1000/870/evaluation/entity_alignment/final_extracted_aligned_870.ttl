@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/A_Gathering_of_Eagles> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Delbert_Mann> ;
    ex:hasDirector <http://example.org/entity/Delbert_Mann> .

<http://example.org/entity/September_Affair> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/William_Dieterle> ;
    ex:hasDirector <http://example.org/entity/William_Dieterle> .

<http://example.org/entity/Delbert_Mann> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1920-01-30"^^xsd:date ;
    ex:hasDeathDate "2007-11-11"^^xsd:date .

<http://example.org/entity/William_Dieterle> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1893-07-15"^^xsd:date ;
    ex:hasDeathDate "1972-12-09"^^xsd:date .

