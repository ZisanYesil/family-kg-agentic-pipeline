@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Beyond_the_Sunset> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Beyond the Sunset" ;
    onto:hasPublicationDate "1989"^^xsd:gYear .

<http://example.org/entity/Kauravar> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Kauravar" ;
    onto:hasPublicationDate "1992"^^xsd:gYear .

