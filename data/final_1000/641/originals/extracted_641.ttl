@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_beyond_the_sunset a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Beyond the Sunset" ;
    onto:hasPublicationDate "1989"^^xsd:gYear .

data:film_kauravar a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Kauravar" ;
    onto:hasPublicationDate "1992"^^xsd:gYear .

