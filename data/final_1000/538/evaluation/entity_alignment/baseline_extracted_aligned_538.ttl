@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Reunion_at_Fairborough> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Reunion at Fairborough" ;
    onto:hasDirector <http://example.org/entity/Herbert_Wise> .

<http://example.org/entity/Herbert_Wise> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Herbert Wise" ;
    onto:hasChild <http://example.org/entity/Susannah_Wise>,
        data:charlie_walker_wise .

<http://example.org/entity/Susannah_Wise> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Susannah Wise" .

data:charlie_walker_wise a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Charlie Walker-Wise" .

