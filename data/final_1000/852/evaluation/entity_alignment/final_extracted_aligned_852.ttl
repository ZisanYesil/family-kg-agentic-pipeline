@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Coulson_Wallop> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/John_Wallop_2nd_Earl_of_Portsmouth> ;
    ex:hasParent <http://example.org/entity/John_Wallop_2nd_Earl_of_Portsmouth> .

<http://example.org/entity/Oxford> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/John_Wallop_2nd_Earl_of_Portsmouth> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Coulson_Wallop> ;
    ex:hasEducatedAt <http://example.org/entity/Oxford> .

