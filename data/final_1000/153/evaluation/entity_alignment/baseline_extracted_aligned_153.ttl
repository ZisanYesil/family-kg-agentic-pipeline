@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Gå_och_göm_dig_Åke_Tråk> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Gå och göm dig, Åke Tråk" ;
    onto:hasPerformer <http://example.org/entity/Mona_Wessman> .

<http://example.org/entity/Mona_Wessman> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mona Wessman" ;
    onto:hasNationality <http://example.org/entity/Sweden> .

<http://example.org/entity/Sweden> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Sweden" ;
    skos:altLabel "Swedish" .

