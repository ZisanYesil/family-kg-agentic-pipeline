@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Gå_och_göm_dig_Åke_Tråk> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Mona_Wessman> ;
    ex:hasPerformer <http://example.org/entity/Mona_Wessman> .

<http://example.org/entity/Mona_Wessman> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Sweden> ;
    ex:hasNationality <http://example.org/entity/Sweden> .

<http://example.org/entity/Sweden> a ex:Country,
        ex:Place .

