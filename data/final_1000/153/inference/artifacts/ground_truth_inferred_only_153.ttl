@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Gå_och_göm_dig_Åke_Tråk a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Mona_Wessman .

entity:Mona_Wessman a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:Sweden .

entity:Sweden a ex:Country,
        ex:Place .

