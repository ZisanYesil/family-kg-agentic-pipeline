@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Las_Vegas_Sands> a ex:Agent,
        ex:Organization .

<http://example.org/entity/Miriam_Adelson> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Sheldon_Adelson> .

<http://example.org/entity/Sheldon_Adelson> a ex:Agent,
        ex:Person ;
    ex:hasEmployer <http://example.org/entity/Las_Vegas_Sands> ;
    ex:hasSpouse <http://example.org/entity/Miriam_Adelson> .

