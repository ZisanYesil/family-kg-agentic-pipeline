@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:cry_of_jazz_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Cry Of Jazz" ;
    onto:hasPublicationDate "1959"^^xsd:gYear .

data:tu_je_sei_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Tu Je Sei" ;
    onto:hasPublicationDate "2016"^^xsd:gYear .

