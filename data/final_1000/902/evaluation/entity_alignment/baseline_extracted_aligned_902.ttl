@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/The_Cry_of_Jazz> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Cry Of Jazz" ;
    onto:hasPublicationDate "1959"^^xsd:gYear .

<http://example.org/entity/Tu_Je_Sei> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Tu Je Sei" ;
    onto:hasPublicationDate "2016"^^xsd:gYear .

