@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Ahmose_Nebetta> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ahmose-Nebetta" ;
    onto:hasFather <http://example.org/entity/Seqenenre_Tao> ;
    skos:altLabel "Ahmose-Nebta" .

<http://example.org/entity/Seqenenre_Tao> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Seqenenre Tao" ;
    onto:hasMother <http://example.org/entity/Tetisheri> .

<http://example.org/entity/Tetisheri> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tetisheri" .

