@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Ahmose_Nebetta> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Seqenenre_Tao> ;
    ex:hasParent <http://example.org/entity/Seqenenre_Tao> .

<http://example.org/entity/Tetisheri> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Seqenenre_Tao> .

<http://example.org/entity/Seqenenre_Tao> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Ahmose_Nebetta> ;
    ex:hasMother <http://example.org/entity/Tetisheri> ;
    ex:hasParent <http://example.org/entity/Tetisheri> .

