@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Yellow_Passport a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Edwin_August ;
    ex:hasDirector entity:Edwin_August .

entity:Valhalla_Memorial_Park_Cemetery a ex:Place .

entity:Edwin_August a ex:Agent,
        ex:Person ;
    ex:hasBurialPlace entity:Valhalla_Memorial_Park_Cemetery .

