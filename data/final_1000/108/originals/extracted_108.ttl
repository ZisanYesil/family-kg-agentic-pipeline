@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_the_yellow_passport_1916 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Yellow Passport" ;
    onto:hasDirector data:person_edwin_august .

data:person_edwin_august a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Edwin August" ;
    onto:hasBurialPlace data:place_valhalla_memorial_park_cemetery ;
    skos:altLabel "Edwin August Phillip von der Butz" .

data:place_valhalla_memorial_park_cemetery a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Valhalla Memorial Park Cemetery" .

