@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:mariam_el_masri a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mariam El-Masri" ;
    onto:hasBirthDate "1991-06-20"^^xsd:date ;
    skos:altLabel "Mariam El Masri" .

data:marie_agba_otikpo a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Marie Agba-Otikpo" ;
    onto:hasBirthDate "1948-12-01"^^xsd:date ;
    skos:altLabel "Marie Belkine" .

