@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:saga_africa a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Saga Africa" ;
    onto:hasPerformer data:yannick_noah .

data:joakim_noah a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Joakim Noah" .

data:yannick_noah a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Yannick Noah" ;
    onto:hasChild data:joakim_noah .

