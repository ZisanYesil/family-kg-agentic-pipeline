@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Saga_Africa a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Yannick_Noah ;
    ex:hasPerformer entity:Yannick_Noah .

entity:Joakim_Noah a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Yannick_Noah .

entity:Yannick_Noah a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Joakim_Noah .

