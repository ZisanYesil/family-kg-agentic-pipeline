@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Saga_Africa> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Yannick_Noah> ;
    ex:hasPerformer <http://example.org/entity/Yannick_Noah> .

<http://example.org/entity/Joakim_Noah> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/entity/Yannick_Noah> .

<http://example.org/entity/Yannick_Noah> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Joakim_Noah> .

