@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:ferdinande_henriette_of_stolberg_gedern a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Countess Ferdinande Henriette of Stolberg-Gedern" ;
    onto:hasMother data:christine_of_mecklenburg_gustrow .

data:christine_of_mecklenburg_gustrow a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Duchess Christine of Mecklenburg-Güstrow" ;
    onto:hasFather data:gustav_adolph_duke_of_mecklenburg_gustrow .

data:gustav_adolph_duke_of_mecklenburg_gustrow a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gustav Adolph, Duke of Mecklenburg-Güstrow" .

