@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Countess_Ferdinande_Henriette_of_Stolberg_Gedern> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Countess Ferdinande Henriette of Stolberg-Gedern" ;
    onto:hasMother <http://example.org/entity/Christine_of_Mecklenburg_Güstrow> .

<http://example.org/entity/Christine_of_Mecklenburg_Güstrow> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Duchess Christine of Mecklenburg-Güstrow" ;
    onto:hasFather <http://example.org/entity/Gustav_Adolph_Duke_of_Mecklenburg_Güstrow> .

<http://example.org/entity/Gustav_Adolph_Duke_of_Mecklenburg_Güstrow> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gustav Adolph, Duke of Mecklenburg-Güstrow" .

