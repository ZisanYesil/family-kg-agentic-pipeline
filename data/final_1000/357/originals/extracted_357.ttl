@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:kansas_city_confidential_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Kansas City Confidential" ;
    onto:hasPublicationDate "1952"^^xsd:gYear .

data:men_o_war_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Men O' War" ;
    onto:hasPublicationDate "1929-06-29"^^xsd:date .

