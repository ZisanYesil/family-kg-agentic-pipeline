@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Kansas_City_Confidential> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Kansas City Confidential" ;
    onto:hasPublicationDate "1952"^^xsd:gYear .

<http://example.org/entity/Men_O_War> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Men O' War" ;
    onto:hasPublicationDate "1929-06-29"^^xsd:date .

