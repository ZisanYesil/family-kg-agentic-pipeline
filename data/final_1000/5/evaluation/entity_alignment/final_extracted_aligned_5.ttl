@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Sunday_Papers> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Joe_Jackson> ;
    ex:hasPerformer <http://example.org/entity/Joe_Jackson> .

<http://example.org/entity/Grammy> a ex:Award .

<http://example.org/entity/Joe_Jackson> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/entity/Grammy> .

