@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Sunday_Papers> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Sunday Papers" ;
    onto:hasPerformer <http://example.org/entity/Joe_Jackson> .

<http://example.org/entity/Grammy> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Grammy Award nomination" .

<http://example.org/entity/Joe_Jackson> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Joe Jackson" ;
    onto:hasAwardReceived <http://example.org/entity/Grammy> ;
    skos:altLabel "David Ian \"Joe\" Jackson" .

