@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Sunday_Papers a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Joe_Jackson ;
    ex:hasPerformer entity:Joe_Jackson .

entity:Grammy a ex:Award .

entity:Joe_Jackson a ex:Agent ;
    ex:hasAwardReceived entity:Grammy .

