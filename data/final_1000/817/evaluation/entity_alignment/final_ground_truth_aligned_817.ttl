@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Marry_You a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Bruno_Mars ;
    ex:hasPerformer entity:Bruno_Mars .

entity:Grammy_Award a ex:Award .

entity:Bruno_Mars a ex:Agent ;
    ex:hasAwardReceived entity:Grammy_Award .

