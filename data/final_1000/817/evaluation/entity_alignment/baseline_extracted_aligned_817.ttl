@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Marry_You> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Marry You" ;
    onto:hasPerformer <http://example.org/entity/Bruno_Mars> .

<http://example.org/entity/Bruno_Mars> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bruno Mars" ;
    onto:hasAwardReceived <http://example.org/entity/Grammy_Award> .

<http://example.org/entity/Grammy_Award> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Grammy Award" .

