@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:edward_stillingfleet_physician a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Edward Stillingfleet" ;
    onto:hasBirthDate "1660"^^xsd:gYear ;
    onto:hasDeathDate "1708"^^xsd:gYear .

data:jm_balliol_salmon a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "J M Balliol Salmon" ;
    onto:hasBirthDate "1868"^^xsd:gYear ;
    onto:hasDeathDate "1953"^^xsd:gYear .

