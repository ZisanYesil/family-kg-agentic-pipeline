@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Edward_Stillingfleet> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Edward Stillingfleet" ;
    onto:hasBirthDate "1660"^^xsd:gYear ;
    onto:hasDeathDate "1708"^^xsd:gYear .

<http://example.org/entity/J_M_Balliol_Salmon> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "J M Balliol Salmon" ;
    onto:hasBirthDate "1868"^^xsd:gYear ;
    onto:hasDeathDate "1953"^^xsd:gYear .

