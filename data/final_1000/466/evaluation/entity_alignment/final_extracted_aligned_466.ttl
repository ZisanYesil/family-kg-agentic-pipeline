@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Edward_Stillingfleet> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1660"^^xsd:gYear ;
    ex:hasDeathDate "1708"^^xsd:gYear .

<http://example.org/entity/J_M_Balliol_Salmon> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1868"^^xsd:gYear ;
    ex:hasDeathDate "1953"^^xsd:gYear .

