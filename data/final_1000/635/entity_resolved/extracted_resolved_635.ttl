@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:catherine_ivanovna a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tsarevna Catherine Ivanovna of Russia" ;
    onto:hasMother data:praskovia_saltykova ;
    skos:altLabel "Catherine Ivanovna" .

data:praskovia_saltykova a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Praskovia Saltykova" ;
    onto:hasDeathDate "1723-10-13"^^xsd:date ;
    skos:altLabel "Praskovia Fyodorovna Saltykova" .

