@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Tsarevna_Catherine_Ivanovna_of_Russia> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Praskovia_Saltykova> ;
    ex:hasParent <http://example.org/entity/Praskovia_Saltykova> .

<http://example.org/entity/Praskovia_Saltykova> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Tsarevna_Catherine_Ivanovna_of_Russia> ;
    ex:hasDeathDate "1723-10-13"^^xsd:date .

