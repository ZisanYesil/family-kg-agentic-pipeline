@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Tsarevna_Catherine_Ivanovna_of_Russia> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tsarevna Catherine Ivanovna of Russia" ;
    onto:hasMother <http://example.org/entity/Praskovia_Saltykova> ;
    skos:altLabel "Catherine Ivanovna" .

<http://example.org/entity/Praskovia_Saltykova> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Praskovia Saltykova" ;
    onto:hasDeathDate "1723-10-13"^^xsd:date ;
    skos:altLabel "Praskovia Fyodorovna Saltykova" .

