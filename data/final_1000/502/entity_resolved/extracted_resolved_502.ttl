@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:val_toke_gormsson a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Valtoke Gormsson" ;
    onto:hasFather data:gorm_the_old ;
    skos:altLabel "Toke",
        "Valtoke Gormsson" .

data:gorm_the_old a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gorm the Old" ;
    skos:altLabel "Gorm the Old" .

