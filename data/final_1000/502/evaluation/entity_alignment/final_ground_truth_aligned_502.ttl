@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Jelling a ex:Place .

entity:Toke_also_known_as_Valtoke a ex:Agent,
        ex:Person ;
    ex:hasFather entity:Gorm_the_Old ;
    ex:hasParent entity:Gorm_the_Old .

entity:Gorm_the_Old a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Toke_also_known_as_Valtoke ;
    ex:hasDeathPlace entity:Jelling .

