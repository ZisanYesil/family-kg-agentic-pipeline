@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Toke_also_known_as_Valtoke> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Valtoke Gormsson" ;
    onto:hasFather <http://example.org/entity/Gorm_the_Old> ;
    skos:altLabel "Toke",
        "Valtoke Gormsson" .

<http://example.org/entity/Gorm_the_Old> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gorm the Old" ;
    skos:altLabel "Gorm the Old" .

