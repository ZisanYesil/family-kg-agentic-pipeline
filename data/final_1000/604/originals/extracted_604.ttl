@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:the_return_of_luk_siu_fung a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "The Return of Luk Siu-fung" ;
    onto:hasCreator data:gu_long .

data:cheng_kung_senior_high_school a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Cheng Kung Senior High School" .

data:gu_long a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gu Long" ;
    onto:hasEducatedAt data:cheng_kung_senior_high_school,
        data:tamkang_university .

data:tamkang_university a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Tamkang University" .

