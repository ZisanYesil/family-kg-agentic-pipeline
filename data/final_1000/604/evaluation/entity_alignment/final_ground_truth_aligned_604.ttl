@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Return_of_Luk_Siu_fung a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Gu_Long .

entity:Gu_Long a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt entity:Tamkang_University .

entity:Tamkang_University a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

