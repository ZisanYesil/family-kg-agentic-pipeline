@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_Return_of_Luk_Siu_fung> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Gu_Long> .

<http://example.org/entity/Gu_Long> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/Tamkang_University>,
        <http://example.org/extracted/cheng_kung_senior_high_school> .

<http://example.org/entity/Tamkang_University> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/extracted/cheng_kung_senior_high_school> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

