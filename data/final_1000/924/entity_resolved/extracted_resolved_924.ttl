@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:khalil_el_amin a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Khalil Hassan El-Amin" ;
    onto:hasNationality data:united_states ;
    skos:altLabel "Khalil El-Amin" .

data:tori_anthony a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tori Anthony" ;
    onto:hasNationality data:united_states .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

