@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Khalil_El_Amin> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Khalil Hassan El-Amin" ;
    onto:hasNationality <http://example.org/entity/American> ;
    skos:altLabel "Khalil El-Amin" .

<http://example.org/entity/Tori_Anthony> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tori Anthony" ;
    onto:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

