@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_clegg a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Clegg" ;
    onto:hasDirector data:person_lindsay_shonteff ;
    skos:altLabel "Clegg (film)" .

data:person_lindsay_shonteff a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lindsay Shonteff" ;
    skos:altLabel "Lindsay Craig Shonteff" .

