@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Clegg> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Clegg" ;
    onto:hasDirector <http://example.org/entity/Lindsay_Shonteff> ;
    skos:altLabel "Clegg (film)" .

<http://example.org/entity/Lindsay_Shonteff> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lindsay Shonteff" ;
    skos:altLabel "Lindsay Craig Shonteff" .

