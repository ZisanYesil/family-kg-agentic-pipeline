@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Clegg> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Lindsay_Shonteff> ;
