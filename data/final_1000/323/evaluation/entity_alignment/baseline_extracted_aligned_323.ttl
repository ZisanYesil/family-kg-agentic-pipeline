@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Nathaniel_Wallich> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nathaniel Wallich" ;
    onto:hasFather <http://example.org/entity/George_Charles_Wallich> .

data:royal_botanical_gardens a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Royal Botanical Gardens" .

<http://example.org/entity/George_Charles_Wallich> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "George Charles Wallich" .

