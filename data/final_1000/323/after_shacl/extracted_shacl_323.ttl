@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:nathaniel_wallich a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nathaniel Wallich" ;
    onto:hasFather data:george_charles_wallich .

data:royal_botanical_gardens a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Royal Botanical Gardens" .

data:george_charles_wallich a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "George Charles Wallich" .

