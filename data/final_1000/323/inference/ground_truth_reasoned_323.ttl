@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Calcutta_Botanical_Garden a ex:Agent,
        ex:Organization .

entity:George_Charles_Wallich a ex:Agent,
        ex:Person ;
    ex:hasFather entity:Nathaniel_Wallich ;
    ex:hasParent entity:Nathaniel_Wallich .

entity:Nathaniel_Wallich a ex:Agent,
        ex:Person ;
    ex:hasChild entity:George_Charles_Wallich ;
    ex:hasEmployer entity:Calcutta_Botanical_Garden .

