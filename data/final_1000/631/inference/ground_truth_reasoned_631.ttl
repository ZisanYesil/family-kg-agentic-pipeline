@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Great_Circus_Mystery a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Jay_Marchant ;
    ex:hasDirector entity:Jay_Marchant .

entity:Los_Angeles_County a ex:Place .

entity:Jay_Marchant a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace entity:Los_Angeles_County .

