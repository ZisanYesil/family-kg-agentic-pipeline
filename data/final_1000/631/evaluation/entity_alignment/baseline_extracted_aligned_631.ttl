@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/The_Great_Circus_Mystery> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Great Circus Mystery" ;
    onto:hasDirector <http://example.org/entity/Jay_Marchant> .

<http://example.org/entity/Jay_Marchant> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jay Marchant" ;
    onto:hasDeathPlace <http://example.org/entity/Los_Angeles_County> .

<http://example.org/entity/Los_Angeles_County> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Los Angeles County, California" .

