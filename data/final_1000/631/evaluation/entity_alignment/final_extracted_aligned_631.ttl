@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_Great_Circus_Mystery> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Jay_Marchant> ;
    ex:hasDirector <http://example.org/entity/Jay_Marchant> .

<http://example.org/entity/Los_Angeles_County> a ex:Place .

<http://example.org/entity/Jay_Marchant> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Los_Angeles_County> .

