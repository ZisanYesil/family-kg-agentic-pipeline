@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:wolves_of_the_north_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Wolves of the North" ;
    onto:hasDirector data:william_duncan_person .

data:william_duncan_person a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William Duncan" .

