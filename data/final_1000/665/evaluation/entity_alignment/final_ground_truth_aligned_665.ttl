@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Wolves_of_the_North a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:William_Duncan ;
    ex:hasDirector entity:William_Duncan .

entity:Hollywood a ex:Place .

entity:William_Duncan a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace entity:Hollywood .

