@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Wolves_of_the_North> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Wolves of the North" ;
    onto:hasDirector <http://example.org/entity/William_Duncan> .

<http://example.org/entity/William_Duncan> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William Duncan" .

