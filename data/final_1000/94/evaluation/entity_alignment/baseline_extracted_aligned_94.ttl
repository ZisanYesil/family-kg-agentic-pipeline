@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Dortoir_des_grandes> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Dortoir des grandes" ;
    onto:hasDirector <http://example.org/entity/Henri_Decoin> .

<http://example.org/entity/Is_Paris_Burning_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Is Paris Burning?" ;
    onto:hasDirector <http://example.org/entity/René_Clément> .

<http://example.org/entity/Henri_Decoin> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Henri Decoin" ;
    onto:hasNationality <http://example.org/entity/French> .

<http://example.org/entity/René_Clément> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "René Clément" ;
    onto:hasNationality <http://example.org/entity/French> .

<http://example.org/entity/French> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

