@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:africa_renewal a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Africa Renewal" ;
    onto:hasPublisher data:united_nations .

data:united_nations a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "United Nations" ;
    onto:hasInception "1945-10-24"^^xsd:date .

