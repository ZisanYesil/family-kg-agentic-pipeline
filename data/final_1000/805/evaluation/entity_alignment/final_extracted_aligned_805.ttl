@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Africa_Renewal> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher <http://example.org/entity/United_Nations> .

<http://example.org/entity/United_Nations> a ex:Agent,
        ex:Organization ;
    ex:hasInception "1945-10-24"^^xsd:date .

