@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Africa_Renewal a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher entity:United_Nations .

entity:United_Nations a ex:Agent,
        ex:Organization ;
    ex:hasInception "1945"^^xsd:gYear .

