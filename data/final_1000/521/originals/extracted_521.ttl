@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:dillon_dam_brewery a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Dillon Dam Brewery" ;
    onto:hasCountry data:united_states .

data:ultra_diamonds a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "ULTRA Diamonds" ;
    onto:hasCountry data:united_states .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "U.S.A.",
        "United States of America" .

