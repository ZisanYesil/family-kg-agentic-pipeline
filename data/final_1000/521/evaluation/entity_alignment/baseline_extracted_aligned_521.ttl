@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Dillon_Dam_Brewery> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Dillon Dam Brewery" ;
    onto:hasCountry <http://example.org/entity/United_States> .

<http://example.org/entity/ULTRA_Diamonds> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "ULTRA Diamonds" ;
    onto:hasCountry <http://example.org/entity/United_States> .

<http://example.org/entity/United_States> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "U.S.A.",
        "United States of America" .

