@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Calling_Philo_Vance> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/William_Clemens> ;
    ex:hasDirector <http://example.org/entity/William_Clemens> .

<http://example.org/entity/The_Witch_s_Curse> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Riccardo_Freda> ;
    ex:hasDirector <http://example.org/entity/Riccardo_Freda> .

<http://example.org/entity/Riccardo_Freda> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1999-12-20"^^xsd:date .

<http://example.org/entity/William_Clemens> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1980-04-29"^^xsd:date .

