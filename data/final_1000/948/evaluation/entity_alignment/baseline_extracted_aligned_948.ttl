@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Calling_Philo_Vance> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Calling Philo Vance" ;
    onto:hasDirector <http://example.org/entity/William_Clemens> ;
    skos:altLabel "Calling Philo Vance" .

<http://example.org/entity/The_Witch_s_Curse> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Witch's Curse" ;
    onto:hasDirector <http://example.org/entity/Riccardo_Freda> ;
    skos:altLabel "The Witch's Curse" .

<http://example.org/entity/Riccardo_Freda> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Riccardo Freda" ;
    onto:hasDeathDate "1999-12-20"^^xsd:date ;
    skos:altLabel "Riccardo Freda" .

<http://example.org/entity/William_Clemens> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William Clemens" ;
    onto:hasDeathDate "1980-04-29"^^xsd:date ;
    skos:altLabel "William Clemens" .

