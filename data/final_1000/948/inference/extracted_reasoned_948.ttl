@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_calling_philo_vance> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_william_clemens> ;
    ex:hasDirector <http://example.org/extracted/person_william_clemens> .

<http://example.org/extracted/film_the_witchs_curse> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_riccardo_freda> ;
    ex:hasDirector <http://example.org/extracted/person_riccardo_freda> .

<http://example.org/extracted/person_riccardo_freda> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1999-12-20"^^xsd:date .

<http://example.org/extracted/person_william_clemens> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1980-04-29"^^xsd:date .

