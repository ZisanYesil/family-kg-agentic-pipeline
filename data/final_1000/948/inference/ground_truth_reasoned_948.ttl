@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Calling_Philo_Vance a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:William_Clemens ;
    ex:hasDirector entity:William_Clemens .

entity:The_Witch_s_Curse a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Riccardo_Freda ;
    ex:hasDirector entity:Riccardo_Freda .

entity:William_Clemens_film_director a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1980-04-29"^^xsd:date .

entity:Riccardo_Freda a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1999-12-20"^^xsd:date .

entity:William_Clemens a ex:Agent,
        ex:Person .

