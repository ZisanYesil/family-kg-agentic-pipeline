@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Paper_Bird> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Paper Bird" ;
    onto:hasMember <http://example.org/entity/Sarah_Anderson> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

<http://example.org/entity/Sarah_Anderson> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sarah Anderson" ;
    onto:hasNationality <http://example.org/entity/American> ;
    skos:altLabel "Sarah L. Anderson" .

