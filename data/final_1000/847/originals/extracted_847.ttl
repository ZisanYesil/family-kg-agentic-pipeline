@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:paper_bird a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Paper Bird" ;
    onto:hasMember data:sarah_anderson .

data:sarah_anderson a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sarah Anderson" ;
    onto:hasNationality data:united_states ;
    skos:altLabel "Sarah L. Anderson" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

