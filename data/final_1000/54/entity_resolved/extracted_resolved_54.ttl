@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:lydia_knott a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lydia Knott" ;
    onto:hasBirthDate "1866-10-01"^^xsd:date ;
    onto:hasDeathDate "1955-03-30"^^xsd:date .

data:maria_dulebianka a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Maria Dulębianka" ;
    onto:hasBirthDate "1861-10-21"^^xsd:date ;
    onto:hasDeathDate "1919-03-07"^^xsd:date .

