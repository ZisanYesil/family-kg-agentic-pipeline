@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Ordwulf> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Ordgar> ;
    ex:hasParent <http://example.org/entity/Ordgar> .

<http://example.org/entity/England> a ex:Country,
        ex:Place .

<http://example.org/entity/Ordgar> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Ordwulf> ;
    ex:hasCountry <http://example.org/entity/England> ;
    ex:hasNationality <http://example.org/entity/England> .

