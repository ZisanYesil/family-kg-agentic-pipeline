@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/england> a ex:Place .

<http://example.org/extracted/ordgar> a ex:Agent ;
    ex:hasChild <http://example.org/extracted/ordwulf> ;
    ex:hasCountry <http://example.org/extracted/england> .

<http://example.org/extracted/ordwulf> a ex:Agent ;
    ex:hasParent <http://example.org/extracted/ordgar> .

