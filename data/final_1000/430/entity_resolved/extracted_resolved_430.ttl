@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:ordwulf a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ordwulf" ;
    onto:hasFather data:ordgar .

data:england a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "England" .

data:ordgar a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ordgar" ;
    onto:hasNationality data:england .

