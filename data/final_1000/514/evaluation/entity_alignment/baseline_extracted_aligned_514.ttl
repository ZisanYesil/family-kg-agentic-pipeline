@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Countess_Anna_of_Nassau> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Countess Anna of Nassau" ;
    onto:hasMother <http://example.org/entity/Anna_of_Saxony> .

<http://example.org/entity/Anna_of_Saxony> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Anna of Saxony" ;
    onto:hasBirthDate "1544-12-23"^^xsd:date .

