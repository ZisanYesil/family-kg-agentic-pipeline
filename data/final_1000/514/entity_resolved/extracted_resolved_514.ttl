@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:countess_anna_of_nassau a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Countess Anna of Nassau" ;
    onto:hasMother data:anna_of_saxony .

data:anna_of_saxony a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Anna of Saxony" ;
    onto:hasBirthDate "1544-12-23"^^xsd:date .

