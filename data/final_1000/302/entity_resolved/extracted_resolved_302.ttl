@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:anne_marie_therese_lorraine_1648 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Anne Marie Thérèse de Lorraine" ;
    onto:hasMother data:claude_fran%C3%A7oise_lorraine_1612 .

data:claude_fran%C3%A7oise_lorraine_1612 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Claude Françoise de Lorraine" ;
    onto:hasSister data:nicole_duchess_of_lorraine .

data:nicole_duchess_of_lorraine a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nicole, Duchess of Lorraine" .

