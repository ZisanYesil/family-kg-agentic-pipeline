@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Anne_Marie_Thérèse_of_Lorraine> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Anne Marie Thérèse de Lorraine" ;
    onto:hasMother <http://example.org/entity/Claude_Françoise_de_Lorraine> .

<http://example.org/entity/Claude_Françoise_de_Lorraine> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Claude Françoise de Lorraine" ;
    onto:hasSister <http://example.org/entity/Nicole_Duchess_of_Lorraine> .

<http://example.org/entity/Nicole_Duchess_of_Lorraine> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nicole, Duchess of Lorraine" .

