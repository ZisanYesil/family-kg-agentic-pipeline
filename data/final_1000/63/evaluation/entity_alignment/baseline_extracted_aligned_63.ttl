@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Catholic_University_of_Tachira> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Catholic University Of Tachira" ;
    onto:hasInception "1962"^^xsd:gYear ;
    skos:altLabel "UCAT",
        "Universidad Católica del Táchira" .

<http://example.org/entity/Sri_Dharmaloka_College> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Sri Dharmaloka College" ;
    onto:hasInception "1938"^^xsd:gYear .

