@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Catholic_University_of_Tachira> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization ;
    ex:hasInception "1962"^^xsd:gYear .

<http://example.org/entity/Sri_Dharmaloka_College> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization ;
    ex:hasInception "1938"^^xsd:gYear .

