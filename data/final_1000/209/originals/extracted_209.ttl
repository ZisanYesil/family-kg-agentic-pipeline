@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:ti_person a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Clifford Joseph Harris Jr." ;
    onto:hasOccupation data:occupation_actor,
        data:occupation_rapper ;
    skos:altLabel "T.I.",
        "Tip" .

data:wayne_maki_person a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Wayne Maki" ;
    onto:hasOccupation data:occupation_ice_hockey_player .

data:occupation_actor a onto:Occupation,
        owl:NamedIndividual ;
    rdfs:label "actor" .

data:occupation_ice_hockey_player a onto:Occupation,
        owl:NamedIndividual ;
    rdfs:label "ice hockey player" .

data:occupation_rapper a onto:Occupation,
        owl:NamedIndividual ;
    rdfs:label "rapper" .

