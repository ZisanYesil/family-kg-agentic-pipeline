@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/ti_person> a ex:Agent,
        ex:Person ;
    ex:hasOccupation <http://example.org/extracted/occupation_actor>,
        <http://example.org/extracted/occupation_rapper> .

<http://example.org/extracted/wayne_maki_person> a ex:Agent,
        ex:Person ;
    ex:hasOccupation <http://example.org/extracted/occupation_ice_hockey_player> .

<http://example.org/extracted/occupation_actor> a ex:Occupation .

<http://example.org/extracted/occupation_ice_hockey_player> a ex:Occupation .

<http://example.org/extracted/occupation_rapper> a ex:Occupation .

