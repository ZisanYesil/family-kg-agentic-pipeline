@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:T_I a ex:Agent,
        ex:Person ;
    ex:hasOccupation entity:actor,
        entity:rapper .

entity:Wayne_Maki a ex:Agent,
        ex:Person ;
    ex:hasOccupation entity:ice_hockey_player .

entity:actor a ex:Occupation .

entity:ice_hockey_player a ex:Occupation .

entity:rapper a ex:Occupation .

