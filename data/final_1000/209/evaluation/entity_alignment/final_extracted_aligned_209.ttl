@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/T_I> a ex:Agent,
        ex:Person ;
    ex:hasOccupation <http://example.org/entity/actor>,
        <http://example.org/entity/rapper> .

<http://example.org/entity/Wayne_Maki> a ex:Agent,
        ex:Person ;
    ex:hasOccupation <http://example.org/entity/ice_hockey_player> .

<http://example.org/entity/actor> a ex:Occupation .

<http://example.org/entity/ice_hockey_player> a ex:Occupation .

<http://example.org/entity/rapper> a ex:Occupation .

