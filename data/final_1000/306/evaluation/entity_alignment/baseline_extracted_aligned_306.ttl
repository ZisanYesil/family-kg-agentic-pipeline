@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Rajiv_Gandhi> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Rajiv Gandhi" ;
    onto:hasBrother <http://example.org/entity/Sanjay_Gandhi> ;
    onto:hasChild <http://example.org/entity/Priyanka_Gandhi> .

<http://example.org/entity/Priyanka_Gandhi> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Priyanka Gandhi" ;
    skos:altLabel "Priyanka Gandhi Vadra" .

<http://example.org/entity/Sanjay_Gandhi> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sanjay Gandhi" .

