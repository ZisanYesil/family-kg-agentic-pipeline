@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/My_Father_the_Hero_1994_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/American>,
        <http://example.org/entity/French> ;
    ex:hasCountryOfOrigin <http://example.org/entity/American>,
        <http://example.org/entity/French> .

<http://example.org/entity/Wyoming_Roundup> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasCountryOfOrigin <http://example.org/entity/American> .

<http://example.org/entity/French> a ex:Country,
        ex:Place .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

