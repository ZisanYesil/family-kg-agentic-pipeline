@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/my_father_hero_1994> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/extracted/france>,
        <http://example.org/extracted/united_states> ;
    ex:hasCountryOfOrigin <http://example.org/extracted/france>,
        <http://example.org/extracted/united_states> .

<http://example.org/extracted/wyoming_roundup> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/extracted/united_states> ;
    ex:hasCountryOfOrigin <http://example.org/extracted/united_states> .

