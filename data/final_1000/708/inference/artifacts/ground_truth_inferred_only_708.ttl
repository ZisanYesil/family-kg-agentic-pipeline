@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Stockholm a ex:Place .

entity:Carl_von_Fersen a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Hans_Reinhold_von_Fersen .

entity:Hans_Reinhold_von_Fersen a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Carl_von_Fersen .

