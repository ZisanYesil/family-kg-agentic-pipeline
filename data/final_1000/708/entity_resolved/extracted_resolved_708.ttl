@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:carl_von_fersen a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Carl von Fersen" ;
    onto:hasFather data:hans_reinhold_von_fersen .

data:hans_reinhold_von_fersen a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hans Reinhold von Fersen" ;
    onto:hasDeathPlace data:stockholm .

data:stockholm a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Stockholm" .

