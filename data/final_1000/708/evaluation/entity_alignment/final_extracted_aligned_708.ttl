@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Carl_von_Fersen> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Hans_Reinhold_von_Fersen> ;
    ex:hasParent <http://example.org/entity/Hans_Reinhold_von_Fersen> .

<http://example.org/entity/Stockholm> a ex:Place .

<http://example.org/entity/Hans_Reinhold_von_Fersen> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Carl_von_Fersen> ;
    ex:hasDeathPlace <http://example.org/entity/Stockholm> .

