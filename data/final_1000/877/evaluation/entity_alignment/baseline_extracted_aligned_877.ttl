@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Article_99> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Article 99" ;
    onto:hasCountryOfOrigin <http://example.org/entity/American> .

<http://example.org/entity/Six_Dance_Lessons_in_Six_Weeks_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Six Dance Lessons in Six Weeks" ;
    onto:hasCountryOfOrigin <http://example.org/entity/American> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

