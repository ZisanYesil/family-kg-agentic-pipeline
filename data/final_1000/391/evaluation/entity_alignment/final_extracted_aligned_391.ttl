@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Baby_Love> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Alastair_Reid> ;
    ex:hasDirector <http://example.org/entity/Alastair_Reid> .

<http://example.org/entity/Somerset> a ex:Place .

<http://example.org/entity/Alastair_Reid> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Somerset> .

