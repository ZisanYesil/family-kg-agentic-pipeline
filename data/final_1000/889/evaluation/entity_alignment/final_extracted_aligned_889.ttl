@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Henry_Goes_Arizona> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Edwin_L_Marin> ;
    ex:hasDirector <http://example.org/entity/Edwin_L_Marin> .

<http://example.org/entity/Tex_and_the_Lord_of_the_Deep> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Duccio_Tessari> ;
    ex:hasDirector <http://example.org/entity/Duccio_Tessari> .

<http://example.org/entity/Duccio_Tessari> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1994-09-06"^^xsd:date .

<http://example.org/entity/Edwin_L_Marin> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1951-05-02"^^xsd:date .

