@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Henry_Goes_Arizona a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Edwin_L_Marin ;
    ex:hasDirector entity:Edwin_L_Marin .

entity:Tex_and_the_Lord_of_the_Deep a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Duccio_Tessari ;
    ex:hasDirector entity:Duccio_Tessari .

entity:Duccio_Tessari a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1994-09-06"^^xsd:date .

entity:Edwin_L_Marin a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1951-05-02"^^xsd:date .

