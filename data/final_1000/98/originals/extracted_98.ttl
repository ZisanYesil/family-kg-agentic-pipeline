@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:julius_rockwell a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Julius Rockwell" ;
    onto:hasEducatedAt data:yale_university ;
    onto:hasFather data:francis_w_rockwell .

data:francis_w_rockwell a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Francis W. Rockwell" ;
    skos:altLabel "Francis Williams Rockwell" .

data:yale_university a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Yale University" ;
    skos:altLabel "Yale" .

