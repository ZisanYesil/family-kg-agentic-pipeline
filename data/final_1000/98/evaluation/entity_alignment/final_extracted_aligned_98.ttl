@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Julius_Rockwell> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/Yale> ;
    ex:hasFather <http://example.org/entity/Francis_Williams_Rockwell> ;
    ex:hasParent <http://example.org/entity/Francis_Williams_Rockwell> .

<http://example.org/entity/Yale> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Francis_Williams_Rockwell> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Julius_Rockwell> .

