@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Julius_Rockwell> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Julius Rockwell" ;
    onto:hasEducatedAt <http://example.org/entity/Yale> ;
    onto:hasFather <http://example.org/entity/Francis_Williams_Rockwell> .

<http://example.org/entity/Francis_Williams_Rockwell> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Francis W. Rockwell" ;
    skos:altLabel "Francis Williams Rockwell" .

<http://example.org/entity/Yale> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Yale University" ;
    skos:altLabel "Yale" .

