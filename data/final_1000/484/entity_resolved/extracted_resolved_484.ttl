@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_black_panthers a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Black Panthers" ;
    onto:hasDirector data:person_agnes_varda .

data:country_france a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

data:person_agnes_varda a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Agnès Varda" ;
    onto:hasNationality data:country_france .

