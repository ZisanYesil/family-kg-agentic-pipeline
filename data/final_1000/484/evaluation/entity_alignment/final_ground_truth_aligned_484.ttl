@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Black_Panthers a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Agnès_Varda ;
    ex:hasDirector entity:Agnès_Varda .

entity:Agnès_Varda a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:French ;
    ex:hasCountry entity:French .

entity:French a ex:Country,
        ex:Place .

