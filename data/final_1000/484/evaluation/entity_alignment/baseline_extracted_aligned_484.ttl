@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Black_Panthers> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Black Panthers" ;
    onto:hasDirector <http://example.org/entity/Agnès_Varda> .

<http://example.org/entity/Agnès_Varda> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Agnès Varda" ;
    onto:hasNationality <http://example.org/entity/French> .

<http://example.org/entity/French> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

