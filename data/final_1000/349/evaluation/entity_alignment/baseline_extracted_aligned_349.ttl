@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:silversun_pickups_band a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Silversun Pickups" ;
    onto:hasCountry <http://example.org/entity/American> .

data:wampire_band a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Wampire" ;
    onto:hasCountry <http://example.org/entity/American> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

