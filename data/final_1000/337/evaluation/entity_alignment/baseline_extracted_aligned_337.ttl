@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Herbert_Andrew_Montagu_Douglas_Scott> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lord Herbert Andrew Montagu Douglas Scott" ;
    onto:hasMother <http://example.org/entity/Louisa_Jane_Hamilton> .

<http://example.org/entity/James_Hamilton> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "James Hamilton, 1st Duke of Abercorn" .

<http://example.org/entity/Louisa_Jane_Hamilton> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lady Louisa Jane Hamilton" ;
    onto:hasFather <http://example.org/entity/James_Hamilton> .

