@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Catherine_Allégret> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Yves_Allégret> ;
    ex:hasParent <http://example.org/entity/Yves_Allégret> .

<http://example.org/entity/Marc_Allégret> a ex:Agent,
        ex:Person ;
    ex:hasSibling <http://example.org/entity/Yves_Allégret> ;
    ex:isBrotherOf <http://example.org/entity/Yves_Allégret> .

<http://example.org/entity/Yves_Allégret> a ex:Agent,
        ex:Person ;
    ex:hasBrother <http://example.org/entity/Marc_Allégret> ;
    ex:hasChild <http://example.org/entity/Catherine_Allégret> ;
    ex:hasSibling <http://example.org/entity/Marc_Allégret> .

