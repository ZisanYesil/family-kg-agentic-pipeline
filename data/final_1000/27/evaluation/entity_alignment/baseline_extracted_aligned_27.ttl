@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Catherine_Allégret> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Catherine Allégret" ;
    onto:hasFather <http://example.org/entity/Yves_Allégret> .

<http://example.org/entity/Marc_Allégret> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Marc Allégret" .

<http://example.org/entity/Yves_Allégret> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Yves Allégret" ;
    onto:hasBrother <http://example.org/entity/Marc_Allégret> .

