@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:st_james_holdings a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "St James Holdings Limited" ;
    onto:hasFounder data:mike_ashley ;
    skos:altLabel "St James Holdings" .

data:mike_ashley a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mike Ashley" ;
    onto:hasEmployer data:sports_direct ;
    skos:altLabel "Michael James Wallace Ashley" .

data:sports_direct a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Sports Direct" .

