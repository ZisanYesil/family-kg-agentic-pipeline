@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:St_James_Holdings a ex:Agent,
        ex:Organization ;
    ex:hasFounder entity:Mike_Ashley .

entity:Mike_Ashley a ex:Agent,
        ex:Person ;
    ex:hasEmployer entity:Sports_Direct .

entity:Sports_Direct a ex:Agent,
        ex:Organization .

