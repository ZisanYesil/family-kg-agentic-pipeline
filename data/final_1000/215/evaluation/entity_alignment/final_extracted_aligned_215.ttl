@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Albert_Kellogg> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1813-12-06"^^xsd:date ;
    ex:hasDeathDate "1887-03-31"^^xsd:date .

<http://example.org/entity/Johann_Jakob_Schalch> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1723-01-23"^^xsd:date ;
    ex:hasDeathDate "1789-08-21"^^xsd:date .

