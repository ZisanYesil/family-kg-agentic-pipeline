@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Albert_Kellogg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Albert Kellogg" ;
    onto:hasBirthDate "1813-12-06"^^xsd:date ;
    onto:hasDeathDate "1887-03-31"^^xsd:date ;
    skos:altLabel "Albert Kellogg" .

<http://example.org/entity/Johann_Jakob_Schalch> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Johann Jakob Schalch" ;
    onto:hasBirthDate "1723-01-23"^^xsd:date ;
    onto:hasDeathDate "1789-08-21"^^xsd:date ;
    skos:altLabel "Johann Jakob Schalch" .

