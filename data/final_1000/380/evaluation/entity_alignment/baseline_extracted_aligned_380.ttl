@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Kizhakke_Varum_Paattu> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Kizhakke Varum Paattu" ;
    onto:hasPublicationDate "1993"^^xsd:gYear .

<http://example.org/entity/Le_Maître_d_école> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Le Maître d'école" ;
    onto:hasPublicationDate "1981"^^xsd:gYear .

