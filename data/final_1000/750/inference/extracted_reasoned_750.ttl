@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_la_cage_aux_folles_3> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_georges_lautner> ;
    ex:hasDirector <http://example.org/extracted/person_georges_lautner> .

<http://example.org/extracted/person_renee_saint_cyr> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/extracted/person_georges_lautner> .

<http://example.org/extracted/person_georges_lautner> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1926-01-24"^^xsd:date ;
    ex:hasDeathDate "2013-11-22"^^xsd:date ;
    ex:hasMother <http://example.org/extracted/person_renee_saint_cyr> ;
    ex:hasParent <http://example.org/extracted/person_renee_saint_cyr> .

