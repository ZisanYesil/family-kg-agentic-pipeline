@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/La_Cage_aux_Folles_3_The_Wedding> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "La Cage Aux Folles 3: The Wedding" ;
    onto:hasDirector <http://example.org/entity/Georges_Lautner> .

<http://example.org/entity/Georges_Lautner> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Georges Lautner" ;
    onto:hasBirthDate "1926-01-24"^^xsd:date ;
    onto:hasDeathDate "2013-11-22"^^xsd:date ;
    onto:hasMother <http://example.org/entity/Renée_Saint_Cyr> .

<http://example.org/entity/Renée_Saint_Cyr> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Renée Saint-Cyr" .

