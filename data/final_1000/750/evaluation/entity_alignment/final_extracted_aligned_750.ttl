@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/La_Cage_aux_Folles_3_The_Wedding> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Georges_Lautner> ;
    ex:hasDirector <http://example.org/entity/Georges_Lautner> .

<http://example.org/entity/Renée_Saint_Cyr> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Georges_Lautner> .

<http://example.org/entity/Georges_Lautner> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1926-01-24"^^xsd:date ;
    ex:hasDeathDate "2013-11-22"^^xsd:date ;
    ex:hasMother <http://example.org/entity/Renée_Saint_Cyr> ;
    ex:hasParent <http://example.org/entity/Renée_Saint_Cyr> .

