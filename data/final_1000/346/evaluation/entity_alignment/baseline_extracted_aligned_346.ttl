@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Hubert_Mordek> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hubert Mordek" ;
    onto:hasBirthDate "1939-05-08"^^xsd:date ;
    onto:hasDeathDate "2006-03-17"^^xsd:date .

<http://example.org/entity/Levon_Ashotovich_Grigorian> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Levon Ashotovich Grigorian" ;
    onto:hasBirthDate "1947-09-07"^^xsd:date ;
    onto:hasDeathDate "1975-11-29"^^xsd:date .

