@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Wawel_Cathedral> a ex:Place .

<http://example.org/entity/Augustus_II_the_Strong> a ex:Agent,
        ex:Person ;
    ex:hasBurialPlace <http://example.org/entity/Wawel_Cathedral> ;
    ex:hasChild <http://example.org/entity/Maurice_de_Saxe> ;
    ex:hasSon <http://example.org/entity/Maurice_de_Saxe> .

<http://example.org/entity/Maurice_de_Saxe> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/entity/Augustus_II_the_Strong> ;
    ex:isSonOf <http://example.org/entity/Augustus_II_the_Strong> .

