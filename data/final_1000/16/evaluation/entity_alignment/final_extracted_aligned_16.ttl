@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Antonio_González_Flores> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Lola_Flores> ;
    ex:hasParent <http://example.org/entity/Lola_Flores> .

<http://example.org/entity/Jerez_de_la_Frontera> a ex:Place .

<http://example.org/entity/Lola_Flores> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Jerez_de_la_Frontera> ;
    ex:hasChild <http://example.org/entity/Antonio_González_Flores> .

