@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Antonio_González_Flores a ex:Agent,
        ex:Person ;
    ex:hasMother entity:Lola_Flores ;
    ex:hasParent entity:Lola_Flores .

entity:Jerez_de_la_Frontera a ex:Place .

entity:Lola_Flores a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Jerez_de_la_Frontera ;
    ex:hasChild entity:Antonio_González_Flores .

