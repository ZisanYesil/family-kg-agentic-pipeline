@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/A_South_Sea_Bubble> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A South Sea Bubble" ;
    onto:hasDirector <http://example.org/entity/T_Hayes_Hunter> .

<http://example.org/entity/The_Young_Animals> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Young Animals" ;
    onto:hasDirector <http://example.org/entity/Maury_Dexter> .

<http://example.org/entity/Maury_Dexter> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Maury Dexter" ;
    onto:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/T_Hayes_Hunter> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "T. Hayes Hunter" ;
    onto:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

