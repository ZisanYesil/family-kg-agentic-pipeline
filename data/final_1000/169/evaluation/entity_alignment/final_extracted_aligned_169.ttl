@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Catherine_Charlotte_de_Gramont> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1678-06-04"^^xsd:date ;
    ex:hasSpouse <http://example.org/entity/Louis_I_Prince_of_Monaco> .

<http://example.org/entity/Louis_I_Prince_of_Monaco> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Catherine_Charlotte_de_Gramont> .

