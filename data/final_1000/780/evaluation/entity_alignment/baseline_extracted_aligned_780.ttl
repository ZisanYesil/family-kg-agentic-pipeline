@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Humphry_Waldo_Sibthorp> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Humphry Waldo Sibthorp" ;
    onto:hasFather <http://example.org/entity/John_Sibthorpe> ;
    skos:altLabel "Humphry Sibthorp (botanist)" .

<http://example.org/entity/Christ_Church> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Christ Church, Oxford" .

<http://example.org/entity/John_Sibthorpe> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Sibthorpe" ;
    onto:hasEducatedAt <http://example.org/entity/Christ_Church> .

