@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Christ_Church> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Humphry_Waldo_Sibthorp> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/John_Sibthorpe> ;
    ex:hasParent <http://example.org/entity/John_Sibthorpe> .

<http://example.org/entity/John_Sibthorpe> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Humphry_Waldo_Sibthorp> ;
    ex:hasEducatedAt <http://example.org/entity/Christ_Church> .

