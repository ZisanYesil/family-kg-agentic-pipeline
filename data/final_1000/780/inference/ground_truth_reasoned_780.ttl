@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Christ_Church a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Humphry_Waldo_Sibthorp a ex:Agent,
        ex:Person ;
    ex:hasFather entity:John_Sibthorpe ;
    ex:hasParent entity:John_Sibthorpe .

entity:John_Sibthorpe a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Humphry_Waldo_Sibthorp ;
    ex:hasEducatedAt entity:Christ_Church .

