@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Prince_Foulques_of_Orléans_Duke_of_Aumale> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Prince Foulques of Orléans, Duke of Aumale" ;
    onto:hasFather <http://example.org/entity/Prince_Jacques_Duke_of_Orléans> .

<http://example.org/entity/Prince_Jacques_Duke_of_Orléans> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Prince Jacques of Orléans, Duke of Orléans" ;
    onto:hasMother <http://example.org/entity/Princess_Isabelle_of_Orléans_Braganza> .

<http://example.org/entity/Princess_Isabelle_of_Orléans_Braganza> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Princess Isabelle of Orléans-Braganza" .

