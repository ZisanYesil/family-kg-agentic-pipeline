@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:sean_sogliano a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sean Sogliano" ;
    onto:hasFather data:riccardo_sogliano .

data:alessandria a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Alessandria" .

data:riccardo_sogliano a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Riccardo Sogliano" ;
    onto:hasBirthPlace data:alessandria .

