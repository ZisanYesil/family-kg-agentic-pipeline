@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Sean_Luca_Sogliano> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sean Sogliano" ;
    onto:hasFather <http://example.org/entity/Riccardo_Sogliano> .

<http://example.org/entity/Alessandria> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Alessandria" .

<http://example.org/entity/Riccardo_Sogliano> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Riccardo Sogliano" ;
    onto:hasBirthPlace <http://example.org/entity/Alessandria> .

