@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Alessandria> a ex:Place .

<http://example.org/entity/Sean_Luca_Sogliano> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Riccardo_Sogliano> ;
    ex:hasParent <http://example.org/entity/Riccardo_Sogliano> .

<http://example.org/entity/Riccardo_Sogliano> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Alessandria> ;
    ex:hasChild <http://example.org/entity/Sean_Luca_Sogliano> .

