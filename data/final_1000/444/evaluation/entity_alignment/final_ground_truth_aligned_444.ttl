@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Akbank a ex:Agent,
        ex:Organization ;
    ex:hasInception "1948"^^xsd:gYear .

entity:Up_Tied a ex:Agent,
        ex:Organization ;
    ex:hasInception "1968"^^xsd:gYear .

