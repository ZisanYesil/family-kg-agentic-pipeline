@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:akbank a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Akbank" ;
    onto:hasInception "1948"^^xsd:gYear .

data:up_tied a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Up Tied" ;
    onto:hasInception "1968"^^xsd:gYear .

