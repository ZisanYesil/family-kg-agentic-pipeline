@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/La_Estancia_de_gaucho_Cruz> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "La Estancia de gaucho Cruz" ;
    onto:hasDirector <http://example.org/entity/Leopoldo_Torres_Rios> .

<http://example.org/entity/Leopoldo_Torre_Nilsson> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Leopoldo Torre Nilsson" .

<http://example.org/entity/Leopoldo_Torres_Rios> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Leopoldo Torres Rios" ;
    onto:hasSon <http://example.org/entity/Leopoldo_Torre_Nilsson> .

