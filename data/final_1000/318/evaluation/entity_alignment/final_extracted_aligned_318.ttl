@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/La_Estancia_de_gaucho_Cruz> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Leopoldo_Torres_Rios> ;
    ex:hasDirector <http://example.org/entity/Leopoldo_Torres_Rios> .

<http://example.org/entity/Leopoldo_Torre_Nilsson> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/entity/Leopoldo_Torres_Rios> ;
    ex:isSonOf <http://example.org/entity/Leopoldo_Torres_Rios> .

<http://example.org/entity/Leopoldo_Torres_Rios> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Leopoldo_Torre_Nilsson> ;
    ex:hasSon <http://example.org/entity/Leopoldo_Torre_Nilsson> .

