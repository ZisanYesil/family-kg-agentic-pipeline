@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:La_Estancia_de_gaucho_Cruz a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Leopoldo_Torres_Rios ;
    ex:hasDirector entity:Leopoldo_Torres_Rios .

entity:Leopoldo_Torre_Nilsson a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Leopoldo_Torres_Rios .

entity:Leopoldo_Torres_Rios a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Leopoldo_Torre_Nilsson .

