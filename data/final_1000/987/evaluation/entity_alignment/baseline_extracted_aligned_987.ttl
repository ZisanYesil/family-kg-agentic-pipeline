@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Glimpses_Impressions> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Glimpses/Impressions" ;
    onto:hasDirector <http://example.org/entity/Jean_François_Pouliot> .

data:organization_cossette_communication_marketing a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Cossette Communication Marketing" ;
    onto:hasMember <http://example.org/entity/Jean_François_Pouliot> .

<http://example.org/entity/Jean_François_Pouliot> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jean-François Pouliot" .

