@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:esme_stewart_3rd_duke_of_lennox a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Esmé Stewart, 3rd Duke of Lennox" ;
    onto:hasFather data:esme_stewart_1st_duke_of_lennox .

data:anne_de_la_queuille a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Anne de la Queuille" .

data:esme_stewart_1st_duke_of_lennox a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Esmé Stewart, 1st Duke of Lennox" ;
    onto:hasMother data:anne_de_la_queuille .

