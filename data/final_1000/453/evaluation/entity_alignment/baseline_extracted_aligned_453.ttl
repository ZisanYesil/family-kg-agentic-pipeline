@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Esmé_Stewart_3rd_Duke_of_Lennox> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Esmé Stewart, 3rd Duke of Lennox" ;
    onto:hasFather <http://example.org/entity/Esmé_Stewart_1st_Duke_of_Lennox> .

<http://example.org/entity/Anne_de_la_Queuille> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Anne de la Queuille" .

<http://example.org/entity/Esmé_Stewart_1st_Duke_of_Lennox> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Esmé Stewart, 1st Duke of Lennox" ;
    onto:hasMother <http://example.org/entity/Anne_de_la_Queuille> .

