@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Varnyathil_Aashanka> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Sidharth_Bharathan> ;
    ex:hasDirector <http://example.org/entity/Sidharth_Bharathan> .

<http://example.org/entity/K_P_A_C_Lalitha> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Sidharth_Bharathan> .

<http://example.org/entity/Sidharth_Bharathan> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/K_P_A_C_Lalitha> ;
    ex:hasParent <http://example.org/entity/K_P_A_C_Lalitha> .

