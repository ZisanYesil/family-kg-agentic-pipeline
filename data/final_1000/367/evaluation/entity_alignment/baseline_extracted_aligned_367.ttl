@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Varnyathil_Aashanka> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Varnyathil Aashanka" ;
    onto:hasDirector <http://example.org/entity/Sidharth_Bharathan> .

<http://example.org/entity/K_P_A_C_Lalitha> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "K. P. A. C. Lalitha" .

<http://example.org/entity/Sidharth_Bharathan> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sidharth Bharathan" ;
    onto:hasMother <http://example.org/entity/K_P_A_C_Lalitha> .

