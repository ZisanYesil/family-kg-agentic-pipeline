@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Escape_to_Danger> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Escape to Danger" ;
    onto:hasPublicationDate "1943"^^xsd:gYear .

<http://example.org/entity/Two_Can_Play> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Two Can Play" ;
    onto:hasPublicationDate "1926"^^xsd:gYear .

