@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Escape_to_Danger> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasPublicationDate "1943"^^xsd:gYear .

<http://example.org/entity/Two_Can_Play> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasPublicationDate "1926"^^xsd:gYear .

