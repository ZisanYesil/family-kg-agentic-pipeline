@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:escape_to_danger_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Escape to Danger" ;
    onto:hasPublicationDate "1943"^^xsd:gYear .

data:two_can_play_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Two Can Play" ;
    onto:hasPublicationDate "1926"^^xsd:gYear .

