@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Show_da_World> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Show da World" ;
    onto:hasPerformer <http://example.org/entity/Lil_Boosie> .

<http://example.org/entity/Baton_Rouge> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Baton Rouge, Louisiana" .

<http://example.org/entity/Lil_Boosie> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Boosie Badazz" ;
    onto:hasBirthPlace <http://example.org/entity/Baton_Rouge> ;
    skos:altLabel "Lil Boosie",
        "Torrence Hatch Jr." .

