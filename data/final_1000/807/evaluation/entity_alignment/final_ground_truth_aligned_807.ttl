@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Show_da_World a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Lil_Boosie ;
    ex:hasPerformer entity:Lil_Boosie .

entity:Baton_Rouge a ex:Place .

entity:Lil_Boosie a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Baton_Rouge .

