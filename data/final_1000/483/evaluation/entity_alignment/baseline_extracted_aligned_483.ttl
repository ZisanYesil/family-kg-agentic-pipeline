@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/José_González_Ganoza> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "José González Ganoza" ;
    onto:hasBirthDate "1954-07-10"^^xsd:date ;
    onto:hasDeathDate "1987-12-08"^^xsd:date .

<http://example.org/entity/Sir_Walter_Boyd_1st_Baronet> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sir Walter Boyd, 1st Baronet" ;
    onto:hasBirthDate "1833-01-28"^^xsd:date ;
    onto:hasDeathDate "1918-06-25"^^xsd:date .

