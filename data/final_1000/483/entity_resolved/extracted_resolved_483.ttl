@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:jose_gonzalez_ganoza a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "José González Ganoza" ;
    onto:hasBirthDate "1954-07-10"^^xsd:date ;
    onto:hasDeathDate "1987-12-08"^^xsd:date .

data:sir_walter_boyd_1st_baronet a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sir Walter Boyd, 1st Baronet" ;
    onto:hasBirthDate "1833-01-28"^^xsd:date ;
    onto:hasDeathDate "1918-06-25"^^xsd:date .

