@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Hennessy_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Hennessy" ;
    onto:hasDirector <http://example.org/entity/Don_Sharp> .

<http://example.org/entity/Trouble_in_the_Glen> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Trouble in the Glen" ;
    onto:hasDirector <http://example.org/entity/Herbert_Wilcox> .

<http://example.org/entity/Don_Sharp> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Don Sharp" ;
    onto:hasNationality <http://example.org/entity/British> ;
    skos:altLabel "Donald Herman Sharp" .

<http://example.org/entity/Herbert_Wilcox> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Herbert Wilcox" ;
    onto:hasNationality <http://example.org/entity/British> ;
    skos:altLabel "Herbert Sydney Wilcox" .

<http://example.org/entity/British> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

