@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/_film_my_three_merry_widows> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/_person_fernando_cortes> ;
    ex:hasDirector <http://example.org/extracted/_person_fernando_cortes> .

<http://example.org/extracted/_person_maria_del_pilar_cordero> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/extracted/_person_fernando_cortes> .

<http://example.org/extracted/_person_fernando_cortes> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1909-10-04"^^xsd:date ;
    ex:hasDeathDate "1979"^^xsd:gYear ;
    ex:hasSpouse <http://example.org/extracted/_person_maria_del_pilar_cordero> .

