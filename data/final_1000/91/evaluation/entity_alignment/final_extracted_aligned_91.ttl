@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Gunsmoke> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Nathan_Juran> ;
    ex:hasDirector <http://example.org/entity/Nathan_Juran> .

<http://example.org/entity/Gura_Humorului> a ex:Place .

<http://example.org/entity/Nathan_Juran> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Gura_Humorului> .

