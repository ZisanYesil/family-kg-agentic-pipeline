@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Gunsmoke> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Gunsmoke (film)" ;
    onto:hasDirector <http://example.org/entity/Nathan_Juran> .

<http://example.org/entity/Gura_Humorului> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Gura Humorului" .

<http://example.org/entity/Nathan_Juran> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nathan Juran" ;
    onto:hasBirthPlace <http://example.org/entity/Gura_Humorului> ;
    skos:altLabel "Naftuli \"Nathan\" Hertz Juran" .

