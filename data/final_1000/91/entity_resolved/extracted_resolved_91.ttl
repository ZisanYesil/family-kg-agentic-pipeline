@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:gunsmoke_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Gunsmoke (film)" ;
    onto:hasDirector data:nathan_juran .

data:gura_humorului a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Gura Humorului" .

data:nathan_juran a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nathan Juran" ;
    onto:hasBirthPlace data:gura_humorului ;
    skos:altLabel "Naftuli \"Nathan\" Hertz Juran" .

