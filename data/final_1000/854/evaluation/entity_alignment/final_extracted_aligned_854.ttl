@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/World_and_Time_Enough> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Eric_Mueller> ;
    ex:hasDirector <http://example.org/entity/Eric_Mueller> .

<http://example.org/entity/Eric_Mueller> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/United_States> ;
    ex:hasNationality <http://example.org/entity/United_States> .

<http://example.org/entity/United_States> a ex:Country,
        ex:Place .

