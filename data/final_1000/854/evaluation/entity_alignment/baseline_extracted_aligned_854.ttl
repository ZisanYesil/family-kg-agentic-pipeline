@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/World_and_Time_Enough> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "World And Time Enough" ;
    onto:hasDirector <http://example.org/entity/Eric_Mueller> .

<http://example.org/entity/Eric_Mueller> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Eric Mueller" ;
    onto:hasNationality <http://example.org/entity/United_States> .

<http://example.org/entity/United_States> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" .

