@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:World_and_Time_Enough a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Eric_Mueller .

entity:Eric_Mueller a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:United_States .

entity:United_States a ex:Country,
        ex:Place .

