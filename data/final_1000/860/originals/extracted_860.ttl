@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_beginning_or_the_end a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Beginning or the End" ;
    onto:hasPublicationDate "1947"^^xsd:gYear .

data:film_hold_back_the_night a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Hold Back the Night" ;
    onto:hasPublicationDate "1956"^^xsd:gYear .

