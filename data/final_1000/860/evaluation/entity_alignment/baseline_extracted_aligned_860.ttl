@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Hold_Back_the_Night> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Hold Back the Night" ;
    onto:hasPublicationDate "1956"^^xsd:gYear .

<http://example.org/entity/The_Beginning_or_the_End> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Beginning or the End" ;
    onto:hasPublicationDate "1947"^^xsd:gYear .

