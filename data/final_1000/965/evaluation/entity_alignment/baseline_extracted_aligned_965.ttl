@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Kanchana_Mendis> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Kanchana Mendis" ;
    onto:hasBirthDate "1980-06-24"^^xsd:date .

<http://example.org/entity/Morshed_Alam> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Morshed Alam" ;
    onto:hasBirthDate "1950-03-29"^^xsd:date .

