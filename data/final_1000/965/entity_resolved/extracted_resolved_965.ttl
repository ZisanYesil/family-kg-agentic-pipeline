@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:kanchana_mendis a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Kanchana Mendis" ;
    onto:hasBirthDate "1980-06-24"^^xsd:date .

data:morshed_alam a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Morshed Alam" ;
    onto:hasBirthDate "1950-03-29"^^xsd:date .

