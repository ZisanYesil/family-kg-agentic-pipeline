@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/I_Want_You> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "I Want You" ;
    onto:hasPerformer <http://example.org/entity/Shana> ;
    skos:altLabel "I Want You (Shana song)" .

<http://example.org/entity/Park_Ridge_Illinois> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Park Ridge, Illinois" .

<http://example.org/entity/Shana> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Shana Petrone" ;
    onto:hasBirthPlace <http://example.org/entity/Park_Ridge_Illinois> ;
    skos:altLabel "Shana" .

