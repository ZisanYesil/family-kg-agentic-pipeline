@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/I_Want_You> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Shana> ;
    ex:hasPerformer <http://example.org/entity/Shana> .

<http://example.org/entity/Park_Ridge_Illinois> a ex:Place .

<http://example.org/entity/Shana> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Park_Ridge_Illinois> .

