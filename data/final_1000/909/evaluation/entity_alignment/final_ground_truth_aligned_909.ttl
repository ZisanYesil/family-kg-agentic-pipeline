@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Not_of_This_Earth a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Jim_Wynorski ;
    ex:hasDirector entity:Jim_Wynorski .

entity:New_York a ex:Place .

entity:Jim_Wynorski a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:New_York .

