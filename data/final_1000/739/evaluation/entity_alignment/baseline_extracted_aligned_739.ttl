@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Jo_Jeeta_Wohi_Sikandar> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Jo Jeeta Wohi Sikandar" ;
    onto:hasDirector <http://example.org/entity/Mansoor_Khan> .

<http://example.org/entity/Filmfare_Award_for_Best_Director> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Filmfare Award for Best Director" .

<http://example.org/entity/Mansoor_Khan> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mansoor Khan" ;
    onto:hasAwardReceived <http://example.org/entity/Filmfare_Award_for_Best_Director>,
        data:award_national_film_award_best_popular_film_providing_wholesome_entertainment .

data:award_national_film_award_best_popular_film_providing_wholesome_entertainment a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "National Film Award for Best Popular Film Providing Wholesome Entertainment" .

