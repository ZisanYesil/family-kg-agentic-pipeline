@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:_ida_of_lorraine a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ida of Lorraine" ;
    onto:hasBrother data:_godfrey_iv_duke_of_lower_lorraine .

data:_godfrey_iv_duke_of_lower_lorraine a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Godfrey IV, Duke of Lower Lorraine" ;
    onto:hasSpouse data:_matilda_of_tuscany .

data:_matilda_of_tuscany a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Matilda of Tuscany" .

