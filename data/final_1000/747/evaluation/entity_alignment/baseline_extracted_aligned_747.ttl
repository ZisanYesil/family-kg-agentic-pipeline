@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Ida_of_Lorraine> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ida of Lorraine" ;
    onto:hasBrother <http://example.org/entity/Godfrey_IV_Duke_of_Lower_Lorraine> .

<http://example.org/entity/Godfrey_IV_Duke_of_Lower_Lorraine> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Godfrey IV, Duke of Lower Lorraine" ;
    onto:hasSpouse <http://example.org/entity/Matilda_of_Tuscany> .

<http://example.org/entity/Matilda_of_Tuscany> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Matilda of Tuscany" .

