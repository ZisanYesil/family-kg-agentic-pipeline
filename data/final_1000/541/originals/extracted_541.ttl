@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_drugstore_cowboy a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Drugstore Cowboy" ;
    onto:hasPublicationDate "1989"^^xsd:gYear .

data:film_when_the_sea_rises a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "When the Sea Rises" ;
    onto:hasPublicationDate "2004"^^xsd:gYear .

