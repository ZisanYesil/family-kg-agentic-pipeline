@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/michael_d_antonovich> a ex:Agent,
        ex:Person ;
    ex:hasOccupation <http://example.org/extracted/occupation_politician> .

<http://example.org/extracted/peter_mate_pop> a ex:Agent,
        ex:Person ;
    ex:hasOccupation <http://example.org/extracted/occupation_composer>,
        <http://example.org/extracted/occupation_pianist>,
        <http://example.org/extracted/occupation_pop_singer> .

<http://example.org/extracted/occupation_composer> a ex:Occupation .

<http://example.org/extracted/occupation_pianist> a ex:Occupation .

<http://example.org/extracted/occupation_politician> a ex:Occupation .

<http://example.org/extracted/occupation_pop_singer> a ex:Occupation .

