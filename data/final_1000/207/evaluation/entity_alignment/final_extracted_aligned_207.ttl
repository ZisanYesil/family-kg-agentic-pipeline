@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Michael_D_Antonovich> a ex:Agent,
        ex:Person ;
    ex:hasOccupation <http://example.org/entity/politician> .

<http://example.org/entity/Péter_Máté> a ex:Agent,
        ex:Person ;
    ex:hasOccupation <http://example.org/entity/composer>,
        <http://example.org/entity/pianist>,
        <http://example.org/entity/singer> .

<http://example.org/entity/composer> a ex:Occupation .

<http://example.org/entity/pianist> a ex:Occupation .

<http://example.org/entity/politician> a ex:Occupation .

<http://example.org/entity/singer> a ex:Occupation .

