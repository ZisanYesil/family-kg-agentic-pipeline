@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Michael_D_Antonovich a ex:Agent,
        ex:Person ;
    ex:hasOccupation entity:politician .

entity:Péter_Máté a ex:Agent,
        ex:Person ;
    ex:hasOccupation entity:composer,
        entity:pianist,
        entity:singer .

entity:composer a ex:Occupation .

entity:pianist a ex:Occupation .

entity:politician a ex:Occupation .

entity:singer a ex:Occupation .

