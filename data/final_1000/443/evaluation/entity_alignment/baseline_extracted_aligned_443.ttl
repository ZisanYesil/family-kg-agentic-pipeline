@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Family_Katta> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Family Katta" ;
    onto:hasDirector <http://example.org/entity/Chandrakant_Kulkarni> .

<http://example.org/entity/Ward_No_7> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Ward No.7" ;
    onto:hasDirector <http://example.org/entity/P_Venu> .

<http://example.org/entity/Chandrakant_Kulkarni> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Chandrakant Kulkarni" ;
    onto:hasNationality <http://example.org/entity/India> .

<http://example.org/entity/P_Venu> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "P. Venu" ;
    onto:hasNationality <http://example.org/entity/India> .

<http://example.org/entity/India> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "India" ;
    skos:altLabel "Indian" .

