@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:nevil_shute a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nevil Shute" ;
    onto:hasBirthDate "1899-01-17"^^xsd:date ;
    onto:hasDeathDate "1960-01-12"^^xsd:date .

data:pablo_riccheri a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Pablo Riccheri" ;
    onto:hasBirthDate "1859-08-08"^^xsd:date ;
    onto:hasDeathDate "1936-07-29"^^xsd:date .

