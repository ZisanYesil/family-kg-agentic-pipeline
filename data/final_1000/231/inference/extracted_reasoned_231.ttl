@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/film_diamond_head> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasComposer <http://example.org/extracted/person_john_williams> ;
    ex:hasCreator <http://example.org/extracted/person_john_williams> .

<http://example.org/extracted/country_united_states> a ex:Country,
        ex:Place .

<http://example.org/extracted/person_john_williams> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/extracted/country_united_states> ;
    ex:hasNationality <http://example.org/extracted/country_united_states> .

