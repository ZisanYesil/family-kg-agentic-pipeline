@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Diamond_Head> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasComposer <http://example.org/entity/John_Williams> ;
    ex:hasCreator <http://example.org/entity/John_Williams> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/John_Williams> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasNationality <http://example.org/entity/American> .

