@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Diamond_Head> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Diamond Head" .

<http://example.org/entity/John_Williams> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Williams" ;
    onto:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

