@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_diamond_head a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Diamond Head" ;
    onto:hasComposer data:person_john_williams .

data:country_united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

data:person_john_williams a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Williams" ;
    onto:hasNationality data:country_united_states .

