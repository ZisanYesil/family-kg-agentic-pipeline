@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Finn_Jarle_Sæle> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Finn Jarle Sæle" ;
    onto:hasSon <http://example.org/entity/Finn_Ørjan_Sæle> .

<http://example.org/entity/Finn_Ørjan_Sæle> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Finn Ørjan Sæle" .

