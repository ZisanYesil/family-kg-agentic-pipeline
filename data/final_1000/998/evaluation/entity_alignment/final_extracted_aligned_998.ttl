@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Finn_Jarle_Sæle> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Finn_Ørjan_Sæle> ;
    ex:hasSon <http://example.org/entity/Finn_Ørjan_Sæle> .

<http://example.org/entity/Finn_Ørjan_Sæle> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/entity/Finn_Jarle_Sæle> ;
    ex:isSonOf <http://example.org/entity/Finn_Jarle_Sæle> .

