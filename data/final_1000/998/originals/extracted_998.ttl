@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:finn_jarle_s%C3%A6le a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Finn Jarle Sæle" ;
    onto:hasSon data:finn_%C3%B8rjan_s%C3%A6le .

data:finn_%C3%B8rjan_s%C3%A6le a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Finn Ørjan Sæle" .

