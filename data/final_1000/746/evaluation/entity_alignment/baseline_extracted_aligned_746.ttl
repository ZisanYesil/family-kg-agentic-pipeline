@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/De_Contrabando> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "De Contrabando" ;
    onto:hasPerformer <http://example.org/entity/Jenni_Rivera> .

<http://example.org/entity/Jenni_Rivera> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jenni Rivera" ;
    onto:hasDeathPlace <http://example.org/entity/Monterrey> .

<http://example.org/entity/Monterrey> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Monterrey" .

