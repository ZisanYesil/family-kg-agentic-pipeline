@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/De_Contrabando> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Jenni_Rivera> ;
    ex:hasPerformer <http://example.org/entity/Jenni_Rivera> .

<http://example.org/entity/Monterrey> a ex:Place .

<http://example.org/entity/Jenni_Rivera> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Monterrey> .

