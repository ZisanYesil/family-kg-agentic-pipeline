@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Como_yo_te_quería> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Como yo te quería" ;
    onto:hasPublicationDate "1944"^^xsd:gYear .

<http://example.org/entity/Sex_Is_Zero_2> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Sex Is Zero 2" ;
    onto:hasPublicationDate "2007-12-12"^^xsd:date .

