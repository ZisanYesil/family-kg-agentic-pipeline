@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:infanta_maria_cristina_spain_1833 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Infanta Maria Cristina of Spain" ;
    onto:hasMother data:luisa_carlotta_bourbon_two_sicilies ;
    skos:altLabel "Maria Cristina, Infanta of Spain and Portugal" .

data:luisa_carlotta_bourbon_two_sicilies a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Princess Luisa Carlotta of Bourbon-Two Sicilies" .

