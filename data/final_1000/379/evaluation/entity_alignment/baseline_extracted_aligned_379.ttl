@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Maria_Cristina_Infanta_of_Spain> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Infanta Maria Cristina of Spain" ;
    onto:hasMother <http://example.org/entity/Princess_Luisa_Carlotta_of_Naples_and_Sicily> ;
    skos:altLabel "Maria Cristina, Infanta of Spain and Portugal" .

<http://example.org/entity/Princess_Luisa_Carlotta_of_Naples_and_Sicily> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Princess Luisa Carlotta of Bourbon-Two Sicilies" .

