@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Sarah_Sutherland> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sarah Sutherland" ;
    onto:hasFather <http://example.org/entity/Kiefer_Sutherland> .

<http://example.org/entity/Truth_or_Consequences_N_M> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Truth or Consequences, N.M." ;
    onto:hasDirector <http://example.org/entity/Kiefer_Sutherland> .

<http://example.org/entity/Kiefer_Sutherland> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Kiefer Sutherland" .

