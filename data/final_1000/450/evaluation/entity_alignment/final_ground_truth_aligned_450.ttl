@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Truth_or_Consequences_N_M a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Kiefer_Sutherland ;
