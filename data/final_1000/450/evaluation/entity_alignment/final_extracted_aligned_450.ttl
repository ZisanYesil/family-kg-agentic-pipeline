@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Truth_or_Consequences_N_M> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Kiefer_Sutherland> ;
    ex:hasDirector <http://example.org/entity/Kiefer_Sutherland> .

<http://example.org/entity/Sarah_Sutherland> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Kiefer_Sutherland> ;
    ex:hasParent <http://example.org/entity/Kiefer_Sutherland> .

<http://example.org/entity/Kiefer_Sutherland> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Sarah_Sutherland> .

