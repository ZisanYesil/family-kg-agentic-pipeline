@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:sarah_sutherland a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sarah Sutherland" ;
    onto:hasFather data:kiefer_sutherland .

data:truth_or_consequences_nm_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Truth or Consequences, N.M." ;
    onto:hasDirector data:kiefer_sutherland .

data:kiefer_sutherland a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Kiefer Sutherland" .

