@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Oh_boy_oh_boy_oh_boy a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Lasse_Dahlquist ;
    ex:hasPerformer entity:Lasse_Dahlquist .

entity:laryngeal_cancer a ex:CauseOfDeath .

entity:Lasse_Dahlquist a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath entity:laryngeal_cancer .

