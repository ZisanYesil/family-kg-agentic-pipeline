@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Oh_boy_oh_boy_oh_boy> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Oh boy, oh boy, oh boy!" ;
    onto:hasPerformer <http://example.org/entity/Lasse_Dahlquist> .

<http://example.org/entity/Lasse_Dahlquist> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lasse Dahlquist" ;
    onto:hasCauseOfDeath <http://example.org/entity/laryngeal_cancer> .

<http://example.org/entity/laryngeal_cancer> a onto:CauseOfDeath,
        owl:NamedIndividual ;
    rdfs:label "laryngeal cancer" .

