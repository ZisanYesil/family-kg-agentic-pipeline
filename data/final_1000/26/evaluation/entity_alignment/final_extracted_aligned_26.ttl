@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Oh_boy_oh_boy_oh_boy> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Lasse_Dahlquist> ;
    ex:hasPerformer <http://example.org/entity/Lasse_Dahlquist> .

<http://example.org/entity/laryngeal_cancer> a ex:CauseOfDeath .

<http://example.org/entity/Lasse_Dahlquist> a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath <http://example.org/entity/laryngeal_cancer> .

