@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Say_it_in_Russian> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Jeff_Celentano> ;
    ex:hasDirector <http://example.org/entity/Jeff_Celentano> .

<http://example.org/entity/Pemberton_New_Jersey> a ex:Place .

<http://example.org/entity/Jeff_Celentano> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Pemberton_New_Jersey> .

