@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/dawn_fraser> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1937-09-04"^^xsd:date ;
    ex:hasOccupation <http://example.org/extracted/occupation_politician>,
        <http://example.org/extracted/occupation_swimmer> .

<http://example.org/extracted/dunois_master> a ex:Agent,
        ex:Person ;
    ex:hasOccupation <http://example.org/extracted/occupation_illuminator> .

<http://example.org/extracted/occupation_illuminator> a ex:Occupation .

<http://example.org/extracted/occupation_politician> a ex:Occupation .

<http://example.org/extracted/occupation_swimmer> a ex:Occupation .

