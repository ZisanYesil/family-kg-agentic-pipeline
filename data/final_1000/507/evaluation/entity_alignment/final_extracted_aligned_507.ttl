@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Dawn_Fraser> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1937-09-04"^^xsd:date ;
    ex:hasOccupation <http://example.org/entity/politician>,
        <http://example.org/entity/swimmer> .

<http://example.org/entity/Dunois_Master> a ex:Agent,
        ex:Person ;
    ex:hasOccupation <http://example.org/entity/manuscript_illuminator> .

<http://example.org/entity/manuscript_illuminator> a ex:Occupation .

<http://example.org/entity/politician> a ex:Occupation .

<http://example.org/entity/swimmer> a ex:Occupation .

