@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:pchelovodstvo a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Pchelovodstvo" ;
    onto:hasPublicationDate "1921"^^xsd:gYear .

data:western_producer a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "The Western Producer" ;
    onto:hasPublicationDate "1924"^^xsd:gYear .

