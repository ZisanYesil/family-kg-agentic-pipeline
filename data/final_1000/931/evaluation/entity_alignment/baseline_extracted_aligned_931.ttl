@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Punyakoti> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Punyakoti" ;
    onto:hasDirector <http://example.org/entity/Ravi_Shankar> .

<http://example.org/entity/The_Company_s_in_Love> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Company's in Love" ;
    onto:hasDirector <http://example.org/entity/Max_Ophüls> .

<http://example.org/entity/Max_Ophüls> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Max Ophüls" ;
    onto:hasBirthDate "1902-05-06"^^xsd:date ;
    onto:hasDeathDate "1957-03-26"^^xsd:date ;
    skos:altLabel "Maximillian Oppenheimer" .

<http://example.org/entity/Ravi_Shankar> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ravi Shankar V" .

