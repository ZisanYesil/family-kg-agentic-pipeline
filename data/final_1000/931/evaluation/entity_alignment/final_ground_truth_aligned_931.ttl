@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Punyakoti a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Ravi_Shankar ;
    ex:hasDirector entity:Ravi_Shankar .

entity:The_Company_s_in_Love a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Max_Ophüls ;
    ex:hasDirector entity:Max_Ophüls .

entity:Max_Ophüls a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1957-03-26"^^xsd:date .

entity:Ravi_Shankar a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2012-12-11"^^xsd:date .

