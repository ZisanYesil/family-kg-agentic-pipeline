@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Punyakoti> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Ravi_Shankar> ;
    ex:hasDirector <http://example.org/entity/Ravi_Shankar> .

<http://example.org/entity/The_Company_s_in_Love> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Max_Ophüls> ;
    ex:hasDirector <http://example.org/entity/Max_Ophüls> .

<http://example.org/entity/Max_Ophüls> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1902-05-06"^^xsd:date ;
    ex:hasDeathDate "1957-03-26"^^xsd:date .

<http://example.org/entity/Ravi_Shankar> a ex:Agent,
        ex:Person .

