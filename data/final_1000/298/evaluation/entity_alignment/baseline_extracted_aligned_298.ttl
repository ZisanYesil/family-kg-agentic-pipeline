@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:reverse_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Reverse" ;
    onto:hasDirector <http://example.org/entity/Borys_Lankosz> .

<http://example.org/entity/Borys_Lankosz> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Borys Lankosz" ;
    onto:hasEducatedAt <http://example.org/entity/National_Film_School_in_Łódź> .

<http://example.org/entity/National_Film_School_in_Łódź> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "National Film School in Łódź" .

