@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:old_and_new_dreams a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Old and New Dreams" ;
    onto:hasMember data:ed_blackwell .

data:ed_blackwell a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ed Blackwell" ;
    onto:hasBirthPlace data:new_orleans_louisiana ;
    skos:altLabel "Edward Joseph Blackwell" .

data:new_orleans_louisiana a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "New Orleans, Louisiana" .

