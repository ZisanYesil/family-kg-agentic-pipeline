@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/black_birds_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasComposer <http://example.org/extracted/andjeko_klobucar> ;
    ex:hasCreator <http://example.org/extracted/andjeko_klobucar> .

<http://example.org/extracted/porin_lifetime_award> a ex:Award .

<http://example.org/extracted/vladimir_nazor_award> a ex:Award .

<http://example.org/extracted/andjeko_klobucar> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/extracted/porin_lifetime_award>,
        <http://example.org/extracted/vladimir_nazor_award> ;
    ex:hasBirthDate "1931-07-11"^^xsd:date ;
    ex:hasDeathDate "2016-08-07"^^xsd:date .

