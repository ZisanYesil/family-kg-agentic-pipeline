@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Only_When_I_Dance> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Only When I Dance" ;
    onto:hasPublicationDate "2009"^^xsd:gYear ;
    skos:altLabel "Only When I Dance" .

<http://example.org/entity/The_Wicked_Dreams_of_Paula_Schultz> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Wicked Dreams of Paula Schultz" ;
    onto:hasPublicationDate "1968"^^xsd:gYear ;
    skos:altLabel "The Wicked Dreams of Paula Schultz" .

