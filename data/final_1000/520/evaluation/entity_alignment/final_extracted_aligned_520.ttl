@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/C_Man_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Joseph_Lerner> ;
    ex:hasDirector <http://example.org/entity/Joseph_Lerner> .

<http://example.org/entity/Greencastle_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Koran_Dunbar> ;
    ex:hasDirector <http://example.org/entity/Koran_Dunbar> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/Canadian> a ex:Country,
        ex:Place .

<http://example.org/entity/Joseph_Lerner> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Canadian> ;
    ex:hasNationality <http://example.org/entity/Canadian> .

<http://example.org/entity/Koran_Dunbar> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasNationality <http://example.org/entity/American> .

