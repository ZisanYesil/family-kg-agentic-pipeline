@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/film_c_man> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/extracted/person_joseph_lerner> .

<http://example.org/extracted/film_greencastle> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/extracted/person_koran_dunbar> .

<http://example.org/extracted/country_canada> a ex:Place .

<http://example.org/extracted/country_usa> a ex:Place .

<http://example.org/extracted/person_joseph_lerner> a ex:Agent ;
    ex:hasCountry <http://example.org/extracted/country_canada> .

<http://example.org/extracted/person_koran_dunbar> a ex:Agent ;
    ex:hasCountry <http://example.org/extracted/country_usa> .

