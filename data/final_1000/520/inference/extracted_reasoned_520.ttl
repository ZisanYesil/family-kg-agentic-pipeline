@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/film_c_man> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_joseph_lerner> ;
    ex:hasDirector <http://example.org/extracted/person_joseph_lerner> .

<http://example.org/extracted/film_greencastle> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_koran_dunbar> ;
    ex:hasDirector <http://example.org/extracted/person_koran_dunbar> .

<http://example.org/extracted/country_canada> a ex:Country,
        ex:Place .

<http://example.org/extracted/country_usa> a ex:Country,
        ex:Place .

<http://example.org/extracted/person_joseph_lerner> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/extracted/country_canada> ;
    ex:hasNationality <http://example.org/extracted/country_canada> .

<http://example.org/extracted/person_koran_dunbar> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/extracted/country_usa> ;
    ex:hasNationality <http://example.org/extracted/country_usa> .

