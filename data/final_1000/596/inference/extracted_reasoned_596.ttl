@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/miljenko_hrkac> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1947-10-02"^^xsd:date ;
    ex:hasDeathDate "1978-01-11"^^xsd:date .

<http://example.org/extracted/william_chopin> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1827"^^xsd:gYear ;
    ex:hasDeathDate "1900-10-30"^^xsd:date .

