@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Miljenko_Hrkać> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Miljenko Hrkać" ;
    onto:hasBirthDate "1947-10-02"^^xsd:date ;
    onto:hasDeathDate "1978-01-11"^^xsd:date .

<http://example.org/entity/William_Chopin> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William Chopin" ;
    onto:hasBirthDate "1827"^^xsd:gYear ;
    onto:hasDeathDate "1900-10-30"^^xsd:date .

