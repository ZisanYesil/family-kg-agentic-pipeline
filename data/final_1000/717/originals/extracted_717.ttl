@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:adv_cyclist_magazine a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Adventure Cyclist magazine" ;
    onto:hasPublisher data:adv_cycling_association .

data:adv_cycling_association a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Adventure Cycling Association" ;
    onto:hasCountry data:united_states .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" .

