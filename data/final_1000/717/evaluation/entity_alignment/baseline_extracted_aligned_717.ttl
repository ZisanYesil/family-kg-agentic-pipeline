@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Adventure_Cyclist_is_an_association_magazine> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Adventure Cyclist magazine" ;
    onto:hasPublisher <http://example.org/entity/Adventure_Cycling_Association> .

<http://example.org/entity/Adventure_Cycling_Association> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Adventure Cycling Association" ;
    onto:hasCountry <http://example.org/entity/U_S> .

<http://example.org/entity/U_S> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" .

