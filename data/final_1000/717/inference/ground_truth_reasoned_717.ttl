@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Adventure_Cyclist_is_an_association_magazine a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher entity:Adventure_Cycling_Association .

entity:Adventure_Cycling_Association a ex:Agent,
        ex:Organization ;
    ex:hasCountry entity:U_S .

entity:U_S a ex:Country,
        ex:Place .

