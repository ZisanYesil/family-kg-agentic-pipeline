@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Aatma_Gowravam> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Aatma Gowravam" ;
    onto:hasProducer <http://example.org/entity/D_Madhusudhana_Rao> .

<http://example.org/entity/Vitti_Dandu> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Vitti Dandu" ;
    onto:hasProducer <http://example.org/entity/Ajay_Devgn> .

<http://example.org/entity/Ajay_Devgn> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ajay Devgn" ;
    onto:hasBirthDate "1969-04-02"^^xsd:date .

<http://example.org/entity/D_Madhusudhana_Rao> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "D. Madhusudhana Rao" ;
    onto:hasBirthDate "1917-07-27"^^xsd:date .

