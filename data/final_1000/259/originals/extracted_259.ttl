@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:aatma_gowravam_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Aatma Gowravam" ;
    onto:hasProducer data:madhusudhana_rao_person .

data:vitti_dandu_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Vitti Dandu" ;
    onto:hasProducer data:ajay_devgn_person .

data:ajay_devgn_person a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ajay Devgn" ;
    onto:hasBirthDate "1969-04-02"^^xsd:date .

data:madhusudhana_rao_person a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "D. Madhusudhana Rao" ;
    onto:hasBirthDate "1917-07-27"^^xsd:date .

