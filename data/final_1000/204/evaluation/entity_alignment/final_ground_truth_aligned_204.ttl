@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Seabiscuit_film a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Gary_Ross ;
    ex:hasDirector entity:Gary_Ross .

entity:Warn_London a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:T_Hayes_Hunter ;
    ex:hasDirector entity:T_Hayes_Hunter .

entity:Gary_Ross a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:American ;
    ex:hasCountry entity:American .

entity:T_Hayes_Hunter a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:American ;
    ex:hasCountry entity:American .

entity:American a ex:Country,
        ex:Place .

