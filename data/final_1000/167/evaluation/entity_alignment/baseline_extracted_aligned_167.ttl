@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Black_Gravel> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Black Gravel" ;
    onto:hasDirector <http://example.org/entity/Helmut_Käutner> .

<http://example.org/entity/The_Little_Napoleon> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Little Napoleon" ;
    onto:hasDirector <http://example.org/entity/Georg_Jacoby> .

<http://example.org/entity/Georg_Jacoby> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Georg Jacoby" ;
    onto:hasNationality <http://example.org/entity/Germany> .

<http://example.org/entity/Helmut_Käutner> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Helmut Käutner" ;
    onto:hasNationality <http://example.org/entity/Germany> .

<http://example.org/entity/Germany> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Germany" ;
    skos:altLabel "German" .

