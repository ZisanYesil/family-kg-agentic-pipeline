@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Black_Gravel> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Helmut_Käutner> ;
    ex:hasDirector <http://example.org/entity/Helmut_Käutner> .

<http://example.org/entity/The_Little_Napoleon> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Georg_Jacoby> ;
    ex:hasDirector <http://example.org/entity/Georg_Jacoby> .

<http://example.org/entity/Georg_Jacoby> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Germany> ;
    ex:hasNationality <http://example.org/entity/Germany> .

<http://example.org/entity/Helmut_Käutner> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Germany> ;
    ex:hasNationality <http://example.org/entity/Germany> .

<http://example.org/entity/Germany> a ex:Country,
        ex:Place .

