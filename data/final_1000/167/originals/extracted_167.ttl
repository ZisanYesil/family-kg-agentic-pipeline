@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_black_gravel a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Black Gravel" ;
    onto:hasDirector data:person_helmut_kaeutner .

data:film_the_little_napoleon a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Little Napoleon" ;
    onto:hasDirector data:person_georg_jacoby .

data:person_georg_jacoby a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Georg Jacoby" ;
    onto:hasNationality data:country_germany .

data:person_helmut_kaeutner a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Helmut Käutner" ;
    onto:hasNationality data:country_germany .

data:country_germany a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Germany" ;
    skos:altLabel "German" .

