@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Joseph_Pitton_de_Tournefort> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Joseph Pitton de Tournefort" ;
    onto:hasBirthDate "1656-06-05"^^xsd:date ;
    onto:hasDeathDate "1708-12-28"^^xsd:date .

<http://example.org/entity/Piotr_Wala> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Piotr Wala" ;
    onto:hasBirthDate "1936-12-16"^^xsd:date ;
    onto:hasDeathDate "2013-10-22"^^xsd:date .

