@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Joanna_Sophia_of_Bavaria> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Joanna Sophia of Bavaria" ;
    onto:hasSpouse <http://example.org/entity/Albert_IV_Duke_of_Austria> .

<http://example.org/entity/Albert_IV_Duke_of_Austria> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Albert IV, Duke of Austria" ;
    onto:hasBurialPlace <http://example.org/entity/Stephansdom> .

<http://example.org/entity/Stephansdom> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Ducal Crypt in the Stephansdom, Vienna" .

