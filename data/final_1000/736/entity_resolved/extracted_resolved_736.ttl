@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:men_with_brooms a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Men with Brooms" ;
    onto:hasPublicationDate "2002"^^xsd:gYear .

data:the_sleeping_tiger a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Sleeping Tiger" ;
    onto:hasPublicationDate "1954"^^xsd:gYear .

