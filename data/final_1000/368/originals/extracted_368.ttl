@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_freakdog a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Freakdog" ;
    onto:hasDirector data:person_paddy_breathnach .

data:country_ireland a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Ireland" ;
    skos:altLabel "Irish" .

data:person_paddy_breathnach a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Paddy Breathnach" ;
    onto:hasNationality data:country_ireland .

