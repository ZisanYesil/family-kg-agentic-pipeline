@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Freakdog> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Paddy_Breathnach> ;
    ex:hasDirector <http://example.org/entity/Paddy_Breathnach> .

<http://example.org/entity/Ireland> a ex:Country,
        ex:Place .

<http://example.org/entity/Paddy_Breathnach> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Ireland> ;
    ex:hasNationality <http://example.org/entity/Ireland> .

