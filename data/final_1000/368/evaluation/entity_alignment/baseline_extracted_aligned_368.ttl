@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Freakdog> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Freakdog" ;
    onto:hasDirector <http://example.org/entity/Paddy_Breathnach> .

<http://example.org/entity/Ireland> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Ireland" ;
    skos:altLabel "Irish" .

<http://example.org/entity/Paddy_Breathnach> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Paddy Breathnach" ;
    onto:hasNationality <http://example.org/entity/Ireland> .

