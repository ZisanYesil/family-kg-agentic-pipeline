@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Freakdog a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Paddy_Breathnach .

entity:Ireland a ex:Country,
        ex:Place .

entity:Paddy_Breathnach a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:Ireland .

