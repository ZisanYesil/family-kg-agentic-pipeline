@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Fraise_Tagada a ex:Artifact,
        ex:Product ;
    ex:hasManufacturer entity:Haribo .

entity:Hans_Riegel a ex:Agent .

entity:Haribo a ex:Agent,
        ex:Organization ;
    ex:hasFounder entity:Hans_Riegel .

