@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Fraise_Tagada> a ex:Artifact,
        ex:Product ;
    ex:hasManufacturer <http://example.org/entity/Haribo> .

<http://example.org/entity/Hans_Riegel> a ex:Agent,
        ex:Person .

<http://example.org/entity/Haribo> a ex:Agent,
        ex:Organization ;
    ex:hasFounder <http://example.org/entity/Hans_Riegel> .

