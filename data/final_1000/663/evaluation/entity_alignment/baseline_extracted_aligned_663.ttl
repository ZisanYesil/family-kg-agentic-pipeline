@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Tamluk_Junction_railway_station> a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Tamluk Junction railway station" ;
    onto:hasCountry <http://example.org/entity/Indian> .

<http://example.org/entity/Tauheed_railway_station> a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Tauheed railway station" ;
    onto:hasCountry <http://example.org/entity/Indian> .

<http://example.org/entity/Indian> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "India" .

