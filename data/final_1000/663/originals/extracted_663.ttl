@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:tamluk_junction_railway_station a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Tamluk Junction railway station" ;
    onto:hasCountry data:india .

data:tauheed_railway_station a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Tauheed railway station" ;
    onto:hasCountry data:india .

data:india a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "India" .

