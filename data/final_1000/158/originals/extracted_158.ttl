@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:marie_of_cleves a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Marie of Cleves" ;
    onto:hasMother data:mary_of_burgundy .

data:john_the_fearless a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John the Fearless" .

data:mary_of_burgundy a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mary of Burgundy" ;
    onto:hasFather data:john_the_fearless ;
    skos:altLabel "Marie of Burgundy, Duchess of Cleves" .

