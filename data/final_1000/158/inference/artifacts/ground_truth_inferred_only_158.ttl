@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:John_the_Fearless a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Mary_of_Burgundy_Duchess_of_Cleves .

entity:Marie_of_Burgundy a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Marie_of_Cleves_Duchess_of_Orléans .

entity:Marie_of_Cleves_Duchess_of_Orléans a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Marie_of_Burgundy .

entity:Mary_of_Burgundy_Duchess_of_Cleves a ex:Agent,
        ex:Person ;
    ex:hasParent entity:John_the_Fearless .

