@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:album_all_world_1996 a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "All World: Greatest Hits" ;
    onto:hasPublicationDate "1996-11-05"^^xsd:date .

data:album_you_say_2018 a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "You Say I'm Too Much, I Say You're Not Enough" ;
    onto:hasPublicationDate "2018-10-05"^^xsd:date .

