@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:freestylers a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Freestylers" ;
    onto:hasCountry data:united_kingdom .

data:the_nouvelles a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "The Nouvelles" ;
    onto:hasCountry data:united_kingdom .

data:united_kingdom a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

