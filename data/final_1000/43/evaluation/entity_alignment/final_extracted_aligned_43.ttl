@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Polish_Russian_War> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Xawery_Żuławski> ;
    ex:hasDirector <http://example.org/entity/Xawery_Żuławski> .

<http://example.org/entity/National_Film_School_in_Łódź> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Xawery_Żuławski> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/National_Film_School_in_Łódź> .

