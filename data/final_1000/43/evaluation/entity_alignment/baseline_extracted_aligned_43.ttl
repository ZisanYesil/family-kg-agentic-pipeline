@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Polish_Russian_War> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Polish-Russian War" ;
    onto:hasDirector <http://example.org/entity/Xawery_Żuławski> .

<http://example.org/entity/National_Film_School_in_Łódź> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "National Film School in Łódź" .

<http://example.org/entity/Xawery_Żuławski> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Xawery Żuławski" ;
    onto:hasEducatedAt <http://example.org/entity/National_Film_School_in_Łódź> .

