@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Juke_Girl a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Curtis_Bernhardt ;
    ex:hasDirector entity:Curtis_Bernhardt .

entity:Forest_Lawn_Memorial_Park a ex:Place .

entity:Curtis_Bernhardt a ex:Agent,
        ex:Person ;
    ex:hasBurialPlace entity:Forest_Lawn_Memorial_Park .

