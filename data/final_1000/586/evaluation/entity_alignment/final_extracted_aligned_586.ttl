@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Juke_Girl> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Curtis_Bernhardt> ;
    ex:hasDirector <http://example.org/entity/Curtis_Bernhardt> .

<http://example.org/entity/Forest_Lawn_Memorial_Park> a ex:Place .

<http://example.org/entity/Curtis_Bernhardt> a ex:Agent,
        ex:Person ;
    ex:hasBurialPlace <http://example.org/entity/Forest_Lawn_Memorial_Park> .

