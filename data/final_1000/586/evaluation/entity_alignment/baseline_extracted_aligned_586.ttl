@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Juke_Girl> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Juke Girl" ;
    onto:hasDirector <http://example.org/entity/Curtis_Bernhardt> .

<http://example.org/entity/Curtis_Bernhardt> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Curtis Bernhardt" ;
    onto:hasBurialPlace <http://example.org/entity/Forest_Lawn_Memorial_Park> .

<http://example.org/entity/Forest_Lawn_Memorial_Park> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Glendale's Forest Lawn Memorial Park Cemetery" ;
    skos:altLabel "Forest Lawn Memorial Park Cemetery" .

