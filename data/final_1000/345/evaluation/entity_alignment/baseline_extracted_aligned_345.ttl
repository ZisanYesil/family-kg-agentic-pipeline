@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Pleasure_1931_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Pleasure" ;
    onto:hasCountry <http://example.org/entity/American> .

<http://example.org/entity/Ten_Thousand_Dollars_for_a_Massacre> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Ten Thousand Dollars for a Massacre" ;
    onto:hasCountry <http://example.org/entity/Italian> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" .

<http://example.org/entity/Italian> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Italy" .

