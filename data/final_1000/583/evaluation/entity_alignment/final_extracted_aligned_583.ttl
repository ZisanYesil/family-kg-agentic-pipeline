@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Timothy_John_Russert> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPresenter <http://example.org/entity/Tim_Russert> .

<http://example.org/entity/Tim_Russert> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1950-05-07"^^xsd:date .

