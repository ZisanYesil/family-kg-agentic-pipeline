@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:tim_russert_talk_show a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Tim Russert (talk show)" ;
    onto:hasPresenter data:tim_russert .

data:tim_russert a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tim Russert" ;
    onto:hasBirthDate "1950-05-07"^^xsd:date .

