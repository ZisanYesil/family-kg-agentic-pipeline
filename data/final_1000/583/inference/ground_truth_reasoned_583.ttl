@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Timothy_John_Russert a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPresenter entity:Tim_Russert .

entity:Tim_Russert a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1950-05-07"^^xsd:date .

