@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/tim_russert_talk_show> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPresenter <http://example.org/extracted/tim_russert> .

<http://example.org/extracted/tim_russert> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1950-05-07"^^xsd:date .

