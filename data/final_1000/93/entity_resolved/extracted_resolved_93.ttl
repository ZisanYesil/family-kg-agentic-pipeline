@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:jack_robertson_1902 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jack Robertson" ;
    onto:hasNationality data:australia ;
    skos:altLabel "Jack Robertson (footballer, born 1902)" .

data:peter_levy a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Peter Levy" ;
    onto:hasNationality data:australia ;
    skos:altLabel "Peter Levy (cinematographer)" .

data:australia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Australia" ;
    skos:altLabel "Australian" .

