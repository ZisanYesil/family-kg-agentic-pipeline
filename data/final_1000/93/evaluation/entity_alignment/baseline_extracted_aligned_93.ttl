@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Jack_Robertson_footballer_born_1902> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jack Robertson" ;
    onto:hasNationality <http://example.org/entity/Australian> ;
    skos:altLabel "Jack Robertson (footballer, born 1902)" .

<http://example.org/entity/Peter_Levy_cinematographer> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Peter Levy" ;
    onto:hasNationality <http://example.org/entity/Australian> ;
    skos:altLabel "Peter Levy (cinematographer)" .

<http://example.org/entity/Australian> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Australia" ;
    skos:altLabel "Australian" .

