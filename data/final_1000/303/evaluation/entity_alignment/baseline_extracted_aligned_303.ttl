@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Rudolph_of_France> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Rudolph of France" ;
    onto:hasMother <http://example.org/entity/Adelaide_of_Auxerre> .

<http://example.org/entity/Adelaide_of_Auxerre> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Adelaide of Auxerre" ;
    onto:hasFather <http://example.org/entity/Conrad_II_Duke_of_Transjurane_Burgundy> .

<http://example.org/entity/Conrad_II_Duke_of_Transjurane_Burgundy> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Conrad II, Duke of Transjurane Burgundy" .

