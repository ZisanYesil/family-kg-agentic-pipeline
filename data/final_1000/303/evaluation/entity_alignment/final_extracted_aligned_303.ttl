@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Rudolph_of_France> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Adelaide_of_Auxerre> ;
    ex:hasParent <http://example.org/entity/Adelaide_of_Auxerre> .

<http://example.org/entity/Conrad_II_Duke_of_Transjurane_Burgundy> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Adelaide_of_Auxerre> .

<http://example.org/entity/Adelaide_of_Auxerre> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Rudolph_of_France> ;
    ex:hasFather <http://example.org/entity/Conrad_II_Duke_of_Transjurane_Burgundy> ;
    ex:hasParent <http://example.org/entity/Conrad_II_Duke_of_Transjurane_Burgundy> .

