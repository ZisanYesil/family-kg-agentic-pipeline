@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Qui a ex:Agent,
        ex:Organization ;
    ex:hasMember entity:David_Yow .

entity:David_Yow a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Las_Vegas_Nevada .

entity:Las_Vegas_Nevada a ex:Place .

