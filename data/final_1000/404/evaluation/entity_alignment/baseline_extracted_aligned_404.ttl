@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/David_Yow> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "David Yow" ;
    onto:hasBirthPlace <http://example.org/entity/Las_Vegas_Nevada> .

<http://example.org/entity/Las_Vegas_Nevada> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Las Vegas, Nevada" .

