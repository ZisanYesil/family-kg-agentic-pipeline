@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:david_yow a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "David Yow" ;
    onto:hasBirthPlace data:las_vegas_nevada .

data:las_vegas_nevada a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Las Vegas, Nevada" .

