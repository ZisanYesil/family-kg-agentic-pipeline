@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Mae a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Herb_Alpert ;
    ex:hasPerformer entity:Herb_Alpert .

entity:Lani_Hall a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Herb_Alpert .

entity:Herb_Alpert a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Lani_Hall .

