@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Mae> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Mae (Riz Ortolani song)" ;
    onto:hasPerformer <http://example.org/entity/Herb_Alpert> ;
    skos:altLabel "Mae" .

<http://example.org/entity/Herb_Alpert> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Herb Alpert" ;
    onto:hasSpouse <http://example.org/entity/Lani_Hall> ;
    skos:altLabel "Herb Alpert" .

<http://example.org/entity/Lani_Hall> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lani Hall" ;
    skos:altLabel "Lani Hall" .

