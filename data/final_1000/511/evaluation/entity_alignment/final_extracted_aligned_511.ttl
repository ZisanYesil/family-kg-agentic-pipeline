@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Mae> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Herb_Alpert> ;
    ex:hasPerformer <http://example.org/entity/Herb_Alpert> .

<http://example.org/entity/Lani_Hall> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Herb_Alpert> .

<http://example.org/entity/Herb_Alpert> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Lani_Hall> .

