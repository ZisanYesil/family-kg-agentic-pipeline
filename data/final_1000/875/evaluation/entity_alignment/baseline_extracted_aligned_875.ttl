@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Grimoald_II_died_714_called_the_Younger> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Grimoald the Younger" ;
    onto:hasFather <http://example.org/entity/Pepin_of_Herstal> ;
    skos:altLabel "Grimoald II" .

<http://example.org/entity/Ansegisel> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ansegisel" .

<http://example.org/entity/Pepin_of_Herstal> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Pepin of Herstal" ;
    onto:hasFather <http://example.org/entity/Ansegisel> ;
    skos:altLabel "Pepin II" .

