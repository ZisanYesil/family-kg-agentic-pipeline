@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Pugachev> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Pugachev" ;
    onto:hasDirector <http://example.org/entity/Aleksei_Saltykov> ;
    onto:hasPublicationDate "1978"^^xsd:gYear .

<http://example.org/entity/Aleksei_Saltykov> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Aleksei Saltykov" ;
    onto:hasAwardReceived <http://example.org/entity/People_s_Artist_of_the_RSFSR> ;
    skos:altLabel "Aleksey Aleksandrovich Saltykov",
        "Alexey Saltykov" .

<http://example.org/entity/People_s_Artist_of_the_RSFSR> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "People's Artist of the RSFSR" .

