@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Pugachev> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Aleksei_Saltykov> ;
    ex:hasDirector <http://example.org/entity/Aleksei_Saltykov> ;
    ex:hasPublicationDate "1978"^^xsd:gYear .

<http://example.org/entity/People_s_Artist_of_the_RSFSR> a ex:Award .

<http://example.org/entity/Aleksei_Saltykov> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/entity/People_s_Artist_of_the_RSFSR> .

