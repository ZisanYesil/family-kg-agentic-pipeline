@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Kalavar_King> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Kalavar King" ;
    onto:hasPublicationDate "2010-02-26"^^xsd:date .

<http://example.org/entity/Ogro> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Operación Ogro" ;
    onto:hasPublicationDate "1979"^^xsd:gYear .

