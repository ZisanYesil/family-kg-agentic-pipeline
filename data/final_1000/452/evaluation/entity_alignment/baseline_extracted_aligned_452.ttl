@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Ripkin> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Ripkin" ;
    onto:hasDirector <http://example.org/entity/Frank_Arnold> .

<http://example.org/entity/This_Man_Is_Mine_1934_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "This Man Is Mine (1934 film)" ;
    onto:hasDirector <http://example.org/entity/John_Cromwell> .

<http://example.org/entity/Frank_Arnold> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Frank Arnold" ;
    onto:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/John_Cromwell> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Cromwell" ;
    onto:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

