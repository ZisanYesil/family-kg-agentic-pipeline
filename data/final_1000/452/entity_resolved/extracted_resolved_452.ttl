@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:ripkin_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Ripkin" ;
    onto:hasDirector data:frank_arnold .

data:this_man_is_mine_1934_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "This Man Is Mine (1934 film)" ;
    onto:hasDirector data:john_cromwell .

data:frank_arnold a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Frank Arnold" ;
    onto:hasNationality data:united_states .

data:john_cromwell a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Cromwell" ;
    onto:hasNationality data:united_states .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

