@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:murder_tomorrow_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Murder Tomorrow" ;
    onto:hasPublicationDate "1938"^^xsd:gYear .

data:to_grab_the_ring_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "To Grab the Ring" ;
    onto:hasPublicationDate "1968"^^xsd:gYear .

