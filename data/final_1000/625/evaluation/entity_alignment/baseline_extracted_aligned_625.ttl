@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Murder_Tomorrow> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Murder Tomorrow" ;
    onto:hasPublicationDate "1938"^^xsd:gYear .

<http://example.org/entity/To_Grab_the_Ring> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "To Grab the Ring" ;
    onto:hasPublicationDate "1968"^^xsd:gYear .

