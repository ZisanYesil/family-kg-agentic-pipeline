@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Jan_Karol_Opaliński> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jan Karol Opaliński" ;
    onto:hasFather <http://example.org/entity/Krzysztof_Opaliński> .

<http://example.org/entity/Krzysztof_Opaliński> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Krzysztof Opaliński" ;
    onto:hasNationality <http://example.org/entity/Polish_Lithuanian_Commonwealth> .

<http://example.org/entity/Polish_Lithuanian_Commonwealth> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Poland" ;
    skos:altLabel "Polish" .

