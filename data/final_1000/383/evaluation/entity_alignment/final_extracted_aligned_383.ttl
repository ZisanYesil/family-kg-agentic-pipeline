@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Vai_viegli_būt_jaunam> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Juris_Podnieks> ;
