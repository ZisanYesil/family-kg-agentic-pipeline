@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Vai_viegli_būt_jaunam> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Is It Easy To Be Young?" ;
    onto:hasDirector <http://example.org/entity/Juris_Podnieks> ;
    skos:altLabel "Vai viegli būt jaunam?" .

<http://example.org/entity/Juris_Podnieks> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Juris Podnieks" ;
    onto:hasEducatedAt <http://example.org/entity/VGIK> .

<http://example.org/entity/VGIK> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Soviet VGIK film school" ;
    skos:altLabel "VGIK film school" .

