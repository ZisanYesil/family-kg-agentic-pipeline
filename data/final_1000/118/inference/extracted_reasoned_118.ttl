@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/ruffine_tsiranana> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/extracted/justine_tsiranana> ;
    ex:hasParent <http://example.org/extracted/justine_tsiranana> .

<http://example.org/extracted/justine_tsiranana> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/extracted/ruffine_tsiranana> ;
    ex:hasDeathDate "1999-07-01"^^xsd:date .

