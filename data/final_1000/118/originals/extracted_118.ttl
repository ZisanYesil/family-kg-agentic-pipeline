@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:ruffine_tsiranana a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ruffine Tsiranana" ;
    onto:hasMother data:justine_tsiranana .

data:justine_tsiranana a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Justine Tsiranana" ;
    onto:hasDeathDate "1999-07-01"^^xsd:date ;
    skos:altLabel "Justine Kalotody" .

