@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Ruffine_Tsiranana> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ruffine Tsiranana" ;
    onto:hasMother <http://example.org/entity/Justine_Tsiranana> .

<http://example.org/entity/Justine_Tsiranana> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Justine Tsiranana" ;
    onto:hasDeathDate "1999-07-01"^^xsd:date ;
    skos:altLabel "Justine Kalotody" .

