@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Ruffine_Tsiranana> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Justine_Tsiranana> ;
    ex:hasParent <http://example.org/entity/Justine_Tsiranana> .

<http://example.org/entity/Justine_Tsiranana> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Ruffine_Tsiranana> ;
    ex:hasDeathDate "1999-07-01"^^xsd:date .

