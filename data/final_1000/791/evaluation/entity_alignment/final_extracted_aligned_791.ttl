@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/The_Famous_Mrs_Fair> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/Louis_B_Mayer> .

<http://example.org/entity/The_Flame_Barrier> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/Arthur_Gardner> .

<http://example.org/entity/Arthur_Gardner> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1910-06-07"^^xsd:date ;
    ex:hasDeathDate "2014-12-19"^^xsd:date .

<http://example.org/entity/Louis_B_Mayer> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1884-07-12"^^xsd:date ;
    ex:hasDeathDate "1957-10-29"^^xsd:date .

