@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:shriro a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Shriro" ;
    onto:hasInception "1906"^^xsd:gYear .

data:tj_ryan_foundation a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "TJ Ryan Foundation" ;
    onto:hasInception "2012-05-04"^^xsd:date .

