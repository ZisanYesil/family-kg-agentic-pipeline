@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/duel_of_champions> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/extracted/italy> ;
    ex:hasCountryOfOrigin <http://example.org/extracted/italy> .

<http://example.org/extracted/tarzan_ape_man_1932> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/extracted/united_states> ;
    ex:hasCountryOfOrigin <http://example.org/extracted/united_states> .

<http://example.org/extracted/italy> a ex:Country,
        ex:Place .

