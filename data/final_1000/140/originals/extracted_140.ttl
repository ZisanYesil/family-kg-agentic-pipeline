@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:duel_of_champions a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Duel of Champions" ;
    onto:hasCountryOfOrigin data:italy .

data:tarzan_ape_man_1932 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Tarzan the Ape Man (1932 film)" ;
    onto:hasCountryOfOrigin data:united_states .

data:italy a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Italy" ;
    skos:altLabel "Italian" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

