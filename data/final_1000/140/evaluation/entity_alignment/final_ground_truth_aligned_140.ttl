@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Duel_of_Champions a ex:Artifact ;
    ex:hasCountry entity:Italian ;
    ex:hasCountryOfOrigin entity:Italian .

entity:Tarzan_the_Ape_Man_1932_film a ex:Artifact ;
    ex:hasCountry entity:American ;
    ex:hasCountryOfOrigin entity:American .

entity:American a ex:Country,
        ex:Place .

entity:Italian a ex:Country,
        ex:Place .

