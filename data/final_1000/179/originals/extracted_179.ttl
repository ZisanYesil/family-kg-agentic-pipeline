@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:person_johann_georg_tralles a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Johann Georg Tralles" ;
    onto:hasBirthDate "1763-10-15"^^xsd:date ;
    onto:hasDeathDate "1822-11-19"^^xsd:date ;
    skos:altLabel "Johann Georg Tralles" .

data:person_raymond_adolphe_sere_de_rivieres a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Raymond Adolphe Séré de Rivières" ;
    onto:hasBirthDate "1815-05-20"^^xsd:date ;
    onto:hasDeathDate "1895-02-16"^^xsd:date ;
    skos:altLabel "Raymond Adolphe Séré de Rivières" .

