@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Johann_Georg_Tralles> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Johann Georg Tralles" ;
    onto:hasBirthDate "1763-10-15"^^xsd:date ;
    onto:hasDeathDate "1822-11-19"^^xsd:date ;
    skos:altLabel "Johann Georg Tralles" .

<http://example.org/entity/Raymond_Adolphe_Séré_de_Rivières> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Raymond Adolphe Séré de Rivières" ;
    onto:hasBirthDate "1815-05-20"^^xsd:date ;
    onto:hasDeathDate "1895-02-16"^^xsd:date ;
    skos:altLabel "Raymond Adolphe Séré de Rivières" .

