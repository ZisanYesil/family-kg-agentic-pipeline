@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/inthaphom> a ex:Agent ;
    ex:hasParent <http://example.org/extracted/inthasom> .

<http://example.org/extracted/kingkitsarat> a ex:Agent ;
    ex:hasSibling <http://example.org/extracted/inthasom> ;
    ex:isBrotherOf <http://example.org/extracted/inthasom> .

<http://example.org/extracted/inthasom> a ex:Agent ;
    ex:hasChild <http://example.org/extracted/inthaphom> ;
    ex:hasSibling <http://example.org/extracted/kingkitsarat> .

