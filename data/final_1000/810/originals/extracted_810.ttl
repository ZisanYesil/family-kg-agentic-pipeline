@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:caroline_kennedy a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Caroline Bouvier Kennedy" ;
    onto:hasMother data:jacqueline_kennedy_onassis .

data:jacqueline_kennedy_onassis a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jacqueline Lee Kennedy Onassis" ;
    onto:hasBirthPlace data:southampton_new_york ;
    skos:altLabel "Jacqueline Bouvier Kennedy" .

data:southampton_new_york a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Southampton, New York" .

