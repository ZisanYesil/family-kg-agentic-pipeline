@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Junkin_with_Val_and_Dave a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Dave_Bird .

entity:Dave_Bird a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Gloucester .

entity:Gloucester a ex:Place .

