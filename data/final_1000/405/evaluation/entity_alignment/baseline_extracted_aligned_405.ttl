@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Junkin_with_Val_and_Dave> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Junkin' with Val and Dave" ;
    onto:hasCreator <http://example.org/entity/Dave_Bird> .

<http://example.org/entity/Dave_Bird> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Dave Bird" ;
    skos:altLabel "David Alan \"Dave\" Bird" .

