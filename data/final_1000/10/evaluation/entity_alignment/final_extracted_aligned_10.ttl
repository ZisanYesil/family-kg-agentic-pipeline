@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/List_of_The_Dillinger_Escape_Plan_band_members> a ex:Agent,
        ex:Organization ;
    ex:hasMember <http://example.org/entity/Ben_Weinman> .

<http://example.org/entity/Ben_Weinman> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1975-08-08"^^xsd:date .

