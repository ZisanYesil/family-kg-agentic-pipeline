@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:organization_the_dillinger_escape_plan a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "The Dillinger Escape Plan" ;
    onto:hasMember data:person_benjamin_weinman .

data:person_benjamin_weinman a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Benjamin Weinman" ;
    onto:hasBirthDate "1975-08-08"^^xsd:date ;
    skos:altLabel "Ben Weinman",
        "Benjamin A. Weinman" .

