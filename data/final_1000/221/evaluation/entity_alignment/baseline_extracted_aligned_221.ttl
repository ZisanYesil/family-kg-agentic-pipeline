@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Horror_Story_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Horror Story" ;
    onto:hasPublicationDate "2013-09-13"^^xsd:date .

<http://example.org/entity/The_Heat_s_On> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Heat's On" ;
    onto:hasPublicationDate "1943"^^xsd:gYear .

