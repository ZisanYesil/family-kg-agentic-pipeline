@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_heat_on a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Heat's On" ;
    onto:hasPublicationDate "1943"^^xsd:gYear .

data:film_horror_story a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Horror Story" ;
    onto:hasPublicationDate "2013-09-13"^^xsd:date .

