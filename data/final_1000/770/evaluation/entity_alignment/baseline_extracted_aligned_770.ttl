@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Blockade_1938_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Blockade (1938 film)" ;
    onto:hasDirector <http://example.org/entity/William_Dieterle> .

<http://example.org/entity/Woman_in_the_River> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Woman in the River" ;
    onto:hasDirector <http://example.org/entity/Gerhard_Lamprecht> .

<http://example.org/entity/Gerhard_Lamprecht> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gerhard Lamprecht" ;
    onto:hasNationality <http://example.org/entity/German> .

<http://example.org/entity/William_Dieterle> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William Dieterle" ;
    onto:hasNationality <http://example.org/entity/German> .

<http://example.org/entity/German> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Germany" ;
    skos:altLabel "German" .

