@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Gisela_of_Hungary> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gisela of Hungary" ;
    onto:hasSpouse <http://example.org/entity/Stephen_I_of_Hungary> .

<http://example.org/entity/Sarolt> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sarolt" .

<http://example.org/entity/Stephen_I_of_Hungary> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Stephen I of Hungary" ;
    onto:hasMother <http://example.org/entity/Sarolt> .

