@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Gisela_of_Hungary> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Stephen_I_of_Hungary> .

<http://example.org/entity/Sarolt> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Stephen_I_of_Hungary> .

<http://example.org/entity/Stephen_I_of_Hungary> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Sarolt> ;
    ex:hasParent <http://example.org/entity/Sarolt> ;
    ex:hasSpouse <http://example.org/entity/Gisela_of_Hungary> .

