@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Gisela_of_Hungary a ex:Agent,
        ex:Person .

entity:Sarolt a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Stephen_I_of_Hungary .

entity:Stephen_I_of_Hungary a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Sarolt ;
    ex:hasSpouse entity:Gisela_of_Hungary .

