@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:gisela_of_hungary a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gisela of Hungary" ;
    onto:hasSpouse data:stephen_i_of_hungary .

data:sarolt a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sarolt" .

data:stephen_i_of_hungary a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Stephen I of Hungary" ;
    onto:hasMother data:sarolt .

