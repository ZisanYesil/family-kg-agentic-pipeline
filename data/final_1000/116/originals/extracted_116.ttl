@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:collector_2002 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Collector (2002 film)" ;
    onto:hasCountry data:canada .

data:gulistan_land_of_roses a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Gulîstan, Land Of Roses" .

data:canada a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" ;
    skos:altLabel "Canadian" .

