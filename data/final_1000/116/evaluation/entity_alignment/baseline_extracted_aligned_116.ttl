@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Gulîstan_Land_of_Roses> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Gulîstan, Land Of Roses" .

<http://example.org/entity/The_Collector_2002_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Collector (2002 film)" ;
    onto:hasCountry <http://example.org/entity/Canadian> .

<http://example.org/entity/Canadian> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" ;
    skos:altLabel "Canadian" .

