@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Falling> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Falling (Bruce Guthro song)" ;
    onto:hasPerformer <http://example.org/entity/Bruce_Guthro> .

<http://example.org/entity/Bruce_Guthro> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bruce Guthro" ;
    onto:hasBirthPlace <http://example.org/entity/Cape_Breton_Island> ;
    skos:altLabel "Bruce Gouthro" .

<http://example.org/entity/Cape_Breton_Island> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Cape Breton Island, Nova Scotia" .

