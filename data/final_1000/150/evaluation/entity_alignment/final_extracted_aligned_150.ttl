@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Falling> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Bruce_Guthro> ;
    ex:hasPerformer <http://example.org/entity/Bruce_Guthro> .

<http://example.org/entity/Cape_Breton_Island> a ex:Place .

<http://example.org/entity/Bruce_Guthro> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Cape_Breton_Island> .

