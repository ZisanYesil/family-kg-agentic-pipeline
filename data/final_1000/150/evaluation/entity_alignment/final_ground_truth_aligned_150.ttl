@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Falling a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Bruce_Guthro ;
    ex:hasPerformer entity:Bruce_Guthro .

entity:Cape_Breton_Island a ex:Place .

entity:Bruce_Guthro a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Cape_Breton_Island .

