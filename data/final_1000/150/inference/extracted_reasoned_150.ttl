        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/extracted/bruce_guthro> ;
    ex:hasPerformer <http://example.org/extracted/bruce_guthro> .

<http://example.org/extracted/cape_breton> a ex:Place .

