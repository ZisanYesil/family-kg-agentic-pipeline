@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Emmy_of_Stork_s_Nest> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Emmy of Stork's Nest" ;
    onto:hasPublicationDate "1915"^^xsd:gYear .

<http://example.org/entity/Indira_Vizha> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Indira Vizha" ;
    onto:hasPublicationDate "2009-07-10"^^xsd:date .

