@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:emmy_of_storks_nest a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Emmy of Stork's Nest" ;
    onto:hasPublicationDate "1915"^^xsd:gYear .

data:indira_vizha a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Indira Vizha" ;
    onto:hasPublicationDate "2009-07-10"^^xsd:date .

