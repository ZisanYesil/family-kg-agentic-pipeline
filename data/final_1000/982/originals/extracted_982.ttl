@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_strange_boarders a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Strange Boarders" ;
    onto:hasDirector data:person_herbert_mason .

data:person_herbert_mason a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Herbert Mason" ;
    skos:altLabel "Samuel George Herbert Mason" .

