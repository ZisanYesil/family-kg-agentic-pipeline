@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Strange_Boarders> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Strange Boarders" ;
    onto:hasDirector <http://example.org/entity/Herbert_Mason> .

<http://example.org/entity/Herbert_Mason> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Herbert Mason" ;
    skos:altLabel "Samuel George Herbert Mason" .

