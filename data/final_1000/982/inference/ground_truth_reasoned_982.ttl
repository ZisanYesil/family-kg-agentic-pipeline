@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Strange_Boarders a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Herbert_Mason ;
    ex:hasDirector entity:Herbert_Mason .

entity:Birmingham a ex:Place .

entity:Herbert_Mason a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Birmingham .

