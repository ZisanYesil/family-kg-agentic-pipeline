@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_stolen_identity> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_gunther_von_fritsch> ;
    ex:hasDirector <http://example.org/extracted/person_gunther_von_fritsch> .

<http://example.org/extracted/film_them> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_gordon_douglas> ;
    ex:hasDirector <http://example.org/extracted/person_gordon_douglas> .

<http://example.org/extracted/person_gordon_douglas> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1907-12-15"^^xsd:date .

<http://example.org/extracted/person_gunther_von_fritsch> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1906-07-15"^^xsd:date .

