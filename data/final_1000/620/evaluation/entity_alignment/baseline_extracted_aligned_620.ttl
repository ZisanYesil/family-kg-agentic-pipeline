@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Columbia_Montour_Area_Vocational_Technical_School> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Columbia-Montour Area Vocational-Technical School" ;
    onto:hasCountry <http://example.org/entity/United_States> ;
    skos:altLabel "Columbia-Montour Area Vocational-Technical School" .

<http://example.org/entity/St_Patrick_s_High_School_Ottawa> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "St. Patrick's High School (Ottawa)" ;
    onto:hasCountry <http://example.org/entity/Canada> ;
    skos:altLabel "St. Patrick's High School (Ottawa)" .

<http://example.org/entity/Canada> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" ;
    skos:altLabel "Canada" .

<http://example.org/entity/United_States> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "United States" .

