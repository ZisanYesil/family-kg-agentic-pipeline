@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:columbia_montour a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Columbia-Montour Area Vocational-Technical School" ;
    onto:hasCountry data:united_states ;
    skos:altLabel "Columbia-Montour Area Vocational-Technical School" .

data:st_patricks_ottawa a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "St. Patrick's High School (Ottawa)" ;
    onto:hasCountry data:canada ;
    skos:altLabel "St. Patrick's High School (Ottawa)" .

data:canada a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" ;
    skos:altLabel "Canada" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "United States" .

