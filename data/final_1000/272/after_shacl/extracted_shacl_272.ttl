@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:occ a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Osborne Computer Corporation" ;
    onto:hasFounder data:adam_osborne .

data:thailand a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Thailand" .

data:adam_osborne a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Adam Osborne" .

