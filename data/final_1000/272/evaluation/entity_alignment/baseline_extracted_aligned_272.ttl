@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Osborne_Computer_Corporation> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Osborne Computer Corporation" ;
    onto:hasFounder <http://example.org/entity/Adam_Osborne> .

data:thailand a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Thailand" .

<http://example.org/entity/Adam_Osborne> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Adam Osborne" .

