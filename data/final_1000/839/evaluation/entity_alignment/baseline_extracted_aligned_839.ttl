@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Crossbones> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Crossbones (TV series)" ;
    onto:hasCreator <http://example.org/entity/Neil_Cross> .

<http://example.org/entity/British> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

<http://example.org/entity/Neil_Cross> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Neil Cross" ;
    onto:hasNationality <http://example.org/entity/British> .

