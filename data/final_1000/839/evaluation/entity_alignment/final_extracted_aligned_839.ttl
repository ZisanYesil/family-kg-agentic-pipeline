@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Crossbones> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Neil_Cross> .

<http://example.org/entity/Neil_Cross> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/British> ;
    ex:hasNationality <http://example.org/entity/British> .

<http://example.org/entity/British> a ex:Country,
        ex:Place .

