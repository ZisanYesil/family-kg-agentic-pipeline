@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:crossbones_tv_series a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Crossbones (TV series)" ;
    onto:hasCreator data:neil_cross .

data:neil_cross a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Neil Cross" ;
    onto:hasNationality data:united_kingdom .

data:united_kingdom a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

