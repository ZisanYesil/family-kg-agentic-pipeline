@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Wallace> a ex:Place .

<http://example.org/entity/Hubert_Horatio_Skip_Humphrey> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/entity/Hubert_Humphrey> ;
    ex:isSonOf <http://example.org/entity/Hubert_Humphrey> .

<http://example.org/entity/Hubert_Humphrey> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Wallace> ;
    ex:hasChild <http://example.org/entity/Hubert_Horatio_Skip_Humphrey> ;
    ex:hasSon <http://example.org/entity/Hubert_Horatio_Skip_Humphrey> .

