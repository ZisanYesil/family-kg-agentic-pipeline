@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Colgú_mac_Faílbe_Flaind> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Colgú mac Faílbe Flaind" ;
    onto:hasFather <http://example.org/entity/Faílbe_Flann_mac_Áedo_Duib> .

<http://example.org/entity/Faílbe_Flann_mac_Áedo_Duib> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Faílbe Flann mac Áedo Duib" ;
    onto:hasBrother <http://example.org/entity/Fíngen_mac_Áedo_Duib> .

<http://example.org/entity/Fíngen_mac_Áedo_Duib> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Fíngen mac Áedo Duib" .

