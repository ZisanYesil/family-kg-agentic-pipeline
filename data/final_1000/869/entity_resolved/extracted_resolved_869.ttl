@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:colgu_mac_faelbe_flaind a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Colgú mac Faílbe Flaind" ;
    onto:hasFather data:faile_flann_mac_aedo_duib .

data:faile_flann_mac_aedo_duib a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Faílbe Flann mac Áedo Duib" ;
    onto:hasBrother data:fingen_mac_aedo_duib .

data:fingen_mac_aedo_duib a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Fíngen mac Áedo Duib" .

