@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:kilippattu_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Kilippattu" ;
    onto:hasDirector data:raghavan_person .

data:jishnu_person a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jishnu" .

data:raghavan_person a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Raghavan" ;
    onto:hasSon data:jishnu_person .

