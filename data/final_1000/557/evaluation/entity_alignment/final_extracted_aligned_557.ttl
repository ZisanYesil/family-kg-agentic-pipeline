@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Kilippattu> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Raghavan> ;
    ex:hasDirector <http://example.org/entity/Raghavan> .

<http://example.org/entity/Jishnu> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/entity/Raghavan> ;
    ex:isSonOf <http://example.org/entity/Raghavan> .

<http://example.org/entity/Raghavan> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Jishnu> ;
    ex:hasSon <http://example.org/entity/Jishnu> .

