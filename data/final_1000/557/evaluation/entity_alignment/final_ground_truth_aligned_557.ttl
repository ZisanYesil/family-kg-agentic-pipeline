@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Kilippattu a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Raghavan ;
    ex:hasDirector entity:Raghavan .

entity:Jishnu a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Raghavan .

entity:Raghavan a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Jishnu .

