@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/kilippattu_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/raghavan_person> ;
    ex:hasDirector <http://example.org/extracted/raghavan_person> .

<http://example.org/extracted/jishnu_person> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/extracted/raghavan_person> ;
    ex:isSonOf <http://example.org/extracted/raghavan_person> .

<http://example.org/extracted/raghavan_person> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/extracted/jishnu_person> ;
    ex:hasSon <http://example.org/extracted/jishnu_person> .

