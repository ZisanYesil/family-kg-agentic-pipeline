@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Sand_And_Sorrow> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Sand And Sorrow" ;
    onto:hasDirector <http://example.org/entity/Paul_Freedman> .

<http://example.org/entity/Paul_Freedman> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Paul Freedman" ;
    onto:hasEmployer <http://example.org/entity/Yale> .

<http://example.org/entity/Yale> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Yale University" .

