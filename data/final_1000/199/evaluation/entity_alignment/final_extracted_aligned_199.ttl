@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Sand_And_Sorrow> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Paul_Freedman> ;
    ex:hasDirector <http://example.org/entity/Paul_Freedman> .

<http://example.org/entity/Yale> a ex:Agent,
        ex:Organization .

<http://example.org/entity/Paul_Freedman> a ex:Agent,
        ex:Person ;
    ex:hasEmployer <http://example.org/entity/Yale> .

