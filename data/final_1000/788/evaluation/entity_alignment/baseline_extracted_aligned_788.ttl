@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Ryu_Mi_yong> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ryu Mi-yong" ;
    onto:hasBirthDate "1921-02-14"^^xsd:date ;
    onto:hasDeathDate "2016-11-23"^^xsd:date .

<http://example.org/entity/Thomas_Johannes_Lauritz_Parr> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Thomas Johannes Lauritz Parr" ;
    onto:hasBirthDate "1862-05-13"^^xsd:date ;
    onto:hasDeathDate "1935-08-12"^^xsd:date .

