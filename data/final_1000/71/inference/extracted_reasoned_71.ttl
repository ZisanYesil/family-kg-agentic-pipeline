@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/carlisle_school> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization ;
    ex:hasInception "1968"^^xsd:gYear .

<http://example.org/extracted/triam_udom_suksa_school> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization ;
    ex:hasInception "1938"^^xsd:gYear .

