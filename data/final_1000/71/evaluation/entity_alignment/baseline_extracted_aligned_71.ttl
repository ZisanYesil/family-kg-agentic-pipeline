@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Carlisle_School> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Carlisle School" ;
    onto:hasInception "1968"^^xsd:gYear .

<http://example.org/entity/Triam_Udom_Suksa_School> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Triam Udom Suksa School" ;
    onto:hasInception "1938"^^xsd:gYear .

