@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:carlisle_school a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Carlisle School" ;
    onto:hasInception "1968"^^xsd:gYear .

data:triam_udom_suksa_school a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Triam Udom Suksa School" ;
    onto:hasInception "1938"^^xsd:gYear .

