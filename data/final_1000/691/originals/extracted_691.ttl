@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_indian_fighter a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Indian Fighter" ;
    onto:hasProducer data:person_kirk_douglas ;
    onto:hasPublicationDate "1955"^^xsd:gYear .

data:film_story_of_three_loves a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Story Of Three Loves" ;
    onto:hasProducer data:person_sidney_franklin ;
    onto:hasPublicationDate "1953"^^xsd:gYear .

data:person_kirk_douglas a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Kirk Douglas" ;
    onto:hasBirthDate "1916-12-09"^^xsd:date .

data:person_sidney_franklin a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sidney Franklin" ;
    onto:hasBirthDate "1893-03-21"^^xsd:date ;
    onto:hasDeathDate "1972-05-18"^^xsd:date .

