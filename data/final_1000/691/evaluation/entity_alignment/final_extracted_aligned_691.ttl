@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/The_Indian_Fighter> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/Kirk_Douglas> ;
    ex:hasPublicationDate "1955"^^xsd:gYear .

<http://example.org/entity/The_Story_of_Three_Loves> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/Sidney_Franklin> ;
    ex:hasPublicationDate "1953"^^xsd:gYear .

<http://example.org/entity/Kirk_Douglas> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1916-12-09"^^xsd:date .

<http://example.org/entity/Sidney_Franklin> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1893-03-21"^^xsd:date ;
    ex:hasDeathDate "1972-05-18"^^xsd:date .

