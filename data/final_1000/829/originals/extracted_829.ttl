@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:deadly_little_christmas_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Deadly Little Christmas" ;
    onto:hasPublicationDate "2009"^^xsd:gYear .

data:monster_squad_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Monster Squad" ;
    onto:hasPublicationDate "1987-08-14"^^xsd:date .

