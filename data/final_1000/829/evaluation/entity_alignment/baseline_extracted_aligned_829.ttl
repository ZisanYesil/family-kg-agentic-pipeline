@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Deadly_Little_Christmas> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Deadly Little Christmas" ;
    onto:hasPublicationDate "2009"^^xsd:gYear .

<http://example.org/entity/The_Monster_Squad> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Monster Squad" ;
    onto:hasPublicationDate "1987-08-14"^^xsd:date .

