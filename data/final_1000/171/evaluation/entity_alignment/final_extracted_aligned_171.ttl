@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Prunella_Scales> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Timothy_West> .

<http://example.org/entity/Lockwood_West> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Timothy_West> .

<http://example.org/entity/Timothy_West> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Lockwood_West> ;
    ex:hasParent <http://example.org/entity/Lockwood_West> ;
    ex:hasSpouse <http://example.org/entity/Prunella_Scales> .

