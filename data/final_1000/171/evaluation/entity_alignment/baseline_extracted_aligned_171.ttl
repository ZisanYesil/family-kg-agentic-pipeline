@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Timothy_West> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Timothy West" ;
    onto:hasFather <http://example.org/entity/Lockwood_West> ;
    onto:hasSpouse <http://example.org/entity/Prunella_Scales> ;
    skos:altLabel "Timothy Lancaster West" .

<http://example.org/entity/Lockwood_West> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lockwood West" ;
    skos:altLabel "Harry Lockwood West" .

<http://example.org/entity/Prunella_Scales> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Prunella Scales" .

