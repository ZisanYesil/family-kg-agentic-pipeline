@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:free_china_journal a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Free China Journal" ;
    onto:hasPublicationDate "1949"^^xsd:gYear .

data:neue_grafik a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Neue Grafik" ;
    onto:hasPublicationDate "1958"^^xsd:gYear .

