@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Free_China_Journal a ex:Agent,
        ex:Organization ;
    ex:hasInception "1949"^^xsd:gYear .

entity:Neue_Grafik a ex:Agent,
        ex:Organization ;
    ex:hasInception "1958"^^xsd:gYear .

