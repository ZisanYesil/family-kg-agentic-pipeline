@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/George_S_Patton> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "George S. Patton Sr." ;
    onto:hasSpouse <http://example.org/entity/Susan_Thornton_Glassell> .

<http://example.org/entity/Susan_Thornton_Glassell> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Susan Thornton Glassell" .

