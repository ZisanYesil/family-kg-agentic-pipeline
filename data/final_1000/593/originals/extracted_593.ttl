@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:george_patton_sr a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "George S. Patton Sr." ;
    onto:hasSpouse data:susan_thornton_glassell .

data:susan_thornton_glassell a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Susan Thornton Glassell" .

