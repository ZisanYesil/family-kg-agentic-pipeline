@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Kálmán_Rózsahegyi> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Kálmán Rózsahegyi" ;
    onto:hasBirthDate "1873-10-06"^^xsd:date ;
    onto:hasDeathDate "1961-08-27"^^xsd:date .

<http://example.org/entity/Lili_Damita> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lili Damita" ;
    onto:hasBirthDate "1904-07-10"^^xsd:date ;
    onto:hasDeathDate "1994-03-21"^^xsd:date .

