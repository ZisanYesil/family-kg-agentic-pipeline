@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:florence_of_holland a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Florence of Holland" ;
    onto:hasFather data:florence_iii_count_of_holland .

data:florence_iii_count_of_holland a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Florence III, Count of Holland" .

