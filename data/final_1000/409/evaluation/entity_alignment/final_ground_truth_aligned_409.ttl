@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Florence_of_Holland a ex:Agent,
        ex:Person ;
    ex:hasMother entity:Ada_of_Huntingdon ;
    ex:hasParent entity:Ada_of_Huntingdon .

entity:Floris_III a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Ada_of_Huntingdon .

entity:Ada_of_Huntingdon a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Florence_of_Holland ;
    ex:hasSpouse entity:Floris_III .

