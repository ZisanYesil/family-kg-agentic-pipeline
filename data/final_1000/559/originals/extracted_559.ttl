@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:breaking_dawn_part1_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Twilight Saga: Breaking Dawn – Part 1" ;
    onto:hasPublicationDate "2011-11-18"^^xsd:date .

data:unseen_forces_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Unseen Forces" ;
    onto:hasPublicationDate "1920"^^xsd:gYear .

