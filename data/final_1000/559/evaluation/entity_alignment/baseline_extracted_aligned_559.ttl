@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/The_Twilight_Saga_Breaking_Dawn_Part_1> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Twilight Saga: Breaking Dawn – Part 1" ;
    onto:hasPublicationDate "2011-11-18"^^xsd:date .

<http://example.org/entity/Unseen_Forces> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Unseen Forces" ;
    onto:hasPublicationDate "1920"^^xsd:gYear .

