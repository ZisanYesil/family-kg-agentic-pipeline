@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_everything_ducky> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_don_taylor> ;
    ex:hasDirector <http://example.org/extracted/person_don_taylor> .

<http://example.org/extracted/film_karthika> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_m_krishnan_nair> ;
    ex:hasDirector <http://example.org/extracted/person_m_krishnan_nair> .

<http://example.org/extracted/person_don_taylor> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1998-12-29"^^xsd:date .

<http://example.org/extracted/person_m_krishnan_nair> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2001-05-10"^^xsd:date .

