@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Everything_s_Ducky> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Don_Taylor> ;
    ex:hasDirector <http://example.org/entity/Don_Taylor> .

<http://example.org/entity/Karthika_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/M_Krishnan_Nair> ;
    ex:hasDirector <http://example.org/entity/M_Krishnan_Nair> .

<http://example.org/entity/Don_Taylor> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1998-12-29"^^xsd:date .

<http://example.org/entity/M_Krishnan_Nair> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2001-05-10"^^xsd:date .

