@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Everything_s_Ducky> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Everything's Ducky" ;
    onto:hasDirector <http://example.org/entity/Don_Taylor> .

<http://example.org/entity/Karthika_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Karthika" ;
    onto:hasDirector <http://example.org/entity/M_Krishnan_Nair> .

<http://example.org/entity/Don_Taylor> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Don Taylor" ;
    onto:hasDeathDate "1998-12-29"^^xsd:date .

<http://example.org/entity/M_Krishnan_Nair> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "M. Krishnan Nair" ;
    onto:hasDeathDate "2001-05-10"^^xsd:date .

