@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Cursed_2005_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Cursed (2005 film)" ;
    onto:hasDirector <http://example.org/entity/Wes_Craven> .

<http://example.org/entity/The_Wrath_of_God> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Wrath of God" ;
    onto:hasDirector <http://example.org/entity/Ralph_Nelson> .

<http://example.org/entity/Ralph_Nelson> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ralph Nelson" ;
    onto:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/Wes_Craven> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Wes Craven" ;
    onto:hasNationality <http://example.org/entity/American> ;
    skos:altLabel "Wesley Earl Craven" .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

