@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Cursed_2005_film a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Wes_Craven .

