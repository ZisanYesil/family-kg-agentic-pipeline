entity:Ralph_Nelson a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:American .

entity:Wes_Craven a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:American .

entity:American a ex:Country,
        ex:Place .

