        ex:Person ;
    ex:hasChild <http://example.org/entity/Harith_ibn_Harb> ;
    ex:hasFather <http://example.org/entity/Umayya_ibn_Abd_Shams> ;
    ex:hasParent <http://example.org/entity/Umayya_ibn_Abd_Shams> .

