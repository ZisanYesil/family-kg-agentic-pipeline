@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Harith_ibn_Harb> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Harith ibn Harb" ;
    onto:hasFather <http://example.org/entity/Harb_ibn_Umayya> .

<http://example.org/entity/Harb_ibn_Umayya> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Harb ibn Umayya" ;
    onto:hasFather <http://example.org/entity/Umayya_ibn_Abd_Shams> .

<http://example.org/entity/Umayya_ibn_Abd_Shams> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Umayya ibn Abd Shams" .

