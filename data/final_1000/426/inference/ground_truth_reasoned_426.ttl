@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Bombshell_The_Hedy_Lamarr_Story a ex:Artifact ;
    ex:hasCountry entity:American ;
    ex:hasCountryOfOrigin entity:American .

entity:Toman_film a ex:Artifact ;
    ex:hasCountry entity:Czech ;
    ex:hasCountryOfOrigin entity:Czech .

entity:American a ex:Country,
        ex:Place .

entity:Czech a ex:Country,
        ex:Place .

