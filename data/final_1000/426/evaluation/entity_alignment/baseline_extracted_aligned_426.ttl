@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Bombshell_The_Hedy_Lamarr_Story> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Bombshell: The Hedy Lamarr Story" ;
    onto:hasCountry <http://example.org/entity/American> .

<http://example.org/entity/Toman_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Toman" ;
    onto:hasCountry <http://example.org/entity/Czech> ;
    skos:altLabel "Zdeněk Toman" .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

<http://example.org/entity/Czech> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Czech Republic" ;
    skos:altLabel "Czech" .

