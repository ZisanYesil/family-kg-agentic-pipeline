@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:bombshell_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Bombshell: The Hedy Lamarr Story" ;
    onto:hasCountry data:united_states .

data:toman_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Toman" ;
    onto:hasCountry data:czech_republic ;
    skos:altLabel "Zdeněk Toman" .

data:czech_republic a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Czech Republic" ;
    skos:altLabel "Czech" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

