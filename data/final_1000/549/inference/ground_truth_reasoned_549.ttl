@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Latin_Moon a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Massari ;
    ex:hasPerformer entity:Massari .

entity:Lebanese a ex:Country,
        ex:Place .

entity:Massari a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:Lebanese ;
    ex:hasCountry entity:Lebanese .

