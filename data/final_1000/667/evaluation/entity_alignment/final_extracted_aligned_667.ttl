@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Pro_Wrestling_Alliance> a ex:Agent,
        ex:Organization ;
    ex:hasFounder <http://example.org/entity/Booker_T> .

<http://example.org/entity/Booker_T> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/entity/WWE_Hall_of_Fame> .

<http://example.org/entity/WWE_Hall_of_Fame> a ex:Award .

