@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Pro_Wrestling_Alliance> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Reality Of Wrestling" ;
    onto:hasFounder <http://example.org/entity/Booker_T> ;
    skos:altLabel "ROW",
        "Reality of Wrestling" .

<http://example.org/entity/Booker_T> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Booker T" ;
    onto:hasAwardReceived <http://example.org/entity/WWE_Hall_of_Fame> ;
    skos:altLabel "Robert Booker Tio Huffman" .

<http://example.org/entity/WWE_Hall_of_Fame> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "WWE Hall of Fame" .

