@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Pro_Wrestling_Alliance a ex:Agent,
        ex:Organization ;
    ex:hasFounder entity:Booker_T .

entity:Booker_T a ex:Agent ;
    ex:hasAwardReceived entity:WWE_Hall_of_Fame .

entity:WWE_Hall_of_Fame a ex:Award .

