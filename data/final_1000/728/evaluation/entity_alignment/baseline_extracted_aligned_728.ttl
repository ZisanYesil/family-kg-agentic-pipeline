@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Lover_s_Grief_over_the_Yellow_River> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Lover's Grief over the Yellow River" ;
    onto:hasDirector <http://example.org/entity/Feng_Xiaoning> .

<http://example.org/entity/Feng_Xiaoning> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Feng Xiaoning" ;
    onto:hasBirthPlace <http://example.org/entity/Xi_an> .

<http://example.org/entity/Xi_an> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Xi'an" .

