@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Lover_s_Grief_over_the_Yellow_River a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Feng_Xiaoning ;
    ex:hasDirector entity:Feng_Xiaoning .

entity:Xi_an a ex:Place .

entity:Feng_Xiaoning a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Xi_an .

