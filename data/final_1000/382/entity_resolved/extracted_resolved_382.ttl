@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:place_chah_e_ali_kapari a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Chah-E Ali Kapari" ;
    onto:hasCountry data:country_iran .

data:place_chak_26_11_l a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Chak 26/11-L, Chichawatni" ;
    onto:hasCountry data:country_pakistan .

data:country_iran a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Iran" .

data:country_pakistan a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Pakistan" .

