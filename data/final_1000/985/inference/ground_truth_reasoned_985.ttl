@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Elisabeth_Magdalena_of_Pomerania a ex:Agent,
        ex:Person ;
    ex:hasFather entity:Ernst_Ludwig_Duke_of_Pomerania ;
    ex:hasParent entity:Ernst_Ludwig_Duke_of_Pomerania .

entity:Wolgast a ex:Place .

entity:Ernst_Ludwig_Duke_of_Pomerania a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Wolgast ;
    ex:hasChild entity:Elisabeth_Magdalena_of_Pomerania .

