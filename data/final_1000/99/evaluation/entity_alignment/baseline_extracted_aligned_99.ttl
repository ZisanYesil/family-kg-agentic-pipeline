@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Gofraid_ua_Ímair> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gofraid ua Ímair" ;
    onto:hasSon <http://example.org/entity/Olaf_Guthfrithson> .

<http://example.org/entity/Blácaire_mac_Gofraid> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Blácaire mac Gofraid" .

<http://example.org/entity/Olaf_Guthfrithson> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Olaf Guthfrithson" ;
    onto:hasBrother <http://example.org/entity/Blácaire_mac_Gofraid> .

