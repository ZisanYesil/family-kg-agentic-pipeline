@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/When_You_re_Smiling> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "When You're Smiling" ;
    onto:hasPerformer <http://example.org/entity/Louis_Armstrong> .

<http://example.org/entity/America> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

<http://example.org/entity/Louis_Armstrong> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Louis Armstrong" ;
    onto:hasNationality <http://example.org/entity/America> .

