@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/When_You_re_Smiling> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Louis_Armstrong> ;
    ex:hasPerformer <http://example.org/entity/Louis_Armstrong> .

<http://example.org/entity/America> a ex:Country,
        ex:Place .

<http://example.org/entity/Louis_Armstrong> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/America> ;
    ex:hasNationality <http://example.org/entity/America> .

