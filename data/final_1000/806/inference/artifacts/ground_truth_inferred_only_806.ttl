@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:When_You_re_Smiling a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Louis_Armstrong .

entity:America a ex:Country,
        ex:Place .

entity:Louis_Armstrong a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:America .

