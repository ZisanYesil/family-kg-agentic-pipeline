@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:when_youre_smiling a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "When You're Smiling" ;
    onto:hasPerformer data:louis_armstrong .

data:louis_armstrong a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Louis Armstrong" ;
    onto:hasNationality data:united_states .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

