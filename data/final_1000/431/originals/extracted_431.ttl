@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:rolf_billberg a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Rolf Billberg" ;
    onto:hasBirthDate "1930-08-22"^^xsd:date ;
    onto:hasDeathDate "1966-08-17"^^xsd:date .

data:yeo_woon_kay a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Yeo Woon-Kay" ;
    onto:hasBirthDate "1940-02-25"^^xsd:date ;
    onto:hasDeathDate "2009-05-22"^^xsd:date .

