@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_Vanity_Pool> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Ida_May_Park> ;
    ex:hasDirector <http://example.org/entity/Ida_May_Park> .

<http://example.org/entity/Los_Angeles> a ex:Place .

<http://example.org/entity/Ida_May_Park> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Los_Angeles> .

