@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Vanity_Pool a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Ida_May_Park ;
    ex:hasDirector entity:Ida_May_Park .

entity:Los_Angeles a ex:Place .

entity:Ida_May_Park a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Los_Angeles .

