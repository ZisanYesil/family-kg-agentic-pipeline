@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Princess_Margarita_of_Greece_and_Denmark> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Princess Margarita of Greece and Denmark" ;
    onto:hasMother <http://example.org/entity/Princess_Alice_of_Battenberg> .

<http://example.org/entity/Buckingham_Palace> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Buckingham Palace" .

<http://example.org/entity/Princess_Alice_of_Battenberg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Princess Alice of Battenberg" ;
    onto:hasDeathPlace <http://example.org/entity/Buckingham_Palace> .

