@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/André_Testut> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "André Testut" ;
    onto:hasBirthDate "1926-04-13"^^xsd:date ;
    onto:hasDeathDate "2005-09-24"^^xsd:date .

<http://example.org/entity/Kurt_Cuno> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Kurt Cuno" ;
    onto:hasBirthDate "1896-08-27"^^xsd:date ;
    onto:hasDeathDate "1961-07-14"^^xsd:date .

