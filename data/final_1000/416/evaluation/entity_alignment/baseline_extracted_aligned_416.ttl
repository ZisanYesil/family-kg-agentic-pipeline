@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Agnes_of_Meissen> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Agnes of Meissen" ;
    onto:hasMother <http://example.org/entity/Margaret_of_Sicily> .

<http://example.org/entity/Margaret_of_Sicily> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Margaret of Sicily" ;
    onto:hasNationality data:sicily .

data:sicily a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Sicily" .

