@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:agnes_of_meissen a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Agnes of Meissen" ;
    onto:hasMother data:margaret_of_sicily .

data:margaret_of_sicily a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Margaret of Sicily" ;
    onto:hasNationality data:sicily .

data:sicily a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Sicily" .

