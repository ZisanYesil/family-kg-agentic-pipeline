@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Agnes_of_Meissen a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Margaret_of_Sicily .

entity:Germany a ex:Country,
        ex:Place .

entity:Margaret_of_Sicily a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Agnes_of_Meissen ;
    ex:hasCountry entity:Germany .

