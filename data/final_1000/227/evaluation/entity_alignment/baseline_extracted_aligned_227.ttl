@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/The_Man_in_Grey> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Man in Grey" ;
    onto:hasPublicationDate "1943"^^xsd:gYear .

<http://example.org/entity/The_Queen_s_Traitor> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "The Queen's Traitor" ;
    onto:hasPublicationDate "1967"^^xsd:gYear .

