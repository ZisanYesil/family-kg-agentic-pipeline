@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:the_man_in_grey a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Man in Grey" ;
    onto:hasPublicationDate "1943"^^xsd:gYear .

data:the_queen_s_traitor a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "The Queen's Traitor" ;
    onto:hasPublicationDate "1967"^^xsd:gYear .

