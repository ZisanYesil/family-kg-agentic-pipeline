@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:sheila_mary_tuer a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sheila Mary Tuer" ;
    onto:hasSpouse data:tai_solarin ;
    skos:altLabel "Sheila Mary Solarin" .

data:tai_solarin a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tai Solarin" ;
    skos:altLabel "Augustus Taiwo \"Tai\" Solarin" .

