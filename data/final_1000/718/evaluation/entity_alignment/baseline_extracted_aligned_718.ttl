@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Sheila_Mary_Solarin_née_Tuer> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sheila Mary Tuer" ;
    onto:hasSpouse <http://example.org/entity/Tai_Solarin> ;
    skos:altLabel "Sheila Mary Solarin" .

<http://example.org/entity/Tai_Solarin> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tai Solarin" ;
    skos:altLabel "Augustus Taiwo \"Tai\" Solarin" .

