@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/William_Douglas_2nd_Earl_of_Angus> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William Douglas, 2nd Earl of Angus" ;
    onto:hasBirthPlace <http://example.org/entity/Tantallon_Castle> ;
    onto:hasSon <http://example.org/entity/James_Douglas_3rd_Earl_of_Angus> .

<http://example.org/entity/James_Douglas_3rd_Earl_of_Angus> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "James Douglas, 3rd Earl of Angus" .

<http://example.org/entity/Tantallon_Castle> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Tantallon Castle" .

