@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Tantallon_Castle> a ex:Place .

<http://example.org/entity/James_Douglas_3rd_Earl_of_Angus> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/entity/William_Douglas_2nd_Earl_of_Angus> ;
    ex:isSonOf <http://example.org/entity/William_Douglas_2nd_Earl_of_Angus> .

<http://example.org/entity/William_Douglas_2nd_Earl_of_Angus> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Tantallon_Castle> ;
    ex:hasChild <http://example.org/entity/James_Douglas_3rd_Earl_of_Angus> ;
    ex:hasSon <http://example.org/entity/James_Douglas_3rd_Earl_of_Angus> .

