@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:william_douglas_2nd_earl_of_angus a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William Douglas, 2nd Earl of Angus" ;
    onto:hasBirthPlace data:tantallon_castle_east_lothian ;
    onto:hasSon data:james_douglas_3rd_earl_of_angus .

data:james_douglas_3rd_earl_of_angus a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "James Douglas, 3rd Earl of Angus" .

data:tantallon_castle_east_lothian a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Tantallon Castle" .

