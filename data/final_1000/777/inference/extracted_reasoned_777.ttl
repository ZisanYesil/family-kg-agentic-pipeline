@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/france> a ex:Country,
        ex:Place .

<http://example.org/extracted/isabel_de_la_cerda> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/extracted/luis_de_la_cerda> ;
    ex:hasParent <http://example.org/extracted/luis_de_la_cerda> .

<http://example.org/extracted/luis_de_la_cerda> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/extracted/france> ;
    ex:hasChild <http://example.org/extracted/isabel_de_la_cerda> .

