@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/France> a ex:Country,
        ex:Place .

<http://example.org/entity/Isabel_de_la_Cerda> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Luis_de_la_Cerda> ;
    ex:hasParent <http://example.org/entity/Luis_de_la_Cerda> .

<http://example.org/entity/Luis_de_la_Cerda> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/France> ;
    ex:hasChild <http://example.org/entity/Isabel_de_la_Cerda> .

