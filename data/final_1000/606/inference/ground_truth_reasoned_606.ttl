@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Candy a ex:Artifact,
        ex:CreativeWork ;
    ex:hasComposer entity:Alex_Kramer ;
    ex:hasCreator entity:Alex_Kramer .

entity:Montreal_Quebec a ex:Place .

entity:Alex_Kramer a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Montreal_Quebec .

