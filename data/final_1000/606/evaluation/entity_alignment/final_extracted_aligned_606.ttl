@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Candy> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasComposer <http://example.org/entity/Alex_Kramer> ;
    ex:hasCreator <http://example.org/entity/Alex_Kramer> .

<http://example.org/entity/Montreal_Quebec> a ex:Place .

<http://example.org/entity/Alex_Kramer> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Montreal_Quebec> .

