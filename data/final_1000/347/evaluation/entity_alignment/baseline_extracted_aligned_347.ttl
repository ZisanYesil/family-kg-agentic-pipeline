@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Angel_Eyes_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Angel Eyes" ;
    onto:hasPublicationDate "2001"^^xsd:gYear .

<http://example.org/entity/Mickey_s_Disguises> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Mickey's Disguises" ;
    onto:hasPublicationDate "1933-07-17"^^xsd:date .

