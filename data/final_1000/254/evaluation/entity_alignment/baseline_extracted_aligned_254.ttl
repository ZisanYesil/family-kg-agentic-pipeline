@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/The_Hideout_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Hideout" ;
    onto:hasCountryOfOrigin <http://example.org/entity/American>,
        <http://example.org/entity/Italian> .

<http://example.org/entity/Trieste_mia> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Trieste mia!" ;
    onto:hasCountryOfOrigin <http://example.org/entity/Italian> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

<http://example.org/entity/Italian> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Italy" ;
    skos:altLabel "Italian" .

