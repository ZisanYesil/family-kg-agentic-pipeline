@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_Hideout_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/American>,
        <http://example.org/entity/Italian> ;
    ex:hasCountryOfOrigin <http://example.org/entity/American>,
        <http://example.org/entity/Italian> .

<http://example.org/entity/Trieste_mia> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/Italian> ;
    ex:hasCountryOfOrigin <http://example.org/entity/Italian> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/Italian> a ex:Country,
        ex:Place .

