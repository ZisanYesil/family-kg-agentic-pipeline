@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/hideout_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/extracted/italy>,
        <http://example.org/extracted/united_states> ;
    ex:hasCountryOfOrigin <http://example.org/extracted/italy>,
        <http://example.org/extracted/united_states> .

<http://example.org/extracted/trieste_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/extracted/italy> ;
    ex:hasCountryOfOrigin <http://example.org/extracted/italy> .

<http://example.org/extracted/united_states> a ex:Country,
        ex:Place .

<http://example.org/extracted/italy> a ex:Country,
        ex:Place .

