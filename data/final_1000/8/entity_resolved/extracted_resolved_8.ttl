@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:karin_stoltenberg a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Karin Stoltenberg" ;
    onto:hasSpouse data:thorvald_stoltenberg .

data:thorvald_stoltenberg a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Thorvald Stoltenberg" ;
    onto:hasEmployer data:united_nations .

data:united_nations a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "United Nations" .

