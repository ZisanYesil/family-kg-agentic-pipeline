@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Besançon> a ex:Place .

<http://example.org/entity/Pierre_Brissaud> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Edouard_Brissaud> ;
    ex:hasParent <http://example.org/entity/Edouard_Brissaud> .

<http://example.org/entity/Edouard_Brissaud> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Besançon> ;
    ex:hasChild <http://example.org/entity/Pierre_Brissaud> .

