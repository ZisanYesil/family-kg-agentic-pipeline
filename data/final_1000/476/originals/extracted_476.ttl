@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:pierre_brissaud a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Pierre Brissaud" ;
    onto:hasFather data:edouard_brissaud .

data:besancon a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Besançon" .

data:edouard_brissaud a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Édouard Brissaud" ;
    onto:hasBirthPlace data:besancon ;
    skos:altLabel "Edouard Brissaud" .

