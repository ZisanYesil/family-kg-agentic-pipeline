@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Besançon a ex:Place .

entity:Edouard_Brissaud a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Pierre_Brissaud .

entity:Pierre_Brissaud a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Edouard_Brissaud .

