@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Runaway a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Tim_McCann ;
    ex:hasDirector entity:Tim_McCann .

entity:State_University_of_New_York_at_Purchase a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Tim_McCann a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt entity:State_University_of_New_York_at_Purchase .

