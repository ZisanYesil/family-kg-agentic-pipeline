@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Runaway> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Runaway (2005 film)" ;
    onto:hasDirector <http://example.org/entity/Tim_McCann> .

<http://example.org/entity/State_University_of_New_York_at_Purchase> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "State University of New York at Purchase" .

<http://example.org/entity/Tim_McCann> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tim McCann" ;
    onto:hasEducatedAt <http://example.org/entity/State_University_of_New_York_at_Purchase> .

