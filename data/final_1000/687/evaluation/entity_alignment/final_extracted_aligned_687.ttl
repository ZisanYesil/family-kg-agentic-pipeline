@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Runaway> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Tim_McCann> ;
    ex:hasDirector <http://example.org/entity/Tim_McCann> .

<http://example.org/entity/State_University_of_New_York_at_Purchase> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Tim_McCann> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/State_University_of_New_York_at_Purchase> .

