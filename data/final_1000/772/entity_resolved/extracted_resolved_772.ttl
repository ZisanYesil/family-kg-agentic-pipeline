@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:_eastern_economic_journal a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Eastern Economic Journal" ;
    onto:hasPublisher data:_palgrave_macmillan .

data:_palgrave_macmillan a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Palgrave Macmillan" .

