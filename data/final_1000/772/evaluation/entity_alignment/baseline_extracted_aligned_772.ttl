@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Eastern_Economic_Journal> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Eastern Economic Journal" ;
    onto:hasPublisher <http://example.org/entity/Palgrave> .

<http://example.org/entity/Palgrave> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Palgrave Macmillan" .

