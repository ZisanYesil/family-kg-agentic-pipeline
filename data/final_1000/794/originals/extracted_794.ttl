@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:sri_ramakrishna_vijayam a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Sri Ramakrishna Vijayam" ;
    onto:hasPublicationDate "1921"^^xsd:gYear .

data:tait_edinburgh_magazine a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Tait's Edinburgh Magazine" ;
    onto:hasPublicationDate "1832"^^xsd:gYear .

