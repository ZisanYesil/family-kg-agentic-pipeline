@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Hot_Time_in_the_Town_of_Berlin> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasComposer <http://example.org/entity/Joe_Bushkin> ;
    ex:hasCreator <http://example.org/entity/Joe_Bushkin> .

<http://example.org/entity/Santa_Barbara> a ex:Place .

<http://example.org/entity/Joe_Bushkin> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Santa_Barbara> .

