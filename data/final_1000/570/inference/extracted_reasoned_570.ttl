@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/song_hot_time_berlin> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasComposer <http://example.org/extracted/person_joe_bushkin> ;
