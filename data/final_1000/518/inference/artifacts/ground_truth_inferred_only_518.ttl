@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Buchanan_Rides_Alone a ex:Artifact ;
    ex:hasCountry entity:American .

entity:The_Good_Old_Naughty_Days a ex:Artifact ;
    ex:hasCountry entity:French .

entity:American a ex:Country,
        ex:Place .

entity:French a ex:Country,
        ex:Place .

