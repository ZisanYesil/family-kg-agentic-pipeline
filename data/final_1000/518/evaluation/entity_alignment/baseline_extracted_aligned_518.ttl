@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Buchanan_Rides_Alone> a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Buchanan Rides Alone" ;
    onto:hasCountryOfOrigin <http://example.org/entity/American> .

<http://example.org/entity/The_Good_Old_Naughty_Days> a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "The Good Old Naughty Days" ;
    onto:hasCountryOfOrigin <http://example.org/entity/French> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

<http://example.org/entity/French> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

