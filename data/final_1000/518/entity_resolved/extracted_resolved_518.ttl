@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:buchanan_rides_alone a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Buchanan Rides Alone" ;
    onto:hasCountryOfOrigin data:united_states .

data:good_old_naughty_days a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "The Good Old Naughty Days" ;
    onto:hasCountryOfOrigin data:france .

data:france a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

