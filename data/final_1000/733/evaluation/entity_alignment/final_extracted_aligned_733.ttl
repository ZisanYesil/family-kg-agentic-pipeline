@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Maiden_s_Cheek> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Alekos_Sakellarios> ;
    ex:hasDirector <http://example.org/entity/Alekos_Sakellarios> .

<http://example.org/entity/First_Cemetery_of_Athens> a ex:Place .

<http://example.org/entity/Alekos_Sakellarios> a ex:Agent,
        ex:Person ;
    ex:hasBurialPlace <http://example.org/entity/First_Cemetery_of_Athens> .

