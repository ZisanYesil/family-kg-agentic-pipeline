@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Maiden_s_Cheek> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Maiden's Cheek" ;
    onto:hasDirector <http://example.org/entity/Alekos_Sakellarios> .

<http://example.org/entity/Alekos_Sakellarios> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alekos Sakellarios" ;
    onto:hasBurialPlace <http://example.org/entity/First_Cemetery_of_Athens> .

<http://example.org/entity/First_Cemetery_of_Athens> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "First Cemetery of Athens" .

