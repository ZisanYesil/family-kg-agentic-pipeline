@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Charles_Prince_of_Nassau_Usingen> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Charles, Prince of Nassau-Usingen" ;
    onto:hasBirthDate "1712-12-31"^^xsd:date .

<http://example.org/entity/Charles_Émile_Troisier> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Charles Émile Troisier" ;
    onto:hasBirthDate "1844-04-06"^^xsd:date .

