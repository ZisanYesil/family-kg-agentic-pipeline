@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:charles_emile_troisier_1844 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Charles Émile Troisier" ;
    onto:hasBirthDate "1844-04-06"^^xsd:date .

data:charles_prince_nassau_usingen_1712 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Charles, Prince of Nassau-Usingen" ;
    onto:hasBirthDate "1712-12-31"^^xsd:date .

