@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Oriental_Stories> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasEditor <http://example.org/entity/Farnsworth_Wright> .

<http://example.org/entity/Farnsworth_Wright> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1888-07-29"^^xsd:date .

