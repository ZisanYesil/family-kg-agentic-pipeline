@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Oriental_Stories> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Oriental Stories" ;
    onto:hasEditor <http://example.org/entity/Farnsworth_Wright> .

<http://example.org/entity/Farnsworth_Wright> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Farnsworth Wright" ;
    onto:hasBirthDate "1888-07-29"^^xsd:date .

