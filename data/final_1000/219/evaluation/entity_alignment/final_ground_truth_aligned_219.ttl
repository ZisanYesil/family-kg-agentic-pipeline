@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Oriental_Stories a ex:Artifact,
        ex:CreativeWork ;
    ex:hasEditor entity:Farnsworth_Wright .

entity:Farnsworth_Wright a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1888-07-29"^^xsd:date .

