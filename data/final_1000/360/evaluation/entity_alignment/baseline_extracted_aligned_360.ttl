@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Little_More_Royalty> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Little More (Royalty)" ;
    onto:hasPerformer <http://example.org/entity/Chris_Brown> .

<http://example.org/entity/Chris_Brown> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Chris Brown" ;
    onto:hasAwardReceived <http://example.org/entity/Grammy_Award_for_Best_R_B_Album>,
        data:award_bet,
        data:award_billboard_music,
        data:award_soul_train_music .

<http://example.org/entity/Grammy_Award_for_Best_R_B_Album> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Grammy Award" .

data:award_bet a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "BET Award" .

data:award_billboard_music a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Billboard Music Award" .

data:award_soul_train_music a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Soul Train Music Award" .

