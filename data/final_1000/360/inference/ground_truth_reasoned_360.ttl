@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Little_More_Royalty a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Chris_Brown ;
    ex:hasPerformer entity:Chris_Brown .

entity:Grammy_Award_for_Best_R_B_Album a ex:Award .

entity:Chris_Brown a ex:Agent ;
    ex:hasAwardReceived entity:Grammy_Award_for_Best_R_B_Album .

