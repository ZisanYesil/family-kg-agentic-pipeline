@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/song_little_more_royalty> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/extracted/person_chris_brown> ;
    ex:hasPerformer <http://example.org/extracted/person_chris_brown> .

<http://example.org/extracted/award_bet> a ex:Award .

<http://example.org/extracted/award_billboard_music> a ex:Award .

<http://example.org/extracted/award_grammy> a ex:Award .

<http://example.org/extracted/award_soul_train_music> a ex:Award .

<http://example.org/extracted/person_chris_brown> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/extracted/award_bet>,
        <http://example.org/extracted/award_billboard_music>,
        <http://example.org/extracted/award_grammy>,
        <http://example.org/extracted/award_soul_train_music> .

