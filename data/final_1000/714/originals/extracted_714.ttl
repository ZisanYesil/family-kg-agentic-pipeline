@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:lyutenge_river a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Lyutenge River" ;
    onto:hasCountry data:russia .

data:pizhma_river_komi a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Pizhma River (Komi Republic)" ;
    onto:hasCountry data:russia .

data:russia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Russia" .

