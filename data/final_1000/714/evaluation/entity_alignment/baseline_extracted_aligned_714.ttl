@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Lyutenge_River> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Lyutenge River" ;
    onto:hasCountry <http://example.org/entity/Russia> .

<http://example.org/entity/Pizhma_River_Komi_Republic> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Pizhma River (Komi Republic)" ;
    onto:hasCountry <http://example.org/entity/Russia> .

<http://example.org/entity/Russia> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Russia" .

