@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/film_the_escapist_2002> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_gillies_mackinnon> ;
    ex:hasDirector <http://example.org/extracted/person_gillies_mackinnon> .

<http://example.org/extracted/edu_glasgow_school_of_art> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/extracted/edu_middlesex_polytechnic> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/extracted/edu_national_film_and_television_school> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/extracted/person_gillies_mackinnon> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/extracted/edu_glasgow_school_of_art>,
        <http://example.org/extracted/edu_middlesex_polytechnic>,
        <http://example.org/extracted/edu_national_film_and_television_school> .

