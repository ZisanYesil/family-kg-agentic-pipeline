@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_Escapist> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Gillies_MacKinnon> ;
    ex:hasDirector <http://example.org/entity/Gillies_MacKinnon> .

<http://example.org/entity/National_Film_and_Television_School> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/extracted/edu_glasgow_school_of_art> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/extracted/edu_middlesex_polytechnic> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Gillies_MacKinnon> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/National_Film_and_Television_School>,
        <http://example.org/extracted/edu_glasgow_school_of_art>,
        <http://example.org/extracted/edu_middlesex_polytechnic> .

