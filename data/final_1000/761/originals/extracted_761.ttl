@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:sammy_drechsel a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sammy Drechsel" ;
    onto:hasBirthDate "1925-04-25"^^xsd:date ;
    onto:hasDeathDate "1986-01-19"^^xsd:date ;
    skos:altLabel "Karl- Heinz Kamke" .

data:wolfgang_fischer_officer a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Wolfgang Fischer" ;
    onto:hasBirthDate "1888-12-11"^^xsd:date ;
    onto:hasDeathDate "1943-02-01"^^xsd:date .

