@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/sammy_drechsel> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1925-04-25"^^xsd:date ;
    ex:hasDeathDate "1986-01-19"^^xsd:date .

<http://example.org/extracted/wolfgang_fischer_officer> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1888-12-11"^^xsd:date ;
    ex:hasDeathDate "1943-02-01"^^xsd:date .

