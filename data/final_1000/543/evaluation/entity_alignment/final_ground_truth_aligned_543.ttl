@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Hush_Money a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Sidney_Lanfield ;
    ex:hasDirector entity:Sidney_Lanfield .

entity:Westwood_Village_Memorial_Park_Cemetery a ex:Place .

entity:Sidney_Lanfield a ex:Agent,
        ex:Person ;
    ex:hasBurialPlace entity:Westwood_Village_Memorial_Park_Cemetery .

