@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Hush_Money> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Sidney_Lanfield> ;
    ex:hasDirector <http://example.org/entity/Sidney_Lanfield> .

<http://example.org/entity/Westwood_Village_Memorial_Park_Cemetery> a ex:Place .

<http://example.org/entity/Sidney_Lanfield> a ex:Agent,
        ex:Person ;
    ex:hasBurialPlace <http://example.org/entity/Westwood_Village_Memorial_Park_Cemetery> .

