@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Baahubali_2_The_Conclusion> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Baahubali 2: The Conclusion" ;
    onto:hasProducer <http://example.org/entity/Prasad_Devineni>,
        <http://example.org/entity/Shobu_Yarlagadda> .

<http://example.org/entity/Manhattan_Night> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Manhattan Night" .

<http://example.org/entity/Prasad_Devineni> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Prasad Devineni" .

<http://example.org/entity/Shobu_Yarlagadda> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Shobu Yarlagadda" .

