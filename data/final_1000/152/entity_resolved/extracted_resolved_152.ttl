@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:film_baahubali_2_conclusion a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Baahubali 2: The Conclusion" ;
    onto:hasProducer data:person_prasad_devineni,
        data:person_shobu_yarlagadda .

data:film_manhattan_night a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Manhattan Night" .

data:person_prasad_devineni a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Prasad Devineni" .

data:person_shobu_yarlagadda a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Shobu Yarlagadda" .

