@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/A_Day_at_the_Museum> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Day at the Museum" ;
    onto:hasPublicationDate "2008"^^xsd:gYear .

<http://example.org/entity/Ryan_s_Daughter> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Ryan's Daughter" ;
    onto:hasPublicationDate "1970"^^xsd:gYear .

