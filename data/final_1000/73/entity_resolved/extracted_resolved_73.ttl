@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_a_day_at_the_museum a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Day at the Museum" ;
    onto:hasPublicationDate "2008"^^xsd:gYear .

data:film_ryans_daughter a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Ryan's Daughter" ;
    onto:hasPublicationDate "1970"^^xsd:gYear .

