@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Dalida> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Lisa_Azuelos> ;
    ex:hasDirector <http://example.org/entity/Lisa_Azuelos> .

<http://example.org/entity/Marie_Laforêt> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Lisa_Azuelos> .

<http://example.org/entity/Lisa_Azuelos> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Marie_Laforêt> ;
    ex:hasParent <http://example.org/entity/Marie_Laforêt> .

