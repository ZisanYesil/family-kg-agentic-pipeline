@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Dalida> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Dalida (2017 film)" ;
    onto:hasDirector <http://example.org/entity/Lisa_Azuelos> .

<http://example.org/entity/Lisa_Azuelos> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lisa Azuelos" ;
    onto:hasMother <http://example.org/entity/Marie_Laforêt> .

<http://example.org/entity/Marie_Laforêt> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Marie Laforêt" .

