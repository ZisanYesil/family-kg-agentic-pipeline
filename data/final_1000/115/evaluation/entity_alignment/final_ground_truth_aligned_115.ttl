@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Arbusto_Energy a ex:Agent,
        ex:Organization ;
    ex:hasFounder entity:President_George_W_Bush .

entity:George_W_Bush a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:American ;
    ex:hasCountry entity:American .

entity:President_George_W_Bush a ex:Agent .

entity:American a ex:Country,
        ex:Place .

