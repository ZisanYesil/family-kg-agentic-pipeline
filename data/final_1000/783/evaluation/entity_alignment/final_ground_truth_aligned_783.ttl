@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Versus a ex:Agent,
        ex:Organization ;
    ex:hasFounder entity:Gianni_Versace .

entity:Gianni_Versace a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace entity:Miami_Beach .

entity:Miami_Beach a ex:Place .

