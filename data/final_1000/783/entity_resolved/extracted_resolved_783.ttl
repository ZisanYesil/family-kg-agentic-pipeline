@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:gianni_versace_person a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gianni Versace" ;
    onto:hasDeathPlace data:casa_casuarina_place ;
    skos:altLabel "Giovanni Maria Versace" .

data:versus_versace_artifact a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Versus (Versace)" .

data:casa_casuarina_place a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Casa Casuarina" ;
    skos:altLabel "Miami Beach mansion Casa Casuarina" .

