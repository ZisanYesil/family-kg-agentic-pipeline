@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Man_of_God> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Man Of God" ;
    onto:hasDirector <http://example.org/entity/Jefery_Levy> .

<http://example.org/entity/Jefery_Levy> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jefery Levy" ;
    onto:hasEmployer <http://example.org/entity/University_of_Southern_California> .

<http://example.org/entity/University_of_Southern_California> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "University of Southern California film school" .

