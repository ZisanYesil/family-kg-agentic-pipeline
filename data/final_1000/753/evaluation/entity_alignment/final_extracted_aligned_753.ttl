@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Man_of_God> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Jefery_Levy> ;
    ex:hasDirector <http://example.org/entity/Jefery_Levy> .

<http://example.org/entity/University_of_Southern_California> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Jefery_Levy> a ex:Agent,
        ex:Person ;
    ex:hasEmployer <http://example.org/entity/University_of_Southern_California> .

