@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/film_man_of_god> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_jefery_levy> ;
    ex:hasDirector <http://example.org/extracted/person_jefery_levy> .

<http://example.org/extracted/org_us_csu_film_school> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/extracted/person_jefery_levy> a ex:Agent,
        ex:Person ;
    ex:hasEmployer <http://example.org/extracted/org_us_csu_film_school> .

