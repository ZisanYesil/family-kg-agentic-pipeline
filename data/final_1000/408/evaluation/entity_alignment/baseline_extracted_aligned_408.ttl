@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Metropolitan> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Metropolitan" ;
    onto:hasMember <http://example.org/entity/John_Masters> ;
    skos:altLabel "Metropolitan (band)" .

<http://example.org/entity/British> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

<http://example.org/entity/John_Masters> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Masters" ;
    onto:hasNationality <http://example.org/entity/British> .

