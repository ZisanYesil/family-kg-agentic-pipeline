@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Hürriyet a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher entity:Doğan_Media .

entity:Doğan_Media a ex:Agent,
        ex:Organization ;
    ex:hasInception "1997"^^xsd:gYear .

