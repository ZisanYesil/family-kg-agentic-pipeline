@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Hürriyet> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher <http://example.org/entity/Doğan_Media> .

<http://example.org/entity/Doğan_Media> a ex:Agent,
        ex:Organization ;
    ex:hasInception "1997"^^xsd:gYear .

