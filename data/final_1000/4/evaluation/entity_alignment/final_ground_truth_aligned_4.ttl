@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:John_Middleton_Murry a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Katherine_Mansfield .

entity:Katherine_Mansfield a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath entity:tuberculosis ;
    ex:hasSpouse entity:John_Middleton_Murry .

entity:tuberculosis a ex:CauseOfDeath .

