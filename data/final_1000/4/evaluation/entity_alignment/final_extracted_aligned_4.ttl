@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/John_Middleton_Murry> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Katherine_Mansfield> .

<http://example.org/entity/Katherine_Mansfield> a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath <http://example.org/entity/tuberculosis> ;
    ex:hasSpouse <http://example.org/entity/John_Middleton_Murry> .

<http://example.org/entity/tuberculosis> a ex:CauseOfDeath .

