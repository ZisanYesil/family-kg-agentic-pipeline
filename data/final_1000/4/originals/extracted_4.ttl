@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:john_midland_murry a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Middleton Murry" ;
    onto:hasSpouse data:katherine_mansfield .

data:extrapulmonary_tuberculosis a onto:CauseOfDeath,
        owl:NamedIndividual ;
    rdfs:label "extrapulmonary tuberculosis" .

data:katherine_mansfield a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Katherine Mansfield" ;
    onto:hasCauseOfDeath data:extrapulmonary_tuberculosis ;
    skos:altLabel "Katherine Mansfield",
        "Kathleen Mansfield Murry" .

