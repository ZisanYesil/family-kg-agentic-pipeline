@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:dillon_s_myer a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Dillon S. Myer" ;
    onto:hasBirthDate "1891-09-04"^^xsd:date ;
    onto:hasDeathDate "1982-10-21"^^xsd:date .

data:jean_de_bie a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jean de Bie" ;
    onto:hasBirthDate "1892-05-09"^^xsd:date ;
    onto:hasDeathDate "1961-04-30"^^xsd:date .

