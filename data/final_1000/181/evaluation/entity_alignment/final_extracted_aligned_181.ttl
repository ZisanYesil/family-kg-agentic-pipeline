@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Dillon_S_Myer> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1891-09-04"^^xsd:date ;
    ex:hasDeathDate "1982-10-21"^^xsd:date .

<http://example.org/entity/Jean_de_Bie> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1892-05-09"^^xsd:date ;
    ex:hasDeathDate "1961-04-30"^^xsd:date .

