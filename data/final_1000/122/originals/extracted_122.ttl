@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:guido_lauri a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Guido Lauri" ;
    onto:hasBirthDate "1922-11-23"^^xsd:date ;
    onto:hasDeathDate "2019-10-27"^^xsd:date .

data:joris_van_severen a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Joris Van Severen" ;
    onto:hasBirthDate "1894-07-19"^^xsd:date ;
    onto:hasDeathDate "1940-05-20"^^xsd:date .

