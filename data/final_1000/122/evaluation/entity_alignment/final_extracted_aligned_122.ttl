@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Guido_Lauri> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1922-11-23"^^xsd:date ;
    ex:hasDeathDate "2019-10-27"^^xsd:date .

<http://example.org/entity/Joris_Van_Severen> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1894-07-19"^^xsd:date ;
    ex:hasDeathDate "1940-05-20"^^xsd:date .

