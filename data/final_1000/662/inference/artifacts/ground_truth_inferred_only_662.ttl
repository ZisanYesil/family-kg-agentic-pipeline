@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Perpignan a ex:Place .

entity:Louis_of_France a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Philip_III_of_France .

entity:Philip_III_of_France a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Louis_of_France .

