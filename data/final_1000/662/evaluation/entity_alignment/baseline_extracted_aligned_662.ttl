@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Philip_III_of_France> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Philip III of France" ;
    onto:hasDeathPlace <http://example.org/entity/Perpignan> ;
    onto:hasFather <http://example.org/entity/Louis_of_France> .

<http://example.org/entity/Louis_of_France> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Louis of France (1264–1276)" .

<http://example.org/entity/Perpignan> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Perpignan" .

