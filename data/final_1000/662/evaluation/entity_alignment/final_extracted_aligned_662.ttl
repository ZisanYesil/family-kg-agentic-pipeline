@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Perpignan> a ex:Place .

<http://example.org/entity/Philip_III_of_France> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Perpignan> ;
    ex:hasFather <http://example.org/entity/Louis_of_France> ;
    ex:hasParent <http://example.org/entity/Louis_of_France> .

<http://example.org/entity/Louis_of_France> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Philip_III_of_France> .

