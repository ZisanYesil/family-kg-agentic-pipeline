@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:lettre_ouverte_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Lettre ouverte" ;
    onto:hasPublicationDate "1953"^^xsd:gYear .

data:woman_war_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Woman's War" ;
    onto:hasPublicationDate "1957"^^xsd:gYear .

