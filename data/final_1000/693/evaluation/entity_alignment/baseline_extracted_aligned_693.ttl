@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/A_Woman_s_War> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Woman's War" ;
    onto:hasPublicationDate "1957"^^xsd:gYear .

<http://example.org/entity/Lettre_ouverte> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Lettre ouverte" ;
    onto:hasPublicationDate "1953"^^xsd:gYear .

