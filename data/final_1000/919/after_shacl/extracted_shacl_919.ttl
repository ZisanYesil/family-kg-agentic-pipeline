@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:suwanda_denuna_jeewithe a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Suwanda Denuna Jeewithe" ;
    onto:hasDirector data:dhammika_siriwardana .

data:tjitra a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Tjitra" ;
    onto:hasDirector data:usmar_ismail .

data:dhammika_siriwardana a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Dhammika Siriwardana" ;
    onto:hasDeathDate "2015-12-15"^^xsd:date .

data:usmar_ismail a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Usmar Ismail" ;
    onto:hasDeathDate "1971-01-02"^^xsd:date .

