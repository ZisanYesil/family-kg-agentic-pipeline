@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Suwanda_Denuna_Jeewithe> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Dhammika_Siriwardana> ;
    ex:hasDirector <http://example.org/entity/Dhammika_Siriwardana> .

<http://example.org/entity/Tjitra> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Usmar_Ismail> ;
    ex:hasDirector <http://example.org/entity/Usmar_Ismail> .

<http://example.org/entity/Dhammika_Siriwardana> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2015-12-15"^^xsd:date .

<http://example.org/entity/Usmar_Ismail> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1971-01-02"^^xsd:date .

