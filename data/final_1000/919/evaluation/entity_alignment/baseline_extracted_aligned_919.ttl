@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Suwanda_Denuna_Jeewithe> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Suwanda Denuna Jeewithe" ;
    onto:hasDirector <http://example.org/entity/Dhammika_Siriwardana> .

<http://example.org/entity/Tjitra> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Tjitra" ;
    onto:hasDirector <http://example.org/entity/Usmar_Ismail> .

<http://example.org/entity/Dhammika_Siriwardana> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Dhammika Siriwardana" ;
    onto:hasDeathDate "2015-12-15"^^xsd:date .

<http://example.org/entity/Usmar_Ismail> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Usmar Ismail" ;
    onto:hasDeathDate "1971-01-02"^^xsd:date .

