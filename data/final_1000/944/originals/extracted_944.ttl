@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:song_you_can a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "You Can" ;
    onto:hasPerformer data:person_madleen_kane .

data:country_sweden a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Sweden" ;
    skos:altLabel "Swedish" .

data:person_madleen_kane a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Madleen Kane" ;
    onto:hasNationality data:country_sweden .

