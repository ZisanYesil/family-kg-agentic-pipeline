@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:You_Can a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Madleen_Kane ;
    ex:hasPerformer entity:Madleen_Kane .

entity:Madleen_Kane a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:Sweden ;
    ex:hasCountry entity:Sweden .

entity:Sweden a ex:Country,
        ex:Place .

