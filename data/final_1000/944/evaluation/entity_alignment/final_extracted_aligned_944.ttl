@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/You_Can> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Madleen_Kane> ;
    ex:hasPerformer <http://example.org/entity/Madleen_Kane> .

<http://example.org/entity/Madleen_Kane> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Sweden> ;
    ex:hasNationality <http://example.org/entity/Sweden> .

<http://example.org/entity/Sweden> a ex:Country,
        ex:Place .

