@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/irina_berezina> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1965-07-07"^^xsd:date ;
    ex:hasBirthPlace <http://example.org/extracted/kiev> ;
    ex:hasSpouse <http://example.org/extracted/vladimir_feldman> .

<http://example.org/extracted/kiev> a ex:Place .

<http://example.org/extracted/vladimir_feldman> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/extracted/irina_berezina> .

