@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:vladimir_feldman a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Vladimir Feldman" ;
    onto:hasSpouse data:irina_berezina .

data:irina_berezina a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Irina Berezina" ;
    onto:hasBirthDate "1965-07-07"^^xsd:date ;
    onto:hasBirthPlace data:kiev ;
    skos:altLabel "Irina Berezina-Feldman",
        "Irina Feldman" .

data:kiev a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Kiev" .

