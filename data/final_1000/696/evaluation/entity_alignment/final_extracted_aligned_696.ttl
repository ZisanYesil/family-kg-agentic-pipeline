@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/To_Light_a_Candle> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Maziar_Bahari> .

<http://example.org/entity/Maziar_Bahari> a ex:Agent,
        ex:Person ;
    ex:hasEmployer <http://example.org/entity/Newsweek> .

<http://example.org/entity/Newsweek> a ex:Agent,
        ex:Organization .

