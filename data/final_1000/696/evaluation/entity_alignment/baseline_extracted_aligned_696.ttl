@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/To_Light_a_Candle> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "To Light a Candle" ;
    onto:hasCreator <http://example.org/entity/Maziar_Bahari> .

<http://example.org/entity/Maziar_Bahari> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Maziar Bahari" ;
    onto:hasEmployer <http://example.org/entity/Newsweek> .

<http://example.org/entity/Newsweek> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Newsweek" .

