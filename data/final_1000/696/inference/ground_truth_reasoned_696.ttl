@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:To_Light_a_Candle a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Maziar_Bahari ;
    ex:hasDirector entity:Maziar_Bahari .

entity:Newsweek a ex:Agent,
        ex:Organization .

entity:Maziar_Bahari a ex:Agent,
        ex:Person ;
    ex:hasEmployer entity:Newsweek .

