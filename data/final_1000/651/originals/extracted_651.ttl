@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:song_moonlight_bay a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Moonlight Bay" ;
    onto:hasComposer data:person_percy_wenrich .

data:person_percy_wenrich a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Percy Wenrich" ;
    onto:hasDeathPlace data:place_new_york_city .

data:place_new_york_city a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "New York City" .

