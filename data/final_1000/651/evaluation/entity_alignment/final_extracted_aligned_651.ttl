@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/On_Moonlight_Bay> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasComposer <http://example.org/entity/Percy_Wenrich> ;
    ex:hasCreator <http://example.org/entity/Percy_Wenrich> .

<http://example.org/entity/New_York> a ex:Place .

<http://example.org/entity/Percy_Wenrich> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/New_York> .

