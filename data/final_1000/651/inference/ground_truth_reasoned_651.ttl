@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:On_Moonlight_Bay a ex:Artifact,
        ex:CreativeWork ;
    ex:hasComposer entity:Percy_Wenrich ;
    ex:hasCreator entity:Percy_Wenrich .

entity:New_York a ex:Place .

entity:Percy_Wenrich a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace entity:New_York .

