@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:I_Love_You_Beth_Cooper a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Chris_Columbus ;
    ex:hasDirector entity:Chris_Columbus .

entity:Tisch a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Chris_Columbus a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt entity:Tisch .

