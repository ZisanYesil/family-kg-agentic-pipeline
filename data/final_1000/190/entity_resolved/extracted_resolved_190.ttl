@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:san_clemente_brescia a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "San Clemente, Brescia" ;
    onto:hasCountry data:italy .

data:santi_apostoli_naples a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Santi Apostoli, Naples" ;
    onto:hasCountry data:italy .

data:italy a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Italy" .

