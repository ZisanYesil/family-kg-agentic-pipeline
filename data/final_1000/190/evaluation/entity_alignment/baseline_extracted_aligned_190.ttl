@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/San_Clemente_Brescia> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "San Clemente, Brescia" ;
    onto:hasCountry <http://example.org/entity/Italy> .

<http://example.org/entity/Santi_Apostoli_Naples> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Santi Apostoli, Naples" ;
    onto:hasCountry <http://example.org/entity/Italy> .

<http://example.org/entity/Italy> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Italy" .

