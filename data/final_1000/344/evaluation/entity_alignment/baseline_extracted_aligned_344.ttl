@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Henry_Strutt_2nd_Baron_Belper> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Henry Strutt, 2nd Baron Belper" ;
    onto:hasBirthDate "1840-05-20"^^xsd:date ;
    onto:hasDeathDate "1914-07-26"^^xsd:date .

<http://example.org/entity/Nina_Škottová> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nina Škottová" ;
    onto:hasBirthDate "1946-10-06"^^xsd:date ;
    onto:hasDeathDate "2018-04-28"^^xsd:date .

