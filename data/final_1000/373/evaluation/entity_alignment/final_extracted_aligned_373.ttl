@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Marie_Louise_of_Hesse_Kassel> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Maria_Amalia_of_Courland> ;
    ex:hasParent <http://example.org/entity/Maria_Amalia_of_Courland> .

<http://example.org/entity/Maria_Amalia_of_Courland> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Marie_Louise_of_Hesse_Kassel> ;
    ex:hasDeathDate "1711-06-16"^^xsd:date .

