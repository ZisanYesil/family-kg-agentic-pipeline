@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/fuego_song> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasComposer <http://example.org/extracted/alex_p> ;
    ex:hasCreator <http://example.org/extracted/alex_p> .

<http://example.org/extracted/alex_p> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1979-12-29"^^xsd:date .

