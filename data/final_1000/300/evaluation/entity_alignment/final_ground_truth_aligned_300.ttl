@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Fuego a ex:Artifact,
        ex:CreativeWork ;
    ex:hasComposer entity:Alex_P ;
    ex:hasCreator entity:Alex_P .

entity:Alex_P a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1979-12-29"^^xsd:date .

