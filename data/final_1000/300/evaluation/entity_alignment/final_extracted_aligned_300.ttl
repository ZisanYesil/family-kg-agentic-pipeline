@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Fuego> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasComposer <http://example.org/entity/Alex_P> ;
    ex:hasCreator <http://example.org/entity/Alex_P> .

<http://example.org/entity/Alex_P> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1979-12-29"^^xsd:date .

