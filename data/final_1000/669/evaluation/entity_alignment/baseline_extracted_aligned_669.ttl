@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Stary_Onokhoy> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Stary Onokhoy" ;
    onto:hasCountry <http://example.org/entity/Russia> .

<http://example.org/entity/Vtorye_Korosteli> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Vtorye Korosteli" ;
    onto:hasCountry <http://example.org/entity/Russia> .

<http://example.org/entity/Russia> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Russia" .

