@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:amanda_ruter_dufour a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Amanda Ruter Dufour" ;
    onto:hasBirthDate "1822-02-26"^^xsd:date ;
    onto:hasDeathDate "1899-05-29"^^xsd:date .

data:daniel_agnew a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Daniel Agnew" ;
    onto:hasBirthDate "1809-01-05"^^xsd:date ;
    onto:hasDeathDate "1902-03-09"^^xsd:date .

