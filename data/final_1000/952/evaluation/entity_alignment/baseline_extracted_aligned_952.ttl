@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Ruqayyah_bint_Husayn> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ruqayyah bint Al-Ḥusayn" ;
    onto:hasFather <http://example.org/entity/Husayn_ibn_Ali> .

<http://example.org/entity/Battle_of_Karbala> a onto:CauseOfDeath,
        owl:NamedIndividual ;
    rdfs:label "killed in the Battle of Karbala" .

<http://example.org/entity/Husayn_ibn_Ali> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Husayn ibn Ali" ;
    onto:hasCauseOfDeath <http://example.org/entity/Battle_of_Karbala> .

