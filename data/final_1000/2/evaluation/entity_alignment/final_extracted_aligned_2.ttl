@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Beat_Girl> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Edmond_T_Gréville> ;
    ex:hasDirector <http://example.org/entity/Edmond_T_Gréville> .

<http://example.org/entity/Nice> a ex:Place .

<http://example.org/entity/Edmond_T_Gréville> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Nice> .

