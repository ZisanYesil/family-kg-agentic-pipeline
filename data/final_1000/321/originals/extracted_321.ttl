@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:sophia_duleet_singh a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sophia Duleep Singh" ;
    onto:hasMother data:bamba_muller ;
    skos:altLabel "Princess Sophia Alexandrovna Duleep Singh",
        "Sophia Duleep Singh" .

data:bamba_muller a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bamba Müller" ;
    onto:hasDeathDate "1887-09-18"^^xsd:date ;
    skos:altLabel "Bamba Müller",
        "Lady Duleep Singh",
        "Maharani Bamba" .

