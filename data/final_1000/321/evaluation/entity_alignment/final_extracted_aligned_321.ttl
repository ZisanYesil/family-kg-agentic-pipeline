@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Princess_Sophia_Alexandrovna_Duleep_Singh> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Bamba_Müller> ;
    ex:hasParent <http://example.org/entity/Bamba_Müller> .

<http://example.org/entity/Bamba_Müller> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Princess_Sophia_Alexandrovna_Duleep_Singh> ;
    ex:hasDeathDate "1887-09-18"^^xsd:date .

