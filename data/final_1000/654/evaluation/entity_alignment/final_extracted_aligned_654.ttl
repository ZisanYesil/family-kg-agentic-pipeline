@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Safeguard> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher <http://example.org/entity/Thomson_Reuters> .

<http://example.org/entity/Canadian> a ex:Country,
        ex:Place .

<http://example.org/entity/Thomson_Reuters> a ex:Agent,
        ex:Organization ;
    ex:hasCountry <http://example.org/entity/Canadian> .

