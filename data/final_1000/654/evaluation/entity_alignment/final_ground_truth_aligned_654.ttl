@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Safeguard a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher entity:Thomson_Reuters .

entity:Canadian a ex:Country,
        ex:Place .

entity:Thomson_Reuters a ex:Agent,
        ex:Organization ;
    ex:hasCountry entity:Canadian .

