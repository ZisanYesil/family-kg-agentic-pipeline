@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Safeguard> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Safeguard (magazine)" ;
    onto:hasPublisher <http://example.org/entity/Thomson_Reuters> .

<http://example.org/entity/Canadian> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" ;
    skos:altLabel "Canadian" .

<http://example.org/entity/Thomson_Reuters> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Thomson Reuters" ;
    onto:hasCountry <http://example.org/entity/Canadian> ;
    skos:altLabel "Thomson Reuters Corporation" .

