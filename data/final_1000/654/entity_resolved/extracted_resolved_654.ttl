@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:safeguard_magazine a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Safeguard (magazine)" ;
    onto:hasPublisher data:thomson_reuters .

data:canada a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" ;
    skos:altLabel "Canadian" .

data:thomson_reuters a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Thomson Reuters" ;
    onto:hasCountry data:canada ;
    skos:altLabel "Thomson Reuters Corporation" .

