@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Cousin_from_Nowhere a ex:Artifact,
        ex:CreativeWork ;
    ex:hasComposer entity:Eduard_Künneke ;
    ex:hasCreator entity:Eduard_Künneke .

entity:Evelyn_Künneke a ex:Agent,
        ex:Person ;
