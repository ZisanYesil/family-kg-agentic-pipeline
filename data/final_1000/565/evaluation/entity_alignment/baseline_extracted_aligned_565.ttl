@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Eduard_Künneke> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Eduard Künneke" ;
    onto:hasBirthDate "1885-01-27"^^xsd:date ;
    onto:hasDaughter <http://example.org/entity/Evelyn_Künneke> ;
    onto:hasDeathDate "1953-10-27"^^xsd:date .

<http://example.org/entity/The_Cousin_from_Nowhere> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Cousin From Nowhere (1953 film)" .

<http://example.org/entity/Evelyn_Künneke> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Evelyn Künneke" .

