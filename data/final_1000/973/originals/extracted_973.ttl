@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:for_a_few_extra_dollars a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "For a Few Extra Dollars" ;
    onto:hasCountryOfOrigin data:italy .

data:vendetta_di_zingara a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Vendetta di zingara" ;
    onto:hasCountryOfOrigin data:italy .

data:italy a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Italy" ;
    skos:altLabel "Italian" .

