@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Lucius_Tarquinius_Collatinus a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Lucretia .

entity:Spurius_Lucretius_Tricipitinus a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Lucretia .

entity:Lucretia a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Spurius_Lucretius_Tricipitinus ;
    ex:hasSpouse entity:Lucius_Tarquinius_Collatinus .

