@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Lucretia> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lucretia" ;
    onto:hasFather <http://example.org/entity/Spurius_Lucretius_Tricipitinus> ;
    onto:hasSpouse <http://example.org/entity/Lucius_Tarquinius_Collatinus> .

<http://example.org/entity/Lucius_Tarquinius_Collatinus> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lucius Tarquinius Collatinus" .

<http://example.org/entity/Spurius_Lucretius_Tricipitinus> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Spurius Lucretius Tricipitinus" .

