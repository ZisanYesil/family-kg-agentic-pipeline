@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Awesome_I_Fuckin_Shot_That> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Awesome; I Fuckin' Shot That!" ;
    onto:hasDirector <http://example.org/entity/Adam_Yauch> .

<http://example.org/entity/Adam_Yauch> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Adam Yauch" ;
    onto:hasCauseOfDeath <http://example.org/entity/cancer> ;
    skos:altLabel "Adam Nathaniel Yauch" .

<http://example.org/entity/cancer> a onto:CauseOfDeath,
        owl:NamedIndividual ;
    rdfs:label "parotid cancer" .

