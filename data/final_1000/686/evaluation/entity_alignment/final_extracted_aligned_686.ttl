@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Awesome_I_Fuckin_Shot_That> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Adam_Yauch> ;
    ex:hasDirector <http://example.org/entity/Adam_Yauch> .

<http://example.org/entity/cancer> a ex:CauseOfDeath .

<http://example.org/entity/Adam_Yauch> a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath <http://example.org/entity/cancer> .

