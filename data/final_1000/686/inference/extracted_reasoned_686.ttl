@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/awesome_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/adam_yauch> ;
    ex:hasDirector <http://example.org/extracted/adam_yauch> .

<http://example.org/extracted/parotid_cancer> a ex:CauseOfDeath .

<http://example.org/extracted/adam_yauch> a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath <http://example.org/extracted/parotid_cancer> .

