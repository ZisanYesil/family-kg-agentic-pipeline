@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Awesome_I_Fuckin_Shot_That a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Adam_Yauch ;
    ex:hasDirector entity:Adam_Yauch .

entity:cancer a ex:CauseOfDeath .

entity:Adam_Yauch a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath entity:cancer .

