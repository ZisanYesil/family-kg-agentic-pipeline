@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Balliol_College> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Margaret_Simey> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Tom_Simey> .

<http://example.org/entity/Tom_Simey> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/Balliol_College> ;
    ex:hasSpouse <http://example.org/entity/Margaret_Simey> .

