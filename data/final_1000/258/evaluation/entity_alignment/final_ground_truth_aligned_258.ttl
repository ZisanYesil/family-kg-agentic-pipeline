        ex:EducationalInstitution,
        ex:Organization .

entity:Margaret_Simey a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Tom_Simey .

entity:Tom_Simey a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Margaret_Simey .

