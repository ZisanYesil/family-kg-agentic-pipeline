@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Thomas_Spensley_Simey a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt entity:Balliol_College .

