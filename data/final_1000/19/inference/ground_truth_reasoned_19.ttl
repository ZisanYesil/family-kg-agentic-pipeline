@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Edward_I_of_England a ex:Agent,
        ex:Person ;
    ex:hasFather entity:Henry_III ;
    ex:hasParent entity:Henry_III .

entity:Eleanor_of_Provence a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Henry_III .

entity:Henry_III a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Edward_I_of_England ;
    ex:hasSpouse entity:Eleanor_of_Provence .

