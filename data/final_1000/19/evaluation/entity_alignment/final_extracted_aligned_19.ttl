@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Edward_I_of_England> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Henry_III> ;
    ex:hasParent <http://example.org/entity/Henry_III> .

<http://example.org/entity/Eleanor_of_Provence> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Henry_III> .

<http://example.org/entity/Henry_III> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Edward_I_of_England> ;
    ex:hasSpouse <http://example.org/entity/Eleanor_of_Provence> .

