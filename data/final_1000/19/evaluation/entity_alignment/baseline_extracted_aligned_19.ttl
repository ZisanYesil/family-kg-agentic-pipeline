@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Edward_I_of_England> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Edward I of England" ;
    onto:hasFather <http://example.org/entity/Henry_III> .

<http://example.org/entity/Eleanor_of_Provence> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Eleanor of Provence" .

<http://example.org/entity/Henry_III> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Henry III of England" ;
    onto:hasSpouse <http://example.org/entity/Eleanor_of_Provence> .

