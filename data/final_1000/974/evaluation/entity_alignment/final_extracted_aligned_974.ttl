@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Æthelric> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Æthelmund> ;
    ex:hasParent <http://example.org/entity/Æthelmund> .

<http://example.org/entity/Æthelmund> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Æthelric> ;
    ex:hasDeathDate "0802"^^xsd:gYear .

