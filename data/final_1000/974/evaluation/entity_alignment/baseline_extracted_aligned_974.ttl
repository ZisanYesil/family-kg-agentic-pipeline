@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Æthelric> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Æthelric" ;
    onto:hasFather <http://example.org/entity/Æthelmund> ;
    skos:altLabel "Æthelric son of Æthelmund" .

<http://example.org/entity/Æthelmund> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Æthelmund" ;
    onto:hasDeathDate "0802"^^xsd:gYear .

