@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:motu_hafoka a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Motu Hafoka" ;
    onto:hasBirthDate "1987-03-13"^^xsd:date ;
    onto:hasDeathDate "2012-06-30"^^xsd:date .

data:wilhelm_meise a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Wilhelm Meise" ;
    onto:hasBirthDate "1901-09-12"^^xsd:date ;
    onto:hasDeathDate "2002-08-24"^^xsd:date .

