@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_disaster_movie a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Disaster Movie" ;
    onto:hasCountry data:country_united_states .

data:film_hacker a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Hacker" .

data:country_united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

