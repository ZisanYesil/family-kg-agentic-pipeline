@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Disaster_Movie a ex:Artifact ;
    ex:hasCountry entity:American ;
    ex:hasCountryOfOrigin entity:American .

entity:Hacker_film a ex:Artifact ;
    ex:hasCountry entity:Hong_Kong ;
    ex:hasCountryOfOrigin entity:Hong_Kong .

entity:American a ex:Country,
        ex:Place .

entity:Hong_Kong a ex:Country,
        ex:Place .

