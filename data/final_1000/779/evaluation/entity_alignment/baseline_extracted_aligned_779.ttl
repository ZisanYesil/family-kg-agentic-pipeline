@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Disaster_Movie> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Disaster Movie" ;
    onto:hasCountry <http://example.org/entity/American> .

<http://example.org/entity/Hacker_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Hacker" .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

