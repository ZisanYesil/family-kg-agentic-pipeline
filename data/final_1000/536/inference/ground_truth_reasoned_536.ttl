@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Army a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Helen_Dortch_Longstreet a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:James_Longstreet .

entity:James_Longstreet a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt entity:Army ;
    ex:hasSpouse entity:Helen_Dortch_Longstreet .

