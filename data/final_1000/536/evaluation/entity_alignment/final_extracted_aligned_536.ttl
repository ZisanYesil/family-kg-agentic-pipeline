@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Army> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Helen_Dortch_Longstreet> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/James_Longstreet> .

<http://example.org/entity/James_Longstreet> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/Army> ;
    ex:hasSpouse <http://example.org/entity/Helen_Dortch_Longstreet> .

