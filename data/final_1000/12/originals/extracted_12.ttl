@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:pleshkovo_altai_krai a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Pleshkovo" ;
    onto:hasCountry data:russia .

data:tomskoye_amur_oblast a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Tomskoye" ;
    onto:hasCountry data:russia .

data:russia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Russia" .

