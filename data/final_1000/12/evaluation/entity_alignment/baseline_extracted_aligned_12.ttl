@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Pleshkovo> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Pleshkovo" ;
    onto:hasCountry <http://example.org/entity/Russia> .

<http://example.org/entity/Tomskoye_Amur_Oblast> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Tomskoye" ;
    onto:hasCountry <http://example.org/entity/Russia> .

<http://example.org/entity/Russia> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Russia" .

