@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Brisa_Auto_estradas_de_Portugal> a ex:Agent,
        ex:Organization ;
    ex:hasFounder <http://example.org/entity/Jorge_de_Brito> .

<http://example.org/entity/Jorge_de_Brito> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/extracted/place_lisbon> .

<http://example.org/extracted/place_lisbon> a ex:Place .

