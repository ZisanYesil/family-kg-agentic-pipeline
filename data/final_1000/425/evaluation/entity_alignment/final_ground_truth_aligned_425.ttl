@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Brisa_Auto_estradas_de_Portugal a ex:Agent,
        ex:Organization ;
    ex:hasFounder entity:Jorge_de_Brito .

entity:Jorge_de_Brito a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace entity:Prazeres .

entity:Prazeres a ex:Place .

