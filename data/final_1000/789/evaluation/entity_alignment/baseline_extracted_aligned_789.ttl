@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Curly_Seckler> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Curly Seckler" ;
    onto:hasBirthDate "1919-12-25"^^xsd:date ;
    onto:hasDeathDate "2017-12-27"^^xsd:date ;
    skos:altLabel "John Ray Sechler" .

<http://example.org/entity/James_Flack_Norris> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "James Flack Norris" ;
    onto:hasBirthDate "1871-01-20"^^xsd:date ;
    onto:hasDeathDate "1940-08-04"^^xsd:date .

