@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/apne_dam_par> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/arshad_khan> ;
    ex:hasDirector <http://example.org/extracted/arshad_khan> .

<http://example.org/extracted/cela_s_appele_l_aurore> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/luis_bunuel> ;
    ex:hasDirector <http://example.org/extracted/luis_bunuel> .

<http://example.org/extracted/arshad_khan> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1971-03-22"^^xsd:date .

<http://example.org/extracted/luis_bunuel> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1900-02-22"^^xsd:date .

