@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Apne_Dam_Par> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Apne Dam Par" ;
    onto:hasDirector <http://example.org/entity/Arshad_Khan> .

<http://example.org/entity/Cela_s_appelle_l_aurore> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Cela s'appelle l'aurore" ;
    onto:hasDirector <http://example.org/entity/Luis_Buñuel> .

<http://example.org/entity/Arshad_Khan> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Arshad Khan" ;
    onto:hasBirthDate "1971-03-22"^^xsd:date .

<http://example.org/entity/Luis_Buñuel> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Luis Buñuel" ;
    onto:hasBirthDate "1900-02-22"^^xsd:date .

