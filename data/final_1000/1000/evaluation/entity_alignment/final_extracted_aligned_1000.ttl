@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Apne_Dam_Par> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Arshad_Khan> ;
    ex:hasDirector <http://example.org/entity/Arshad_Khan> .

<http://example.org/entity/Cela_s_appelle_l_aurore> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Luis_Buñuel> ;
    ex:hasDirector <http://example.org/entity/Luis_Buñuel> .

<http://example.org/entity/Arshad_Khan> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1971-03-22"^^xsd:date .

<http://example.org/entity/Luis_Buñuel> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1900-02-22"^^xsd:date .

