@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:brisk_island a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Brisk Island" ;
    onto:hasCountry data:australia .

data:churchill_island a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Churchill Island" ;
    onto:hasCountry data:australia .

data:australia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Australia" ;
    skos:altLabel "Australia" .

