@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Brisk_Island> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Brisk Island" ;
    onto:hasCountry <http://example.org/entity/Australia> .

<http://example.org/entity/Churchill_Island> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Churchill Island" ;
    onto:hasCountry <http://example.org/entity/Australia> .

<http://example.org/entity/Australia> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Australia" ;
    skos:altLabel "Australia" .

