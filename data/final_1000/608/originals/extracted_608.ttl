@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:antonieta_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Antonieta" ;
    onto:hasPublicationDate "1982"^^xsd:gYear .

data:autumn_milk_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Autumn Milk" ;
    onto:hasPublicationDate "1988"^^xsd:gYear .

