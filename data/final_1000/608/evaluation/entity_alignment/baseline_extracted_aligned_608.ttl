@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Antonieta> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Antonieta" ;
    onto:hasPublicationDate "1982"^^xsd:gYear .

<http://example.org/entity/Autumn_Milk> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Autumn Milk" ;
    onto:hasPublicationDate "1988"^^xsd:gYear .

