@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Devils_Rope_Barbed_Wire_Museum> a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Devils Rope Barbed Wire Museum" ;
    onto:hasCountry <http://example.org/entity/United_States> ;
    skos:altLabel "Devils Rope Barbed Wire Museum" .

<http://example.org/entity/Museum_of_Primitive_Art_and_Culture> a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Museum of Primitive Art and Culture" ;
    onto:hasCountry <http://example.org/entity/United_States> ;
    skos:altLabel "Museum of Primitive Art and Culture" .

<http://example.org/entity/United_States> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "United States" .

