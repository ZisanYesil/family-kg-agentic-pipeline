@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:devils_rope_museum a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Devils Rope Barbed Wire Museum" ;
    onto:hasCountry data:united_states ;
    skos:altLabel "Devils Rope Barbed Wire Museum" .

data:primitive_art_museum a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Museum of Primitive Art and Culture" ;
    onto:hasCountry data:united_states ;
    skos:altLabel "Museum of Primitive Art and Culture" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "United States" .

