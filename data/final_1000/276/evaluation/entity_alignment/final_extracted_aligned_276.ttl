@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Zoia_Ceaușescu> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Nicolae_Ceaușescu> ;
    ex:hasParent <http://example.org/entity/Nicolae_Ceaușescu> .

<http://example.org/entity/firing_squad> a ex:CauseOfDeath .

<http://example.org/entity/Nicolae_Ceaușescu> a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath <http://example.org/entity/firing_squad> ;
    ex:hasChild <http://example.org/entity/Zoia_Ceaușescu> .

