@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Gillian_Blake> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gillian Blake" ;
    onto:hasSpouse <http://example.org/entity/Peter_Whitbread> .

<http://example.org/entity/Gresham_s_School> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Gresham's School" ;
    skos:altLabel "Gresham's School, Holt, Norfolk" .

<http://example.org/entity/Peter_Whitbread> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Peter Whitbread" ;
    onto:hasEducatedAt <http://example.org/entity/Gresham_s_School> .

