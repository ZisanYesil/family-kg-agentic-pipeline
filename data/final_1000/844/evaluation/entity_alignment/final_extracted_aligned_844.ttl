@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Gillian_Blake> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Peter_Whitbread> .

<http://example.org/entity/Gresham_s_School> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Peter_Whitbread> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/Gresham_s_School> ;
    ex:hasSpouse <http://example.org/entity/Gillian_Blake> .

