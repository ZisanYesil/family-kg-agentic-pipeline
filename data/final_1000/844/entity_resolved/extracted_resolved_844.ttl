@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:gillian_blake a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gillian Blake" ;
    onto:hasSpouse data:peter_whitbread .

data:greshams_school_holt a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Gresham's School" ;
    skos:altLabel "Gresham's School, Holt, Norfolk" .

data:peter_whitbread a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Peter Whitbread" ;
    onto:hasEducatedAt data:greshams_school_holt .

