@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/gillian_blake> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/extracted/peter_whitbread> .

<http://example.org/extracted/greshams_school_holt> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/extracted/peter_whitbread> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/extracted/greshams_school_holt> ;
    ex:hasSpouse <http://example.org/extracted/gillian_blake> .

