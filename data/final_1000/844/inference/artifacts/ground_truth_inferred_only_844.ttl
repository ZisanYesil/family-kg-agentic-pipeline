@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Gresham_s_School a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Peter_Whitbread a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Gillian_Blake .

