@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:franklin_edson a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Franklin Edson" ;
    onto:hasBirthDate "1832-04-05"^^xsd:date ;
    onto:hasDeathDate "1904-09-24"^^xsd:date .

data:martino_finotto a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Martino Finotto" ;
    onto:hasBirthDate "1933-11-11"^^xsd:date ;
    onto:hasDeathDate "2014-08-13"^^xsd:date .

