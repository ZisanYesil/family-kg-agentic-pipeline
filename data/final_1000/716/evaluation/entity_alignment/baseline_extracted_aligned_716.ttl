@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/George_F_Sowers> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "George F. Sowers" ;
    onto:hasBirthDate "1921-09-23"^^xsd:date ;
    onto:hasDeathDate "1996-10-23"^^xsd:date .

<http://example.org/entity/Henrietta_Amelia_Leeson> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Henrietta Amelia Leeson" ;
    onto:hasBirthDate "1751"^^xsd:gYear ;
    onto:hasDeathDate "1826-12-06"^^xsd:date .

