@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Auguste_Tessier> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Ulric_Joseph_Tessier> ;
    ex:hasParent <http://example.org/entity/Ulric_Joseph_Tessier> .

<http://example.org/entity/Cimetière_Notre_Dame_de_Belmont> a ex:Place .

<http://example.org/entity/Ulric_Joseph_Tessier> a ex:Agent,
        ex:Person ;
    ex:hasBurialPlace <http://example.org/entity/Cimetière_Notre_Dame_de_Belmont> ;
    ex:hasChild <http://example.org/entity/Auguste_Tessier> .

