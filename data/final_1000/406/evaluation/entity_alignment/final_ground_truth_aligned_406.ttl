@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Temple_Lea_Houston a ex:Agent,
        ex:Person ;
    ex:hasMother entity:Margaret_Lea_Houston ;
    ex:hasParent entity:Margaret_Lea_Houston .

entity:yellow_fever a ex:CauseOfDeath .

entity:Margaret_Lea_Houston a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath entity:yellow_fever ;
    ex:hasChild entity:Temple_Lea_Houston .

