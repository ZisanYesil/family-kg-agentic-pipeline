@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:jack_klugman a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jack Klugman" ;
    onto:hasBirthDate "1922-04-27"^^xsd:date ;
    onto:hasDeathDate "2012-12-24"^^xsd:date .

data:rembrandt_bugatti a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Rembrandt Bugatti" ;
    onto:hasBirthDate "1884-10-16"^^xsd:date ;
    onto:hasDeathDate "1916-01-08"^^xsd:date .

