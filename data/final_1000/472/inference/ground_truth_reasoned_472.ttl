@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Picturegoer a ex:Agent,
        ex:Organization ;
    ex:hasInception "1911"^^xsd:gYear .

entity:Scribner_s_Monthly a ex:Agent,
        ex:Organization ;
    ex:hasInception "1870"^^xsd:gYear .

