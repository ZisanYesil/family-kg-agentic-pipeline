@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:picturegoer_1911 a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Picturegoer" ;
    onto:hasPublicationDate "1911"^^xsd:gYear .

data:scribners_monthly_1870 a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Scribner's Monthly" ;
    onto:hasPublicationDate "1870"^^xsd:gYear .

