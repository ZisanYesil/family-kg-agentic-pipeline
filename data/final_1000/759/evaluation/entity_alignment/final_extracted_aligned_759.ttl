@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Thundergate> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Joseph_De_Grasse> ;
    ex:hasDirector <http://example.org/entity/Joseph_De_Grasse> .

<http://example.org/entity/New_Brunswick> a ex:Place .

<http://example.org/entity/Joseph_De_Grasse> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/New_Brunswick> .

