@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Thundergate a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Joseph_De_Grasse ;
    ex:hasDirector entity:Joseph_De_Grasse .

entity:New_Brunswick a ex:Place .

entity:Joseph_De_Grasse a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:New_Brunswick .

