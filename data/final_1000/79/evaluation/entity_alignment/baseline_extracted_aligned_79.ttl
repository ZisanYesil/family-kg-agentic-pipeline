@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/A_French_Gigolo> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A French Gigolo" ;
    onto:hasDirector <http://example.org/entity/Josiane_Balasko> .

<http://example.org/entity/Temptation_1929_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Temptation (1929 film)" ;
    onto:hasDirector <http://example.org/entity/René_Barberis> .

<http://example.org/entity/Josiane_Balasko> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Josiane Balasko" ;
    onto:hasNationality <http://example.org/entity/French> .

<http://example.org/entity/René_Barberis> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "René Barberis" ;
    onto:hasNationality <http://example.org/entity/French> .

<http://example.org/entity/French> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

