@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/The_Roller_Blade_Seven> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Roller Blade Seven" ;
    onto:hasDirector <http://example.org/entity/Donald_G_Jackson> .

<http://example.org/entity/Donald_G_Jackson> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Donald G. Jackson" ;
    onto:hasBurialPlace <http://example.org/entity/Westwood_Village_Memorial_Park_Cemetery> .

<http://example.org/entity/Westwood_Village_Memorial_Park_Cemetery> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Westwood Village Memorial Park Cemetery" .

