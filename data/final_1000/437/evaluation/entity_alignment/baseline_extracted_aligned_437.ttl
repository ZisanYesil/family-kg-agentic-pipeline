@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Mere_Rashke_Qamar> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Mere Rashke Qamar" ;
    onto:hasComposer <http://example.org/entity/Nusrat_Fateh_Ali_Khan> .

<http://example.org/entity/Nusrat_Fateh_Ali_Khan> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nusrat Fateh Ali Khan" ;
    onto:hasNationality <http://example.org/entity/Pakistan> .

<http://example.org/entity/Pakistan> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Pakistan" ;
    skos:altLabel "Pakistani" .

