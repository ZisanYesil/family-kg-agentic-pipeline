@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:song_mere_rashke_qamar a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Mere Rashke Qamar" ;
    onto:hasComposer data:person_nusrat_fateh_ali_khan .

data:country_pakistan a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Pakistan" ;
    skos:altLabel "Pakistani" .

data:person_nusrat_fateh_ali_khan a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nusrat Fateh Ali Khan" ;
    onto:hasNationality data:country_pakistan .

