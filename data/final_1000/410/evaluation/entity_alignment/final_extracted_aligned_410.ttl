@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/I_Believe_in_Music> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Mac_Davis> ;
    ex:hasPerformer <http://example.org/entity/Mac_Davis> .

<http://example.org/entity/Lubbock_Texas> a ex:Place .

<http://example.org/entity/Mac_Davis> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Lubbock_Texas> .

