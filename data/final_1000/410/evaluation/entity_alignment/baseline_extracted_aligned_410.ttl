@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/I_Believe_in_Music> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "I Believe in Music" ;
    onto:hasPerformer <http://example.org/entity/Mac_Davis> ;
    skos:altLabel "I Believe in Music (song)" .

<http://example.org/entity/Lubbock_Texas> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Lubbock, Texas, United States" .

<http://example.org/entity/Mac_Davis> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mac Davis" ;
    onto:hasBirthPlace <http://example.org/entity/Lubbock_Texas> ;
    skos:altLabel "Morris Mac Davis" .

