@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Louis_Count_of_Verdun> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Otto_I_Count_of_Chiny> ;
    ex:hasParent <http://example.org/entity/Otto_I_Count_of_Chiny> .

<http://example.org/entity/Gerberge_of_Lorraine> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Otto_I_Count_of_Chiny> .

<http://example.org/entity/Otto_I_Count_of_Chiny> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Louis_Count_of_Verdun> ;
    ex:hasMother <http://example.org/entity/Gerberge_of_Lorraine> ;
    ex:hasParent <http://example.org/entity/Gerberge_of_Lorraine> .

