@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:lady_in_a_cage_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Lady in a Cage" ;
    onto:hasPublicationDate "1964"^^xsd:gYear .

data:russian_souvenir_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Russian Souvenir" ;
    onto:hasPublicationDate "1960"^^xsd:gYear .

