@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Lady_in_a_Cage a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublicationDate "1964"^^xsd:gYear .

entity:Russian_Souvenir a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublicationDate "1960"^^xsd:gYear .

