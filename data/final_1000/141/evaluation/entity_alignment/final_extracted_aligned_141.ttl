@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Lady_in_a_Cage> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasPublicationDate "1964"^^xsd:gYear .

<http://example.org/entity/Russian_Souvenir> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasPublicationDate "1960"^^xsd:gYear .

