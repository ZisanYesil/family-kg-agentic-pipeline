@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Lady_in_a_Cage> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Lady in a Cage" ;
    onto:hasPublicationDate "1964"^^xsd:gYear .

<http://example.org/entity/Russian_Souvenir> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Russian Souvenir" ;
    onto:hasPublicationDate "1960"^^xsd:gYear .

