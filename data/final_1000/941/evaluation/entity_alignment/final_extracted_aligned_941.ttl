@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Dog_Pound> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Kim_Chapiron> ;
    ex:hasDirector <http://example.org/entity/Kim_Chapiron> .

<http://example.org/entity/France> a ex:Country,
        ex:Place .

<http://example.org/entity/Kim_Chapiron> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/France> ;
    ex:hasNationality <http://example.org/entity/France> .

