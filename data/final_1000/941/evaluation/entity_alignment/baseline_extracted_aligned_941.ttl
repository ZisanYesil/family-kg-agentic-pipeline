@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Dog_Pound> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Dog Pound" ;
    onto:hasDirector <http://example.org/entity/Kim_Chapiron> .

<http://example.org/entity/France> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

<http://example.org/entity/Kim_Chapiron> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Kim Chapiron" ;
    onto:hasNationality <http://example.org/entity/France> .

