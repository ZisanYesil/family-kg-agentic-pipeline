@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:dog_pound_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Dog Pound" ;
    onto:hasDirector data:kim_chapiron .

data:france a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

data:kim_chapiron a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Kim Chapiron" ;
    onto:hasNationality data:france .

