@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Dog_Pound a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Kim_Chapiron .

entity:France a ex:Country,
        ex:Place .

entity:Kim_Chapiron a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:France .

