@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:trudeliese_schmidt a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Trudeliese Schmidt" ;
    onto:hasBirthDate "1942-11-07"^^xsd:date ;
    onto:hasDeathDate "2004-06-24"^^xsd:date ;
    skos:altLabel "Trudeliese Schmidt" .

data:yardena_alotin a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Yardena Alotin" ;
    onto:hasBirthDate "1930-04-19"^^xsd:date ;
    onto:hasDeathDate "1994-10-04"^^xsd:date ;
    skos:altLabel "Yardena Alotin" .

