@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:expedition_impossible_tv_series a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Expedition Impossible" ;
    onto:hasCreator data:mark_burnett .

data:mark_burnett a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mark Burnett" ;
    onto:hasNationality data:united_kingdom .

data:united_kingdom a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

