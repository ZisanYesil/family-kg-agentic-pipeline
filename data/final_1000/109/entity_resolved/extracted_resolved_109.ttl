@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_the_christian_licorice_store a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Christian Licorice Store" ;
    onto:hasCountryOfOrigin data:country_united_states .

data:film_the_crime_of_korea a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Crime of Korea" ;
    onto:hasCountryOfOrigin data:country_united_states .

data:country_united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

