@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/The_Christian_Licorice_Store> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Christian Licorice Store" ;
    onto:hasCountryOfOrigin <http://example.org/entity/American> .

<http://example.org/entity/The_Crime_of_Korea> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Crime of Korea" ;
    onto:hasCountryOfOrigin <http://example.org/entity/American> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

