@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Christian_Licorice_Store a ex:Artifact ;
    ex:hasCountry entity:American ;
    ex:hasCountryOfOrigin entity:American .

entity:The_Crime_of_Korea a ex:Artifact ;
    ex:hasCountry entity:US ;
    ex:hasCountryOfOrigin entity:US .

entity:American a ex:Country,
        ex:Place .

entity:US a ex:Country,
        ex:Place .

