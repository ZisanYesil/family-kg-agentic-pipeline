@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Codine a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Henri_Colpi ;
    ex:hasDirector entity:Henri_Colpi .

entity:Gold_Frankincense_and_Myrrh a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Ante_Babaja ;
    ex:hasDirector entity:Ante_Babaja .

entity:Ante_Babaja a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2010-01-14"^^xsd:date .

entity:Henri_Colpi a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2006-01-14"^^xsd:date .

