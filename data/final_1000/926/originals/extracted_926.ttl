@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_codine a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Codine" ;
    onto:hasDirector data:person_henri_colpi .

data:film_gold_frankincense_and_myrrh a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Gold, Frankincense and Myrrh" ;
    onto:hasDirector data:person_ante_babaja .

data:person_ante_babaja a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ante Babaja" ;
    onto:hasBirthDate "1927-10-06"^^xsd:date ;
    onto:hasDeathDate "2010-01-14"^^xsd:date .

data:person_henri_colpi a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Henri Colpi" ;
    onto:hasBirthDate "1921-07-15"^^xsd:date ;
    onto:hasDeathDate "2006-01-14"^^xsd:date .

