@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Codine> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Henri_Colpi> ;
    ex:hasDirector <http://example.org/entity/Henri_Colpi> .

<http://example.org/entity/Gold_Frankincense_and_Myrrh> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Ante_Babaja> ;
    ex:hasDirector <http://example.org/entity/Ante_Babaja> .

<http://example.org/entity/Ante_Babaja> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1927-10-06"^^xsd:date ;
    ex:hasDeathDate "2010-01-14"^^xsd:date .

<http://example.org/entity/Henri_Colpi> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1921-07-15"^^xsd:date ;
    ex:hasDeathDate "2006-01-14"^^xsd:date .

