@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Abdülaziz> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Constantinople> ;
    ex:hasSpouse <http://example.org/entity/Edadil_Kadın> .

<http://example.org/entity/Constantinople> a ex:Place .

<http://example.org/entity/Edadil_Kadın> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Abdülaziz> .

