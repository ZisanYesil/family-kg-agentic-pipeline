@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Edadil_Kadın> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Edadil Kadın" ;
    onto:hasSpouse <http://example.org/entity/Abdülaziz> .

<http://example.org/entity/Abdülaziz> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Abdülaziz" ;
    onto:hasBirthPlace <http://example.org/entity/Constantinople> .

<http://example.org/entity/Constantinople> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Eyüp Palace, Constantinople (present‑day Istanbul)" .

