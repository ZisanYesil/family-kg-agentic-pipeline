@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Abdülaziz a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Constantinople ;
    ex:hasSpouse entity:Edadil_Kadın .

entity:Constantinople a ex:Place .

entity:Edadil_Kadın a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Abdülaziz .

