@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Johann_Adolf_of_Saxe_Gotha_Altenburg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Johann Adolf of Saxe-Gotha-Altenburg" ;
    onto:hasBirthDate "1721-05-18"^^xsd:date ;
    onto:hasDeathDate "1799-04-29"^^xsd:date .

<http://example.org/entity/Jules_Brunet> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jules Brunet" ;
    onto:hasBirthDate "1838-01-02"^^xsd:date ;
    onto:hasDeathDate "1911-08-12"^^xsd:date .

