@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Smiles_of_a_Summer_Night> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Smiles of a Summer Night" ;
    onto:hasPublicationDate "1955"^^xsd:gYear .

<http://example.org/entity/Two_Idiots_in_Hollywood> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Two Idiots in Hollywood" ;
    onto:hasPublicationDate "1988"^^xsd:gYear .

