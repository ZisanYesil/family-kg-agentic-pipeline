@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:smiles_of_a_summer_night_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Smiles of a Summer Night" ;
    onto:hasPublicationDate "1955"^^xsd:gYear .

data:two_idiots_in_hollywood_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Two Idiots in Hollywood" ;
    onto:hasPublicationDate "1988"^^xsd:gYear .

