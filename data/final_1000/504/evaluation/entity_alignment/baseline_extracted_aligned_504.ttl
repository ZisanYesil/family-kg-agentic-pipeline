@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Heart_of_Paris> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Heart of Paris" ;
    onto:hasPublicationDate "1932"^^xsd:gYear ;
    skos:altLabel "Coeur de Paris" .

<http://example.org/entity/Padithal_Mattum_Podhuma> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Padithal Mattum Podhuma" ;
    onto:hasPublicationDate "1962-04-14"^^xsd:date ;
    skos:altLabel "Padithaal Mattum Podhuma" .

