@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Universidad_Militar_Bolivariana_de_Venezuela> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization ;
    ex:hasFounder <http://example.org/entity/Hugo_Chávez> .

<http://example.org/entity/Hugo_Chávez> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Sabaneta> .

<http://example.org/entity/Sabaneta> a ex:Place .

