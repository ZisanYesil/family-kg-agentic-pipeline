@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Universidad_Militar_Bolivariana_de_Venezuela> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Bolivarian Military University of Venezuela" ;
    onto:hasFounder <http://example.org/entity/Hugo_Chávez> .

<http://example.org/entity/Hugo_Chávez> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hugo Chávez" ;
    onto:hasBirthPlace <http://example.org/entity/Sabaneta> ;
    skos:altLabel "Hugo Rafael Chávez Frías" .

<http://example.org/entity/Sabaneta> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Sabaneta, Barinas" .

