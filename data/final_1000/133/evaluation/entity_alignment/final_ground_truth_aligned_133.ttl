@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Universidad_Militar_Bolivariana_de_Venezuela a ex:Agent,
        ex:Organization ;
    ex:hasFounder entity:Hugo_Chávez .

entity:Hugo_Chávez a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Sabaneta .

entity:Sabaneta a ex:Place .

