@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Brera_Academy a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Enzo_Mari a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Michele_Mari .

entity:Michele_Mari a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Enzo_Mari .

