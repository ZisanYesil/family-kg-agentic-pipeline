@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Brera_Academy> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Michele_Mari> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Enzo_Mari> ;
    ex:hasParent <http://example.org/entity/Enzo_Mari> .

<http://example.org/entity/Enzo_Mari> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Michele_Mari> ;
    ex:hasEducatedAt <http://example.org/entity/Brera_Academy> .

