@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/James_Scudamore_3rd_Viscount_Scudamore> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "James Scudamore, 3rd Viscount Scudamore" ;
    onto:hasFather <http://example.org/entity/John_Scudamore_2nd_Viscount_Scudamore> .

<http://example.org/entity/Jane_Bennet> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jane Bennet" .

<http://example.org/entity/John_Scudamore_2nd_Viscount_Scudamore> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Scudamore, 2nd Viscount Scudamore" ;
    onto:hasMother <http://example.org/entity/Jane_Bennet> .

