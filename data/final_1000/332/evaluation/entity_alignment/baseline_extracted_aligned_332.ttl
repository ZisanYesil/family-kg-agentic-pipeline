@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Mehmed_Ziyaeddin> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Şehzade Mehmed Ziyaeddin" ;
    onto:hasFather <http://example.org/entity/Mehmed_V> .

<http://example.org/entity/Mehmed_V> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mehmed V" .

