@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:seh_ziaeddin a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Şehzade Mehmed Ziyaeddin" ;
    onto:hasFather data:mehmed_v .

data:mehmed_v a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mehmed V" .

