@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:University_of_Berlin a ex:Agent,
        ex:Organization .

entity:Friedrich_Gottlob_Uhlemann a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Max_Uhlemann .

entity:Max_Uhlemann a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Friedrich_Gottlob_Uhlemann .

