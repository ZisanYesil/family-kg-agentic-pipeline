@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Max_Uhlemann> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Max Uhlemann" ;
    onto:hasFather <http://example.org/entity/Friedrich_Gottlob_Uhlemann> ;
    skos:altLabel "Maximilian Adolph Uhlemann" .

<http://example.org/entity/Friedrich_Gottlob_Uhlemann> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Friedrich Gottlob Uhlemann" ;
    onto:hasEmployer <http://example.org/entity/University_of_Berlin>,
        data:university_of_leipzig .

<http://example.org/entity/University_of_Berlin> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "University of Berlin" .

data:university_of_leipzig a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "University of Leipzig" .

