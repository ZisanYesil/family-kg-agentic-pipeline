@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Aaron_Aaronsohn> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Aaron Aaronsohn" ;
    onto:hasBirthDate "1876-05-21"^^xsd:date ;
    onto:hasDeathDate "1919-05-15"^^xsd:date .

<http://example.org/entity/Howard_Purcell> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Howard Purcell" ;
    onto:hasBirthDate "1918-11-10"^^xsd:date ;
    onto:hasDeathDate "1981-04-24"^^xsd:date .

