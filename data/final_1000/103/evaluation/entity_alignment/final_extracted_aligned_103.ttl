@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Aaron_Aaronsohn> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1876-05-21"^^xsd:date ;
    ex:hasDeathDate "1919-05-15"^^xsd:date .

<http://example.org/entity/Howard_Purcell> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1918-11-10"^^xsd:date ;
    ex:hasDeathDate "1981-04-24"^^xsd:date .

