@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:texas_gun_fighter a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Texas Gun Fighter" ;
    onto:hasDirector data:phil_rosen .

data:what_will_people_say_1916 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "What Will People Say?" ;
    onto:hasDirector data:alice_guy .

data:alice_guy a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alice Guy" ;
    onto:hasBirthDate "1873-07-01"^^xsd:date ;
    skos:altLabel "Alice Guy‑Blaché" .

data:phil_rosen a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Phil Rosen" ;
    onto:hasBirthDate "1888-05-08"^^xsd:date ;
    skos:altLabel "Philip E. Rosen" .

