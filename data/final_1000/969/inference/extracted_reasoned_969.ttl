@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/texas_gun_fighter> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/phil_rosen> ;
    ex:hasDirector <http://example.org/extracted/phil_rosen> .

<http://example.org/extracted/what_will_people_say_1916> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/alice_guy> ;
    ex:hasDirector <http://example.org/extracted/alice_guy> .

<http://example.org/extracted/alice_guy> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1873-07-01"^^xsd:date .

<http://example.org/extracted/phil_rosen> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1888-05-08"^^xsd:date .

