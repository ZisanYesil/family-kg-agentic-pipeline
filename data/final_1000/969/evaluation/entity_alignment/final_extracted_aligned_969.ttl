@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Texas_Gun_Fighter> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Phil_Rosen> ;
    ex:hasDirector <http://example.org/entity/Phil_Rosen> .

<http://example.org/entity/What_Will_People_Say> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/alice_guy> ;
    ex:hasDirector <http://example.org/extracted/alice_guy> .

<http://example.org/entity/Phil_Rosen> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1888-05-08"^^xsd:date .

<http://example.org/extracted/alice_guy> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1873-07-01"^^xsd:date .

