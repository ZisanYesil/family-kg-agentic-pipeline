@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Alice_Guy_Blaché a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1873-07-01"^^xsd:date .

entity:Texas_Gun_Fighter a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Phil_Rosen ;
    ex:hasDirector entity:Phil_Rosen .

entity:What_Will_People_Say a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Alice_Guy ;
    ex:hasDirector entity:Alice_Guy .

entity:Alice_Guy a ex:Agent,
        ex:Person .

entity:Phil_Rosen a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1888-05-08"^^xsd:date .

