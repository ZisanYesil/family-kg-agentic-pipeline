@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Dressmaker_from_Paris a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Paul_Bern ;
    ex:hasDirector entity:Paul_Bern .

entity:Jean_Harlow a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Paul_Bern .

entity:Paul_Bern a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Jean_Harlow .

