@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:film_the_dressmaker_from_paris a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Dressmaker from Paris" ;
    onto:hasDirector data:person_paul_bern_1889 .

data:person_jean_harlow a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jean Harlow" .

data:person_paul_bern_1889 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Paul Bern" ;
    onto:hasSpouse data:person_jean_harlow .

