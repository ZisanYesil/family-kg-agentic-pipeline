@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:bunty_aur_babli_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Bunty Aur Babli" ;
    onto:hasDirector data:shaad_ali_person .

data:lawrence_school_sanawar_educational_institution a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Lawrence School, Sanawar" .

data:shaad_ali_person a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Shaad Ali" ;
    onto:hasEducatedAt data:lawrence_school_sanawar_educational_institution,
        data:welham_boys_school_educational_institution ;
    skos:altLabel "Shaad Ali Sehgal" .

data:welham_boys_school_educational_institution a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Welham Boys' School" .

