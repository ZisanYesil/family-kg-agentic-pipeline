@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/George_II> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "George II, Prince of Waldeck and Pyrmont" ;
    onto:hasDaughter <http://example.org/entity/Princess_Hermine_of_Waldeck_and_Pyrmont> ;
    onto:hasMother <http://example.org/entity/Princess_Augusta_of_Schwarzburg_Sondershausen> .

<http://example.org/entity/Princess_Augusta_of_Schwarzburg_Sondershausen> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Countess Princess Augusta of Schwarzburg-Sondershausen" .

<http://example.org/entity/Princess_Hermine_of_Waldeck_and_Pyrmont> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Princess Hermine of Waldeck and Pyrmont" .

