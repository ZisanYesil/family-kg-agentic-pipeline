@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Gillam_Airport> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Gillam Airport" ;
    onto:hasCountry <http://example.org/entity/Canada> .

<http://example.org/entity/St_François_Xavier_Airport> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "St. François Xavier Airport" ;
    onto:hasCountry <http://example.org/entity/Canada> .

<http://example.org/entity/Canada> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" ;
    skos:altLabel "Canada" .

