@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:gillam_airport a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Gillam Airport" ;
    onto:hasCountry data:canada .

data:st_francois_xavier_airport a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "St. François Xavier Airport" ;
    onto:hasCountry data:canada .

data:canada a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" ;
    skos:altLabel "Canada" .

