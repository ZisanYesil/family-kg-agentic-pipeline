@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Tatiana_Celia_Kennedy_Schlossberg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tatiana Schlossberg" ;
    onto:hasMother <http://example.org/entity/Caroline_Kennedy> .

<http://example.org/entity/Caroline_Kennedy> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Caroline Kennedy" .

