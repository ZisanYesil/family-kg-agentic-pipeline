@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:tatiana_schlossberg_1990 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tatiana Schlossberg" ;
    onto:hasMother data:caroline_kennedy_1957 .

data:caroline_kennedy_1957 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Caroline Kennedy" .

