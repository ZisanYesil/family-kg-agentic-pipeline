@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Hostel_Part_II> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Hostel: Part II" ;
    onto:hasProducer <http://example.org/entity/Boaz_Yakin>,
        <http://example.org/entity/Chris_Briggs>,
        <http://example.org/entity/Eli_Roth>,
        <http://example.org/entity/Mike_Fleiss>,
        <http://example.org/entity/Quentin_Tarantino>,
        <http://example.org/entity/Scott_Spiegel> .

<http://example.org/entity/Neruppu_Da> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Neruppu Da" ;
    onto:hasProducer <http://example.org/entity/Vikram_Prabhu> .

<http://example.org/entity/Boaz_Yakin> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Boaz Yakin" .

<http://example.org/entity/Chris_Briggs> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Chris Briggs" .

<http://example.org/entity/Eli_Roth> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Eli Roth" .

<http://example.org/entity/Mike_Fleiss> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mike Fleiss" .

<http://example.org/entity/Quentin_Tarantino> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Quentin Tarantino" .

<http://example.org/entity/Scott_Spiegel> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Scott Spiegel" .

<http://example.org/entity/Vikram_Prabhu> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Vikram Prabhu" .

