@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:film_hostel_part_ii a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Hostel: Part II" ;
    onto:hasProducer data:person_boaz_yakin,
        data:person_chris_briggs,
        data:person_eli_roth,
        data:person_mike_fleiss,
        data:person_quentin_tarantino,
        data:person_scott_spiegel .

data:film_neruppu_da a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Neruppu Da" ;
    onto:hasProducer data:person_vikram_prabhu .

data:person_boaz_yakin a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Boaz Yakin" .

data:person_chris_briggs a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Chris Briggs" .

data:person_eli_roth a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Eli Roth" .

data:person_mike_fleiss a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mike Fleiss" .

data:person_quentin_tarantino a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Quentin Tarantino" .

data:person_scott_spiegel a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Scott Spiegel" .

data:person_vikram_prabhu a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Vikram Prabhu" .

