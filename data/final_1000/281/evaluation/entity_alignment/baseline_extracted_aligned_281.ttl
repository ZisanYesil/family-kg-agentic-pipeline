@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Lionel_Giles> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lionel Giles" ;
    onto:hasFather <http://example.org/entity/Herbert_Giles> .

<http://example.org/entity/Charterhouse_School> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Charterhouse School" .

<http://example.org/entity/Herbert_Giles> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Herbert Giles" ;
    onto:hasEducatedAt <http://example.org/entity/Charterhouse_School> .

