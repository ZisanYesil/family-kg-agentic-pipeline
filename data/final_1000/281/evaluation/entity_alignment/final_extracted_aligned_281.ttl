@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Charterhouse_School> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Lionel_Giles> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Herbert_Giles> ;
    ex:hasParent <http://example.org/entity/Herbert_Giles> .

<http://example.org/entity/Herbert_Giles> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Lionel_Giles> ;
    ex:hasEducatedAt <http://example.org/entity/Charterhouse_School> .

