@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:lionel_giles a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lionel Giles" ;
    onto:hasFather data:herbert_giles .

data:charterhouse_school a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Charterhouse School" .

data:herbert_giles a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Herbert Giles" ;
    onto:hasEducatedAt data:charterhouse_school .

