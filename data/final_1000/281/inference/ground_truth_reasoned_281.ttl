@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Charterhouse_School a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Lionel_Giles a ex:Agent,
        ex:Person ;
    ex:hasFather entity:Herbert_Giles ;
    ex:hasParent entity:Herbert_Giles .

entity:Herbert_Giles a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Lionel_Giles ;
    ex:hasEducatedAt entity:Charterhouse_School .

