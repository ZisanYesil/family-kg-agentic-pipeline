@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Scrap_Heaven> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Scrap Heaven" ;
    onto:hasPublicationDate "2005"^^xsd:gYear .

<http://example.org/entity/Twelve_Miles_Out> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Twelve Miles Out" ;
    onto:hasPublicationDate "1927"^^xsd:gYear .

