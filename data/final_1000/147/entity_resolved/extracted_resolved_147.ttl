@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:scrap_heaven a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Scrap Heaven" ;
    onto:hasPublicationDate "2005"^^xsd:gYear .

data:twelve_miles_out a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Twelve Miles Out" ;
    onto:hasPublicationDate "1927"^^xsd:gYear .

