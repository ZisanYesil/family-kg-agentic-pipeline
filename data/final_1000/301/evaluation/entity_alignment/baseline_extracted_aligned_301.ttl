@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Ingrith_Johnson_Deyrup_Olsen> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ingrith Johnson Deyrup-Olsen" ;
    onto:hasBirthDate "1919"^^xsd:gYear ;
    onto:hasDeathDate "2004-07-25"^^xsd:date .

<http://example.org/entity/Pierre_Sonnerat> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Pierre Sonnerat" ;
    onto:hasBirthDate "1748-08-18"^^xsd:date ;
    onto:hasDeathDate "1814-03-31"^^xsd:date .

