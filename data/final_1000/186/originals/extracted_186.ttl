@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:his_name_was_holy_ghost a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "His Name Was Holy Ghost" ;
    onto:hasCountry data:italy .

data:the_cop_in_blue_jeans a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Cop In Blue Jeans" ;
    onto:hasCountry data:italy .

data:italy a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Italy" ;
    skos:altLabel "Italian" .

