@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:His_Name_Was_Holy_Ghost a ex:Artifact ;
    ex:hasCountry entity:Italian,
        entity:Spanish .

entity:The_Cop_in_Blue_Jeans a ex:Artifact ;
    ex:hasCountry entity:Italian .

entity:Spanish a ex:Country,
        ex:Place .

entity:Italian a ex:Country,
        ex:Place .

