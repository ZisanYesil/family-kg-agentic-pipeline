@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/His_Name_Was_Holy_Ghost> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "His Name Was Holy Ghost" ;
    onto:hasCountry <http://example.org/entity/Italian> .

<http://example.org/entity/The_Cop_in_Blue_Jeans> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Cop In Blue Jeans" ;
    onto:hasCountry <http://example.org/entity/Italian> .

<http://example.org/entity/Italian> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Italy" ;
    skos:altLabel "Italian" .

