@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Clarice_Orsini a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Lorenzo_de_Medici .

entity:Florentine a ex:Place .

