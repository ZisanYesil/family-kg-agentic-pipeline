@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:clarice_orsini a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Clarice Orsini" ;
    onto:hasSpouse data:lorenzo_de_medici .

data:lorenzo_de_medici a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lorenzo de' Medici" .

