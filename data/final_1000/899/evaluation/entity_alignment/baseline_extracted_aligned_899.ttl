@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Sixteen> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Sixteen (1943 film)" ;
    onto:hasDirector <http://example.org/entity/Carlos_Hugo_Christensen> .

<http://example.org/entity/Carlos_Hugo_Christensen> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Carlos Hugo Christensen" ;
    onto:hasBirthPlace <http://example.org/entity/Santiago_del_Estero> .

<http://example.org/entity/Santiago_del_Estero> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Santiago del Estero" .

