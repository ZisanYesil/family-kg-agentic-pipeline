@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Sixteen> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Carlos_Hugo_Christensen> ;
    ex:hasDirector <http://example.org/entity/Carlos_Hugo_Christensen> .

<http://example.org/entity/Santiago_del_Estero> a ex:Place .

<http://example.org/entity/Carlos_Hugo_Christensen> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Santiago_del_Estero> .

