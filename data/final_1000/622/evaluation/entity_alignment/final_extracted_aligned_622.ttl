@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/CRD> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Kranti_Kanade> ;
    ex:hasDirector <http://example.org/entity/Kranti_Kanade> .

<http://example.org/entity/UCLA> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/extracted/edu_ftii> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Kranti_Kanade> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/UCLA>,
        <http://example.org/extracted/edu_ftii> .

