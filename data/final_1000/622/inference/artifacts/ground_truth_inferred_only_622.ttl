@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:CRD a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Kranti_Kanade .

entity:UCLA a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Kranti_Kanade a ex:Agent,
        ex:Person .

