@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/condemned_women_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/lew_landers> ;
    ex:hasDirector <http://example.org/extracted/lew_landers> .

<http://example.org/extracted/faces_in_the_dark_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/david_edy> ;
    ex:hasDirector <http://example.org/extracted/david_edy> .

<http://example.org/extracted/david_edy> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1924-04-22"^^xsd:date ;
    ex:hasDeathDate "2009-04-05"^^xsd:date .

<http://example.org/extracted/lew_landers> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1901-01-02"^^xsd:date ;
    ex:hasDeathDate "1962-12-16"^^xsd:date .

