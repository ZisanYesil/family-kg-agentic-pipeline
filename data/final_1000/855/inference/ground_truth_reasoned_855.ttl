@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Condemned_Women a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Lew_Landers ;
    ex:hasDirector entity:Lew_Landers .

entity:David_Eady_film_director a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2009-04-05"^^xsd:date .

entity:Faces_in_the_Dark a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:David_Eady ;
    ex:hasDirector entity:David_Eady .

entity:David_Eady a ex:Agent,
        ex:Person .

entity:Lew_Landers a ex:Agent,
        ex:Person ;
