@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Condemned_Women> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Condemned Women" ;
    onto:hasDirector <http://example.org/entity/Lew_Landers> .

<http://example.org/entity/Faces_in_the_Dark> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Faces in the Dark" ;
    onto:hasDirector <http://example.org/entity/David_Eady> .

<http://example.org/entity/David_Eady> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "David Eady" ;
    onto:hasBirthDate "1924-04-22"^^xsd:date ;
    onto:hasDeathDate "2009-04-05"^^xsd:date .

<http://example.org/entity/Lew_Landers> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lew Landers" ;
    onto:hasBirthDate "1901-01-02"^^xsd:date ;
    onto:hasDeathDate "1962-12-16"^^xsd:date ;
    skos:altLabel "Louis Friedlander" .

