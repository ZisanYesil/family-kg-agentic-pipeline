@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Condemned_Women> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Lew_Landers> ;
    ex:hasDirector <http://example.org/entity/Lew_Landers> .

<http://example.org/entity/Faces_in_the_Dark> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/David_Eady> ;
    ex:hasDirector <http://example.org/entity/David_Eady> .

<http://example.org/entity/David_Eady> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1924-04-22"^^xsd:date ;
    ex:hasDeathDate "2009-04-05"^^xsd:date .

<http://example.org/entity/Lew_Landers> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1901-01-02"^^xsd:date ;
    ex:hasDeathDate "1962-12-16"^^xsd:date .

