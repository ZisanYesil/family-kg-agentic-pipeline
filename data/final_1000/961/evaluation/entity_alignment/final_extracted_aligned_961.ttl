@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Road_Hard> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Adam_Carolla> ;
    ex:hasDirector <http://example.org/entity/Adam_Carolla> .

<http://example.org/entity/We_Are_the_Freaks> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Justin_Edgar> ;
    ex:hasDirector <http://example.org/entity/Justin_Edgar> .

<http://example.org/entity/Adam_Carolla> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1964-05-27"^^xsd:date .

<http://example.org/entity/Justin_Edgar> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1971-08-18"^^xsd:date .

