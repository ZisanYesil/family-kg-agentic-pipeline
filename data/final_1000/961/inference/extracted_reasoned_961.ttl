@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_road_hard> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_adam_carolla> ;
    ex:hasDirector <http://example.org/extracted/person_adam_carolla> .

<http://example.org/extracted/film_we_are_the_freaks> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_justin_edgar> ;
    ex:hasDirector <http://example.org/extracted/person_justin_edgar> .

<http://example.org/extracted/person_adam_carolla> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1964-05-27"^^xsd:date .

<http://example.org/extracted/person_justin_edgar> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1971-08-18"^^xsd:date .

