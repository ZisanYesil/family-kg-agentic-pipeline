@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Ang_Padrino> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Ang Padrino" ;
    onto:hasDirector <http://example.org/entity/Fernando_Poe_Jr> .

<http://example.org/entity/Fernando_Poe_Jr> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Fernando Poe Jr." ;
    onto:hasAwardReceived <http://example.org/entity/National_Artist_of_the_Philippines> ;
    skos:altLabel "Da King",
        "FPJ",
        "Ronald Allan Kelley Poe",
        "Ronwaldo Reyes" .

<http://example.org/entity/National_Artist_of_the_Philippines> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "National Artist of the Philippines for Film" .

