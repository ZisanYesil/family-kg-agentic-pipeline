@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Marie_Frederike_of_Hesse_Kassel> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Marie Frederike of Hesse-Kassel" ;
    onto:hasFather <http://example.org/entity/William_I_Elector_of_Hesse> ;
    skos:altLabel "Marie Friederike of Hesse-Kassel" .

<http://example.org/entity/Princess_Mary_of_Great_Britain> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Princess Mary of Great Britain" .

<http://example.org/entity/William_I_Elector_of_Hesse> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William I, Elector of Hesse" ;
    onto:hasMother <http://example.org/entity/Princess_Mary_of_Great_Britain> .

