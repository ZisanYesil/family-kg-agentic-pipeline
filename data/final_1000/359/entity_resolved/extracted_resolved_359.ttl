@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:marie_friederike_of_hesse_kassel a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Marie Frederike of Hesse-Kassel" ;
    onto:hasFather data:william_i_elector_of_hesse ;
    skos:altLabel "Marie Friederike of Hesse-Kassel" .

data:princess_mary_of_great_britain a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Princess Mary of Great Britain" .

data:william_i_elector_of_hesse a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William I, Elector of Hesse" ;
    onto:hasMother data:princess_mary_of_great_britain .

