@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Ernst_Ziehm> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ernst Ziehm" ;
    onto:hasBirthDate "1867-05-01"^^xsd:date ;
    onto:hasDeathDate "1962-07-07"^^xsd:date .

<http://example.org/entity/Horace_Lawson_Hunley> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Horace Lawson Hunley" ;
    onto:hasBirthDate "1823-06-20"^^xsd:date ;
    onto:hasDeathDate "1863-10-15"^^xsd:date .

