@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Ernst_Ziehm> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1867-05-01"^^xsd:date ;
    ex:hasDeathDate "1962-07-07"^^xsd:date .

<http://example.org/entity/Horace_Lawson_Hunley> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1823-06-20"^^xsd:date ;
    ex:hasDeathDate "1863-10-15"^^xsd:date .

