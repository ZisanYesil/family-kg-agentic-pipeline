@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Seraphina_Sforza> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Seraphina Sforza" ;
    onto:hasSpouse <http://example.org/entity/Alessandro_Sforza> .

<http://example.org/entity/Alessandro_Sforza> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alessandro Sforza" .

