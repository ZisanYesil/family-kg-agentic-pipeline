@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:seraphina_sforza a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Seraphina Sforza" ;
    onto:hasSpouse data:alessandro_sforza .

data:alessandro_sforza a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alessandro Sforza" .

