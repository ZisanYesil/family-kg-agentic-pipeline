@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Berkeley_in_the_Sixties> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Berkeley in the Sixties" ;
    onto:hasPublicationDate "1990"^^xsd:gYear ;
    skos:altLabel "Berkeley in the Sixties" .

<http://example.org/entity/Caesar_Must_Die> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Caesar Must Die" ;
    onto:hasPublicationDate "2012"^^xsd:gYear ;
    skos:altLabel "Caesar Must Die" .

