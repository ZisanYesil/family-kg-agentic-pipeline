@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:berkeley_in_the_sxties a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Berkeley in the Sixties" ;
    onto:hasPublicationDate "1990"^^xsd:gYear ;
    skos:altLabel "Berkeley in the Sixties" .

data:caesar_must_die a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Caesar Must Die" ;
    onto:hasPublicationDate "2012"^^xsd:gYear ;
    skos:altLabel "Caesar Must Die" .

