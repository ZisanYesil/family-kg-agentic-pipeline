@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Back_Home> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Piers_Haggard> ;
    ex:hasDirector <http://example.org/entity/Piers_Haggard> .

<http://example.org/entity/Daisy_Haggard> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/entity/Piers_Haggard> .

<http://example.org/entity/Piers_Haggard> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Daisy_Haggard> .

