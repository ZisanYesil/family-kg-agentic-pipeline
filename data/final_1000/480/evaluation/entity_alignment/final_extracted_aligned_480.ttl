@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Erik_Ole_Bye> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1883-03-20"^^xsd:date ;
    ex:hasDeathDate "1953-05-17"^^xsd:date .

<http://example.org/entity/Henry_Paget_2nd_Marquess_of_Anglesey> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1797-07-06"^^xsd:date ;
    ex:hasDeathDate "1869-02-07"^^xsd:date .

