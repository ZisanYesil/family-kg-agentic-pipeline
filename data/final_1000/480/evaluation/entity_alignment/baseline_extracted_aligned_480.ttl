@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Erik_Ole_Bye> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Erik Ole Bye" ;
    onto:hasBirthDate "1883-03-20"^^xsd:date ;
    onto:hasDeathDate "1953-05-17"^^xsd:date .

<http://example.org/entity/Henry_Paget_2nd_Marquess_of_Anglesey> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Henry Paget, 2nd Marquess of Anglesey" ;
    onto:hasBirthDate "1797-07-06"^^xsd:date ;
    onto:hasDeathDate "1869-02-07"^^xsd:date .

