@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:creative_call_for_help a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Call for Help" ;
    onto:hasPresenter data:person_chris_pirillo .

data:org_lockergnome_inc a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "LockerGnome, Inc." ;
    onto:hasFounder data:person_chris_pirillo .

data:person_chris_pirillo a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Chris Pirillo" .

