@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Call_for_Help a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Leo_Laporte .

entity:Leo_Laporte a ex:Agent,
        ex:Person ;
    ex:hasEmployer entity:TWiT_tv .

entity:TWiT_tv a ex:Agent,
        ex:Organization .

