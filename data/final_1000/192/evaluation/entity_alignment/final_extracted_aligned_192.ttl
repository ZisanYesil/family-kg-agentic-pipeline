@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Antonio_Poggi> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Erminia_Frezzolini> .

<http://example.org/entity/Giuseppe_Frezzolini> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Erminia_Frezzolini> .

<http://example.org/entity/Erminia_Frezzolini> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/entity/Giuseppe_Frezzolini> ;
    ex:hasSpouse <http://example.org/entity/Antonio_Poggi> .

