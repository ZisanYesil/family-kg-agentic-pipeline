@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Antonio_Poggi a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Erminia_Frezzolini .

entity:Giuseppe_Frezzolini a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Erminia_Frezzolini .

entity:Erminia_Frezzolini a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Giuseppe_Frezzolini ;
    ex:hasSpouse entity:Antonio_Poggi .

