@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:song_oui_oui_marie a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Oui, Oui, Marie" ;
    onto:hasComposer data:person_fred_fisher .

data:country_united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

data:person_fred_fisher a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Fred Fisher" ;
    onto:hasNationality data:country_united_states ;
    skos:altLabel "Alfred Breitenbach" .

