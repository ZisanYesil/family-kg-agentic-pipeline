@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Oui_Oui_Marie> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasComposer <http://example.org/entity/Fred_Fisher> ;
    ex:hasCreator <http://example.org/entity/Fred_Fisher> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/Fred_Fisher> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasNationality <http://example.org/entity/American> .

