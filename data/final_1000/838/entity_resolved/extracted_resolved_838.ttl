@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:film_my_other_husband a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "My Other Husband" ;
    onto:hasDirector data:person_georges_lautner .

data:person_georges_lautner a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Georges Lautner" ;
    onto:hasMother data:person_renee_saint_cyr .

data:person_renee_saint_cyr a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Renée Saint‑Cyr" .

