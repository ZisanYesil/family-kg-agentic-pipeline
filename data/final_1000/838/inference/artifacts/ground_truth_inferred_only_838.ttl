@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:My_Other_Husband a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Georges_Lautner .

entity:Renée_Saint_Cyr a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Georges_Lautner .

entity:Georges_Lautner a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Renée_Saint_Cyr .

