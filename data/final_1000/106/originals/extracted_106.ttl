@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:peder_per_veggum a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Peder Per Veggum" ;
    onto:hasBirthDate "1768-04-11"^^xsd:date ;
    onto:hasDeathDate "1836-04-15"^^xsd:date .

data:piero_campelli a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Piero Campelli" ;
    onto:hasBirthDate "1893-12-20"^^xsd:date ;
    onto:hasDeathDate "1946-10-20"^^xsd:date .

