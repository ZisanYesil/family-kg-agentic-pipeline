@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Lorentz_Creutz> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lorentz Creutz Sr." ;
    onto:hasDeathPlace <http://example.org/entity/Öland> ;
    onto:hasFather <http://example.org/entity/Carl_Gustaf_Creutz> ;
    skos:altLabel "Lorentz Creutz" .

<http://example.org/entity/Carl_Gustaf_Creutz> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Carl Gustaf Creutz" .

<http://example.org/entity/Öland> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Battle of Öland" .

