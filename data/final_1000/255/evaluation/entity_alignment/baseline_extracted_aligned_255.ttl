@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Paul_Richter> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Paul Richter" ;
    onto:hasSpouse <http://example.org/entity/Aud_Egede_Nissen> .

<http://example.org/entity/Aud_Egede_Nissen> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Aud Egede-Nissen" ;
    onto:hasNationality <http://example.org/entity/Norwegian> .

<http://example.org/entity/Norwegian> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Norway" ;
    skos:altLabel "Norwegian" .

