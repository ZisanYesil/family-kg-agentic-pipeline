@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Aud_Egede_Nissen a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:Norwegian ;
    ex:hasCountry entity:Norwegian ;
    ex:hasSpouse entity:Paul_Richter .

entity:Paul_Richter a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Aud_Egede_Nissen .

entity:Norwegian a ex:Country,
        ex:Place .

