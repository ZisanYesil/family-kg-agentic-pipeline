@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:bakers_hawk_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Baker's Hawk" ;
    onto:hasPublicationDate "1976"^^xsd:gYear .

data:majority_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Majority" ;
    onto:hasPublicationDate "2010"^^xsd:gYear .

