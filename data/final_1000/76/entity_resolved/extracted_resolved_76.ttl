@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:shadow_of_evil_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Shadow of Evil" ;
    onto:hasPublicationDate "1964"^^xsd:gYear .

data:siyaah_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Siyaah" ;
    onto:hasPublicationDate "2013"^^xsd:gYear .

