@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Shadow_of_Evil> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Shadow of Evil" ;
    onto:hasPublicationDate "1964"^^xsd:gYear .

<http://example.org/entity/Siyaah> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Siyaah" ;
    onto:hasPublicationDate "2013"^^xsd:gYear .

