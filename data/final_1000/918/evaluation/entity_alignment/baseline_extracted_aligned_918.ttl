@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Queen_Gongye> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Queen Gongye" ;
    onto:hasSpouse <http://example.org/entity/Injong> .

<http://example.org/entity/Yejong> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "King Yejong" ;
    onto:hasSon <http://example.org/entity/Injong> .

<http://example.org/entity/Injong> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Injong of Goryeo" .

