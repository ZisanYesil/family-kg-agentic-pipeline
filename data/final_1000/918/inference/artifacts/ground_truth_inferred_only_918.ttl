@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Injong a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Yejong ;
    ex:hasSpouse entity:Queen_Gongye .

entity:Queen_Gongye a ex:Agent,
        ex:Person .

entity:Yejong a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Injong .

