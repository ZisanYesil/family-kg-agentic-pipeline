@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:king_yejong a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "King Yejong" ;
    onto:hasSon data:injong_of_goryeo .

data:queen_gongye a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Queen Gongye" ;
    onto:hasSpouse data:injong_of_goryeo .

data:injong_of_goryeo a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Injong of Goryeo" .

