@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:jonathan_nolan a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jonathan Nolan" ;
    onto:hasBrother data:christopher_nolan .

data:christopher_nolan a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Christopher Nolan" ;
    onto:hasSpouse data:emma_thomas .

data:emma_thomas a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Emma Thomas" .

