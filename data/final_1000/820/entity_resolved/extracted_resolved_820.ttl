@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:cornelis_steenis_1901 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Cornelis Gijsbert Gerrit Jan van Steenis" ;
    onto:hasBirthDate "1901-10-31"^^xsd:date ;
    onto:hasDeathDate "1986-05-14"^^xsd:date ;
    skos:altLabel "Cornelis Gijsbert Gerrit Jan Van Steenis" .

data:tarsem_king_1937 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tarsem King, Baron King of West Bromwich" ;
    onto:hasBirthDate "1937-04-24"^^xsd:date ;
    onto:hasDeathDate "2013-01-09"^^xsd:date ;
    skos:altLabel "Baron King of West Bromwich",
        "Tarsem King" .

