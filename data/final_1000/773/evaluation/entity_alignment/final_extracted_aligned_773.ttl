@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Love_on_the_Cloud> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Gu_Changwei> ;
    ex:hasDirector <http://example.org/entity/Gu_Changwei> .

<http://example.org/entity/Xi_an> a ex:Place .

<http://example.org/entity/Gu_Changwei> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Xi_an> .

