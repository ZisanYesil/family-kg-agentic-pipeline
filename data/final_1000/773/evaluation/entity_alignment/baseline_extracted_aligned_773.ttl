@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Love_on_the_Cloud> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Love on the Cloud" ;
    onto:hasDirector <http://example.org/entity/Gu_Changwei> .

<http://example.org/entity/Gu_Changwei> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gu Changwei" ;
    onto:hasBirthPlace <http://example.org/entity/Xi_an> .

<http://example.org/entity/Xi_an> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Xi'an, Shaanxi, People's Republic of China" .

