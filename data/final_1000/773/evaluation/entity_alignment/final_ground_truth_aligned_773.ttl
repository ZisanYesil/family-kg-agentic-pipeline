@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Love_on_the_Cloud a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Gu_Changwei ;
    ex:hasDirector entity:Gu_Changwei .

entity:Xi_an a ex:Place .

entity:Gu_Changwei a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Xi_an .

