@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Emma_de_Caunes> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Emma de Caunes" ;
    onto:hasFather <http://example.org/entity/Antoine_de_Caunes> .

<http://example.org/entity/Monsieur_N> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Monsieur N." ;
    onto:hasDirector <http://example.org/entity/Antoine_de_Caunes> .

<http://example.org/entity/Antoine_de_Caunes> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Antoine de Caunes" .

