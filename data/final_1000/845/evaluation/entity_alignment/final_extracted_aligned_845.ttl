@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Monsieur_N> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Antoine_de_Caunes> ;
    ex:hasDirector <http://example.org/entity/Antoine_de_Caunes> .

<http://example.org/entity/Emma_de_Caunes> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Antoine_de_Caunes> ;
    ex:hasParent <http://example.org/entity/Antoine_de_Caunes> .

<http://example.org/entity/Antoine_de_Caunes> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Emma_de_Caunes> .

