@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/John_A_McDougald> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Palm_Beach> ;
    ex:hasSpouse <http://example.org/entity/Maude_Smith> .

<http://example.org/entity/Maude_Smith> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/John_A_McDougald> .

<http://example.org/entity/Palm_Beach> a ex:Place .

