@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:John_A_McDougald a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace entity:Palm_Beach ;
    ex:hasSpouse entity:Maude_Smith .

entity:Maude_Smith a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:John_A_McDougald .

entity:Palm_Beach a ex:Place .

