@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_a_soldiers_oath a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Soldier's Oath" ;
    onto:hasProducer data:person_william_fox .

data:film_the_criminal a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Criminal" ;
    onto:hasProducer data:person_nat_cohen ;
    skos:altLabel "The Criminal (1960 film)" .

data:person_nat_cohen a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nat Cohen" ;
    onto:hasBirthDate "1905-12-23"^^xsd:date ;
    onto:hasDeathDate "1988-02-10"^^xsd:date .

data:person_william_fox a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William Fox" ;
    onto:hasBirthDate "1879-01-01"^^xsd:date ;
    onto:hasDeathDate "1952-05-08"^^xsd:date ;
    skos:altLabel "Vilmos Fuchs",
        "William Fox" .

