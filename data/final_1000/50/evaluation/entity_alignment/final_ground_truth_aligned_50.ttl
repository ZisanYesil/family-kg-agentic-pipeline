@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:A_Soldier_s_Oath a ex:Artifact,
        ex:CreativeWork ;
    ex:hasProducer entity:William_Fox .

entity:The_Criminal_1960_film a ex:Artifact,
        ex:CreativeWork ;
