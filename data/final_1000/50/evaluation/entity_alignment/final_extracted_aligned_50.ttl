@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/A_Soldier_s_Oath> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/William_Fox> .

<http://example.org/entity/The_Criminal_1960_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/Nat_Cohen> .

<http://example.org/entity/Nat_Cohen> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1905-12-23"^^xsd:date ;
    ex:hasDeathDate "1988-02-10"^^xsd:date .

<http://example.org/entity/William_Fox> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1879-01-01"^^xsd:date ;
    ex:hasDeathDate "1952-05-08"^^xsd:date .

