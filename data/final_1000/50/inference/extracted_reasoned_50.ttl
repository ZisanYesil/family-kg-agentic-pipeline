@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_a_soldiers_oath> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/extracted/person_william_fox> .

<http://example.org/extracted/film_the_criminal> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/extracted/person_nat_cohen> .

<http://example.org/extracted/person_nat_cohen> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1905-12-23"^^xsd:date ;
    ex:hasDeathDate "1988-02-10"^^xsd:date .

<http://example.org/extracted/person_william_fox> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1879-01-01"^^xsd:date ;
    ex:hasDeathDate "1952-05-08"^^xsd:date .

