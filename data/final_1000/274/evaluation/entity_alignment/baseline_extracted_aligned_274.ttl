@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Conquest_of_the_Planet_of_the_Apes> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Conquest of the Planet of the Apes" ;
    onto:hasProducer <http://example.org/entity/Arthur_P_Jacobs> .

<http://example.org/entity/I_m_Not_Harry_Jenson> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "I'm Not Harry Jenson" ;
    onto:hasProducer <http://example.org/entity/Tom_Hern> .

<http://example.org/entity/Arthur_P_Jacobs> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Arthur P. Jacobs" ;
    onto:hasBirthDate "1922-03-07"^^xsd:date .

<http://example.org/entity/Tom_Hern> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tom Hern" ;
    onto:hasBirthDate "1984-12-10"^^xsd:date .

