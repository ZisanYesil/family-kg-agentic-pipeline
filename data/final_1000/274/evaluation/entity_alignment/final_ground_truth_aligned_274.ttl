@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Conquest_of_the_Planet_of_the_Apes a ex:Artifact,
        ex:CreativeWork ;
    ex:hasProducer entity:Arthur_P_Jacobs .

entity:I_m_Not_Harry_Jenson a ex:Artifact,
        ex:CreativeWork ;
    ex:hasProducer entity:Tom_Hern .

entity:Arthur_P_Jacobs a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1922-03-07"^^xsd:date .

entity:Tom_Hern a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1984-12-10"^^xsd:date .

