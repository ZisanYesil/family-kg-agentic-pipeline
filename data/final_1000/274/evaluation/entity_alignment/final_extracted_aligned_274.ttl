@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Conquest_of_the_Planet_of_the_Apes> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/Arthur_P_Jacobs> .

<http://example.org/entity/I_m_Not_Harry_Jenson> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/Tom_Hern> .

<http://example.org/entity/Arthur_P_Jacobs> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1922-03-07"^^xsd:date .

<http://example.org/entity/Tom_Hern> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1984-12-10"^^xsd:date .

