@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_conquest> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/extracted/person_arthur_jacobs> .

<http://example.org/extracted/film_im_not_harry_jenson> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/extracted/person_tom_hern> .

<http://example.org/extracted/person_arthur_jacobs> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1922-03-07"^^xsd:date .

<http://example.org/extracted/person_tom_hern> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1984-12-10"^^xsd:date .

