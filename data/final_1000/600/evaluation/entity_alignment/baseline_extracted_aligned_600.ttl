@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/From_Bedrooms_to_Billions> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "From Bedrooms to Billions" ;
    onto:hasCountryOfOrigin <http://example.org/entity/British> .

<http://example.org/entity/Son_of_Rambow> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Son of Rambow" ;
    onto:hasCountryOfOrigin <http://example.org/entity/British> .

<http://example.org/entity/British> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

