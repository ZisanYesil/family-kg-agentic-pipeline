@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Daawat_e_Ishq> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Habib_Faisal> ;
    ex:hasDirector <http://example.org/entity/Habib_Faisal> .

<http://example.org/entity/Jamia_Millia_Islamia> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Habib_Faisal> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/Jamia_Millia_Islamia> .

