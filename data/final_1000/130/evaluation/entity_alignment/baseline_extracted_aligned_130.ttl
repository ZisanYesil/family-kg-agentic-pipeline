@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Daawat_e_Ishq> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Daawat-e-Ishq" ;
    onto:hasDirector <http://example.org/entity/Habib_Faisal> .

<http://example.org/entity/Habib_Faisal> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Habib Faisal" ;
    onto:hasEducatedAt <http://example.org/entity/Jamia_Millia_Islamia> .

<http://example.org/entity/Jamia_Millia_Islamia> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Jamia Millia Islamia" .

