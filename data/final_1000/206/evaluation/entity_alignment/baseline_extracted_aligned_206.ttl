@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Arirang_geuhu_iyagi> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Arirang geuhu iyagi" ;
    onto:hasPublicationDate "1930"^^xsd:gYear ;
    skos:altLabel "A Story of the Day after Arirang",
        "Arirang 2",
        "Arirang Geuhu Iyagi",
        "아리랑 그 후 이야기",
        "아리알 후편" .

<http://example.org/entity/The_Gypsy_Moths> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Gypsy Moths" ;
    onto:hasPublicationDate "1969"^^xsd:gYear .

