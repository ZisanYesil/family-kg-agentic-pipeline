@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Félicité_2017_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Alain_Gomis> ;
    ex:hasDirector <http://example.org/entity/Alain_Gomis> .

<http://example.org/entity/Villa_Amalia_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Benoît_Jacquot> ;
    ex:hasDirector <http://example.org/entity/Benoît_Jacquot> .

<http://example.org/entity/Alain_Gomis> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/French>,
        <http://example.org/entity/Senegalese> ;
    ex:hasNationality <http://example.org/entity/French>,
        <http://example.org/entity/Senegalese> .

<http://example.org/entity/Benoît_Jacquot> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/French> ;
    ex:hasNationality <http://example.org/entity/French> .

<http://example.org/entity/Senegalese> a ex:Country,
        ex:Place .

<http://example.org/entity/French> a ex:Country,
        ex:Place .

