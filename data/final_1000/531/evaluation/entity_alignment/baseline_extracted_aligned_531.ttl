@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Laila_Kaland> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Laila Kaland" ;
    onto:hasBirthDate "1939-01-08"^^xsd:date ;
    onto:hasDeathDate "2007-12-30"^^xsd:date .

<http://example.org/entity/William_F_Brown> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William F. Brown" ;
    onto:hasBirthDate "1919-11-29"^^xsd:date ;
    onto:hasDeathDate "2010-09-06"^^xsd:date .

