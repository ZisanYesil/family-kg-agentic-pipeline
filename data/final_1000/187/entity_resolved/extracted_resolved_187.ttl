@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:bruce_cummins a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bruce Cummins" ;
    onto:hasBirthDate "1929-11-17"^^xsd:date ;
    onto:hasDeathDate "2017-08-22"^^xsd:date .

data:ko_tun_hwa a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ko Tun-Hwa" ;
    onto:hasBirthDate "1921-09-18"^^xsd:date ;
    onto:hasDeathDate "2010-06-12"^^xsd:date ;
    skos:altLabel "Vice Admiral Ko Tun-hwa" .

