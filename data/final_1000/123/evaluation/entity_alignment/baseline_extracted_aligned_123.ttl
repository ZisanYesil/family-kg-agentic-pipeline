@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Don_t_Take_My_Darling_Boy_Away> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Don't Take My Darling Boy Away" ;
    onto:hasComposer <http://example.org/entity/Albert_Von_Tilzer> .

<http://example.org/entity/Albert_Von_Tilzer> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Albert Von Tilzer" ;
    onto:hasBirthDate "1878-03-29"^^xsd:date .

