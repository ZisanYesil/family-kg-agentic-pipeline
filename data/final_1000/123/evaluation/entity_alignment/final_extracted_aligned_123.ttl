@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Don_t_Take_My_Darling_Boy_Away> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasComposer <http://example.org/entity/Albert_Von_Tilzer> ;
    ex:hasCreator <http://example.org/entity/Albert_Von_Tilzer> .

<http://example.org/entity/Albert_Von_Tilzer> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1878-03-29"^^xsd:date .

