@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:thomas_stafford_3rd_earl_of_stafford a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Thomas Stafford, 3rd Earl of Stafford" ;
    onto:hasFather data:hugh_stafford_2nd_earl_of_stafford ;
    skos:altLabel "Thomas Stafford" .

data:hugh_stafford_2nd_earl_of_stafford a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hugh Stafford, 2nd Earl of Stafford" ;
    skos:altLabel "Hugh Stafford" .

