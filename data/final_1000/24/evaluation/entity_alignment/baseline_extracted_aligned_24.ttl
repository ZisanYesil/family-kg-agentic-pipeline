@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Thomas_Stafford_3rd_Earl_of_Stafford> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Thomas Stafford, 3rd Earl of Stafford" ;
    onto:hasFather <http://example.org/entity/Hugh_de_Stafford_2nd_Earl_of_Stafford> ;
    skos:altLabel "Thomas Stafford" .

<http://example.org/entity/Hugh_de_Stafford_2nd_Earl_of_Stafford> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hugh Stafford, 2nd Earl of Stafford" ;
    skos:altLabel "Hugh Stafford" .

