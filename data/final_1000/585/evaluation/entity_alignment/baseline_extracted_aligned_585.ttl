@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Minsan_Pa> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Minsan Pa" ;
    onto:hasDirector <http://example.org/entity/Jeffrey_Jeturian> .

<http://example.org/entity/Jeffrey_Jeturian> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jeffrey Jeturian" ;
    onto:hasEducatedAt <http://example.org/entity/University_of_the_Philippines> .

<http://example.org/entity/University_of_the_Philippines> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "University of the Philippines Diliman" .

