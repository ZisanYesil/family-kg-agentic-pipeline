@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Minsan_Pa> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Jeffrey_Jeturian> ;
    ex:hasDirector <http://example.org/entity/Jeffrey_Jeturian> .

<http://example.org/entity/University_of_the_Philippines> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Jeffrey_Jeturian> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/University_of_the_Philippines> .

