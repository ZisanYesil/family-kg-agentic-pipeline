@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Port_of_Seven_Seas> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/James_Whale> ;
    ex:hasDirector <http://example.org/entity/James_Whale> .

<http://example.org/entity/drowning> a ex:CauseOfDeath .

<http://example.org/entity/James_Whale> a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath <http://example.org/entity/drowning> .

