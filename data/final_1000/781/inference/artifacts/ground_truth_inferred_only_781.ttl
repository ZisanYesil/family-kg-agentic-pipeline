@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Port_of_Seven_Seas a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:James_Whale .

entity:drowning a ex:CauseOfDeath .

entity:James_Whale a ex:Agent,
        ex:Person .

