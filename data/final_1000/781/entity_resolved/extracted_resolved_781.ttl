@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:port_of_seven_seas_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Port of Seven Seas" ;
    onto:hasDirector data:james_whale_person .

data:james_whale_person a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "James Whale" ;
    onto:hasCauseOfDeath data:suicide_cause .

data:suicide_cause a onto:CauseOfDeath,
        owl:NamedIndividual ;
    rdfs:label "suicide" .

