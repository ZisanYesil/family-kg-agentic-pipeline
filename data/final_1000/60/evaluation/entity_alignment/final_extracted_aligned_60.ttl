@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Den_of_Lions> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasPublicationDate "2003"^^xsd:gYear .

<http://example.org/entity/The_Greatest_Thing_in_Life> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasPublicationDate "1918"^^xsd:gYear .

