@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:den_of_lions_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Den of Lions" ;
    onto:hasPublicationDate "2003"^^xsd:gYear .

data:the_greatest_thing_in_life_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Greatest Thing in Life" ;
    onto:hasPublicationDate "1918"^^xsd:gYear .

