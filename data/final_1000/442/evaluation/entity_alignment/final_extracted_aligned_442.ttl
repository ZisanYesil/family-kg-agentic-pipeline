@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Caerphilly> a ex:Place .

<http://example.org/entity/Hugh_le_Despenser> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Eleanor_de_Clare> ;
    ex:hasParent <http://example.org/entity/Eleanor_de_Clare> .

<http://example.org/entity/Eleanor_de_Clare> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Caerphilly> ;
    ex:hasChild <http://example.org/entity/Hugh_le_Despenser> .

