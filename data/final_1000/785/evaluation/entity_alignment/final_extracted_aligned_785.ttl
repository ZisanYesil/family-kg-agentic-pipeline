@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Science_Fiction_Adventures> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasEditor <http://example.org/entity/Lester_del_Rey> .

<http://example.org/entity/Lester_del_Rey> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1993-05-10"^^xsd:date .

