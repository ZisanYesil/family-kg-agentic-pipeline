@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/WikiTribune> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "WikiTribune" ;
    onto:hasFounder <http://example.org/entity/Jimmy_Wales> .

<http://example.org/entity/Huntsville_Alabama> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Huntsville, Alabama" .

<http://example.org/entity/Jimmy_Wales> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jimmy Wales" ;
    onto:hasBirthPlace <http://example.org/entity/Huntsville_Alabama> .

