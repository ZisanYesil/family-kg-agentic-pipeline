@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:wikitribune a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "WikiTribune" ;
    onto:hasFounder data:jimmy_wales .

data:huntsville_alabama a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Huntsville, Alabama" .

data:jimmy_wales a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jimmy Wales" ;
    onto:hasBirthPlace data:huntsville_alabama .

