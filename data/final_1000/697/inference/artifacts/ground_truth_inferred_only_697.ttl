@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Busir a ex:Agent,
        ex:Person ;
    ex:hasSibling entity:Theodora_of_Khazaria .

entity:Tiberius a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Theodora_of_Khazaria .

entity:Theodora_of_Khazaria a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Tiberius .

