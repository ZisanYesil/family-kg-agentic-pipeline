@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Tiberius> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Theodora_of_Khazaria> ;
    ex:hasParent <http://example.org/entity/Theodora_of_Khazaria> .

<http://example.org/entity/Busir> a ex:Agent,
        ex:Person ;
    ex:hasSibling <http://example.org/entity/Theodora_of_Khazaria> ;
    ex:isBrotherOf <http://example.org/entity/Theodora_of_Khazaria> .

<http://example.org/entity/Theodora_of_Khazaria> a ex:Agent,
        ex:Person ;
    ex:hasBrother <http://example.org/entity/Busir> ;
    ex:hasChild <http://example.org/entity/Tiberius> ;
    ex:hasSibling <http://example.org/entity/Busir> .

