@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Mukat_Behari_Lal_Bhargava> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mukat Behari Lal Bhargava" ;
    onto:hasBirthDate "1903-06-30"^^xsd:date ;
    onto:hasDeathDate "1980-12-18"^^xsd:date .

<http://example.org/entity/Salvador_J_Lara> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Salvador J. Lara" ;
    onto:hasBirthDate "1920-07-11"^^xsd:date ;
    onto:hasDeathDate "1945-09-01"^^xsd:date .

