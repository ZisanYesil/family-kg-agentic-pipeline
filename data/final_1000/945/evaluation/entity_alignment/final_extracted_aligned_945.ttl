@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/The_Luckiest_Girl_in_the_World> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Edward_Buzzell> ;
    ex:hasDirector <http://example.org/entity/Edward_Buzzell> .

<http://example.org/entity/The_Tiger_s_Shadow> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Spencer_Gordon_Bennet> ;
    ex:hasDirector <http://example.org/entity/Spencer_Gordon_Bennet> .

<http://example.org/entity/Edward_Buzzell> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1895-11-13"^^xsd:date ;
    ex:hasDeathDate "1985-01-11"^^xsd:date .

<http://example.org/entity/Spencer_Gordon_Bennet> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1893-01-05"^^xsd:date ;
    ex:hasDeathDate "1987-10-08"^^xsd:date .

