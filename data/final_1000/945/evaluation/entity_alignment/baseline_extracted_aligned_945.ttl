@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/The_Luckiest_Girl_in_the_World> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Luckiest Girl in the World" ;
    onto:hasDirector <http://example.org/entity/Edward_Buzzell> .

<http://example.org/entity/The_Tiger_s_Shadow> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Tiger's Shadow" ;
    onto:hasDirector <http://example.org/entity/Spencer_Gordon_Bennet> .

<http://example.org/entity/Edward_Buzzell> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Edward Buzzell" ;
    onto:hasBirthDate "1895-11-13"^^xsd:date ;
    onto:hasDeathDate "1985-01-11"^^xsd:date .

<http://example.org/entity/Spencer_Gordon_Bennet> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Spencer Gordon Bennet" ;
    onto:hasBirthDate "1893-01-05"^^xsd:date ;
    onto:hasDeathDate "1987-10-08"^^xsd:date .

