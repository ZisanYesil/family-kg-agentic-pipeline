@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Silver ground-truth triples for example1100
# Source: 2WikiMultihopQA dev split, evidences field
# Predicates use this project's ontology (see ontology.ttl)

inst:The_Luckiest_Girl_in_the_World ex:hasDirector inst:Edward_Buzzell .  # director
inst:The_Tiger_s_Shadow ex:hasDirector inst:Spencer_Gordon_Bennet .  # director
inst:Edward_Buzzell ex:hasDeathDate "1985-01-11"^^xsd:date .  # date of death -> "January 11, 1985"
inst:Spencer_Gordon_Bennet ex:hasDeathDate "1987-10-08"^^xsd:date .  # date of death -> "October 8, 1987"
