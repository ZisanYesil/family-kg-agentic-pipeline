@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_luckiest_girl_1936> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_edward_buzzell> ;
    ex:hasDirector <http://example.org/extracted/person_edward_buzzell> .

<http://example.org/extracted/film_tigers_shadow_1928> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_spencer_gordon_bennet> ;
    ex:hasDirector <http://example.org/extracted/person_spencer_gordon_bennet> .

<http://example.org/extracted/person_edward_buzzell> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1895-11-13"^^xsd:date ;
    ex:hasDeathDate "1985-01-11"^^xsd:date .

<http://example.org/extracted/person_spencer_gordon_bennet> a ex:Agent,
        ex:Person ;
