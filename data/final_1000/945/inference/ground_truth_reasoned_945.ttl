@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:The_Luckiest_Girl_in_the_World a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Edward_Buzzell ;
    ex:hasDirector entity:Edward_Buzzell .

entity:The_Tiger_s_Shadow a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Spencer_Gordon_Bennet ;
    ex:hasDirector entity:Spencer_Gordon_Bennet .

entity:Edward_Buzzell a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1985-01-11"^^xsd:date .

entity:Spencer_Gordon_Bennet a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1987-10-08"^^xsd:date .

