@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Wee_Wee_Hours> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Wee Wee Hours" ;
    onto:hasPerformer <http://example.org/entity/Chuck_Berry> .

<http://example.org/entity/Chuck_Berry> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Chuck Berry" ;
    onto:hasBirthPlace <http://example.org/entity/St_Louis_Missouri> .

<http://example.org/entity/St_Louis_Missouri> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "St. Louis, Missouri" .

