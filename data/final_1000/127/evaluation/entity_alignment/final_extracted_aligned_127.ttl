@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Wee_Wee_Hours> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Chuck_Berry> ;
    ex:hasPerformer <http://example.org/entity/Chuck_Berry> .

<http://example.org/entity/St_Louis_Missouri> a ex:Place .

<http://example.org/entity/Chuck_Berry> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/St_Louis_Missouri> .

