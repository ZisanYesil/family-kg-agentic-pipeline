@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Wee_Wee_Hours a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Chuck_Berry ;
    ex:hasPerformer entity:Chuck_Berry .

entity:St_Louis_Missouri a ex:Place .

entity:Chuck_Berry a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:St_Louis_Missouri .

