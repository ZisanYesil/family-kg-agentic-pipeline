@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Róża_Maria_Wodzicka a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Jan_Nepomucen_Potocki .

entity:Stanisław_Antoni_Potocki a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Jan_Nepomucen_Potocki .

entity:Jan_Nepomucen_Potocki a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Stanisław_Antoni_Potocki ;
    ex:hasSpouse entity:Róża_Maria_Wodzicka .

