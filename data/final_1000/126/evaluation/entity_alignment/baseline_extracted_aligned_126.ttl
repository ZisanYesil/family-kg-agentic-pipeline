@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/G_V_Prakash_Kumar> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "G. V. Prakash Kumar" ;
    onto:hasMother <http://example.org/entity/A_R_Reihana> .

<http://example.org/entity/Machi> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Machi" .

data:person_bhavani_sree a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bhavani Sree" ;
    onto:hasMother <http://example.org/entity/A_R_Reihana> .

<http://example.org/entity/A_R_Reihana> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "A. R. Reihana" ;
    skos:altLabel "Rayhanah" .

