@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:alice_k_bache a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alice K. Bache" ;
    onto:hasBirthDate "1903"^^xsd:gYear ;
    onto:hasDeathDate "1977"^^xsd:gYear .

data:ma_xisheng a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ma Xisheng" ;
    onto:hasBirthDate "0899"^^xsd:gYear ;
    onto:hasDeathDate "0932-08-15"^^xsd:date .

