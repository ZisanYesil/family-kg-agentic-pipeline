@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Ab_Dilli_Dur_Nahin> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Ab Dilli Dur Nahin" ;
    onto:hasProducer <http://example.org/entity/Raj_Kapoor> .

<http://example.org/entity/Rarandoi_Veduka_Chudham> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Rarandoi Veduka Chudham" ;
    onto:hasProducer <http://example.org/entity/Akkineni_Nagarjuna> .

<http://example.org/entity/Akkineni_Nagarjuna> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Akkineni Nagarjuna" ;
    onto:hasBirthDate "1959-08-29"^^xsd:date .

<http://example.org/entity/Raj_Kapoor> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Raj Kapoor" ;
    onto:hasBirthDate "1924-12-14"^^xsd:date .

