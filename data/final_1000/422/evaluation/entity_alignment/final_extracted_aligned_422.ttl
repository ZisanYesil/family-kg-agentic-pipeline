@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Ab_Dilli_Dur_Nahin> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/Raj_Kapoor> .

<http://example.org/entity/Rarandoi_Veduka_Chudham> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/Akkineni_Nagarjuna> .

<http://example.org/entity/Akkineni_Nagarjuna> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1959-08-29"^^xsd:date .

<http://example.org/entity/Raj_Kapoor> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1924-12-14"^^xsd:date .

