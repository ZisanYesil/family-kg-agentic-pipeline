@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/The_Coalition_of_the_Willing> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "The Coalition of the Willing" ;
    onto:hasMember <http://example.org/entity/Bobby_Previte> .

<http://example.org/entity/Bobby_Previte> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bobby Previte" ;
    onto:hasBirthPlace <http://example.org/entity/Niagara_Falls_New_York> .

<http://example.org/entity/Niagara_Falls_New_York> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Niagara Falls, New York" .

