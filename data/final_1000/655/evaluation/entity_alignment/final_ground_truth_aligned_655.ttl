@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Coalition_of_the_Willing a ex:Agent,
        ex:Organization ;
    ex:hasMember entity:Bobby_Previte .

entity:Bobby_Previte a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Niagara_Falls_New_York .

entity:Niagara_Falls_New_York a ex:Place .

