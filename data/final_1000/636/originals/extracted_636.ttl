@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_commando_leopard a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Commando Leopard" ;
    onto:hasPublicationDate "1985"^^xsd:gYear .

data:film_invasion_astro_monster a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Invasion of Astro-Monster" ;
    onto:hasPublicationDate "1965-12-19"^^xsd:date ;
    skos:altLabel "Invasion Of Astro-Monster" .

