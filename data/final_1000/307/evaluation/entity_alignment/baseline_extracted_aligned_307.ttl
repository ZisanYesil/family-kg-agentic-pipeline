@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:tommys_organization a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Tommys" ;
    onto:hasCountry <http://example.org/entity/Finland> .

data:vocal_spectrum_organization a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Vocal Spectrum" ;
    onto:hasCountry <http://example.org/entity/American> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" .

<http://example.org/entity/Finland> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Finland" .

