        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Charles_I_Louis_Elector_Palatine> .

<http://example.org/entity/Frederick_V> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Charles_I_Louis_Elector_Palatine> ;
    ex:hasSon <http://example.org/entity/Charles_I_Louis_Elector_Palatine> .

