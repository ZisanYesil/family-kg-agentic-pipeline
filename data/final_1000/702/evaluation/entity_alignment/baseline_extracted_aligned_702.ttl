@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Charlotte_of_Hesse_Kassel> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Charlotte of Hesse-Kassel" ;
    onto:hasSpouse <http://example.org/entity/Charles_I_Louis_Elector_Palatine> ;
    skos:altLabel "Landgravine Charlotte of Hesse-Kassel" .

<http://example.org/entity/Frederick_V> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Frederick V of the Palatinate" ;
    onto:hasSon <http://example.org/entity/Charles_I_Louis_Elector_Palatine> .

<http://example.org/entity/Charles_I_Louis_Elector_Palatine> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Charles I Louis, Elector Palatine" ;
    skos:altLabel "Charles Louis, Elector Palatine" .

