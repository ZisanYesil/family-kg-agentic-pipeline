@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:German a ex:Place .

entity:Julia_Bracken_Wendt a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:William_Wendt .

entity:William_Wendt a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:German ;
    ex:hasSpouse entity:Julia_Bracken_Wendt .

