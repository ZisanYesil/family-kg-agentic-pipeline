@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:ordono_bermudez a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ordoño Bermúdez" ;
    onto:hasFather data:bermudo_ii_de_leon .

data:bermudo_ii_de_leon a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bermudo II of León" .

