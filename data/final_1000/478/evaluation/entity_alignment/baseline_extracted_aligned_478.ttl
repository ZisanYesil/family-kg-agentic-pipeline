@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Ordoño_Bermúdez> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ordoño Bermúdez" ;
    onto:hasFather <http://example.org/entity/Bermudo_II_of_León> .

<http://example.org/entity/Bermudo_II_of_León> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bermudo II of León" .

