@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Bermudo_II_of_León a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Ordoño_Bermúdez ;
    ex:hasCountry entity:Kingdom_of_León .

entity:Kingdom_of_León a ex:Country,
        ex:Place .

entity:Ordoño_Bermúdez a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Bermudo_II_of_León .

