@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:colegio_israelita_de_mexico a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Colegio Israelita de México" ;
    onto:hasInception "1924"^^xsd:gYear .

data:waldorf_university a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Waldorf University" ;
    onto:hasInception "1903"^^xsd:gYear .

