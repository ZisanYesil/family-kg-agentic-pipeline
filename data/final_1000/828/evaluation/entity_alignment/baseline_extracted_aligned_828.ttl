@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Colegio_Israelita_de_México> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Colegio Israelita de México" ;
    onto:hasInception "1924"^^xsd:gYear .

<http://example.org/entity/Waldorf_University> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Waldorf University" ;
    onto:hasInception "1903"^^xsd:gYear .

