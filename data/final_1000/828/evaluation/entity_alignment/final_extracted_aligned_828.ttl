@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Colegio_Israelita_de_México> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization ;
    ex:hasInception "1924"^^xsd:gYear .

<http://example.org/entity/Waldorf_University> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization ;
    ex:hasInception "1903"^^xsd:gYear .

