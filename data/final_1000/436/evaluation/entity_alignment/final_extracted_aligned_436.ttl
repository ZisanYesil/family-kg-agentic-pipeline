@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Red> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Branko_Tomovic> ;
    ex:hasDirector <http://example.org/entity/Branko_Tomovic> .

<http://example.org/entity/Münster> a ex:Place .

<http://example.org/entity/Branko_Tomovic> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Münster> .

