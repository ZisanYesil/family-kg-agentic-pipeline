@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Red a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Branko_Tomovic ;
    ex:hasDirector entity:Branko_Tomovic .

entity:Münster a ex:Place .

entity:Branko_Tomovic a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Münster .

