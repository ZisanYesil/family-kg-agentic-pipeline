@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Balls_Out> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Andrew_Disney> ;
    ex:hasDirector <http://example.org/entity/Andrew_Disney> .

<http://example.org/extracted/edu_tisch_school_of_the_arts> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Andrew_Disney> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/extracted/edu_tisch_school_of_the_arts> .

