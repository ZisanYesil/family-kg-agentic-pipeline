@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Balls_Out a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Andrew_Disney ;
    ex:hasDirector entity:Andrew_Disney .

entity:Tisch a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Andrew_Disney a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt entity:Tisch .

