@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_a_midnight_romance> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/extracted/person_anita_stewart> .

<http://example.org/extracted/film_the_bedford_incident> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/extracted/person_richard_widmark> .

<http://example.org/extracted/person_anita_stewart> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1961-05-04"^^xsd:date .

<http://example.org/extracted/person_richard_widmark> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2008-03-24"^^xsd:date .

