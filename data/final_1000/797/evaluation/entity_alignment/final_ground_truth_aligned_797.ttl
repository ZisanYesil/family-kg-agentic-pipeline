@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:A_Midnight_Romance a ex:Artifact,
        ex:CreativeWork ;
    ex:hasProducer entity:Anita_Stewart .

entity:The_Bedford_Incident a ex:Artifact,
        ex:CreativeWork ;
    ex:hasProducer entity:Richard_Widmark .

entity:Anita_Stewart a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1961-05-04"^^xsd:date .

entity:Richard_Widmark a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2008-03-24"^^xsd:date .

