@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/A_Midnight_Romance> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/Anita_Stewart> .

<http://example.org/entity/The_Bedford_Incident> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/Richard_Widmark> .

<http://example.org/entity/Anita_Stewart> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1961-05-04"^^xsd:date .

<http://example.org/entity/Richard_Widmark> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2008-03-24"^^xsd:date .

