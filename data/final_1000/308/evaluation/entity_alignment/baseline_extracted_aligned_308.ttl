@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Juliana_of_the_Netherlands> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Juliana of the Netherlands" ;
    onto:hasFather <http://example.org/entity/Duke_Henry_of_Mecklenburg_Schwerin> ;
    skos:altLabel "Juliana" .

<http://example.org/entity/Duke_Henry_of_Mecklenburg_Schwerin> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Prince Henry of Mecklenburg-Schwerin" ;
    skos:altLabel "Henry of Mecklenburg-Schwerin" .

