@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:juliana_netherlands a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Juliana of the Netherlands" ;
    onto:hasFather data:prince_henry_mecklenburg_schwerin ;
    skos:altLabel "Juliana" .

data:prince_henry_mecklenburg_schwerin a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Prince Henry of Mecklenburg-Schwerin" ;
    skos:altLabel "Henry of Mecklenburg-Schwerin" .

