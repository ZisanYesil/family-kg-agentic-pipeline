@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:She_Asked_for_It a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Erle_C_Kenton ;
    ex:hasDirector entity:Erle_C_Kenton .

entity:Parkinson a ex:CauseOfDeath .

entity:Erle_C_Kenton a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath entity:Parkinson .

