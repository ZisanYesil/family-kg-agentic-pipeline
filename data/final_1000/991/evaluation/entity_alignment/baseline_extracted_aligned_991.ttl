@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Killer_s_Romance> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Killer's Romance" ;
    onto:hasDirector <http://example.org/entity/Phillip_Ko> .

<http://example.org/entity/The_Ides_of_March_2011_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Ides of March (2011 film)" ;
    onto:hasDirector <http://example.org/entity/George_Clooney> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

<http://example.org/entity/George_Clooney> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "George Clooney" ;
    onto:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/Phillip_Ko> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Phillip Ko" ;
    onto:hasNationality data:country_hongkong .

data:country_hongkong a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Hong Kong" .

