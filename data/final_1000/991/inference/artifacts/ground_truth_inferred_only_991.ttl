@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Killer_s_Romance a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Phillip_Ko .

entity:The_Ides_of_March_2011_film a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:George_Clooney .

entity:American a ex:Country,
        ex:Place .

entity:China a ex:Country,
        ex:Place .

entity:George_Clooney a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:American .

entity:Phillip_Ko a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:China .

