@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/film_ides_2011> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/director_clooney> ;
    ex:hasDirector <http://example.org/extracted/director_clooney> .

<http://example.org/extracted/film_killers_romance> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/director_phillip_ko> ;
    ex:hasDirector <http://example.org/extracted/director_phillip_ko> .

<http://example.org/extracted/country_hongkong> a ex:Country,
        ex:Place .

<http://example.org/extracted/country_usa> a ex:Country,
        ex:Place .

<http://example.org/extracted/director_clooney> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/extracted/country_usa> ;
    ex:hasNationality <http://example.org/extracted/country_usa> .

<http://example.org/extracted/director_phillip_ko> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/extracted/country_hongkong> ;
    ex:hasNationality <http://example.org/extracted/country_hongkong> .

