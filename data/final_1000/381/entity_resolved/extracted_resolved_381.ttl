@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_guilty a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Guilty?" ;
    onto:hasPublicationDate "1930"^^xsd:gYear .

data:film_the_clink_of_ice a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Clink of Ice" ;
    onto:hasPublicationDate "2010"^^xsd:gYear .

