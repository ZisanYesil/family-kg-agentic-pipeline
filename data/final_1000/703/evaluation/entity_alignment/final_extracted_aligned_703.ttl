@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Simha_Jodi> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Joe_Simon> ;
    ex:hasDirector <http://example.org/entity/Joe_Simon> .

<http://example.org/entity/The_Pauper_Millionaire> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Frank_Hall_Crane> ;
    ex:hasDirector <http://example.org/entity/Frank_Hall_Crane> .

<http://example.org/entity/Frank_Hall_Crane> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/America> ;
    ex:hasNationality <http://example.org/entity/America> .

<http://example.org/entity/Joe_Simon> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/America> ;
    ex:hasNationality <http://example.org/entity/America> .

<http://example.org/entity/America> a ex:Country,
        ex:Place .

