@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Simha_Jodi> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Simha Jodi" ;
    onto:hasDirector <http://example.org/entity/Joe_Simon> .

<http://example.org/entity/The_Pauper_Millionaire> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Pauper Millionaire" ;
    onto:hasDirector <http://example.org/entity/Frank_Hall_Crane> .

<http://example.org/entity/Frank_Hall_Crane> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Frank Hall Crane" ;
    onto:hasNationality <http://example.org/entity/America> .

<http://example.org/entity/Joe_Simon> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Joe Simon" ;
    onto:hasNationality <http://example.org/entity/America> ;
    skos:altLabel "Joseph Henry Simon" .

<http://example.org/entity/America> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

