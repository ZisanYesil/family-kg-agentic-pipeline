@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Wonder_en_is_gheen_Wonder a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher entity:SKEPP .

entity:Belgian a ex:Country,
        ex:Place .

