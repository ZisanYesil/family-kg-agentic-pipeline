@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:chris_haughton a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Chris Haughton" ;
    onto:hasNationality data:canada .

data:j_herve_proulx a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "J. Hervé Proulx" ;
    onto:hasNationality data:canada .

data:canada a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" ;
    skos:altLabel "Canadian" .

