@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Coal_City_Illinois> a ex:Place ;
    ex:hasCountry <http://example.org/entity/U_S> .

<http://example.org/entity/Lash_Kenar_Nur> a ex:Place ;
    ex:hasCountry <http://example.org/entity/Iran> .

<http://example.org/entity/Iran> a ex:Country,
        ex:Place .

<http://example.org/entity/U_S> a ex:Country,
        ex:Place .

