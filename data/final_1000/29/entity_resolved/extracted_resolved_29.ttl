@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:coal_city_illinois a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Coal City, Illinois" ;
    onto:hasCountry data:united_states .

data:lash_kenar_nur a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Lash Kenar, Nur" ;
    onto:hasCountry data:iran .

data:iran a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Iran" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "America",
        "U.S.",
        "U.S.A." .

