@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Julia_Drusilla> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/extracted/caligula> ;
    ex:hasParent <http://example.org/extracted/caligula> .

<http://example.org/entity/Agrippina_the_Elder> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/extracted/caligula> .

<http://example.org/extracted/caligula> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Julia_Drusilla> ;
    ex:hasMother <http://example.org/entity/Agrippina_the_Elder> ;
    ex:hasParent <http://example.org/entity/Agrippina_the_Elder> .

