@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Agrippina_the_Younger> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Agrippina_the_Elder> ;
    ex:hasParent <http://example.org/entity/Agrippina_the_Elder> .

<http://example.org/entity/starvation> a ex:CauseOfDeath .

<http://example.org/entity/Agrippina_the_Elder> a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath <http://example.org/entity/starvation> ;
    ex:hasChild <http://example.org/entity/Agrippina_the_Younger> .

