@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Agrippina_the_Younger a ex:Agent,
        ex:Person ;
    ex:hasMother entity:Agrippina_the_Elder ;
    ex:hasParent entity:Agrippina_the_Elder .

entity:starvation a ex:CauseOfDeath .

entity:Agrippina_the_Elder a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath entity:starvation ;
    ex:hasChild entity:Agrippina_the_Younger .

