@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:lake_powell a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Lake Powell" ;
    onto:hasCountry data:united_states .

data:takhlakh_lake a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Takhlakh Lake" ;
    onto:hasCountry data:united_states .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "U.S.",
        "USA" .

