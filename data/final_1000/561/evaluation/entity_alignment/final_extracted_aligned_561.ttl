@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Life_Without_Soul> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Joseph_W_Smiley> ;
    ex:hasDirector <http://example.org/entity/Joseph_W_Smiley> .

<http://example.org/entity/New_York> a ex:Place .

<http://example.org/entity/Joseph_W_Smiley> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/New_York> .

