@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Life_Without_Soul> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Life Without Soul" ;
    onto:hasDirector <http://example.org/entity/Joseph_W_Smiley> .

<http://example.org/entity/Joseph_W_Smiley> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Joseph W. Smiley" ;
    onto:hasDeathPlace <http://example.org/entity/New_York> .

<http://example.org/entity/New_York> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "New York City, New York, USA" ;
    skos:altLabel "New York City" .

