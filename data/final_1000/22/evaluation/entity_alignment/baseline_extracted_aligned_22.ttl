@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Ingegerd_Olofsdotter_of_Sweden> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ingegerd Olofsdotter of Sweden" ;
    onto:hasFather <http://example.org/entity/Olof_Skötkonung> ;
    skos:altLabel "Anna",
        "Ingegerd Olofsdotter",
        "Ingegerd Olofsdotter of Sweden",
        "Irene",
        "Saint Anna" .

<http://example.org/entity/Olof_Skötkonung> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Olof Skötkonung" ;
    onto:hasMother <http://example.org/entity/Sigrid_the_Haughty> ;
    skos:altLabel "Olof Skötkonung" .

<http://example.org/entity/Sigrid_the_Haughty> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sigrid the Haughty" ;
    skos:altLabel "Sigrid the Haughty" .

