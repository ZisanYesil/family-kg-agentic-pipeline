@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Blanche_of_France_Duchess_of_Orléans> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Blanche of France, Duchess of Orléans" ;
    onto:hasMother <http://example.org/entity/Jeanne_d_Évreux> .

<http://example.org/entity/Jeanne_d_Évreux> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jeanne d'Évreux" ;
    onto:hasFather <http://example.org/entity/Louis_Count_of_Évreux> .

<http://example.org/entity/Louis_Count_of_Évreux> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Louis, Count of Évreux" .

