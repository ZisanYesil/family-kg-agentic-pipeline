@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:hard_feelings_loveless a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Hard Feelings/Loveless" ;
    onto:hasPerformer data:lorde .

data:lorde a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lorde" ;
    onto:hasBirthDate "1996-11-07"^^xsd:date ;
    onto:hasBirthPlace data:takapuna ;
    skos:altLabel "Ella Marija Lani Yelich-O'Connor" .

data:takapuna a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Takapuna" ;
    skos:altLabel "Auckland suburb of Takapuna" .

