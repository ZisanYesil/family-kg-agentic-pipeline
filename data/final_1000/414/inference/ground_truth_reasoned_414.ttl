@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Hard_Feelings_Loveless a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Lorde ;
    ex:hasPerformer entity:Lorde .

entity:Takapuna a ex:Place .

entity:Lorde a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Takapuna .

