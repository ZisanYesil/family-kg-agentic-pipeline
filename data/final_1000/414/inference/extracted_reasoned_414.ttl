@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/hard_feelings_loveless> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/extracted/lorde> ;
    ex:hasPerformer <http://example.org/extracted/lorde> .

<http://example.org/extracted/takapuna> a ex:Place .

<http://example.org/extracted/lorde> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1996-11-07"^^xsd:date ;
    ex:hasBirthPlace <http://example.org/extracted/takapuna> .

