@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:nubes_de_humo_film_1958 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Nubes de humo" ;
    onto:hasPublicationDate "1958"^^xsd:gYear ;
    skos:altLabel "Nubes de humo" .

data:the_samurai_in_autumn_film_2016 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Samurai in Autumn" ;
    onto:hasPublicationDate "2016"^^xsd:gYear ;
    skos:altLabel "The Samurai in Autumn" .

