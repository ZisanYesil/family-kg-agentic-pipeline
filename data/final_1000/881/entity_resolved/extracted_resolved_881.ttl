@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:auguste_theodore_paul_de_broglie a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Auguste-Théodore-Paul de Broglie" ;
    onto:hasFather data:achille_victor_duke_de_broglie ;
    skos:altLabel "Abbé Auguste-Théodore-Paul de Broglie" .

data:achille_victor_duke_de_broglie a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Achille-Victor, Duc de Broglie" .

