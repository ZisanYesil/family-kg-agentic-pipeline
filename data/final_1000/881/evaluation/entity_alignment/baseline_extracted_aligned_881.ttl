@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Auguste_Théodore_Paul_de_Broglie> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Auguste-Théodore-Paul de Broglie" ;
    onto:hasFather <http://example.org/entity/Victor_de_Broglie> ;
    skos:altLabel "Abbé Auguste-Théodore-Paul de Broglie" .

<http://example.org/entity/Victor_de_Broglie> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Achille-Victor, Duc de Broglie" .

