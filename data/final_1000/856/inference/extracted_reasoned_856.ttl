@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/film_daadagiri> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_arshad_khan> ;
    ex:hasDirector <http://example.org/extracted/person_arshad_khan> .

<http://example.org/extracted/country_australia> a ex:Country,
        ex:Place .

<http://example.org/extracted/country_pakistan> a ex:Country,
        ex:Place .

<http://example.org/extracted/person_arshad_khan> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/extracted/country_australia>,
        <http://example.org/extracted/country_pakistan> ;
