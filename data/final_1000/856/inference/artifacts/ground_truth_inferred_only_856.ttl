@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Daadagiri a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Arshad_Khan .

entity:Arshad_Khan a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:Pakistan .

entity:Pakistan a ex:Country,
        ex:Place .

