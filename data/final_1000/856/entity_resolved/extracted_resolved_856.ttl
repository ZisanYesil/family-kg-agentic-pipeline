@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_daadagiri a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Daadagiri" ;
    onto:hasDirector data:person_arshad_khan .

data:country_australia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Australia" ;
    skos:altLabel "Australian" .

data:country_pakistan a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Pakistan" ;
    skos:altLabel "Pakistani" .

data:person_arshad_khan a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Arshad Khan" ;
    onto:hasNationality data:country_australia,
        data:country_pakistan .

