@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Daadagiri> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Arshad_Khan> ;
    ex:hasDirector <http://example.org/entity/Arshad_Khan> .

<http://example.org/entity/Arshad_Khan> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Pakistan>,
        <http://example.org/extracted/country_australia> ;
    ex:hasNationality <http://example.org/entity/Pakistan>,
        <http://example.org/extracted/country_australia> .

<http://example.org/entity/Pakistan> a ex:Country,
        ex:Place .

<http://example.org/extracted/country_australia> a ex:Country,
        ex:Place .

