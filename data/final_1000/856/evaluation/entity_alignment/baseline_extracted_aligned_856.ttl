@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Daadagiri> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Daadagiri" ;
    onto:hasDirector <http://example.org/entity/Arshad_Khan> .

<http://example.org/entity/Arshad_Khan> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Arshad Khan" ;
    onto:hasNationality <http://example.org/entity/Pakistan>,
        data:country_australia .

<http://example.org/entity/Pakistan> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Pakistan" ;
    skos:altLabel "Pakistani" .

data:country_australia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Australia" ;
    skos:altLabel "Australian" .

