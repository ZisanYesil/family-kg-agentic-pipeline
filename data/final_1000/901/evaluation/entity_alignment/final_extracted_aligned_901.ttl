@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Red_Sundown> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Jack_Arnold> ;
    ex:hasDirector <http://example.org/entity/Jack_Arnold> .

<http://example.org/entity/Suvarna_Sethuve> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Geethapriya> ;
    ex:hasDirector <http://example.org/entity/Geethapriya> .

<http://example.org/entity/Geethapriya> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2016-01-17"^^xsd:date .

<http://example.org/entity/Jack_Arnold> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1992-03-17"^^xsd:date .

