@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Red_Sundown> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Red Sundown" ;
    onto:hasDirector <http://example.org/entity/Jack_Arnold> .

<http://example.org/entity/Suvarna_Sethuve> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Suvarna Sethuve" ;
    onto:hasDirector <http://example.org/entity/Geethapriya> .

<http://example.org/entity/Geethapriya> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Geethapriya" ;
    onto:hasDeathDate "2016-01-17"^^xsd:date ;
    skos:altLabel "Lakshman Rao Mohite" .

<http://example.org/entity/Jack_Arnold> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jack Arnold" ;
    onto:hasDeathDate "1992-03-17"^^xsd:date .

