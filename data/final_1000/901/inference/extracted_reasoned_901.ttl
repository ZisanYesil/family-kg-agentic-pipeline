@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_red_sundown> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/director_jack_arnold> ;
    ex:hasDirector <http://example.org/extracted/director_jack_arnold> .

<http://example.org/extracted/film_suvarna_sethuve> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/director_geethapriya> ;
    ex:hasDirector <http://example.org/extracted/director_geethapriya> .

<http://example.org/extracted/director_geethapriya> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2016-01-17"^^xsd:date .

<http://example.org/extracted/director_jack_arnold> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1992-03-17"^^xsd:date .

