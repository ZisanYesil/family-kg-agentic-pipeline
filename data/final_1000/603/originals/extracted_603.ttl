@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:a_touch_of_zen_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Touch of Zen" ;
    onto:hasPublicationDate "1971"^^xsd:gYear .

data:chungakkarum_veshyakalum_film a onto:Film,
        owl:NamedIndividual ;
