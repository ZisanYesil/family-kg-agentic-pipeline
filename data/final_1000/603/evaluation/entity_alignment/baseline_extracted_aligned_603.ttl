@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/A_Touch_of_Zen> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Touch of Zen" ;
    onto:hasPublicationDate "1971"^^xsd:gYear .

<http://example.org/entity/Chungakkarum_Veshyakalum> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Chungakkarum Veshyakalum" ;
    onto:hasPublicationDate "2011"^^xsd:gYear .

