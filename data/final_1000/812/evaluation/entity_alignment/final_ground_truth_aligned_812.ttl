@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:24_Hour_Psycho a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Douglas_Gordon ;
    ex:hasDirector entity:Douglas_Gordon .

entity:Turner_Prize a ex:Award .

entity:Douglas_Gordon a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived entity:Turner_Prize .

