@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/24_Hour_Psycho> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Douglas_Gordon> .

<http://example.org/entity/Douglas_Gordon> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/entity/Turner_Prize> .

<http://example.org/entity/Turner_Prize> a ex:Award .

