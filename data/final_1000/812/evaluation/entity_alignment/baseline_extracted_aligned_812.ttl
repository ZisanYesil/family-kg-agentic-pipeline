@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/24_Hour_Psycho> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "24 Hour Psycho" ;
    onto:hasCreator <http://example.org/entity/Douglas_Gordon> .

<http://example.org/entity/Douglas_Gordon> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Douglas Gordon" ;
    onto:hasAwardReceived <http://example.org/entity/Turner_Prize> .

<http://example.org/entity/Turner_Prize> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Turner Prize" .

