@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Bernadine> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Pat_Boone> ;
    ex:hasPerformer <http://example.org/entity/Pat_Boone> .

<http://example.org/entity/Gospel_Music_Hall_of_Fame> a ex:Award .

<http://example.org/entity/Pat_Boone> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/entity/Gospel_Music_Hall_of_Fame> .

