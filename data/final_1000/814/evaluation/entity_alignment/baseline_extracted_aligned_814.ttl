@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Bernadine> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Bernardine" ;
    onto:hasPerformer <http://example.org/entity/Pat_Boone> ;
    skos:altLabel "Bernardine" .

<http://example.org/entity/Gospel_Music_Hall_of_Fame> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Gospel Music Hall of Fame" ;
    skos:altLabel "Gospel Music Hall of Fame" .

<http://example.org/entity/Pat_Boone> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Pat Boone" ;
    skos:altLabel "Pat Boone" .

