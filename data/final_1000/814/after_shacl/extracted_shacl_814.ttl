@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:bernardine_song a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Bernardine" ;
    onto:hasPerformer data:pat_boone ;
    skos:altLabel "Bernardine" .

data:gospel_music_hall_of_fame a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Gospel Music Hall of Fame" ;
    skos:altLabel "Gospel Music Hall of Fame" .

data:pat_boone a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Pat Boone" ;
    onto:hasAwardReceived data:gospel_music_hall_of_fame ;
    skos:altLabel "Pat Boone" .

