@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/FLMNE> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Faculté Libre de Médecines Naturelles et d'Ethnomédecine" ;
    onto:hasFounder <http://example.org/entity/Jean_Pierre_Willem> ;
    skos:altLabel "FLMNE" .

<http://example.org/entity/Jean_Pierre_Willem> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jean-Pierre Willem" ;
    onto:hasBirthPlace <http://example.org/entity/Sedan> .

<http://example.org/entity/Sedan> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Sedan, France" .

