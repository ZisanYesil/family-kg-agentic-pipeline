@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/FLMNE> a ex:Agent,
        ex:Organization ;
    ex:hasFounder <http://example.org/entity/Jean_Pierre_Willem> .

<http://example.org/entity/Jean_Pierre_Willem> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Sedan> .

<http://example.org/entity/Sedan> a ex:Place .

