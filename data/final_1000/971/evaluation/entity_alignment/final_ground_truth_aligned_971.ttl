@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:FLMNE a ex:Agent,
        ex:Organization ;
    ex:hasFounder entity:Jean_Pierre_Willem .

entity:Jean_Pierre_Willem a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Sedan .

entity:Sedan a ex:Place .

