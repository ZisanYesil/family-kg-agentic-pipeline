@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:flmne a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Faculté Libre de Médecines Naturelles et d'Ethnomédecine" ;
    onto:hasFounder data:jean_pierre_willem ;
    skos:altLabel "FLMNE" .

data:jean_pierre_willem a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jean-Pierre Willem" ;
    onto:hasBirthPlace data:sedan_france .

data:sedan_france a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Sedan, France" .

