@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Antikarisma> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Antikarisma" ;
    onto:hasFounder <http://example.org/entity/Shahin_Najafi> .

<http://example.org/entity/Bandar_e_Anzali_Gilan_Iran> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Bandar-e Anzali, Gilan, Iran" .

<http://example.org/entity/Shahin_Najafi> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Shahin Najafi" ;
    onto:hasBirthPlace <http://example.org/entity/Bandar_e_Anzali_Gilan_Iran> .

