@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Office_Romance> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Office Romance" ;
    onto:hasPublicationDate "1977"^^xsd:gYear .

<http://example.org/entity/The_Little_Convict> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Little Convict" ;
    onto:hasPublicationDate "1979"^^xsd:gYear .

