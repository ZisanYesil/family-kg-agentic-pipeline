@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_office_romance a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Office Romance" ;
    onto:hasPublicationDate "1977"^^xsd:gYear .

data:film_the_little_convict a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Little Convict" ;
    onto:hasPublicationDate "1979"^^xsd:gYear .

