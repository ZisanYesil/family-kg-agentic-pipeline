@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Inside_My_Love a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Minnie_Riperton ;
    ex:hasPerformer entity:Minnie_Riperton .

entity:Chicago a ex:Place .

entity:Minnie_Riperton a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Chicago .

