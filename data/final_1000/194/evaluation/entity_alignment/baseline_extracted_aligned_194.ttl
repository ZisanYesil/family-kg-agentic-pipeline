@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Inside_My_Love> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Inside My Love" ;
    onto:hasPerformer <http://example.org/entity/Minnie_Riperton> .

<http://example.org/entity/Minnie_Riperton> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Minnie Riperton" ;
    skos:altLabel "Minnie Julia Riperton‑Rudolph" .

