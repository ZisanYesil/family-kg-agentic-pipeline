@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Operation_Petticoat> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Operation Petticoat" ;
    onto:hasDirector <http://example.org/entity/Blake_Edwards> .

<http://example.org/entity/War_Book> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "War Book" ;
    onto:hasDirector <http://example.org/entity/Tom_Harper> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

<http://example.org/entity/Blake_Edwards> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Blake Edwards" ;
    onto:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/British> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

<http://example.org/entity/Tom_Harper> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tom Harper" ;
    onto:hasNationality <http://example.org/entity/British> .

