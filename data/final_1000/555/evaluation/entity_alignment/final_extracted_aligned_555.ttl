@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Operation_Petticoat> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Blake_Edwards> ;
    ex:hasDirector <http://example.org/entity/Blake_Edwards> .

<http://example.org/entity/War_Book> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Tom_Harper> ;
    ex:hasDirector <http://example.org/entity/Tom_Harper> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/Blake_Edwards> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/British> a ex:Country,
        ex:Place .

<http://example.org/entity/Tom_Harper> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/British> ;
    ex:hasNationality <http://example.org/entity/British> .

