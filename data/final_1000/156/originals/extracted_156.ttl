@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:other_half_2016_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Other Half (2016 film)" ;
    onto:hasCountry data:canada_country .

data:spy_kids_2_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Spy Kids 2: The Island of Lost Dreams" ;
    onto:hasCountry data:united_states_country .

data:canada_country a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" .

data:united_states_country a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" .

