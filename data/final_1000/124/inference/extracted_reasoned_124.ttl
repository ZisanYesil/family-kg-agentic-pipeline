        ex:Person ;
    ex:hasDeathDate "1819-08-25"^^xsd:date .

<http://example.org/extracted/matthew_boulton_1728> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1809-08-17"^^xsd:date .

