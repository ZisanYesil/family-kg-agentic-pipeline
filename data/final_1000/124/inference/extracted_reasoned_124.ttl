@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/boulton_watt> a ex:Agent,
        ex:Organization ;
    ex:hasFounder <http://example.org/extracted/james_watt_1736>,
        <http://example.org/extracted/matthew_boulton_1728> .

