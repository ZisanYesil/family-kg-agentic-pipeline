@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:boulton_watt a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Boulton & Watt" ;
    onto:hasFounder data:james_watt_1736,
        data:matthew_boulton_1728 ;
    skos:altLabel "Boulton and Watt" .

data:james_watt_1736 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "James Watt" ;
    onto:hasDeathDate "1819-08-25"^^xsd:date .

data:matthew_boulton_1728 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Matthew Boulton" ;
    onto:hasDeathDate "1809-08-17"^^xsd:date .

