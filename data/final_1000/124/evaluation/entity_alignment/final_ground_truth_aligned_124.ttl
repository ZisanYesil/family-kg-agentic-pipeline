@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Boulton_Watt a ex:Agent,
        ex:Organization ;
    ex:hasFounder entity:Matthew_Boulton .

entity:Matthew_Boulton a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1809-08-17"^^xsd:date .

