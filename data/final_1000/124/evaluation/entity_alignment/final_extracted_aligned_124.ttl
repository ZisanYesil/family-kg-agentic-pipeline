@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Boulton_Watt> a ex:Agent,
        ex:Organization ;
    ex:hasFounder <http://example.org/entity/Matthew_Boulton>,
        <http://example.org/extracted/james_watt_1736> .

<http://example.org/entity/Matthew_Boulton> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1809-08-17"^^xsd:date .

<http://example.org/extracted/james_watt_1736> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1819-08-25"^^xsd:date .

