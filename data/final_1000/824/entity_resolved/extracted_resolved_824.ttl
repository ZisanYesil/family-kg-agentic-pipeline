@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:the_dancer_of_sanssouci a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Dancer of Sanssouci" ;
    onto:hasPublicationDate "1932"^^xsd:gYear .

data:wish_i_were_a_shark a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Wish I Were a Shark" ;
    onto:hasPublicationDate "1999"^^xsd:gYear .

