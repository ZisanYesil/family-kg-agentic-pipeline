@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/The_Dancer_of_Sanssouci> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Dancer of Sanssouci" ;
    onto:hasPublicationDate "1932"^^xsd:gYear .

<http://example.org/entity/Wish_I_Were_a_Shark> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Wish I Were a Shark" ;
    onto:hasPublicationDate "1999"^^xsd:gYear .

