@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Bernhard_Afinger> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bernhard Afinger" ;
    onto:hasBirthDate "1813-05-06"^^xsd:date ;
    onto:hasDeathDate "1882-12-25"^^xsd:date .

<http://example.org/entity/Melvin_Kranzberg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Melvin Kranzberg" ;
    onto:hasBirthDate "1917-11-22"^^xsd:date ;
    onto:hasDeathDate "1995-12-06"^^xsd:date .

