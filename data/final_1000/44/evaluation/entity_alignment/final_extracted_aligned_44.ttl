@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Bernhard_Afinger> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1813-05-06"^^xsd:date ;
    ex:hasDeathDate "1882-12-25"^^xsd:date .

<http://example.org/entity/Melvin_Kranzberg> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1917-11-22"^^xsd:date ;
    ex:hasDeathDate "1995-12-06"^^xsd:date .

