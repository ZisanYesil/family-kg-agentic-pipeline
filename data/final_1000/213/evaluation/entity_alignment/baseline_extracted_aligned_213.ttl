@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Dear_Brat> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Dear Brat" ;
    onto:hasPublicationDate "1951"^^xsd:gYear .

<http://example.org/entity/Eleven_Pairs_of_Boots> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Eleven Pairs of Boots" ;
    onto:hasPublicationDate "1954"^^xsd:gYear ;
    skos:altLabel "Once pares de botas" .

