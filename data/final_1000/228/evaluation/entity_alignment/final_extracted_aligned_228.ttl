@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Netflix> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/2_Chainz> ;
    ex:hasPerformer <http://example.org/entity/2_Chainz> .

<http://example.org/entity/College_Park_Georgia> a ex:Place .

<http://example.org/entity/2_Chainz> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/College_Park_Georgia> .

