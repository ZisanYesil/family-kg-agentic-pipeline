@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Netflix a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:2_Chainz ;
    ex:hasPerformer entity:2_Chainz .

entity:College_Park_Georgia a ex:Place .

entity:2_Chainz a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:College_Park_Georgia .

