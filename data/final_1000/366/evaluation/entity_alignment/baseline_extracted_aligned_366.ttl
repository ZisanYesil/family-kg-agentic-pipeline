@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Adolphus_Island> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Adolphus Island" ;
    onto:hasCountry <http://example.org/entity/Australia> .

<http://example.org/entity/Seal_Island_Victoria> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Seal Island (Victoria)" ;
    onto:hasCountry <http://example.org/entity/Australia> .

<http://example.org/entity/Australia> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Australia" .

