@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:adolphus_island a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Adolphus Island" ;
    onto:hasCountry data:australia .

data:seal_island_victoria a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Seal Island (Victoria)" ;
    onto:hasCountry data:australia .

data:australia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Australia" .

