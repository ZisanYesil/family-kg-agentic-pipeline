@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Alam_Shah> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Muhammad_Shah> ;
    ex:hasParent <http://example.org/entity/Muhammad_Shah> .

<http://example.org/entity/Lodi_Gardens> a ex:Place .

<http://example.org/entity/Muhammad_Shah> a ex:Agent,
        ex:Person ;
    ex:hasBurialPlace <http://example.org/entity/Lodi_Gardens> ;
    ex:hasChild <http://example.org/entity/Alam_Shah> .

