@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Alam_Shah> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alam Shah" ;
    onto:hasFather <http://example.org/entity/Muhammad_Shah> .

<http://example.org/entity/Lodi_Gardens> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Lodi Gardens" ;
    skos:altLabel "New Delhi" .

<http://example.org/entity/Muhammad_Shah> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Muhammad Shah" ;
    onto:hasBurialPlace <http://example.org/entity/Lodi_Gardens> .

