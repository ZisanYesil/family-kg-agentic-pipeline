@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:charles_orlando_dauphin_of_france a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Charles Orlando, Dauphin of France" ;
    onto:hasFather data:charles_viii_of_france .

data:accidental_head_injury a onto:CauseOfDeath,
        owl:NamedIndividual ;
    rdfs:label "accidental head injury (struck head on door lintel)" .

data:charles_viii_of_france a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Charles VIII of France" ;
    onto:hasCauseOfDeath data:accidental_head_injury .

