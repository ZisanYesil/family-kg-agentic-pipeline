@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Charles_Orlando_Dauphin_of_France> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Charles Orlando, Dauphin of France" ;
    onto:hasFather <http://example.org/entity/Charles_VIII_of_France> .

<http://example.org/entity/Charles_VIII_of_France> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Charles VIII of France" ;
    onto:hasCauseOfDeath data:accidental_head_injury .

data:accidental_head_injury a onto:CauseOfDeath,
        owl:NamedIndividual ;
    rdfs:label "accidental head injury (struck head on door lintel)" .

