@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/supercut_song> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/extracted/lorde_person> ;
    ex:hasPerformer <http://example.org/extracted/lorde_person> .

<http://example.org/extracted/takapuna_place> a ex:Place .

<http://example.org/extracted/lorde_person> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/extracted/takapuna_place> .

