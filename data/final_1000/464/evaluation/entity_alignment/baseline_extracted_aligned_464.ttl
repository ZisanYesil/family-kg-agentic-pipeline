@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Supercut> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Supercut" ;
    onto:hasPerformer <http://example.org/entity/Lorde> .

<http://example.org/entity/Lorde> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lorde" ;
    onto:hasBirthPlace <http://example.org/entity/Takapuna> ;
    skos:altLabel "Ella Marija Lani Yelich-O'Connor" .

<http://example.org/entity/Takapuna> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Takapuna" .

