@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Supercut> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Lorde> ;
    ex:hasPerformer <http://example.org/entity/Lorde> .

<http://example.org/entity/Takapuna> a ex:Place .

<http://example.org/entity/Lorde> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Takapuna> .

