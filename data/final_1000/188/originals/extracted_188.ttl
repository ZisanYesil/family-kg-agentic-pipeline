@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_pyrammmid a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The PyraMMMid" ;
    onto:hasPublicationDate "2011"^^xsd:gYear .

data:film_revolt_praetorians a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Revolt of the Praetorians" ;
    onto:hasPublicationDate "1964"^^xsd:gYear .

