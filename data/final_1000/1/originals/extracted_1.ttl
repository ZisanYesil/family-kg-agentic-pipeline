@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:north_marion_hs_oregon a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "North Marion High School (Oregon)" ;
    onto:hasCountry data:united_states ;
    skos:altLabel "North Marion High School" .

data:seoul_hs a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Seoul High School" ;
    onto:hasCountry data:south_korea .

data:south_korea a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "South Korea" ;
    skos:altLabel "Republic of Korea" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "U.S.",
        "U.S.A.",
        "USA" .

