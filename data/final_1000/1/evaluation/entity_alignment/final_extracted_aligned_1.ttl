@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/North_Marion_High_School_Oregon> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization ;
    ex:hasCountry <http://example.org/entity/United_States> .

<http://example.org/entity/Seoul_High_School> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization ;
    ex:hasCountry <http://example.org/entity/South_Korea> .

<http://example.org/entity/South_Korea> a ex:Country,
        ex:Place .

<http://example.org/entity/United_States> a ex:Country,
        ex:Place .

