@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:sharqliyya a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Sharqliyya" ;
    onto:hasCountry data:syria ;
    skos:altLabel "Sharqlieh" .

data:umm_al_tuyour_hama a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Umm al-Tuyour, Hama Governorate" ;
    onto:hasCountry data:syria ;
    skos:altLabel "Umm al-Tuyour" .

data:syria a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Syria" .

