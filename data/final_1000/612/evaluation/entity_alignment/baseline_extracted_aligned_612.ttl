@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Sharqliyya> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Sharqliyya" ;
    onto:hasCountry <http://example.org/entity/Syria> ;
    skos:altLabel "Sharqlieh" .

<http://example.org/entity/Umm_al_Tuyour_Hama_Governorate> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Umm al-Tuyour, Hama Governorate" ;
    onto:hasCountry <http://example.org/entity/Syria> ;
    skos:altLabel "Umm al-Tuyour" .

<http://example.org/entity/Syria> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Syria" .

