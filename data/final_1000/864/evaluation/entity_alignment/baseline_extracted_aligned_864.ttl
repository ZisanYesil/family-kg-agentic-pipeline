@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Vestire_gli_ignudi> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Vestire gli ignudi" ;
    onto:hasDirector <http://example.org/entity/Marcello_Pagliero> .

<http://example.org/entity/Marcello_Pagliero> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Marcello Pagliero" ;
    onto:hasDeathPlace <http://example.org/entity/Paris> .

<http://example.org/entity/Paris> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Paris" .

