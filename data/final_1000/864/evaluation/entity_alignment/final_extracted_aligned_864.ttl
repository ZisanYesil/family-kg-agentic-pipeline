@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Vestire_gli_ignudi> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Marcello_Pagliero> ;
    ex:hasDirector <http://example.org/entity/Marcello_Pagliero> .

<http://example.org/entity/Paris> a ex:Place .

<http://example.org/entity/Marcello_Pagliero> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Paris> .

