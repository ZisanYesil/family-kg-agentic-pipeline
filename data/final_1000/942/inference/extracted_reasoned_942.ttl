@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/demetrius_and_the_gladiators_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/delmer_daves> ;
    ex:hasDirector <http://example.org/extracted/delmer_daves> .

<http://example.org/extracted/riders_of_the_deadline_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/lesley_selander> ;
    ex:hasDirector <http://example.org/extracted/lesley_selander> .

<http://example.org/extracted/delmer_daves> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1904-07-24"^^xsd:date .

<http://example.org/extracted/lesley_selander> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1900-05-26"^^xsd:date .

