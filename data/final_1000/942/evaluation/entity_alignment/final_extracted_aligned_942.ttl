@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Demetrius_and_the_Gladiators> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Delmer_Daves> ;
    ex:hasDirector <http://example.org/entity/Delmer_Daves> .

<http://example.org/entity/Riders_of_the_Deadline> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Lesley_Selander> ;
    ex:hasDirector <http://example.org/entity/Lesley_Selander> .

<http://example.org/entity/Delmer_Daves> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1904-07-24"^^xsd:date .

<http://example.org/entity/Lesley_Selander> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1900-05-26"^^xsd:date .

