@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Agents_of_Good_Roots a ex:Artifact ;
    ex:hasCountry entity:American .

entity:The_Human_League a ex:Artifact ;
    ex:hasCountry entity:British .

entity:American a ex:Country,
        ex:Place .

entity:British a ex:Country,
        ex:Place .

