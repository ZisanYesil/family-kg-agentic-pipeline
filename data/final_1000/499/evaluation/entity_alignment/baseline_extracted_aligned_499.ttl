@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Galaxis> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Galaxis" ;
    onto:hasPublicationDate "1995"^^xsd:gYear .

<http://example.org/entity/The_Bong_Connection> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Bong Connection" ;
    onto:hasPublicationDate "2006"^^xsd:gYear .

