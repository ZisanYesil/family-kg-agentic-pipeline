@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:bong_connection_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Bong Connection" ;
    onto:hasPublicationDate "2006"^^xsd:gYear .

data:galaxis_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Galaxis" ;
    onto:hasPublicationDate "1995"^^xsd:gYear .

