@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:catherine_osborne a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Catherine Isabella Osborne" ;
    onto:hasBirthDate "1818-06-30"^^xsd:date ;
    onto:hasDeathDate "1880-06-21"^^xsd:date .

data:david_de_haan a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "David Bierens de Haan" ;
    onto:hasBirthDate "1822-05-03"^^xsd:date ;
    onto:hasDeathDate "1895-08-12"^^xsd:date .

