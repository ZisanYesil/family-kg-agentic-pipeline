@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Catherine_Isabella_Osborne> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1818-06-30"^^xsd:date ;
    ex:hasDeathDate "1880-06-21"^^xsd:date .

