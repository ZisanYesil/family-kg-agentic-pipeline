@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Believe_It a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Meek_Mill ;
    ex:hasPerformer entity:Meek_Mill .

entity:State_Correctional_Institution_Chester a ex:Place .

entity:Meek_Mill a ex:Agent,
        ex:Person ;
    ex:hasDetentionPlace entity:State_Correctional_Institution_Chester .

