@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Believe_It> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Meek_Mill> ;
    ex:hasPerformer <http://example.org/entity/Meek_Mill> .

<http://example.org/entity/State_Correctional_Institution_Chester> a ex:Place .

<http://example.org/entity/Meek_Mill> a ex:Agent,
        ex:Person ;
    ex:hasDetentionPlace <http://example.org/entity/State_Correctional_Institution_Chester> .

