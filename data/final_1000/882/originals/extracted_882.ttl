@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:war_of_the_buttons_1994_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "War of the Buttons (1994 film)" ;
    onto:hasDirector data:john_roberts .

data:john_roberts a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Roberts" ;
    onto:hasNationality data:united_states ;
    skos:altLabel "John Glover Roberts Jr." .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

