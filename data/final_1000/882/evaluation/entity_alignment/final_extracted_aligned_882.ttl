@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/War_of_the_Buttons> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/John_Roberts> ;
    ex:hasDirector <http://example.org/entity/John_Roberts> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/John_Roberts> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasNationality <http://example.org/entity/American> .

