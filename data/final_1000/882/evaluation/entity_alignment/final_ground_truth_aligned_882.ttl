@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:War_of_the_Buttons a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:John_Roberts ;
    ex:hasDirector entity:John_Roberts .

entity:American a ex:Country,
        ex:Place .

entity:John_Roberts a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:American ;
    ex:hasCountry entity:American .

