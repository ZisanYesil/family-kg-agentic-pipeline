@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Paul_Foley> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Paul Foley" ;
    onto:hasFather <http://example.org/entity/Thomas_Foley> .

<http://example.org/entity/English> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "England" ;
    skos:altLabel "English" .

<http://example.org/entity/Thomas_Foley> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Thomas Foley" ;
    onto:hasNationality <http://example.org/entity/English> .

