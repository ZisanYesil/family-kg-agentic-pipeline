@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Paul_Foley> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Thomas_Foley> ;
    ex:hasParent <http://example.org/entity/Thomas_Foley> .

<http://example.org/entity/English> a ex:Country,
        ex:Place .

<http://example.org/entity/Thomas_Foley> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Paul_Foley> ;
    ex:hasCountry <http://example.org/entity/English> ;
    ex:hasNationality <http://example.org/entity/English> .

