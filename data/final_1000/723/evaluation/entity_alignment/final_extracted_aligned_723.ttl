@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/El_Show_de_Renny> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPresenter <http://example.org/entity/Renny_Ottolina> .

<http://example.org/entity/Renny_Ottolina> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Valencia> .

<http://example.org/entity/Valencia> a ex:Place .

