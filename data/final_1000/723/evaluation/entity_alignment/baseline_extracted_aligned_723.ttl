@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/El_Show_de_Renny> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "El Show De Renny" ;
    onto:hasPresenter <http://example.org/entity/Renny_Ottolina> .

<http://example.org/entity/Renny_Ottolina> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Renny Ottolina" ;
    onto:hasBirthPlace <http://example.org/entity/Valencia> ;
    skos:altLabel "Renaldo José Ottolina Pinto" .

<http://example.org/entity/Valencia> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Valencia, Carabobo" .

