@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:El_Show_de_Renny a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPresenter entity:Renny_Ottolina .

entity:Renny_Ottolina a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Valencia .

entity:Valencia a ex:Place .

