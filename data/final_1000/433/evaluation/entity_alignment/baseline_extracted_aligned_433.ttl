@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Bare_Wires> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Bare Wires" ;
    onto:hasPublicationDate "1968"^^xsd:gYear .

<http://example.org/entity/Dead_Vent_7> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Dead Vent 7" ;
    onto:hasPublicationDate "1995"^^xsd:gYear .

