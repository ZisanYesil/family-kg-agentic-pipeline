@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:song_fast_car a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Fast Car" ;
    onto:hasPerformer data:person_namie_amuro ;
    skos:altLabel "Fast Car (Namie Amuro song)" .

data:person_namie_amuro a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Namie Amuro" ;
    onto:hasBirthPlace data:place_naha_okinawa_japan ;
    skos:altLabel "Amuro" .

data:place_naha_okinawa_japan a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Naha, Okinawa, Japan" .

