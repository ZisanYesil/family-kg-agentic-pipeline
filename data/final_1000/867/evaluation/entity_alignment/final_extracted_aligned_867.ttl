@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Fast_Car> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Namie_Amuro> ;
    ex:hasPerformer <http://example.org/entity/Namie_Amuro> .

<http://example.org/entity/Naha_Okinawa> a ex:Place .

<http://example.org/entity/Namie_Amuro> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Naha_Okinawa> .

