@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Can_t_Remember_to_Forget_You> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Can't Remember To Forget You" ;
    onto:hasPublicationDate "2014-01-13"^^xsd:date .

<http://example.org/entity/Distant_Lover> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Distant Lover" ;
    onto:hasPublicationDate "1973"^^xsd:gYear .

