@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Douro_Wine_Company a ex:Agent,
        ex:Organization ;
    ex:hasFounder entity:Sebastião_José_de_Carvalho_e_Melo .

entity:Lisbon a ex:Place .

entity:Sebastião_José_de_Carvalho_e_Melo a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Lisbon .

