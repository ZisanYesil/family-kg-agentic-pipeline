@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/douro_wine_company> a ex:Agent,
        ex:Organization ;
    ex:hasFounder <http://example.org/extracted/sebastiao_melo> .

<http://example.org/extracted/sebastiao_melo> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1699-05-13"^^xsd:date ;
    ex:hasDeathDate "1782-05-08"^^xsd:date .

