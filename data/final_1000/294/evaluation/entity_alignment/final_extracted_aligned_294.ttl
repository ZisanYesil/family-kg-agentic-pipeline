@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Douro_Wine_Company> a ex:Agent,
        ex:Organization ;
    ex:hasFounder <http://example.org/entity/Sebastião_José_de_Carvalho_e_Melo> .

<http://example.org/entity/Sebastião_José_de_Carvalho_e_Melo> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1699-05-13"^^xsd:date ;
    ex:hasDeathDate "1782-05-08"^^xsd:date .

