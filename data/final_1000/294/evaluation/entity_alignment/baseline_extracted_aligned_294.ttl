@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Douro_Wine_Company> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Douro Wine Company" ;
    onto:hasFounder <http://example.org/entity/Sebastião_José_de_Carvalho_e_Melo> .

<http://example.org/entity/Sebastião_José_de_Carvalho_e_Melo> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sebastião José de Carvalho e Melo" ;
    onto:hasBirthDate "1699-05-13"^^xsd:date ;
    onto:hasDeathDate "1782-05-08"^^xsd:date ;
    skos:altLabel "Marquis of Pombal" .

