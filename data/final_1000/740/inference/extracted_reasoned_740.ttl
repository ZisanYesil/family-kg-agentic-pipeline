@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/million_dollar_mile> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPresenter <http://example.org/extracted/tim_tebow> .

<http://example.org/extracted/heisman_trophy> a ex:Award .

<http://example.org/extracted/tim_tebow> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/extracted/heisman_trophy> ;
    ex:hasBirthDate "1987-08-14"^^xsd:date .

