@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Million_Dollar_Mile> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPresenter <http://example.org/entity/Tim_Tebow> .

<http://example.org/entity/Heisman_Trophy> a ex:Award .

<http://example.org/entity/Tim_Tebow> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/entity/Heisman_Trophy> ;
    ex:hasBirthDate "1987-08-14"^^xsd:date .

