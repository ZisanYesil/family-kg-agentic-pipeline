@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Million_Dollar_Mile a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPresenter entity:Tim_Tebow .

entity:Heisman_Trophy a ex:Award .

entity:Tim_Tebow a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived entity:Heisman_Trophy .

