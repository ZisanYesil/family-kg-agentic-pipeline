@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Million_Dollar_Mile> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Million Dollar Mile" ;
    onto:hasPresenter <http://example.org/entity/Tim_Tebow> ;
    skos:altLabel "Million Dollar Mile" .

<http://example.org/entity/Heisman_Trophy> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Heisman Trophy" ;
    skos:altLabel "Heisman Trophy" .

<http://example.org/entity/Tim_Tebow> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tim Tebow" ;
    onto:hasAwardReceived <http://example.org/entity/Heisman_Trophy> ;
    onto:hasBirthDate "1987-08-14"^^xsd:date ;
    skos:altLabel "Tim Tebow" .

