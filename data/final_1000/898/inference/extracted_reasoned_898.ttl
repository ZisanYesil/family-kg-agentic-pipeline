@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/cuando_cielo_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/carlos_borcosque> ;
    ex:hasDirector <http://example.org/extracted/carlos_borcosque> .

<http://example.org/extracted/legend_fall_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/edward_zwick> ;
    ex:hasDirector <http://example.org/extracted/edward_zwick> .

<http://example.org/extracted/carlos_borcosque> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1894-09-09"^^xsd:date .

<http://example.org/extracted/edward_zwick> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1952-10-08"^^xsd:date .

