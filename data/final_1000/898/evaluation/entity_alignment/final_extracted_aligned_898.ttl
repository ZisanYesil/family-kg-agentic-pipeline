@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Cuando_en_el_cielo_pasen_lista> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Carlos_F_Borcosque> ;
    ex:hasDirector <http://example.org/entity/Carlos_F_Borcosque> .

<http://example.org/entity/Legends_of_the_Fall> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Edward_Zwick> ;
    ex:hasDirector <http://example.org/entity/Edward_Zwick> .

<http://example.org/entity/Carlos_F_Borcosque> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1894-09-09"^^xsd:date .

<http://example.org/entity/Edward_Zwick> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1952-10-08"^^xsd:date .

