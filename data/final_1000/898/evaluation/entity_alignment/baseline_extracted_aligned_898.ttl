@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Cuando_en_el_cielo_pasen_lista> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Cuando en el cielo pasen lista" ;
    onto:hasDirector <http://example.org/entity/Carlos_F_Borcosque> .

<http://example.org/entity/Legends_of_the_Fall> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Legends of the Fall" ;
    onto:hasDirector <http://example.org/entity/Edward_Zwick> .

<http://example.org/entity/Carlos_F_Borcosque> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Carlos F. Borcosque" ;
    onto:hasBirthDate "1894-09-09"^^xsd:date .

<http://example.org/entity/Edward_Zwick> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Edward Zwick" ;
    onto:hasBirthDate "1952-10-08"^^xsd:date .

