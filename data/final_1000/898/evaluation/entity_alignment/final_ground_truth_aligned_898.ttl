entity:Cuando_en_el_cielo_pasen_lista a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Carlos_F_Borcosque ;
    ex:hasDirector entity:Carlos_F_Borcosque .

