@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Aristotle a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Stagira ;
    ex:hasSpouse entity:Pythias .

entity:Pythias a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Aristotle .

entity:Stagira a ex:Place .

