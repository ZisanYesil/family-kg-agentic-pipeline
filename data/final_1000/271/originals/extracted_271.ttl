@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:pythias a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Pythias" ;
    onto:hasSpouse data:aristotle ;
    skos:altLabel "Pythias the Elder" .

data:aristotle a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Aristotle" ;
    onto:hasBirthPlace data:stagira .

data:stagira a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Stagira" .

