@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Aristotle> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Stagira> ;
    ex:hasSpouse <http://example.org/entity/Pythias> .

<http://example.org/entity/Pythias> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Aristotle> .

<http://example.org/entity/Stagira> a ex:Place .

