@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Pythias> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Pythias" ;
    onto:hasSpouse <http://example.org/entity/Aristotle> ;
    skos:altLabel "Pythias the Elder" .

<http://example.org/entity/Aristotle> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Aristotle" ;
    onto:hasBirthPlace <http://example.org/entity/Stagira> .

<http://example.org/entity/Stagira> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Stagira" .

