@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_workers_settlement a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Workers' Settlement" ;
    onto:hasDirector data:person_vladimir_vengerov .

data:award_peoples_artist_rsfsr a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "People's Artist of the RSFSR" .

data:person_vladimir_vengerov a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Vladimir Vengerov" ;
    onto:hasAwardReceived data:award_peoples_artist_rsfsr ;
    skos:altLabel "Vladimir Yakovlevich Vengerov" .

