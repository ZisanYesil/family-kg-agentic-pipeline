@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Gallopin_Gals> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Gallopin' Gals" ;
    onto:hasDirector <http://example.org/entity/Joseph_Barbera> .

<http://example.org/entity/Joseph_Barbera> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Joseph Barbera" ;
    onto:hasEmployer data:organization_metro_golden_mayer ;
    skos:altLabel "Joseph Roland Barbera" .

data:organization_metro_golden_mayer a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Metro‑Goldwyn‑Mayer" ;
    skos:altLabel "MGM" .

