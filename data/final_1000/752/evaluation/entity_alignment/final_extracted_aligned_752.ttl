@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Gallopin_Gals> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Joseph_Barbera> ;
    ex:hasDirector <http://example.org/entity/Joseph_Barbera> .

<http://example.org/extracted/organization_metro_golden_mayer> a ex:Agent,
        ex:Organization .

<http://example.org/entity/Joseph_Barbera> a ex:Agent,
        ex:Person ;
    ex:hasEmployer <http://example.org/extracted/organization_metro_golden_mayer> .

