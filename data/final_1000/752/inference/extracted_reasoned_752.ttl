@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/film_gallopin_gals> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_joseph_barbera> ;
