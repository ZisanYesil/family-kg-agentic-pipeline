@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/The_Rip_Off_Review_of_Western_Culture> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher <http://example.org/entity/Rip_Off_Press> .

<http://example.org/entity/Rip_Off_Press> a ex:Agent,
        ex:Organization ;
