@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/The_Rip_Off_Review_of_Western_Culture> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "The Rip Off Review of Western Culture" ;
    onto:hasPublisher <http://example.org/entity/Rip_Off_Press> .

<http://example.org/entity/Rip_Off_Press> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Rip Off Press" ;
    onto:hasInception "1969"^^xsd:gYear .

