@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:The_Rip_Off_Review_of_Western_Culture a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher entity:Rip_Off_Press .

entity:Rip_Off_Press a ex:Agent,
        ex:Organization ;
    ex:hasInception "1969"^^xsd:gYear .

