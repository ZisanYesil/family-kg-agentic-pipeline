        ex:Person ;
    ex:hasBurialPlace <http://example.org/entity/Basilica_of_Saint_Servatius> ;
    ex:hasChild <http://example.org/entity/Louis_of_Lower_Lorraine> ;
    ex:hasSon <http://example.org/entity/Louis_of_Lower_Lorraine> .

