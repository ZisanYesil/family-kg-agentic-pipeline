@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Extraordinary_Women> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Extraordinary Women" ;
    onto:hasPublicationDate "2009"^^xsd:gYear .

<http://example.org/entity/The_Law_in_These_Parts> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Law in These Parts" ;
    onto:hasPublicationDate "2011"^^xsd:gYear .

