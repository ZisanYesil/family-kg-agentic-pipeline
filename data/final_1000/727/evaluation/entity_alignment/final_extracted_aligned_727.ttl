@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Chantilly_Lace> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Linda_Yellen> ;
    ex:hasDirector <http://example.org/entity/Linda_Yellen> .

<http://example.org/entity/Emmys> a ex:Award .

<http://example.org/extracted/christopher_award> a ex:Award .

<http://example.org/extracted/peabody_award> a ex:Award .

<http://example.org/extracted/primetime_emmy_award> a ex:Award .

<http://example.org/extracted/silver_nymph_award> a ex:Award .

<http://example.org/entity/Linda_Yellen> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/entity/Emmys>,
        <http://example.org/extracted/christopher_award>,
        <http://example.org/extracted/peabody_award>,
        <http://example.org/extracted/primetime_emmy_award>,
        <http://example.org/extracted/silver_nymph_award> .

