@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Amos_Tuck> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Amos Tuck" ;
    onto:hasBirthDate "1810-08-02"^^xsd:date ;
    onto:hasDeathDate "1879-12-11"^^xsd:date .

<http://example.org/entity/Hans_Döbrich> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hans Döbrich" ;
    onto:hasBirthDate "1916-03-24"^^xsd:date ;
    onto:hasDeathDate "1984-04-06"^^xsd:date .

