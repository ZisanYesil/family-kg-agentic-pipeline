@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Karin_Stoltenberg> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Thorvald_Stoltenberg> .

<http://example.org/entity/Oslo> a ex:Place .

<http://example.org/entity/Thorvald_Stoltenberg> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Oslo> ;
    ex:hasSpouse <http://example.org/entity/Karin_Stoltenberg> .

