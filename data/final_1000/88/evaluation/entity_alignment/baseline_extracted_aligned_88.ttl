@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Karin_Stoltenberg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Karin Stoltenberg" ;
    onto:hasSpouse <http://example.org/entity/Thorvald_Stoltenberg> ;
    skos:altLabel "Karin Stoltenberg" .

<http://example.org/entity/Oslo> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Oslo" ;
    skos:altLabel "Oslo" .

<http://example.org/entity/Thorvald_Stoltenberg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Thorvald Stoltenberg" ;
    onto:hasBirthPlace <http://example.org/entity/Oslo> ;
    skos:altLabel "Thorvald Stoltenberg" .

