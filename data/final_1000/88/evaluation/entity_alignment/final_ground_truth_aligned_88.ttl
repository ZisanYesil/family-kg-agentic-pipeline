@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Karin_Stoltenberg a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Thorvald_Stoltenberg .

entity:Oslo a ex:Place .

entity:Thorvald_Stoltenberg a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Oslo ;
    ex:hasSpouse entity:Karin_Stoltenberg .

