@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:karin_stoltenberg a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Karin Stoltenberg" ;
    onto:hasSpouse data:thorvald_stoltenberg ;
    skos:altLabel "Karin Stoltenberg" .

data:oslo a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Oslo" ;
    skos:altLabel "Oslo" .

data:thorvald_stoltenberg a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Thorvald Stoltenberg" ;
    onto:hasBirthPlace data:oslo ;
    skos:altLabel "Thorvald Stoltenberg" .

