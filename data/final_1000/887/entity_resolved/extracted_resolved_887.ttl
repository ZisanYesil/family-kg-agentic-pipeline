@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:film_1950 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "No Sin on the Alpine Pastures (1950 film)" ;
    onto:hasDirector data:person_franz_antel .

data:person_franz_antel a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Franz Antel" .

