@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:No_Sin_on_the_Alpine_Pastures a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Franz_Antel ;
    ex:hasDirector entity:Franz_Antel .

entity:Vienna a ex:Place .

entity:Franz_Antel a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace entity:Vienna .

