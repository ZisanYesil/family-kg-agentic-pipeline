@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/No_Sin_on_the_Alpine_Pastures> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "No Sin on the Alpine Pastures (1950 film)" ;
    onto:hasDirector <http://example.org/entity/Franz_Antel> .

<http://example.org/entity/Franz_Antel> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Franz Antel" .

