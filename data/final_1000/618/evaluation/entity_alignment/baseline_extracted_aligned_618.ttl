@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Station_West> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Station West" ;
    onto:hasDirector <http://example.org/entity/Sidney_Lanfield> .

<http://example.org/entity/Sidney_Lanfield> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sidney Lanfield" ;
    onto:hasBurialPlace <http://example.org/entity/Westwood_Village_Memorial_Park_Cemetery> ;
    skos:altLabel "Sidney Landfield" .

<http://example.org/entity/Westwood_Village_Memorial_Park_Cemetery> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Westwood Village Memorial Park Cemetery" .

