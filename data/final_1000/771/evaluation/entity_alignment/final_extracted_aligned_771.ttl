@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Billy_Elliot> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasComposer <http://example.org/entity/Stephen_Warbeck> ;
    ex:hasCreator <http://example.org/entity/Stephen_Warbeck> .

<http://example.org/entity/Southampton_Hampshire> a ex:Place .

<http://example.org/entity/Stephen_Warbeck> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Southampton_Hampshire> .

