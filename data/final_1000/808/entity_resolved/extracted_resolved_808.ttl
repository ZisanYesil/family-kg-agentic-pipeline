@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:colonel_abrams_album a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Colonel Abrams" ;
    onto:hasPublicationDate "1985"^^xsd:gYear ;
    skos:altLabel "Colonel Abrams" .

data:eto_basc_hocu_album a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Eto! Baš hoću!" ;
    onto:hasPublicationDate "1976"^^xsd:gYear ;
    skos:altLabel "Eto! Baš hoću!" .

