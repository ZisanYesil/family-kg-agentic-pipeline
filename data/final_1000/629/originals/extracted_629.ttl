@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:sancha_of_castile a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sancha of Castile" ;
    onto:hasFather data:alfonso_vii_leon_castile .

data:alfonso_vii_leon_castile a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alfonso VII of León and Castile" ;
    onto:hasMother data:urraca_of_leon .

data:urraca_of_leon a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Urraca of León" .

