@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Sancha_of_Castile_Queen_of_Navarre> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sancha of Castile" ;
    onto:hasFather <http://example.org/entity/Alfonso_VII_of_León_and_Castile> .

<http://example.org/entity/Alfonso_VII_of_León_and_Castile> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alfonso VII of León and Castile" ;
    onto:hasMother <http://example.org/entity/Urraca_of_León> .

<http://example.org/entity/Urraca_of_León> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Urraca of León" .

