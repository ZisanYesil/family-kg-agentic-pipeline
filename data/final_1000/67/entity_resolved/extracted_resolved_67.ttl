@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:moscow_pride_06 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Moscow Pride '06" ;
    onto:hasPublicationDate "2006"^^xsd:gYear .

data:my_favourite_fabric a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "My Favourite Fabric" ;
    onto:hasPublicationDate "2018"^^xsd:gYear .

