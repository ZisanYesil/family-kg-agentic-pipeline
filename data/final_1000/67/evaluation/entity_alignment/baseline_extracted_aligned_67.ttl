@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Moscow_Pride_06> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Moscow Pride '06" ;
    onto:hasPublicationDate "2006"^^xsd:gYear .

<http://example.org/entity/My_Favourite_Fabric> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "My Favourite Fabric" ;
    onto:hasPublicationDate "2018"^^xsd:gYear .

