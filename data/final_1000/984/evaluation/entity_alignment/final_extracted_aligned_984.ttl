@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Fort_Bowie> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Howard_W_Koch> ;
    ex:hasDirector <http://example.org/entity/Howard_W_Koch> .

<http://example.org/entity/Howard_W_Koch> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1916-04-11"^^xsd:date .

