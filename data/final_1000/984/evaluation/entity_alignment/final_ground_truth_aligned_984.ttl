@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Fort_Bowie a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Howard_W_Koch ;
    ex:hasDirector entity:Howard_W_Koch .

entity:Howard_W_Koch a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1916-04-11"^^xsd:date .

