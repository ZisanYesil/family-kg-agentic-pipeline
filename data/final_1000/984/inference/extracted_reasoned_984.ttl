@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_fort_bowie> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_howard_koch> ;
    ex:hasDirector <http://example.org/extracted/person_howard_koch> .

<http://example.org/extracted/person_howard_koch> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1916-04-11"^^xsd:date .

