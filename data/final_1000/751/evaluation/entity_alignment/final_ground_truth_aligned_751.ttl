@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Splendor_in_the_Grass a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Elia_Kazan ;
    ex:hasDirector entity:Elia_Kazan .

entity:Constantinople a ex:Place .

entity:Elia_Kazan a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Constantinople .

