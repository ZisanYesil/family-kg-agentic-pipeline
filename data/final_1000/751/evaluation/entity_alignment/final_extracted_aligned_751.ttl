@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Splendor_in_the_Grass> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Elia_Kazan> ;
    ex:hasDirector <http://example.org/entity/Elia_Kazan> .

<http://example.org/entity/Constantinople> a ex:Place .

<http://example.org/entity/Elia_Kazan> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Constantinople> .

