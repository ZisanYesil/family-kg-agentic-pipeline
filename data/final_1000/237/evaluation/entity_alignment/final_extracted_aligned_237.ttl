@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Fred_Keays> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1898-07-12"^^xsd:date ;
    ex:hasDeathDate "1983-06-24"^^xsd:date .

<http://example.org/entity/William_H_Brand> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1824-04-20"^^xsd:date ;
    ex:hasDeathDate "1891"^^xsd:gYear .

