@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Fred_Keays> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Fred Keays" ;
    onto:hasBirthDate "1898-07-12"^^xsd:date ;
    onto:hasDeathDate "1983-06-24"^^xsd:date ;
    skos:altLabel "Frederick William Keays" .

<http://example.org/entity/William_H_Brand> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William H. Brand" ;
    onto:hasBirthDate "1824-04-20"^^xsd:date ;
    onto:hasDeathDate "1891"^^xsd:gYear .

