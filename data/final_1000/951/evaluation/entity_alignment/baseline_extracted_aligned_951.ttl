@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/James_FitzGerald_6th_Earl_of_Desmond> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "James FitzGerald, 6th Earl of Desmond" ;
    onto:hasFather <http://example.org/entity/Gerald_FitzGerald_3rd_Earl_of_Desmond> .

<http://example.org/entity/Gerald_FitzGerald_3rd_Earl_of_Desmond> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gerald FitzGerald, 3rd Earl of Desmond" ;
    onto:hasBrother <http://example.org/entity/Maurice_FitzGerald_2nd_Earl_of_Desmond> .

<http://example.org/entity/Maurice_FitzGerald_2nd_Earl_of_Desmond> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Maurice FitzGerald, 2nd Earl of Desmond" .

