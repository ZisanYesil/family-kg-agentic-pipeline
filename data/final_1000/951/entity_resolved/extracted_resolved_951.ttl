@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:james_fitzgerald_6th_earl_desmond a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "James FitzGerald, 6th Earl of Desmond" ;
    onto:hasFather data:gerald_fitzgerald_3rd_earl_desmond .

data:gerald_fitzgerald_3rd_earl_desmond a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gerald FitzGerald, 3rd Earl of Desmond" ;
    onto:hasBrother data:maurice_fitzgerald_2nd_earl_desmond .

data:maurice_fitzgerald_2nd_earl_desmond a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Maurice FitzGerald, 2nd Earl of Desmond" .

