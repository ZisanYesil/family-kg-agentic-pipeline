@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/David_Fennario> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "David Fennario" ;
    onto:hasBirthDate "1947-04-26"^^xsd:date ;
    skos:altLabel "David William Fennario" .

<http://example.org/entity/Peter_Emanuel_Falck> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Peter Emanuel Falck" ;
    onto:hasBirthDate "1952-07-15"^^xsd:date ;
    skos:altLabel "John Peter Emanuel Falck" .

