@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:hayranidil_kadin a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hayranidil Kadın" ;
    onto:hasSpouse data:abdulaziz .

data:abdulaziz a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Abdülaziz" ;
    onto:hasBirthDate "1830-02-08"^^xsd:date ;
    onto:hasDeathDate "1876-06-04"^^xsd:date .

