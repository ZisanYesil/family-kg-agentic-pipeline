@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Abdülaziz> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1830-02-08"^^xsd:date ;
    ex:hasDeathDate "1876-06-04"^^xsd:date ;
    ex:hasSpouse <http://example.org/entity/Hayranidil_Kadın> .

<http://example.org/entity/Hayranidil_Kadın> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Abdülaziz> .

