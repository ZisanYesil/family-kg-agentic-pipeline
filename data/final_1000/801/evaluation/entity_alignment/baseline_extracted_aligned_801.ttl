@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Get_the_Girl> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Get The Girl" ;
    onto:hasDirector <http://example.org/entity/Eric_England> .

<http://example.org/entity/Eric_England> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Eric England" ;
    onto:hasBirthPlace <http://example.org/entity/Russellville> .

<http://example.org/entity/Russellville> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Russellville, Arkansas" .

