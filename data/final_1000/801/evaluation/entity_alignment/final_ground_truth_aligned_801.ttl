@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Get_the_Girl a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Eric_England ;
    ex:hasDirector entity:Eric_England .

entity:Russellville a ex:Place .

entity:Eric_England a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Russellville .

