@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Get_the_Girl> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Eric_England> ;
    ex:hasDirector <http://example.org/entity/Eric_England> .

<http://example.org/entity/Russellville> a ex:Place .

<http://example.org/entity/Eric_England> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Russellville> .

