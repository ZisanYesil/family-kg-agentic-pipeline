@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Jean_Armand_Charlemagne> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jean Armand Charlemagne" ;
    onto:hasBirthDate "1753-11-30"^^xsd:date ;
    onto:hasDeathDate "1838-03-06"^^xsd:date .

<http://example.org/entity/John_Ashburnham_2nd_Earl_of_Ashburnham> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Ashburnham, 2nd Earl of Ashburnham" ;
    onto:hasBirthDate "1724-10-30"^^xsd:date ;
    onto:hasDeathDate "1812-04-08"^^xsd:date .

