@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Dark_Is_the_Night a ex:Artifact,
        ex:CreativeWork ;
    ex:hasComposer entity:Nikita_Bogoslovsky ;
    ex:hasCreator entity:Nikita_Bogoslovsky .

entity:Petersburg a ex:Place .

entity:Nikita_Bogoslovsky a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Petersburg .

