@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Dark_Is_the_Night> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Dark Is The Night (Soviet song)" ;
    onto:hasComposer <http://example.org/entity/Nikita_Bogoslovsky> .

<http://example.org/entity/Nikita_Bogoslovsky> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nikita Bogoslovsky" ;
    onto:hasBirthPlace <http://example.org/entity/Petersburg> .

<http://example.org/entity/Petersburg> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Saint-Petersburg" .

