@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Dark_Is_the_Night> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasComposer <http://example.org/entity/Nikita_Bogoslovsky> ;
    ex:hasCreator <http://example.org/entity/Nikita_Bogoslovsky> .

<http://example.org/entity/Petersburg> a ex:Place .

<http://example.org/entity/Nikita_Bogoslovsky> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Petersburg> .

