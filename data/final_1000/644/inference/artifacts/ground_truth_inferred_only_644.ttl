@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Bonne_of_Bohemia a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Louis_I .

entity:Louis_I a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Bonne_of_Bohemia ;
    ex:hasSpouse entity:Marie_of_Blois_Duchess_of_Anjou .

entity:Marie_of_Blois_Duchess_of_Anjou a ex:Agent,
        ex:Person .

