@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Marie_of_Blois_Duchess_of_Anjou> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Marie of Blois" ;
    onto:hasSpouse <http://example.org/entity/Louis_I> .

<http://example.org/entity/Bonne_of_Bohemia> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bonne of Bohemia" .

<http://example.org/entity/Louis_I> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Louis I of Anjou" ;
    onto:hasMother <http://example.org/entity/Bonne_of_Bohemia> .

