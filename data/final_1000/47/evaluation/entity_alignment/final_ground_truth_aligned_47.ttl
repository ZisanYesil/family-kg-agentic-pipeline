@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Pre a ex:Agent,
        ex:Organization ;
    ex:hasMember entity:Akiko_Matsuura .

entity:Akiko_Matsuura a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:Japan ;
    ex:hasCountry entity:Japan .

entity:Japan a ex:Country,
        ex:Place .

