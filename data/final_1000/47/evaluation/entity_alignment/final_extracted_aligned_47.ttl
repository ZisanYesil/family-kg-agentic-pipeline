@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Pre> a ex:Agent,
        ex:Organization ;
    ex:hasMember <http://example.org/entity/Akiko_Matsuura> .

<http://example.org/entity/Akiko_Matsuura> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/extracted/osaka> .

<http://example.org/entity/Japan> a ex:Country,
        ex:Place .

<http://example.org/extracted/osaka> a ex:Place ;
    ex:hasCountry <http://example.org/entity/Japan> .

