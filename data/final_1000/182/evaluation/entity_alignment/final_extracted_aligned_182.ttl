@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/A_Heart_in_Winter> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Claude_Sautet> ;
    ex:hasDirector <http://example.org/entity/Claude_Sautet> .

<http://example.org/entity/Single_White_Female> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Barbet_Schroeder> ;
    ex:hasDirector <http://example.org/entity/Barbet_Schroeder> .

<http://example.org/entity/Barbet_Schroeder> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Swiss> ;
    ex:hasNationality <http://example.org/entity/Swiss> .

<http://example.org/entity/Claude_Sautet> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/French> ;
    ex:hasNationality <http://example.org/entity/French> .

<http://example.org/entity/French> a ex:Country,
        ex:Place .

<http://example.org/entity/Swiss> a ex:Country,
        ex:Place .

