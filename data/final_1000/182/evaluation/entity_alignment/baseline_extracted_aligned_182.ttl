@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/A_Heart_in_Winter> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Heart In Winter" ;
    onto:hasDirector <http://example.org/entity/Claude_Sautet> .

<http://example.org/entity/Single_White_Female> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Single White Female" ;
    onto:hasDirector <http://example.org/entity/Barbet_Schroeder> .

<http://example.org/entity/Barbet_Schroeder> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Barbet Schroeder" ;
    onto:hasNationality <http://example.org/entity/Swiss> .

<http://example.org/entity/Claude_Sautet> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Claude Sautet" ;
    onto:hasNationality <http://example.org/entity/French> .

<http://example.org/entity/French> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

<http://example.org/entity/Swiss> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Switzerland" ;
    skos:altLabel "Swiss" .

