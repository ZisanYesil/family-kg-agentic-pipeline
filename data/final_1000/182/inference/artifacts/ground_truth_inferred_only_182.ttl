@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:A_Heart_in_Winter a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Claude_Sautet .

entity:Single_White_Female a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Barbet_Schroeder .

entity:Barbet_Schroeder a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:French,
        entity:Swiss .

entity:Claude_Sautet a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:French .

entity:Swiss a ex:Country,
        ex:Place .

entity:French a ex:Country,
        ex:Place .

