@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:film_the_return_of_swamp_thing a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Return of Swamp Thing" ;
    onto:hasDirector data:person_jim_wynorski .

data:person_jim_wynorski a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jim Wynorski" ;
    onto:hasBirthPlace data:place_glen_cove_long_island_new_york .

data:place_glen_cove_long_island_new_york a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Glen Cove, Long Island, New York" .

