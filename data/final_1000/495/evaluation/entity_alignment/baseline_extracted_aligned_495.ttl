@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Günther_Weißenborn> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Günther Weißenborn" ;
    onto:hasBirthDate "1911-06-02"^^xsd:date ;
    onto:hasDeathDate "2001-02-25"^^xsd:date .

<http://example.org/entity/Pierluigi_Samaritani> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Pierluigi Samaritani" ;
    onto:hasBirthDate "1942-09-29"^^xsd:date ;
    onto:hasDeathDate "1994-01-05"^^xsd:date ;
    skos:altLabel "PierLuigi Samaritani" .

