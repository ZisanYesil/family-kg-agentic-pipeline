@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Argentus a ex:Artifact,
        ex:CreativeWork ;
    ex:hasEditor entity:Steven_H_Silver .

entity:Hinsdale a ex:Place .

