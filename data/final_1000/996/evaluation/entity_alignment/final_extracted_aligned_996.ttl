@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/There_s_No_Tomorrow> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Max_Ophüls> ;
    ex:hasDirector <http://example.org/entity/Max_Ophüls> .

<http://example.org/extracted/country_germany> a ex:Country,
        ex:Place .

<http://example.org/entity/Max_Ophüls> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/extracted/country_germany> .

