@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Saarbrücken a ex:Place .

entity:There_s_No_Tomorrow a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
