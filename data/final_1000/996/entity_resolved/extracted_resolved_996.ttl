@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_theres_no_tomorrow a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "There's No Tomorrow" ;
    onto:hasDirector data:person_max_ophuls .

data:country_germany a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Germany" ;
    skos:altLabel "German" .

data:person_max_ophuls a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Max Ophüls" ;
    onto:hasBirthPlace data:country_germany ;
    skos:altLabel "Maximillian Oppenheimer" .

