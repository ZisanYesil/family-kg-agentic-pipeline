@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_housefull2> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/extracted/person_sajid_nadiadwala> .

<http://example.org/extracted/film_term_life> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/extracted/person_vince_vaughn> .

<http://example.org/extracted/person_sajid_nadiadwala> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1966-02-18"^^xsd:date .

<http://example.org/extracted/person_vince_vaughn> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1970-03-28"^^xsd:date .

