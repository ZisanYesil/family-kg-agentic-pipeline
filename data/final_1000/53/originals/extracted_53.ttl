@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_housefull2 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Housefull 2" ;
    onto:hasProducer data:person_sajid_nadiadwala .

data:film_term_life a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Term Life" ;
    onto:hasProducer data:person_vince_vaughn .

data:person_sajid_nadiadwala a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sajid Nadiadwala" ;
    onto:hasBirthDate "1966-02-18"^^xsd:date .

data:person_vince_vaughn a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Vince Vaughn" ;
    onto:hasBirthDate "1970-03-28"^^xsd:date ;
    skos:altLabel "Vincent Anthony Vaughn" .

