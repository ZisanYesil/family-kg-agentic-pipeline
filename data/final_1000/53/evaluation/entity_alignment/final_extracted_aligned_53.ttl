@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Housefull_2> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/Sajid_Nadiadwala> .

<http://example.org/entity/Term_Life> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/Vince_Vaughn> .

<http://example.org/entity/Sajid_Nadiadwala> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1966-02-18"^^xsd:date .

<http://example.org/entity/Vince_Vaughn> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1970-03-28"^^xsd:date .

