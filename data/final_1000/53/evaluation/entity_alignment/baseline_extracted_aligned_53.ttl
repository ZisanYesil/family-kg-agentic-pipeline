@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Housefull_2> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Housefull 2" ;
    onto:hasProducer <http://example.org/entity/Sajid_Nadiadwala> .

<http://example.org/entity/Term_Life> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Term Life" ;
    onto:hasProducer <http://example.org/entity/Vince_Vaughn> .

<http://example.org/entity/Sajid_Nadiadwala> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sajid Nadiadwala" ;
    onto:hasBirthDate "1966-02-18"^^xsd:date .

<http://example.org/entity/Vince_Vaughn> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Vince Vaughn" ;
    onto:hasBirthDate "1970-03-28"^^xsd:date ;
    skos:altLabel "Vincent Anthony Vaughn" .

