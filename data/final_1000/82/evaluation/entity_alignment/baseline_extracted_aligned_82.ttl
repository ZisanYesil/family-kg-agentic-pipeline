@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/A_M_Julien> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "A.-M. Julien" ;
    onto:hasBirthDate "1903-07-24"^^xsd:date ;
    onto:hasDeathDate "2001-01-15"^^xsd:date ;
    skos:altLabel "A.- M. Julien",
        "A.-M. Julien",
        "Aman- Julien Maistre" .

<http://example.org/entity/Ernst_zu_Münster> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ernst zu Münster" ;
    onto:hasBirthDate "1766-03-01"^^xsd:date ;
    onto:hasDeathDate "1839-05-20"^^xsd:date ;
    skos:altLabel "Ernst zu Münster",
        "Graf Ernst Friedrich Herbert zu Münster" .

