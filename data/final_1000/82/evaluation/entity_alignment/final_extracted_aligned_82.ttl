@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/A_M_Julien> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1903-07-24"^^xsd:date ;
    ex:hasDeathDate "2001-01-15"^^xsd:date .

<http://example.org/entity/Ernst_zu_Münster> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1766-03-01"^^xsd:date ;
    ex:hasDeathDate "1839-05-20"^^xsd:date .

