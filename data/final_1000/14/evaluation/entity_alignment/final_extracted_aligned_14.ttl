@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Old_Man_Drinking_a_Glass_of_Beer> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/George_Albert_Smith> ;
    ex:hasDirector <http://example.org/entity/George_Albert_Smith> .

<http://example.org/entity/George_Albert_Smith> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1864-01-04"^^xsd:date ;
    ex:hasDeathDate "1959-05-17"^^xsd:date .

