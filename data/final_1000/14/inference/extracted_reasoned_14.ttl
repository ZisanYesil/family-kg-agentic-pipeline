@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_old_man_drinking_a_glass_of_beer> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_george_albert_smith> ;
    ex:hasDirector <http://example.org/extracted/person_george_albert_smith> .

<http://example.org/extracted/person_george_albert_smith> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1864-01-04"^^xsd:date ;
    ex:hasDeathDate "1959-05-17"^^xsd:date .

