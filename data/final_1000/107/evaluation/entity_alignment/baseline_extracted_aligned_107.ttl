@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Fast_Five> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Fast Five" ;
    onto:hasPublicationDate "2011-04-20"^^xsd:date .

<http://example.org/entity/The_Testament_of_Dr_Mabuse> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Testament Of Dr. Mabuse" ;
    onto:hasPublicationDate "1933"^^xsd:gYear .

