@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Pier_Celestino_Gilardi> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Pier Celestino Gilardi" ;
    onto:hasBirthDate "1837-09-16"^^xsd:date ;
    skos:altLabel "Pier Celestino Gilardi" .

<http://example.org/entity/Robert_Heetmøller> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Robert Heetmøller" ;
    onto:hasBirthDate "1950-06-28"^^xsd:date ;
    skos:altLabel "Robert Heetmøller" .

