@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:adelaide_of_lippe_biesterfeld a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Countess Adelaide of Lippe-Biesterfeld" ;
    onto:hasMother data:karoline_of_wartensleben .

data:karoline_of_wartensleben a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Countess Karoline Friederike Cäcilie Klothilde von Wartensleben" ;
    onto:hasBirthPlace data:mannheim .

data:mannheim a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Mannheim" .

