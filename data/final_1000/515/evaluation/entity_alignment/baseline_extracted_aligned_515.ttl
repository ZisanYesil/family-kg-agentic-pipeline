@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Countess_Adelaide_of_Lippe_Biesterfeld> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Countess Adelaide of Lippe-Biesterfeld" ;
    onto:hasMother <http://example.org/entity/Karoline_of_Wartensleben> .

<http://example.org/entity/Karoline_of_Wartensleben> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Countess Karoline Friederike Cäcilie Klothilde von Wartensleben" ;
    onto:hasBirthPlace <http://example.org/entity/Mannheim> .

<http://example.org/entity/Mannheim> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Mannheim" .

