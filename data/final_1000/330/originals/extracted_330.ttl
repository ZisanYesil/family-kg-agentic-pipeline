@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:pippin_of_heristal a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Pippin of Heristal" ;
    onto:hasFather data:drogo_of_champagne ;
    skos:altLabel "Pepin of Heristal" .

data:drogo_of_champagne a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Drogo of Champagne" .

