@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Pepin_of_Herstal a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Plectrude .

entity:Drogo_of_Champagne a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Plectrudis .

entity:Plectrude a ex:Agent,
        ex:Person .

entity:Plectrudis a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Drogo_of_Champagne .

