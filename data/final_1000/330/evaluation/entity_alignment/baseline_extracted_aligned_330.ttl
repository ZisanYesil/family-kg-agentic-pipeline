@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Pepin_of_Herstal> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Pippin of Heristal" ;
    onto:hasFather <http://example.org/entity/Drogo_of_Champagne> ;
    skos:altLabel "Pepin of Heristal" .

<http://example.org/entity/Drogo_of_Champagne> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Drogo of Champagne" .

