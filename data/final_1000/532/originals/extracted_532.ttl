@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:mahatma_life_of_gandhi_1968_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Mahatma: Life of Gandhi, 1869–1948" ;
    onto:hasDirector data:vithalbhai_jhaveri .

data:padma_bhushan a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Padma Bhushan" .

data:vithalbhai_jhaveri a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Vithalbhai Jhaveri" ;
    onto:hasAwardReceived data:padma_bhushan ;
    skos:altLabel "Vitthal Jhaveri" .

