@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Margaret_Lloyd_George> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Margaret Lloyd George" ;
    onto:hasSpouse <http://example.org/entity/David_Lloyd_George> ;
    skos:altLabel "Dame Margaret Lloyd George" .

<http://example.org/entity/David_Lloyd_George> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "David Lloyd George" ;
    onto:hasBirthPlace <http://example.org/entity/Manchester> .

<http://example.org/entity/Manchester> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Manchester" .

