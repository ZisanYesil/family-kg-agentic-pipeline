@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Stefan_the_First_Crowned> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Stefan the First-Crowned" ;
    onto:hasFather <http://example.org/entity/Stefan_Vladislav> ;
    onto:hasNationality data:serbia ;
    skos:altLabel "Stefan Nemanjić" .

<http://example.org/entity/Stefan_Vladislav> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Stefan Vladislav" .

data:serbia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Serbia" .

