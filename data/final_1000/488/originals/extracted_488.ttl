@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:stefan_firstcrowned a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Stefan the First-Crowned" ;
    onto:hasFather data:stefan_vladislav ;
    onto:hasNationality data:serbia ;
    skos:altLabel "Stefan Nemanjić" .

data:serbia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Serbia" .

data:stefan_vladislav a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Stefan Vladislav" .

