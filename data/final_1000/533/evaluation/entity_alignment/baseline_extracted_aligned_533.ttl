@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Janine_Krieber> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Janine Krieber" ;
    onto:hasSpouse <http://example.org/entity/Stéphane_Dion> .

data:germany a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Germany" .

<http://example.org/entity/Stéphane_Dion> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Stéphane Dion" .

