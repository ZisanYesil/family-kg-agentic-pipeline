@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:We_Write_the_Story a ex:Artifact,
        ex:CreativeWork ;
    ex:hasComposer entity:Avicii ;
    ex:hasCreator entity:Avicii .

entity:Muscat a ex:Place .

entity:Avicii a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace entity:Muscat .

