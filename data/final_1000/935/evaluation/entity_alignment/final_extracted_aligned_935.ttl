@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/We_Write_the_Story> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasComposer <http://example.org/entity/Avicii> ;
    ex:hasCreator <http://example.org/entity/Avicii> .

<http://example.org/entity/Muscat> a ex:Place .

<http://example.org/entity/Avicii> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Muscat> .

