@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:philip_foster_farm a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Philip Foster Farm" ;
    onto:hasCountry data:united_states ;
    skos:altLabel "Philip Foster Farm" .

data:seattle_times_building a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Seattle Times Building" ;
    onto:hasCountry data:united_states ;
    skos:altLabel "Seattle Times Building" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "United States" .

