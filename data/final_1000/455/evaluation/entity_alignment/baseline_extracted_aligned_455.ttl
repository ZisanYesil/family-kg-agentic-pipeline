@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Philip_Foster_Farm> a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Philip Foster Farm" ;
    onto:hasCountry <http://example.org/entity/United_States> ;
    skos:altLabel "Philip Foster Farm" .

<http://example.org/entity/Seattle_Times_Building> a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Seattle Times Building" ;
    onto:hasCountry <http://example.org/entity/United_States> ;
    skos:altLabel "Seattle Times Building" .

<http://example.org/entity/United_States> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "United States" .

