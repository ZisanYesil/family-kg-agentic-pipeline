@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:especially_on_sunday_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Especially on Sunday" ;
    onto:hasPublicationDate "1991"^^xsd:gYear .

data:the_devils_tomb_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Devil's Tomb" ;
    onto:hasPublicationDate "2009-05-26"^^xsd:date .

