@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Especially_on_Sunday> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Especially on Sunday" ;
    onto:hasPublicationDate "1991"^^xsd:gYear .

<http://example.org/entity/The_Devil_s_Tomb> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Devil's Tomb" ;
    onto:hasPublicationDate "2009-05-26"^^xsd:date .

