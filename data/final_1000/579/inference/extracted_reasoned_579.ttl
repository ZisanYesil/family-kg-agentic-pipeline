@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/everything_i_like_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/martin_sulik_person> ;
    ex:hasDirector <http://example.org/extracted/martin_sulik_person> .

<http://example.org/extracted/academy_of_performing_arts_bratislava_educational_institution> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/extracted/martin_sulik_person> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/extracted/academy_of_performing_arts_bratislava_educational_institution> .

