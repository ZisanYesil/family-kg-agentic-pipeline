@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Everything_I_Like a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Martin_Šulík ;
    ex:hasDirector entity:Martin_Šulík .

entity:Academy_of_Performing_Arts_in_Bratislava a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Martin_Šulík a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt entity:Academy_of_Performing_Arts_in_Bratislava .

