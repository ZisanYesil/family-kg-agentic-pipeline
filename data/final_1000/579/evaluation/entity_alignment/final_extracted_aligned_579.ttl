@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Everything_I_Like> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Martin_Šulík> ;
    ex:hasDirector <http://example.org/entity/Martin_Šulík> .

<http://example.org/entity/Academy_of_Performing_Arts_in_Bratislava> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Martin_Šulík> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/Academy_of_Performing_Arts_in_Bratislava> .

