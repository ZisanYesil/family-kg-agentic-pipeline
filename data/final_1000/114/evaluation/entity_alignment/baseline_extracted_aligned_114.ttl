@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Henry_of_Berg_Lord_of_Windeck> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Henry of Berg, Lord of Windeck" ;
    onto:hasFather <http://example.org/entity/Adolf_VII_of_Berg> .

<http://example.org/entity/Adolf_VII_of_Berg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Adolf VII of Berg" ;
    onto:hasDeathPlace <http://example.org/entity/Neuss> .

<http://example.org/entity/Neuss> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Neuss" .

