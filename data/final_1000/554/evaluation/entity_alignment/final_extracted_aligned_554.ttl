@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Kraków> a ex:Place .

<http://example.org/entity/Władysław_I_Herman> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Casimir_I_the_Restorer> ;
    ex:hasParent <http://example.org/entity/Casimir_I_the_Restorer> .

<http://example.org/entity/Casimir_I_the_Restorer> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Kraków> ;
    ex:hasChild <http://example.org/entity/Władysław_I_Herman> .

