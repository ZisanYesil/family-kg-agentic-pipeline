@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/song_you_changed_me> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/extracted/person_jamie_foxx> ;
    ex:hasPerformer <http://example.org/extracted/person_jamie_foxx> .

<http://example.org/extracted/award_grammy> a ex:Award .

<http://example.org/extracted/person_jamie_foxx> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/extracted/award_grammy> .

