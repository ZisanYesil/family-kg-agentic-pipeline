@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:You_Changed_Me a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Jamie_Foxx ;
    ex:hasPerformer entity:Jamie_Foxx .

entity:Best_Actor a ex:Award .

entity:Jamie_Foxx a ex:Agent ;
    ex:hasAwardReceived entity:Best_Actor .

