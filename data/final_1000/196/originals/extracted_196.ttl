@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:song_you_changed_me a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "You Changed Me" ;
    onto:hasPerformer data:person_jamie_foxx .

data:award_grammy a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Grammy Award" .

data:person_jamie_foxx a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jamie Foxx" ;
    onto:hasAwardReceived data:award_grammy ;
    skos:altLabel "Eric Marlon Bishop" .

