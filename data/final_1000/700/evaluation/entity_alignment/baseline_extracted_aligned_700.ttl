@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Long_Legs_Long_Fingers> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Long Legs, Long Fingers" ;
    onto:hasDirector <http://example.org/entity/Alfred_Vohrer> ;
    skos:altLabel "Long Legs, Long Fingers" .

<http://example.org/entity/Premutos_The_Fallen_Angel> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Premutos: The Fallen Angel" ;
    onto:hasDirector <http://example.org/entity/Olaf_Ittenbach> ;
    skos:altLabel "Premutos: The Fallen Angel" .

<http://example.org/entity/Alfred_Vohrer> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alfred Vohrer" ;
    onto:hasNationality <http://example.org/entity/German> ;
    skos:altLabel "Alfred Vohrer" .

<http://example.org/entity/Olaf_Ittenbach> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Olaf Ittenbach" ;
    onto:hasNationality <http://example.org/entity/German> ;
    skos:altLabel "Olaf Ittenbach" .

<http://example.org/entity/German> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Germany" ;
    skos:altLabel "German",
        "Germany" .

