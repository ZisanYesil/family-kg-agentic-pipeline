@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Tsai_Cheng_fu> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tsai Cheng-Fu" ;
    onto:hasBirthDate "1929"^^xsd:gYear ;
    onto:hasDeathDate "2016-07-13"^^xsd:date .

<http://example.org/entity/William_H_Maynard> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William H. Maynard" ;
    onto:hasBirthDate "1786-11-23"^^xsd:date ;
    onto:hasDeathDate "1832-08-28"^^xsd:date .

