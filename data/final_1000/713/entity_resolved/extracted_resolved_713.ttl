@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:imagina_of_issenburg_limburg a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Imagina of Isenburg-Limburg" ;
    onto:hasSpouse data:adolf_of_germany .

data:adolf_of_germany a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Adolf of Germany" ;
    onto:hasDeathPlace data:gollheim .

data:gollheim a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Göllheim" .

