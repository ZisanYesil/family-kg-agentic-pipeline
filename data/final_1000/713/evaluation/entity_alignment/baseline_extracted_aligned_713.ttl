@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Imagina_of_Isenburg_Limburg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Imagina of Isenburg-Limburg" ;
    onto:hasSpouse <http://example.org/entity/Adolf_of_Germany> .

<http://example.org/entity/Adolf_of_Germany> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Adolf of Germany" ;
    onto:hasDeathPlace <http://example.org/entity/Göllheim> .

<http://example.org/entity/Göllheim> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Göllheim" .

