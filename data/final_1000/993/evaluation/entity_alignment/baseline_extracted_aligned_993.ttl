@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Dorte> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Dorte" ;
    onto:hasPublicationDate "1951"^^xsd:gYear .

<http://example.org/entity/Senorita_from_the_West> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Senorita from the West" ;
    onto:hasPublicationDate "1945"^^xsd:gYear .

