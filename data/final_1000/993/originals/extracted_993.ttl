@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:dorte_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Dorte" ;
    onto:hasPublicationDate "1951"^^xsd:gYear .

data:senorita_from_the_west_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Senorita from the West" ;
    onto:hasPublicationDate "1945"^^xsd:gYear .

