@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Ladislav_Stroupežnický> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1850-01-06"^^xsd:date ;
    ex:hasDeathDate "1892-08-11"^^xsd:date .

<http://example.org/entity/Peder_Mørk_Mønsted> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1859-12-10"^^xsd:date ;
    ex:hasDeathDate "1941-06-20"^^xsd:date .

