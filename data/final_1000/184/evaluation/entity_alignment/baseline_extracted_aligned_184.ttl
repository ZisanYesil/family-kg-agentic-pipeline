@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Ladislav_Stroupežnický> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ladislav Stroupežnický" ;
    onto:hasBirthDate "1850-01-06"^^xsd:date ;
    onto:hasDeathDate "1892-08-11"^^xsd:date .

<http://example.org/entity/Peder_Mørk_Mønsted> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Peder Mørk Mønsted" ;
    onto:hasBirthDate "1859-12-10"^^xsd:date ;
    onto:hasDeathDate "1941-06-20"^^xsd:date .

