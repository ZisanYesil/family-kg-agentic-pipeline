@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/The_Son_of_Amir_Is_Dead> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Son Of Amir Is Dead" ;
    onto:hasPublicationDate "1975"^^xsd:gYear .

<http://example.org/entity/Vishwavidhaata> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Vishwavidhaata" ;
    onto:hasPublicationDate "1997"^^xsd:gYear .

