@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_corridors_of_blood a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Corridors of Blood" ;
    onto:hasDirector data:director_robert_day .

data:film_min_marion a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Min Marion" ;
    onto:hasDirector data:director_nils_r_muller ;
    onto:hasPublicationDate "1975"^^xsd:gYear .

data:director_nils_r_muller a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nils R. Müller" ;
    onto:hasBirthDate "1921-01-17"^^xsd:date ;
    onto:hasDeathDate "2007-03-06"^^xsd:date .

data:director_robert_day a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Robert Day" ;
    onto:hasBirthDate "1922-09-11"^^xsd:date ;
    onto:hasDeathDate "2017-03-17"^^xsd:date ;
    skos:altLabel "Robert Frederick Day" .

