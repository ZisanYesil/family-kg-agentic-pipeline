@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Corridors_of_Blood a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Robert_Day ;
    ex:hasDirector entity:Robert_Day .

entity:Min_Marion a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Nils_R_Müller ;
    ex:hasDirector entity:Nils_R_Müller .

entity:Robert_Day_director a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1922-09-11"^^xsd:date .

entity:Nils_R_Müller a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1921-01-17"^^xsd:date .

entity:Robert_Day a ex:Agent,
        ex:Person .

