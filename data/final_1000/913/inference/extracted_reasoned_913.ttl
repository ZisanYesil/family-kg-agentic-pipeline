@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_corridors_of_blood> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/director_robert_day> ;
    ex:hasDirector <http://example.org/extracted/director_robert_day> .

<http://example.org/extracted/film_min_marion> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/director_nils_r_muller> ;
    ex:hasDirector <http://example.org/extracted/director_nils_r_muller> ;
    ex:hasPublicationDate "1975"^^xsd:gYear .

<http://example.org/extracted/director_nils_r_muller> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1921-01-17"^^xsd:date ;
    ex:hasDeathDate "2007-03-06"^^xsd:date .

<http://example.org/extracted/director_robert_day> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1922-09-11"^^xsd:date ;
    ex:hasDeathDate "2017-03-17"^^xsd:date .

