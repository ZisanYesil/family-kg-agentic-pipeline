@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Corridors_of_Blood> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Robert_Day> ;
    ex:hasDirector <http://example.org/entity/Robert_Day> .

<http://example.org/entity/Min_Marion> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Nils_R_Müller> ;
    ex:hasDirector <http://example.org/entity/Nils_R_Müller> ;
    ex:hasPublicationDate "1975"^^xsd:gYear .

<http://example.org/entity/Nils_R_Müller> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1921-01-17"^^xsd:date ;
    ex:hasDeathDate "2007-03-06"^^xsd:date .

<http://example.org/entity/Robert_Day> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1922-09-11"^^xsd:date ;
    ex:hasDeathDate "2017-03-17"^^xsd:date .

