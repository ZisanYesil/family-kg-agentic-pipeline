@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Corridors_of_Blood> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Corridors of Blood" ;
    onto:hasDirector <http://example.org/entity/Robert_Day> .

<http://example.org/entity/Min_Marion> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Min Marion" ;
    onto:hasDirector <http://example.org/entity/Nils_R_Müller> ;
    onto:hasPublicationDate "1975"^^xsd:gYear .

<http://example.org/entity/Nils_R_Müller> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nils R. Müller" ;
    onto:hasBirthDate "1921-01-17"^^xsd:date ;
    onto:hasDeathDate "2007-03-06"^^xsd:date .

<http://example.org/entity/Robert_Day> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Robert Day" ;
    onto:hasBirthDate "1922-09-11"^^xsd:date ;
    onto:hasDeathDate "2017-03-17"^^xsd:date ;
    skos:altLabel "Robert Frederick Day" .

