@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Rock_the_Kasbah_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Barry_Levinson> ;
    ex:hasDirector <http://example.org/entity/Barry_Levinson> .

<http://example.org/entity/The_Irish_in_America> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Sidney_Olcott> ;
    ex:hasDirector <http://example.org/entity/Sidney_Olcott> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/Barry_Levinson> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/Canadian> a ex:Country,
        ex:Place .

<http://example.org/entity/Sidney_Olcott> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Canadian> ;
    ex:hasNationality <http://example.org/entity/Canadian> .

