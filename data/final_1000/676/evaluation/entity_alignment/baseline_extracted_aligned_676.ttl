@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Rock_the_Kasbah_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Rock the Kasbah" ;
    onto:hasDirector <http://example.org/entity/Barry_Levinson> .

<http://example.org/entity/The_Irish_in_America> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Irish in America" ;
    onto:hasDirector <http://example.org/entity/Sidney_Olcott> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

<http://example.org/entity/Barry_Levinson> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Barry Levinson" ;
    onto:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/Canadian> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" ;
    skos:altLabel "Canadian" .

<http://example.org/entity/Sidney_Olcott> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sidney Olcott" ;
    onto:hasNationality <http://example.org/entity/Canadian> .

