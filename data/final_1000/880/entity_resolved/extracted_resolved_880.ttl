@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:adam_quick a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Adam Quick" ;
    onto:hasBirthDate "1981-09-01"^^xsd:date .

data:vicente_costa a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Vicente Costa" ;
    onto:hasBirthDate "1947-01-01"^^xsd:date .

