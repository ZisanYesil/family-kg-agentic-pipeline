@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Adam_Quick a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1981-09-01"^^xsd:date .

entity:Vicente_Costa a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1947-01-01"^^xsd:date .

