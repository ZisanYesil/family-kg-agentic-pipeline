@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Adam_Quick> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Adam Quick" ;
    onto:hasBirthDate "1981-09-01"^^xsd:date .

<http://example.org/entity/Vicente_Costa> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Vicente Costa" ;
    onto:hasBirthDate "1947-01-01"^^xsd:date .

