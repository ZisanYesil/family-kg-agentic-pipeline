@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Jean_Martin> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/William_Black> .

<http://example.org/entity/William_Black> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1983-03-07"^^xsd:date ;
    ex:hasSpouse <http://example.org/entity/Jean_Martin> .

