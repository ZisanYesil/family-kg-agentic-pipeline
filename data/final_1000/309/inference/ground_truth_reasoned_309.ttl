@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Charlemagne a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:Carolingian_Empire ;
    ex:hasCountry entity:Carolingian_Empire ;
    ex:hasSpouse entity:Luitgard .

entity:Luitgard a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Charlemagne .

entity:Carolingian_Empire a ex:Country,
        ex:Place .

