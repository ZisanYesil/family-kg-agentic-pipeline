@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Charlemagne> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/extracted/frankish_country> ;
    ex:hasSpouse <http://example.org/entity/Luitgard> .

<http://example.org/entity/Luitgard> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Charlemagne> .

<http://example.org/extracted/frankish_country> a ex:Country,
        ex:Place .

