@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:saint_ignatius_college_adelaide a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Saint Ignatius' College, Adelaide" ;
    onto:hasCountry data:australia .

data:st_josephs_college_gregory_terrace a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "St Joseph's College, Gregory Terrace" ;
    onto:hasCountry data:australia .

data:australia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Australia" .

