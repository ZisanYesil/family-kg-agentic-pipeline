@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Saint_Ignatius_College_Adelaide> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Saint Ignatius' College, Adelaide" ;
    onto:hasCountry <http://example.org/entity/Australia> .

<http://example.org/entity/St_Joseph_s_College_Gregory_Terrace> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "St Joseph's College, Gregory Terrace" ;
    onto:hasCountry <http://example.org/entity/Australia> .

<http://example.org/entity/Australia> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Australia" .

