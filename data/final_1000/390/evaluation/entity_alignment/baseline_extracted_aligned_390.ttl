@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/3_Avengers> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "3 Avengers" ;
    onto:hasCountryOfOrigin <http://example.org/entity/Italian> .

<http://example.org/entity/The_Redemption_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Redemption" ;
    onto:hasCountryOfOrigin <http://example.org/entity/Italian> .

<http://example.org/entity/Italian> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Italy" ;
    skos:altLabel "Italian" .

