@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Karimabad_Silvaneh> a ex:Place ;
    ex:hasCountry <http://example.org/entity/Iran> .

<http://example.org/entity/Shadikhan> a ex:Place ;
    ex:hasCountry <http://example.org/entity/Pakistan> .

<http://example.org/extracted/silvaneh_place> a ex:Place ;
    ex:hasCountry <http://example.org/entity/Iran> .

<http://example.org/entity/Pakistan> a ex:Country,
        ex:Place .

<http://example.org/entity/Iran> a ex:Country,
        ex:Place .

