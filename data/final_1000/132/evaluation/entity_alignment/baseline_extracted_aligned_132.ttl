@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Karimabad_Silvaneh> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Karimabad" ;
    onto:hasCountry <http://example.org/entity/Iran> ;
    skos:altLabel "Karimabad",
        "Karīmābād" .

<http://example.org/entity/Shadikhan> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Shadi Khan" ;
    onto:hasCountry <http://example.org/entity/Pakistan> ;
    skos:altLabel "Shadi Khan",
        "Shadikhan" .

data:silvaneh_place a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Silvaneh" ;
    onto:hasCountry <http://example.org/entity/Iran> ;
    skos:altLabel "Silvaneh" .

<http://example.org/entity/Pakistan> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Pakistan" ;
    skos:altLabel "Pakistan" .

<http://example.org/entity/Iran> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Iran" ;
    skos:altLabel "Iran" .

