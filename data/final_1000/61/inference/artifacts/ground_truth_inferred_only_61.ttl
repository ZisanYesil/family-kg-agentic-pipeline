@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Roman a ex:Place .

entity:Clodia_Pulchra a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Fulvia .

entity:Fulvia a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Clodia_Pulchra .

