@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Clodia_Pulchra> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Clodia Pulchra (wife of Octavian)" ;
    onto:hasMother <http://example.org/entity/Fulvia> .

<http://example.org/entity/Fulvia> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Fulvia" .

