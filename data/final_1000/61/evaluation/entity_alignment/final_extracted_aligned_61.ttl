@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Clodia_Pulchra> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Fulvia> ;
    ex:hasParent <http://example.org/entity/Fulvia> .

<http://example.org/entity/Fulvia> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Clodia_Pulchra> .

