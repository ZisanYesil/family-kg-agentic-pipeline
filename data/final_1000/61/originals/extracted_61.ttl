@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:clodia_pulchra a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Clodia Pulchra (wife of Octavian)" ;
    onto:hasMother data:fulvia .

data:fulvia a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Fulvia" .

