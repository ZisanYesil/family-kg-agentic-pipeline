@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Normande> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Gilles_Carle> ;
    ex:hasDirector <http://example.org/entity/Gilles_Carle> .

<http://example.org/entity/Parkinson_s_disease> a ex:CauseOfDeath .

<http://example.org/entity/Gilles_Carle> a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath <http://example.org/entity/Parkinson_s_disease> .

