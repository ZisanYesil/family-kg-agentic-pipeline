@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Prince_Christopher_of_Greece_and_Denmark> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Prince Christopher of Greece and Denmark" ;
    onto:hasFather <http://example.org/entity/George_I_of_Greece> .

<http://example.org/entity/George_I_of_Greece> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "King George I of Greece" ;
    onto:hasDeathPlace <http://example.org/entity/Thessaloniki> .

<http://example.org/entity/Thessaloniki> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Thessaloniki" .

