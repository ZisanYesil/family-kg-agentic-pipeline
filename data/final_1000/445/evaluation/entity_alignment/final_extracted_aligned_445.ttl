@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/There_Goes_My_Heart> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasComposer <http://example.org/entity/Marvin_Hatley> ;
    ex:hasCreator <http://example.org/entity/Marvin_Hatley> .

<http://example.org/entity/Hollywood_California> a ex:Place .

<http://example.org/entity/Marvin_Hatley> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Hollywood_California> .

