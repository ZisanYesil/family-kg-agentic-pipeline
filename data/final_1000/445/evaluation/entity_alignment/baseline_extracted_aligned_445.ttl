@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Marvin_Hatley> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Marvin Hatley" ;
    onto:hasDeathPlace <http://example.org/entity/Hollywood_California> .

<http://example.org/entity/There_Goes_My_Heart> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "There Goes My Heart" .

<http://example.org/entity/Hollywood_California> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Hollywood, California" .

