@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Gavin_Newsom> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/Santa_Clara_University> ;
    ex:hasSpouse <http://example.org/entity/Jennifer_Siebel> .

<http://example.org/entity/Jennifer_Siebel> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Gavin_Newsom> .

<http://example.org/entity/Santa_Clara_University> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

