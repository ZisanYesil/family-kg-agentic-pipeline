@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Arthur_Kellam_Tylee> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1887-04-24"^^xsd:date ;
    ex:hasDeathDate "1961-04-13"^^xsd:date .

<http://example.org/entity/James_A_Ryder> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1800-10-08"^^xsd:date ;
    ex:hasDeathDate "1860-01-12"^^xsd:date .

