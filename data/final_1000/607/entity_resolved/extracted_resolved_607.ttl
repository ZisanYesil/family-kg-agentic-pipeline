@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:arthur_kellam_tylee a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Arthur Kellam Tylee" ;
    onto:hasBirthDate "1887-04-24"^^xsd:date ;
    onto:hasDeathDate "1961-04-13"^^xsd:date ;
    skos:altLabel "Arthur Kellam Tylee" .

data:james_a_ryder a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "James A. Ryder" ;
    onto:hasBirthDate "1800-10-08"^^xsd:date ;
    onto:hasDeathDate "1860-01-12"^^xsd:date ;
    skos:altLabel "James A. Ryder" .

