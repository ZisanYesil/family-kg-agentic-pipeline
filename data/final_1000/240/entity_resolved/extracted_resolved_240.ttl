@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:bronislav_gimpel a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bronislav Gimpel" ;
    onto:hasBirthDate "1911-01-29"^^xsd:date ;
    onto:hasDeathDate "1979-05-01"^^xsd:date .

data:lilavati_singh a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lilavati Singh" ;
    onto:hasBirthDate "1868-12-14"^^xsd:date ;
    onto:hasDeathDate "1909-05-09"^^xsd:date ;
    skos:altLabel "Lilivati Singh" .

