@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/der_doppelganger> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasComposer <http://example.org/extracted/franz_schubert> ;
    ex:hasCreator <http://example.org/extracted/franz_schubert> .

<http://example.org/extracted/antonio_salieri> a ex:Agent,
        ex:Person .

<http://example.org/extracted/franz_schubert> a ex:Agent,
        ex:Person ;
    ex:hasStudentOf <http://example.org/extracted/antonio_salieri> .

