@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Replay> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Alex_P> .

<http://example.org/entity/Alex_P> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Sweden>,
        <http://example.org/extracted/greece> ;
    ex:hasNationality <http://example.org/entity/Sweden>,
        <http://example.org/extracted/greece> .

<http://example.org/entity/Sweden> a ex:Country,
        ex:Place .

<http://example.org/extracted/greece> a ex:Country,
        ex:Place .

