@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Replay> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Replay" ;
    onto:hasCreator <http://example.org/entity/Alex_P> .

<http://example.org/entity/Alex_P> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alex P" ;
    onto:hasNationality <http://example.org/entity/Sweden>,
        data:greece ;
    skos:altLabel "Alexander \"Alex P\" Papaconstantinou" .

<http://example.org/entity/Sweden> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Sweden" ;
    skos:altLabel "Swedish" .

data:greece a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Greece" ;
    skos:altLabel "Greek" .

