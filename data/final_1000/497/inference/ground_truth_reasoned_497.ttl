@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Replay a ex:Artifact,
        ex:CreativeWork ;
    ex:hasComposer entity:Alex_P ;
    ex:hasCreator entity:Alex_P .

entity:Alex_P a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:Sweden ;
    ex:hasCountry entity:Sweden .

entity:Sweden a ex:Country,
        ex:Place .

