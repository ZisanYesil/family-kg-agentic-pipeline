@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/replay_song> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/extracted/alex_p> .

<http://example.org/extracted/alex_p> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/extracted/greece>,
        <http://example.org/extracted/sweden> ;
    ex:hasNationality <http://example.org/extracted/greece>,
        <http://example.org/extracted/sweden> .

<http://example.org/extracted/greece> a ex:Country,
        ex:Place .

<http://example.org/extracted/sweden> a ex:Country,
        ex:Place .

