@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:replay_song a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Replay" ;
    onto:hasCreator data:alex_p .

data:alex_p a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alex P" ;
    onto:hasNationality data:greece,
        data:sweden ;
    skos:altLabel "Alexander \"Alex P\" Papaconstantinou" .

data:greece a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Greece" ;
    skos:altLabel "Greek" .

data:sweden a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Sweden" ;
    skos:altLabel "Swedish" .

