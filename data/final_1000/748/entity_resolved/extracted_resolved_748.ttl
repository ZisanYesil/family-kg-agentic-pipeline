@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:michael_davitt_poet a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Michael Davitt" ;
    onto:hasBirthDate "1950-04-20"^^xsd:date ;
    onto:hasDeathDate "2005-06-19"^^xsd:date .

data:varoujan_hakhbandian a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Varoujan Hakhbandian" ;
    onto:hasBirthDate "1936-12-04"^^xsd:date ;
    onto:hasDeathDate "1977-09-17"^^xsd:date .

