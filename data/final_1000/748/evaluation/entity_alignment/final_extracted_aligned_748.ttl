@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Michael_Davitt> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1950-04-20"^^xsd:date ;
    ex:hasDeathDate "2005-06-19"^^xsd:date .

<http://example.org/entity/Varoujan_Hakhbandian> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1936-12-04"^^xsd:date ;
    ex:hasDeathDate "1977-09-17"^^xsd:date .

