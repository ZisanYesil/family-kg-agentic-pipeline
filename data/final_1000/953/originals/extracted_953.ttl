@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:murtaza_nizam_shah_i a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Murtaza Nizam Shah I" ;
    onto:hasFather data:hussain_nizam_shah_i .

data:hussain_nizam_shah_i a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hussain Nizam Shah I" ;
    onto:hasCountry data:india .

data:india a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "India" ;
    skos:altLabel "Central India" .

