@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Juan_Carlos_Gumucio> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Marie_Colvin> .

<http://example.org/entity/Marie_Colvin> a ex:Agent,
        ex:Person ;
    ex:hasEmployer <http://example.org/entity/Sunday_Times> ;
    ex:hasSpouse <http://example.org/entity/Juan_Carlos_Gumucio> .

<http://example.org/entity/Sunday_Times> a ex:Agent,
        ex:Organization .

