@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Kanda_Naal_Mudhal> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/V_Priya> ;
    ex:hasDirector <http://example.org/entity/V_Priya> .

<http://example.org/entity/Suhasini> a ex:Agent,
        ex:Person .

<http://example.org/entity/V_Priya> a ex:Agent,
        ex:Person ;
    ex:hasStudentOf <http://example.org/entity/Suhasini> .

