@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Kanda_Naal_Mudhal> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Kanda Naal Mudhal" ;
    onto:hasDirector <http://example.org/entity/V_Priya> .

<http://example.org/entity/Suhasini> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Suhasini" .

<http://example.org/entity/V_Priya> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "V. Priya" ;
    onto:hasStudentOf <http://example.org/entity/Suhasini> .

