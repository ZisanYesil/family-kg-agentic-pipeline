@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:british_motor_corporation a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "British Motor Corporation" ;
    onto:hasInception "1952"^^xsd:gYear .

data:hammarplast a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Hammarplast" ;
    onto:hasInception "1947"^^xsd:gYear .

