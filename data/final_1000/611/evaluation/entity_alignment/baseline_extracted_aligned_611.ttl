@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/British_Motor_Corporation> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "British Motor Corporation" ;
    onto:hasInception "1952"^^xsd:gYear .

<http://example.org/entity/Hammarplast> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Hammarplast" ;
    onto:hasInception "1947"^^xsd:gYear .

