@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:British_Motor_Corporation a ex:Agent,
        ex:Organization ;
    ex:hasInception "1952"^^xsd:gYear .

entity:Hammarplast a ex:Agent,
        ex:Organization ;
    ex:hasInception "1947"^^xsd:gYear .

