@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:kosobokovo_place a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Kosobokovo" ;
    onto:hasCountry data:russia_country .

data:pavlovka_place a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Pavlovka, Uglovsky District, Altai Krai" ;
    onto:hasCountry data:russia_country .

data:russia_country a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Russia" .

