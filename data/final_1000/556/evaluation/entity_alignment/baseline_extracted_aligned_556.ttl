@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Kosobokovo> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Kosobokovo" ;
    onto:hasCountry <http://example.org/entity/Russia> .

<http://example.org/entity/Pavlovka_Uglovsky_District_Altai_Krai> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Pavlovka, Uglovsky District, Altai Krai" ;
    onto:hasCountry <http://example.org/entity/Russia> .

<http://example.org/entity/Russia> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Russia" .

