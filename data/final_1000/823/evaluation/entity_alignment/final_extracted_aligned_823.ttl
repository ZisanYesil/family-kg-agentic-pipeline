@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Do_You_Like_This> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Rome> ;
    ex:hasPerformer <http://example.org/entity/Rome> .

<http://example.org/entity/Benton_Harbor_Michigan> a ex:Place .

<http://example.org/entity/Rome> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Benton_Harbor_Michigan> .

