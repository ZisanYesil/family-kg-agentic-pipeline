@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Do_You_Like_This> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Do You Like This" ;
    onto:hasPerformer <http://example.org/entity/Rome> .

<http://example.org/entity/Benton_Harbor_Michigan> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Benton Harbor, Michigan" .

<http://example.org/entity/Rome> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Rome" ;
    onto:hasBirthPlace <http://example.org/entity/Benton_Harbor_Michigan> ;
    skos:altLabel "Jerome Woods" .

