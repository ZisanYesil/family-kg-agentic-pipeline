@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:song_do_you_like_this a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Do You Like This" ;
    onto:hasPerformer data:rome_singer .

data:benton_harbor_michigan a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Benton Harbor, Michigan" .

data:rome_singer a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Rome" ;
    onto:hasBirthPlace data:benton_harbor_michigan ;
    skos:altLabel "Jerome Woods" .

