@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Do_You_Like_This a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Rome ;
    ex:hasPerformer entity:Rome .

entity:Benton_Harbor_Michigan a ex:Place .

entity:Rome a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Benton_Harbor_Michigan .

