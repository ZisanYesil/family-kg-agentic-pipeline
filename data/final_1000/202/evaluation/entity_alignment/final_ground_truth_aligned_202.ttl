@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Mama_s_Boy a ex:Artifact,
        ex:CreativeWork ;
    ex:hasComposer entity:Mark_Mothersbaugh ;
    ex:hasCreator entity:Mark_Mothersbaugh .

entity:Kent_State_University a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Mark_Mothersbaugh a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt entity:Kent_State_University .

