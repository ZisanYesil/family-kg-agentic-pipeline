@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Mama_s_Boy> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Mama's Boy" ;
    skos:altLabel "Mama's Boy" .

<http://example.org/entity/Mark_Mothersbaugh> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mark Mothersbaugh" ;
    onto:hasEducatedAt <http://example.org/entity/Kent_State_University> ;
    skos:altLabel "Mark Allen Mothersbaugh" .

<http://example.org/entity/Kent_State_University> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Kent State University" ;
    skos:altLabel "Kent State University" .

