@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Mama_s_Boy> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasComposer <http://example.org/entity/Mark_Mothersbaugh> ;
    ex:hasCreator <http://example.org/entity/Mark_Mothersbaugh> .

<http://example.org/entity/Kent_State_University> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Mark_Mothersbaugh> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/Kent_State_University> .

