@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_goonga_pehalwan a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Goonga Pehalwan" ;
    onto:hasPublicationDate "2013"^^xsd:gYear .

data:film_house_on_the_edge_of_the_park a onto:Film,
        owl:NamedIndividual ;
