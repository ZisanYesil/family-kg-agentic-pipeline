@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Great_Pyramid_of_Giza a ex:Place .

entity:Khafra a ex:Agent,
        ex:Person ;
    ex:hasFather entity:Khufu ;
    ex:hasParent entity:Khufu .

entity:Khufu a ex:Agent,
        ex:Person ;
    ex:hasBurialPlace entity:Great_Pyramid_of_Giza ;
    ex:hasChild entity:Khafra .

