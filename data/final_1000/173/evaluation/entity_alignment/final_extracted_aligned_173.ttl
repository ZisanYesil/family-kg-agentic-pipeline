@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Khafra> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Khufu> ;
    ex:hasParent <http://example.org/entity/Khufu> .

<http://example.org/entity/Khufu> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Khafra> .

