@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:khafra_person a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Khafra" ;
    onto:hasFather data:khufu_person ;
    skos:altLabel "Chephren",
        "Khafre",
        "Khefren" .

data:khufu_person a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Khufu" .

