@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Bratuku_Teruvu> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/P_S_Ramakrishna_Rao> ;
    ex:hasDirector <http://example.org/entity/P_S_Ramakrishna_Rao> .

<http://example.org/entity/Bhanumathi_Ramakrishna> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/P_S_Ramakrishna_Rao> .

<http://example.org/entity/P_S_Ramakrishna_Rao> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1918-10-12"^^xsd:date ;
    ex:hasDeathDate "1986-09-07"^^xsd:date ;
    ex:hasSpouse <http://example.org/entity/Bhanumathi_Ramakrishna> .

