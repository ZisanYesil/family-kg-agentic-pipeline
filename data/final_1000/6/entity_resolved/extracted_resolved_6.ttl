@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:nikolsk_airport a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Nikolsk Airport" ;
    onto:hasCountry data:russia .

data:svobodny_airport a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Svobodny Airport" ;
    onto:hasCountry data:russia .

data:russia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Russia" .

