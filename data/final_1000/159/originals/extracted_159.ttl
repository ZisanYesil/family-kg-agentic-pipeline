@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:gordon_bell_high_school a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Gordon Bell High School" ;
    onto:hasCountry data:canada .

data:polyvalente_w_a_losier a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Polyvalente W.-A. Losier" ;
    onto:hasCountry data:canada .

data:canada a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" .

