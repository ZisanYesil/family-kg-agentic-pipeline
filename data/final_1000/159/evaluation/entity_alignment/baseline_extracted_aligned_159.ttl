@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Gordon_Bell_High_School> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Gordon Bell High School" ;
    onto:hasCountry <http://example.org/entity/Canada> .

<http://example.org/entity/Polyvalente_W_A_Losier> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Polyvalente W.-A. Losier" ;
    onto:hasCountry <http://example.org/entity/Canada> .

<http://example.org/entity/Canada> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" .

