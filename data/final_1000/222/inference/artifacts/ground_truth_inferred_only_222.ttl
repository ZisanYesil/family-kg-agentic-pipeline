@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:London_Film_School a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Red_Riding_Hood a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Giacomo_Cimini .

entity:Giacomo_Cimini a ex:Agent,
        ex:Person .

