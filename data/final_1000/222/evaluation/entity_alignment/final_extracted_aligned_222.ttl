@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Red_Riding_Hood> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Giacomo_Cimini> ;
    ex:hasDirector <http://example.org/entity/Giacomo_Cimini> .

<http://example.org/entity/London_Film_School> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Giacomo_Cimini> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/London_Film_School> .

