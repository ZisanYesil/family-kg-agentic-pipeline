@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:lassiette_au_beurre a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "L'Assiette Au Beurre" ;
    onto:hasPublicationDate "1901"^^xsd:gYear .

data:pnai_plus a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Pnai Plus" ;
    onto:hasPublicationDate "1989"^^xsd:gYear .

