@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_don_cesare_di_bazan a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Don Cesare di Bazan" ;
    onto:hasPublicationDate "1942"^^xsd:gYear .

data:film_las_tecnologias_pesqueras a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Las tecnologías pesqueras" ;
    onto:hasPublicationDate "1975"^^xsd:gYear .

