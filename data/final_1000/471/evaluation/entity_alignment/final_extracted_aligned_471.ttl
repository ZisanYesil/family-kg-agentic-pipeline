@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Richard_Bulstrode> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Edward_Bulstrode> ;
    ex:hasParent <http://example.org/entity/Edward_Bulstrode> .

<http://example.org/entity/St_John_s_College> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Edward_Bulstrode> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Richard_Bulstrode> ;
    ex:hasEducatedAt <http://example.org/entity/St_John_s_College> .

