@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Richard_Bulstrode> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Richard Bulstrode" ;
    onto:hasFather <http://example.org/entity/Edward_Bulstrode> .

<http://example.org/entity/Edward_Bulstrode> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Edward Bulstrode" ;
    onto:hasEducatedAt <http://example.org/entity/St_John_s_College> .

<http://example.org/entity/St_John_s_College> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "St. John's College, Oxford" .

