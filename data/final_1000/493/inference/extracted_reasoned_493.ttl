@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/song_to_the_siren> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/extracted/tim_buckley> ;
    ex:hasPerformer <http://example.org/extracted/tim_buckley> .

<http://example.org/extracted/heroin_overdose> a ex:CauseOfDeath .

<http://example.org/extracted/tim_buckley> a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath <http://example.org/extracted/heroin_overdose> .

