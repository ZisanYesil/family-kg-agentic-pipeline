@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Song_to_the_Siren> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Tim_Buckley> ;
    ex:hasPerformer <http://example.org/entity/Tim_Buckley> .

<http://example.org/entity/overdose> a ex:CauseOfDeath .

<http://example.org/entity/Tim_Buckley> a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath <http://example.org/entity/overdose> .

