@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:thomas_henty a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Thomas Henty" ;
    onto:hasFather data:tommy_cooper .

data:heart_attack a onto:CauseOfDeath,
        owl:NamedIndividual ;
    rdfs:label "heart attack" .

data:tommy_cooper a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tommy Cooper" ;
    onto:hasCauseOfDeath data:heart_attack ;
    skos:altLabel "Thomas Frederick Cooper" .

