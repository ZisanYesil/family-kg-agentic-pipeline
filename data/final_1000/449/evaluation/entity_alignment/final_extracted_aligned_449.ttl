@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Thomas_Henty> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Tommy_Cooper> ;
    ex:hasParent <http://example.org/entity/Tommy_Cooper> .

<http://example.org/entity/heart_attack> a ex:CauseOfDeath .

<http://example.org/entity/Tommy_Cooper> a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath <http://example.org/entity/heart_attack> ;
    ex:hasChild <http://example.org/entity/Thomas_Henty> .

