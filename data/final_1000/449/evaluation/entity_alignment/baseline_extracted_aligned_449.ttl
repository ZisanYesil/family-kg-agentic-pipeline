@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Thomas_Henty> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Thomas Henty" ;
    onto:hasFather <http://example.org/entity/Tommy_Cooper> .

<http://example.org/entity/Tommy_Cooper> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tommy Cooper" ;
    onto:hasCauseOfDeath <http://example.org/entity/heart_attack> ;
    skos:altLabel "Thomas Frederick Cooper" .

<http://example.org/entity/heart_attack> a onto:CauseOfDeath,
        owl:NamedIndividual ;
    rdfs:label "heart attack" .

