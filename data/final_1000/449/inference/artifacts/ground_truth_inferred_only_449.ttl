@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:heart_attack a ex:CauseOfDeath .

entity:Thomas_Henty a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Tommy_Cooper .

entity:Tommy_Cooper a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Thomas_Henty .

