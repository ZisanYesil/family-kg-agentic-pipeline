@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_fame_1936> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_leslie_hiscott> ;
    ex:hasDirector <http://example.org/extracted/person_leslie_hiscott> .

<http://example.org/extracted/film_its_all_about_love_2003> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_thomas_vinterberg> ;
    ex:hasDirector <http://example.org/extracted/person_thomas_vinterberg> .

<http://example.org/extracted/person_leslie_hiscott> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1894-07-25"^^xsd:date ;
    ex:hasDeathDate "1968-05-03"^^xsd:date .

<http://example.org/extracted/person_thomas_vinterberg> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1969-05-19"^^xsd:date .

