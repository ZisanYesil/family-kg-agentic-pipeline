@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Fame_1936_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Leslie_S_Hiscott> ;
    ex:hasDirector <http://example.org/entity/Leslie_S_Hiscott> .

<http://example.org/entity/It_s_All_About_Love> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Thomas_Vinterberg> ;
    ex:hasDirector <http://example.org/entity/Thomas_Vinterberg> .

<http://example.org/entity/Leslie_S_Hiscott> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1894-07-25"^^xsd:date ;
    ex:hasDeathDate "1968-05-03"^^xsd:date .

<http://example.org/entity/Thomas_Vinterberg> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1969-05-19"^^xsd:date .

