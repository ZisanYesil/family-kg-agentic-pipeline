@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Fame_1936_film a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Leslie_S_Hiscott ;
    ex:hasDirector entity:Leslie_S_Hiscott .

entity:It_s_All_About_Love a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Thomas_Vinterberg ;
    ex:hasDirector entity:Thomas_Vinterberg .

entity:Leslie_S_Hiscott a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1894-07-25"^^xsd:date .

entity:Thomas_Vinterberg a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1969-05-19"^^xsd:date .

