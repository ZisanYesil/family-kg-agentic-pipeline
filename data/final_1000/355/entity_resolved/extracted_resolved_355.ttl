@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:circle_of_deception_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Circle of Deception" ;
    onto:hasDirector data:jack_lee_person .

data:jack_lee_person a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jack Lee" ;
    onto:hasEducatedAt data:marling_school_educationalinstitution .

data:marling_school_educationalinstitution a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Marling School" .

