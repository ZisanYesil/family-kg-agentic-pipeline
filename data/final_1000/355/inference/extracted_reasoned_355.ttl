@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/circle_of_deception_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/jack_lee_person> ;
    ex:hasDirector <http://example.org/extracted/jack_lee_person> .

<http://example.org/extracted/marling_school_educationalinstitution> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/extracted/jack_lee_person> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/extracted/marling_school_educationalinstitution> .

