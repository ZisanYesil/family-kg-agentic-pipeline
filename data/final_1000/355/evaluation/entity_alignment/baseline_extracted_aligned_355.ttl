@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Circle_of_Deception> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Circle of Deception" ;
    onto:hasDirector <http://example.org/entity/Jack_Lee> .

<http://example.org/entity/Jack_Lee> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jack Lee" ;
    onto:hasEducatedAt <http://example.org/entity/Marling_School> .

<http://example.org/entity/Marling_School> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Marling School" .

