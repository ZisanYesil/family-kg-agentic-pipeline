@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Circle_of_Deception a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Jack_Lee ;
    ex:hasDirector entity:Jack_Lee .

entity:Marling_School a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Jack_Lee a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt entity:Marling_School .

