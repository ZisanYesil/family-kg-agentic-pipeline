@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Circle_of_Deception> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Jack_Lee> ;
    ex:hasDirector <http://example.org/entity/Jack_Lee> .

<http://example.org/entity/Marling_School> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Jack_Lee> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/Marling_School> .

