@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Thomas_the_Impostor> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Georges_Franju> ;
    ex:hasDirector <http://example.org/entity/Georges_Franju> .

<http://example.org/entity/Fougères> a ex:Place .

<http://example.org/entity/Georges_Franju> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Fougères> .

