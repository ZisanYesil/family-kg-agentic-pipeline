@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Thomas_the_Impostor> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Thomas the Impostor" ;
    onto:hasDirector <http://example.org/entity/Georges_Franju> .

<http://example.org/entity/Fougères> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Fougères, Ille-et-Vilaine" .

<http://example.org/entity/Georges_Franju> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Georges Franju" ;
    onto:hasBirthPlace <http://example.org/entity/Fougères> .

