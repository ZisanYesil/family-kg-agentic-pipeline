@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Mukhyamantri> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Anjan_Choudhury> ;
    ex:hasDirector <http://example.org/entity/Anjan_Choudhury> .

<http://example.org/entity/Chumki_Chowdhury> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/entity/Anjan_Choudhury> .

<http://example.org/entity/Anjan_Choudhury> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Chumki_Chowdhury> .

