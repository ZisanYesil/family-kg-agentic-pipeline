@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Mukhyamantri> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Mukhyamantri (1996 film)" ;
    onto:hasDirector <http://example.org/entity/Anjan_Choudhury> .

<http://example.org/entity/Anjan_Choudhury> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Anjan Choudhury" ;
    onto:hasChild <http://example.org/entity/Chumki_Chowdhury> .

<http://example.org/entity/Chumki_Chowdhury> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sandip Choudhury" .

