@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Csaba_Pálinkás> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Csaba Pálinkás" ;
    onto:hasBirthDate "1959-06-02"^^xsd:date ;
    onto:hasDeathDate "2004-10-11"^^xsd:date .

<http://example.org/entity/Henry_Scheffé> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Henry Scheffé" ;
    onto:hasBirthDate "1907-04-11"^^xsd:date ;
    onto:hasDeathDate "1977-07-05"^^xsd:date .

