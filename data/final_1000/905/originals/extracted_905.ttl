@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:anisul_islam_mahmud a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Anisul Islam Mahmud" ;
    onto:hasBirthDate "1947-12-20"^^xsd:date .

data:giampaolo_di_paola a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Giampaolo Di Paola" ;
    onto:hasBirthDate "1944-08-15"^^xsd:date .

