@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Donatus_Prince_and_Landgrave_of_Hesse> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Donatus, Landgrave of Hesse" ;
    onto:hasFather <http://example.org/entity/Moritz_Landgrave_of_Hesse> .

<http://example.org/entity/Moritz_Landgrave_of_Hesse> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Moritz, Landgrave of Hesse" ;
    onto:hasBirthDate "1926-08-06"^^xsd:date .

