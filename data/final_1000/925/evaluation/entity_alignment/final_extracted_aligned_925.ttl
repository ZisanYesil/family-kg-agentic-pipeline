@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Donatus_Prince_and_Landgrave_of_Hesse> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Moritz_Landgrave_of_Hesse> ;
    ex:hasParent <http://example.org/entity/Moritz_Landgrave_of_Hesse> .

<http://example.org/entity/Moritz_Landgrave_of_Hesse> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1926-08-06"^^xsd:date ;
    ex:hasChild <http://example.org/entity/Donatus_Prince_and_Landgrave_of_Hesse> .

