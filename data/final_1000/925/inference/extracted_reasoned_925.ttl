@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/donatus_hesse> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/extracted/moritz_hesse> ;
    ex:hasParent <http://example.org/extracted/moritz_hesse> .

<http://example.org/extracted/moritz_hesse> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1926-08-06"^^xsd:date ;
    ex:hasChild <http://example.org/extracted/donatus_hesse> .

