@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Winter_Meeting> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Bretaigne_Windust> ;
    ex:hasDirector <http://example.org/entity/Bretaigne_Windust> .

<http://example.org/entity/Year_of_the_Horse> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Jim_Jarmusch> ;
    ex:hasDirector <http://example.org/entity/Jim_Jarmusch> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/Bretaigne_Windust> a ex:Agent,
        ex:Person .

<http://example.org/entity/Jim_Jarmusch> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasNationality <http://example.org/entity/American> .

