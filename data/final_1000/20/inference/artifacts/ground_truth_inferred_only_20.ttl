@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Winter_Meeting a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Bretaigne_Windust .

entity:Year_of_the_Horse a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Jim_Jarmusch .

entity:American a ex:Country,
        ex:Place .

entity:Bretaigne_Windust a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:French .

entity:French a ex:Country,
        ex:Place .

entity:Jim_Jarmusch a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:American .

