@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:alexander_orenstein a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alexander Jeremiah Orenstein" ;
    onto:hasBirthDate "1879-09-26"^^xsd:date ;
    onto:hasDeathDate "1972-07-07"^^xsd:date .

data:lydia_flood_jackson a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lydia Flood Jackson" ;
    onto:hasBirthDate "1862-06-06"^^xsd:date ;
    onto:hasDeathDate "1963-07-08"^^xsd:date .

