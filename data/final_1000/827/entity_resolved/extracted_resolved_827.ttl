@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:dyrestuy_place a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Dyrestuy" ;
    onto:hasCountry data:russia_country .

data:nelemnoye_place a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Nelemnoye" ;
    onto:hasCountry data:russia_country .

data:russia_country a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Russia" .

