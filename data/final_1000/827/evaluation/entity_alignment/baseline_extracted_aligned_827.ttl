@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Dyrestuy> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Dyrestuy" ;
    onto:hasCountry <http://example.org/entity/Russia> .

<http://example.org/entity/Nelemnoye> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Nelemnoye" ;
    onto:hasCountry <http://example.org/entity/Russia> .

<http://example.org/entity/Russia> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Russia" .

