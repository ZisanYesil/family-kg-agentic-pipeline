@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Pleasure_Victim> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Pleasure Victim" ;
    onto:hasPublicationDate "1982"^^xsd:gYear .

<http://example.org/entity/Stands_for_Decibels> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Stands for Decibels" ;
    onto:hasPublicationDate "1981"^^xsd:gYear .

