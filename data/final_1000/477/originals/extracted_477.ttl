@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:album_pleasure_victim a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Pleasure Victim" ;
    onto:hasPublicationDate "1982"^^xsd:gYear .

data:album_stands_for_decibels a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Stands for Decibels" ;
    onto:hasPublicationDate "1981"^^xsd:gYear .

