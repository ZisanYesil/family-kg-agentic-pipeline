@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:strevicky_slecny_pavliny a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Střevíčky slečny Pavlíny" ;
    onto:hasPublicationDate "1941"^^xsd:gYear .

data:when_the_angels_sleep a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "When The Angels Sleep" ;
    onto:hasPublicationDate "1947"^^xsd:gYear ;
    skos:altLabel "Cuando los ángeles duermen" .

