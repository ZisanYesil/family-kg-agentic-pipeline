@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Pistol_Whipped> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Pistol Whipped" ;
    onto:hasDirector <http://example.org/entity/Roel_Reiné> .

<http://example.org/entity/Dutch> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Eindhoven" .

<http://example.org/entity/Roel_Reiné> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Roel Reiné" ;
    onto:hasBirthPlace <http://example.org/entity/Dutch> .

