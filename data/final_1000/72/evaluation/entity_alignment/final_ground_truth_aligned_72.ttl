@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Pistol_Whipped a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Roel_Reiné ;
    ex:hasDirector entity:Roel_Reiné .

entity:Dutch a ex:Place .

entity:Roel_Reiné a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Dutch .

