@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Noemie_Fox> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Noemie Fox" ;
    onto:hasMother <http://example.org/entity/Myriam_Fox_Jerusalmi> .

<http://example.org/entity/French> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

<http://example.org/entity/Myriam_Fox_Jerusalmi> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Myriam Fox-Jerusalmi" ;
    onto:hasNationality <http://example.org/entity/French> .

