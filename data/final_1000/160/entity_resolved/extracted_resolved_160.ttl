@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:fanfares_of_love_1951 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Fanfares of Love" ;
    onto:hasCountry data:west_germany .

data:guilty_2011 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Guilty" ;
    onto:hasCountry data:france .

data:france a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

data:west_germany a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "West Germany" ;
    skos:altLabel "West German" .

