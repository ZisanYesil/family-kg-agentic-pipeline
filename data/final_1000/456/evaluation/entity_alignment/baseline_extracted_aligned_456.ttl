@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/In_Bed_with_Santa> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "In Bed With Santa" ;
    onto:hasPublicationDate "1999-11-26"^^xsd:date .

<http://example.org/entity/Ustad_Hotel> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Ustad Hotel" ;
    onto:hasPublicationDate "2012-07-13"^^xsd:date .

