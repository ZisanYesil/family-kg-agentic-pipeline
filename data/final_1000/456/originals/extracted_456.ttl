@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:in_bed_with_santa a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "In Bed With Santa" ;
    onto:hasPublicationDate "1999-11-26"^^xsd:date .

data:ustad_hotel a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Ustad Hotel" ;
    onto:hasPublicationDate "2012-07-13"^^xsd:date .

