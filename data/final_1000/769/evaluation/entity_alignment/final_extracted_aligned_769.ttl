@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Bmahray> a ex:Place ;
    ex:hasCountry <http://example.org/entity/Lebanon> .

<http://example.org/entity/Dargi_Kerman> a ex:Place ;
    ex:hasCountry <http://example.org/entity/Iran> .

<http://example.org/entity/Iran> a ex:Country,
        ex:Place .

<http://example.org/entity/Lebanon> a ex:Country,
        ex:Place .

