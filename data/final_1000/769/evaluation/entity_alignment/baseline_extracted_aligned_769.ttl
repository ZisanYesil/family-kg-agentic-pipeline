@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Bmahray> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Bmahray" ;
    onto:hasCountry <http://example.org/entity/Lebanon> .

<http://example.org/entity/Dargi_Kerman> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Dargi, Kerman" ;
    onto:hasCountry <http://example.org/entity/Iran> .

<http://example.org/entity/Iran> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Iran" .

<http://example.org/entity/Lebanon> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Lebanon" .

