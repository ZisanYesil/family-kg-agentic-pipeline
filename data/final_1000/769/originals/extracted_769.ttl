@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:bmahray a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Bmahray" ;
    onto:hasCountry data:lebanon .

data:dargi_kerman a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Dargi, Kerman" ;
    onto:hasCountry data:iran .

data:iran a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Iran" .

data:lebanon a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Lebanon" .

