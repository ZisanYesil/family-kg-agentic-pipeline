@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Madeleine_Frieden_Kinnen a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Pierre_Frieden .

entity:Pierre_Frieden a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace entity:Zürich ;
    ex:hasSpouse entity:Madeleine_Frieden_Kinnen .

entity:Zürich a ex:Place .

