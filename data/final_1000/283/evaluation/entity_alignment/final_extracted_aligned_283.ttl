@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Madeleine_Frieden_Kinnen> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Pierre_Frieden> .

<http://example.org/entity/Pierre_Frieden> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Zürich> ;
    ex:hasSpouse <http://example.org/entity/Madeleine_Frieden_Kinnen> .

<http://example.org/entity/Zürich> a ex:Place .

