@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Madeleine_Frieden_Kinnen> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Madeleine Frieden-Kinnen" ;
    onto:hasSpouse <http://example.org/entity/Pierre_Frieden> .

<http://example.org/entity/Pierre_Frieden> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Pierre Frieden" ;
    onto:hasDeathPlace <http://example.org/entity/Zürich> .

<http://example.org/entity/Zürich> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Zürich" .

