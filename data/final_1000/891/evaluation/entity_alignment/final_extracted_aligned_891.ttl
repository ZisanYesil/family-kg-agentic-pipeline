@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Jorge_Sapag> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Elías_Sapag> ;
    ex:hasParent <http://example.org/entity/Elías_Sapag> .

<http://example.org/entity/Mayrouba> a ex:Place .

<http://example.org/entity/Elías_Sapag> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Mayrouba> ;
    ex:hasChild <http://example.org/entity/Jorge_Sapag> .

