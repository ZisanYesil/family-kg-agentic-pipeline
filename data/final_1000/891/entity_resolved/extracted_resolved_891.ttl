@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:jorge_sapag a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jorge Augusto Sapag" ;
    onto:hasFather data:elias_sapag ;
    skos:altLabel "Jorge Sapag" .

data:elias_sapag a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Elías Canaán Sapag" ;
    onto:hasBirthPlace data:mayrouba_lebanon ;
    skos:altLabel "Elías Sapag" .

data:mayrouba_lebanon a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Mayrouba, Lebanon" ;
    skos:altLabel "Mayrouba" .

