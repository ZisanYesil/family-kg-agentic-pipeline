@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Jorge_Sapag a ex:Agent,
        ex:Person ;
    ex:hasFather entity:Elías_Sapag ;
    ex:hasParent entity:Elías_Sapag .

entity:Mayrouba a ex:Place .

entity:Elías_Sapag a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Mayrouba ;
    ex:hasChild entity:Jorge_Sapag .

