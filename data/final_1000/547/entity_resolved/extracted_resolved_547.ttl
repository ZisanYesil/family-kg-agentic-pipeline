@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:bottle_caps_candy a onto:Product,
        owl:NamedIndividual ;
    rdfs:label "Bottle Caps" ;
    onto:hasManufacturer data:nestle ;
    skos:altLabel "Bottle Caps (candy)" .

data:nestle a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Nestlé" ;
    onto:hasCountry data:switzerland ;
    skos:altLabel "Nestlé",
        "Nestlé S.A." .

data:switzerland a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Switzerland" ;
    skos:altLabel "Swiss" .

