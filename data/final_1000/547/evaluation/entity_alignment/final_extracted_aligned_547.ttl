@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Bottle_Caps> a ex:Artifact,
        ex:Product ;
    ex:hasManufacturer <http://example.org/entity/Nestlé> .

<http://example.org/entity/Nestlé> a ex:Agent,
        ex:Organization ;
    ex:hasCountry <http://example.org/entity/Swiss> .

<http://example.org/entity/Swiss> a ex:Country,
        ex:Place .

