@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Bottle_Caps a ex:Artifact,
        ex:Product ;
    ex:hasManufacturer entity:Nestlé .

entity:Nestlé a ex:Agent ;
    ex:hasCountry entity:Swiss .

entity:Swiss a ex:Country,
        ex:Place .

