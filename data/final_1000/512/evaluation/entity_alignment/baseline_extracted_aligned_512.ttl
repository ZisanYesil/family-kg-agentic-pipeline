@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Fred_Chittick> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Fred Chittick" ;
    onto:hasBirthDate "1868-04-05"^^xsd:date ;
    onto:hasDeathDate "1917-08-24"^^xsd:date .

<http://example.org/entity/Nils_Tvedt> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nils Tvedt" ;
    onto:hasBirthDate "1883-05-21"^^xsd:date ;
    onto:hasDeathDate "1965-05-25"^^xsd:date .

