@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Fred_Chittick> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1868-04-05"^^xsd:date ;
    ex:hasDeathDate "1917-08-24"^^xsd:date .

<http://example.org/entity/Nils_Tvedt> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1883-05-21"^^xsd:date ;
    ex:hasDeathDate "1965-05-25"^^xsd:date .

