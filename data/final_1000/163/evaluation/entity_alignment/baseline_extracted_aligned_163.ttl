@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Beauty_No_1> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Beauty No. 1" ;
    onto:hasDirector <http://example.org/entity/Andy_Warhol> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

<http://example.org/entity/Andy_Warhol> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Andy Warhol" ;
    onto:hasNationality <http://example.org/entity/American> .

