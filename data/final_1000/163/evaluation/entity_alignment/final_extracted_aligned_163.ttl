@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Beauty_No_1> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Andy_Warhol> ;
    ex:hasDirector <http://example.org/entity/Andy_Warhol> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/Andy_Warhol> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasNationality <http://example.org/entity/American> .

