@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Creditors> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Ben_Cura> ;
    ex:hasDirector <http://example.org/entity/Ben_Cura> .

<http://example.org/entity/Argentine> a ex:Country,
        ex:Place .

<http://example.org/entity/Ben_Cura> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Argentine>,
        <http://example.org/extracted/united_kingdom> ;
    ex:hasNationality <http://example.org/entity/Argentine>,
        <http://example.org/extracted/united_kingdom> .

<http://example.org/extracted/united_kingdom> a ex:Country,
        ex:Place .

