@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Creditors a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Ben_Cura .

entity:Argentine a ex:Country,
        ex:Place .

entity:Ben_Cura a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:Argentine .

