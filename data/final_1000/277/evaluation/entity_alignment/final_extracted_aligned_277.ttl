@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Sigmaringen> a ex:Place .

<http://example.org/entity/Frederick_Prince_of_Hohenzollern> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/entity/William_Prince_of_Hohenzollern> ;
    ex:isSonOf <http://example.org/entity/William_Prince_of_Hohenzollern> .

<http://example.org/entity/William_Prince_of_Hohenzollern> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Frederick_Prince_of_Hohenzollern> ;
    ex:hasDeathPlace <http://example.org/entity/Sigmaringen> ;
    ex:hasSon <http://example.org/entity/Frederick_Prince_of_Hohenzollern> .

