@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/William_Prince_of_Hohenzollern> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William, Prince of Hohenzollern" ;
    onto:hasDeathPlace <http://example.org/entity/Sigmaringen> ;
    onto:hasSon <http://example.org/entity/Frederick_Prince_of_Hohenzollern> .

<http://example.org/entity/Frederick_Prince_of_Hohenzollern> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Frederick, Prince of Hohenzollern" .

<http://example.org/entity/Sigmaringen> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Sigmaringen" .

