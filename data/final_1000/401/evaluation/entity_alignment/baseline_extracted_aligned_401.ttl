@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Nikolay_Novikov> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nikolay Novikov" ;
    onto:hasDeathPlace <http://example.org/entity/Moscow> ;
    skos:altLabel "Nikolay Ivanovich Novikov" .

<http://example.org/entity/Truten> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Truten" .

<http://example.org/entity/Moscow> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Moscow Governorate" .

