@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:nikolay_novikov a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nikolay Novikov" ;
    onto:hasDeathPlace data:moscow_governorate ;
    skos:altLabel "Nikolay Ivanovich Novikov" .

data:truten a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Truten" .

data:moscow_governorate a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Moscow Governorate" .

