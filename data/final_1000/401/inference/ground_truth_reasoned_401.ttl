@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Truten a ex:Artifact,
        ex:CreativeWork ;
    ex:hasEditor entity:Nikolay_Novikov .

entity:Moscow a ex:Place .

entity:Nikolay_Novikov a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace entity:Moscow .

