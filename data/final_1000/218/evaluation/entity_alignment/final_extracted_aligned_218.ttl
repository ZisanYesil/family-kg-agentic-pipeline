@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Damon_Tassos> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1923-12-05"^^xsd:date ;
    ex:hasDeathDate "2001-02-28"^^xsd:date .

<http://example.org/entity/Sir_Frederick_Treves_1st_Baronet> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1853-02-15"^^xsd:date ;
    ex:hasDeathDate "1923-12-07"^^xsd:date .

