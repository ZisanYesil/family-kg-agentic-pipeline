@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Damon_Tassos> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Damon Tassos" ;
    onto:hasBirthDate "1923-12-05"^^xsd:date ;
    onto:hasDeathDate "2001-02-28"^^xsd:date .

<http://example.org/entity/Sir_Frederick_Treves_1st_Baronet> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sir Frederick Treves, 1st Baronet" ;
    onto:hasBirthDate "1853-02-15"^^xsd:date ;
    onto:hasDeathDate "1923-12-07"^^xsd:date ;
    skos:altLabel "Frederick Treves" .

