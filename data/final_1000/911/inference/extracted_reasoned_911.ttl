@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_berlin_jerusalem> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/director_gitai> ;
    ex:hasDirector <http://example.org/extracted/director_gitai> .

<http://example.org/extracted/film_shadow_nazareth> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/director_maude> ;
    ex:hasDirector <http://example.org/extracted/director_maude> .

<http://example.org/extracted/director_gitai> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1950-10-11"^^xsd:date .

<http://example.org/extracted/director_maude> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1880-07-23"^^xsd:date .

