@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Berlin_Jerusalem> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Amos_Gitai> ;
    ex:hasDirector <http://example.org/entity/Amos_Gitai> .

<http://example.org/entity/The_Shadow_of_Nazareth> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Arthur_Maude> ;
    ex:hasDirector <http://example.org/entity/Arthur_Maude> .

<http://example.org/entity/Amos_Gitai> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1950-10-11"^^xsd:date .

<http://example.org/entity/Arthur_Maude> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1880-07-23"^^xsd:date .

