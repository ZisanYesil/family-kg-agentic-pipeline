@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Berlin_Jerusalem> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Berlin-Jerusalem" ;
    onto:hasDirector <http://example.org/entity/Amos_Gitai> .

<http://example.org/entity/The_Shadow_of_Nazareth> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Shadow of Nazareth" ;
    onto:hasDirector <http://example.org/entity/Arthur_Maude> .

<http://example.org/entity/Amos_Gitai> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Amos Gitai" ;
    onto:hasBirthDate "1950-10-11"^^xsd:date .

<http://example.org/entity/Arthur_Maude> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Arthur Maude" ;
    onto:hasBirthDate "1880-07-23"^^xsd:date ;
    skos:altLabel "Arthur John Maude" .

