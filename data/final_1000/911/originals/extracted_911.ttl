@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_berlin_jerusalem a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Berlin-Jerusalem" ;
    onto:hasDirector data:director_gitai .

data:film_shadow_nazareth a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Shadow of Nazareth" ;
    onto:hasDirector data:director_maude .

data:director_gitai a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Amos Gitai" ;
    onto:hasBirthDate "1950-10-11"^^xsd:date .

data:director_maude a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Arthur Maude" ;
    onto:hasBirthDate "1880-07-23"^^xsd:date ;
    skos:altLabel "Arthur John Maude" .

