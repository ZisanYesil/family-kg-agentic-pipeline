@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:rachael_poole a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Rachael Poole" ;
    onto:hasSpouse data:reginald_lane_poole ;
    skos:altLabel "Rachael Emily Poole" .

data:stanley_lane_poole a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Stanley Lane-Poole" ;
    onto:hasBrother data:reginald_lane_poole .

data:reginald_lane_poole a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Reginald Lane Poole" ;
    skos:altLabel "Reginald Lane-Poole" .

