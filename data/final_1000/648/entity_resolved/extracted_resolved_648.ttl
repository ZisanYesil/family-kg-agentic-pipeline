@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:djeli_moussa_diawara a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Djeli Moussa Diawara" ;
    onto:hasBirthPlace data:kankan ;
    skos:altLabel "Djeli Moussa Diawara" .

data:kankan a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Kankan" .

