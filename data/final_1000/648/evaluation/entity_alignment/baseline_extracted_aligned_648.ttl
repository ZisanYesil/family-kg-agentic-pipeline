@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Djeli_Moussa_Diawara> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Djeli Moussa Diawara" ;
    onto:hasBirthPlace <http://example.org/entity/Kankan> ;
    skos:altLabel "Djeli Moussa Diawara" .

<http://example.org/entity/Kankan> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Kankan" .

