@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/God_s_Gun> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Gianfranco_Parolini> ;
    ex:hasDirector <http://example.org/entity/Gianfranco_Parolini> .

<http://example.org/entity/Rome> a ex:Place .

<http://example.org/entity/Gianfranco_Parolini> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Rome> .

