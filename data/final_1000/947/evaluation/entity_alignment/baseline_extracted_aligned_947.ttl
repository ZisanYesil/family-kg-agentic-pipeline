@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/God_s_Gun> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "God's Gun" ;
    onto:hasDirector <http://example.org/entity/Gianfranco_Parolini> .

<http://example.org/entity/Gianfranco_Parolini> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gianfranco Parolini" ;
    onto:hasDeathPlace <http://example.org/entity/Rome> ;
    skos:altLabel "Frank Kramer" .

<http://example.org/entity/Rome> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Rome" ;
    skos:altLabel "Rome, Italy" .

