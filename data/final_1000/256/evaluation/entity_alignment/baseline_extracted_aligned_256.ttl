@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Howrah_Bridge> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Howrah Bridge" .

<http://example.org/entity/O_P_Nayyar> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "O. P. Nayyar" ;
    onto:hasAwardReceived <http://example.org/entity/Filmfare_Award> .

<http://example.org/entity/Filmfare_Award> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Filmfare Award for Best Music Director" .

