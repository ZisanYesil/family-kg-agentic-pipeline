@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Howrah_Bridge a ex:Artifact,
        ex:CreativeWork ;
    ex:hasComposer entity:O_P_Nayyar ;
    ex:hasCreator entity:O_P_Nayyar .

entity:Filmfare_Award a ex:Award .

entity:O_P_Nayyar a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived entity:Filmfare_Award .

