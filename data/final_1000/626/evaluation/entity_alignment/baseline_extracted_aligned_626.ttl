@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Kyebambe_Girls_Secondary_School> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Kyebambe Girls' Secondary School" ;
    onto:hasInception "1910"^^xsd:gYear .

<http://example.org/entity/St_Teresa_s_National_Secondary_School> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "St. Teresa's National Secondary School" ;
    onto:hasInception "1885"^^xsd:gYear .

