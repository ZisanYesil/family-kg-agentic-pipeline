@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Kyebambe_Girls_Secondary_School> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization ;
    ex:hasInception "1910"^^xsd:gYear .

<http://example.org/entity/St_Teresa_s_National_Secondary_School> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization ;
    ex:hasInception "1885"^^xsd:gYear .

