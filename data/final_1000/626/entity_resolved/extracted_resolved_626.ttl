@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:kyebambe_girls_secondary_school_uganda a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Kyebambe Girls' Secondary School" ;
    onto:hasInception "1910"^^xsd:gYear .

data:st_teresas_national_secondary_school_malaysia a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "St. Teresa's National Secondary School" ;
    onto:hasInception "1885"^^xsd:gYear .

