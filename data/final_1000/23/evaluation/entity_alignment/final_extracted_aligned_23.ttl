@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/China> a ex:Country,
        ex:Place .

<http://example.org/entity/Dexter_Young> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Connie_Chan> ;
    ex:hasParent <http://example.org/entity/Connie_Chan> .

<http://example.org/entity/Connie_Chan> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Dexter_Young> ;
    ex:hasCountry <http://example.org/entity/China> .

