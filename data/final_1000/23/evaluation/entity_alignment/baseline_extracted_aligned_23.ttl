@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Dexter_Young> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Dexter Young" ;
    onto:hasMother <http://example.org/entity/Connie_Chan> .

<http://example.org/entity/China> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "China" .

<http://example.org/entity/Connie_Chan> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Connie Chan" ;
    onto:hasCountry <http://example.org/entity/China> .

