@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Talking_Feet> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/John_Baxter> ;
    ex:hasDirector <http://example.org/entity/John_Baxter> .

<http://example.org/entity/The_Third_Miracle> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Agnieszka_Holland> ;
    ex:hasDirector <http://example.org/entity/Agnieszka_Holland> .

<http://example.org/entity/Agnieszka_Holland> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1948-11-28"^^xsd:date .

<http://example.org/entity/John_Baxter> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1896-12-31"^^xsd:date ;
    ex:hasDeathDate "1975-01-21"^^xsd:date .

