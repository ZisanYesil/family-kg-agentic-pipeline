@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:closed_doors_village_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Closed Doors Village" ;
    onto:hasPublicationDate "2014"^^xsd:gYear .

data:poor_girls_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Poor Girls" ;
    onto:hasPublicationDate "1927"^^xsd:gYear .

