@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Closed_Doors_Village> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Closed Doors Village" ;
    onto:hasPublicationDate "2014"^^xsd:gYear .

<http://example.org/entity/Poor_Girls> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Poor Girls" ;
    onto:hasPublicationDate "1927"^^xsd:gYear .

