@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:aami_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Aami" ;
    onto:hasPublicationDate "2018-02-09"^^xsd:date .

data:bitch_slap_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Bitch Slap" ;
    onto:hasPublicationDate "2009"^^xsd:gYear .

