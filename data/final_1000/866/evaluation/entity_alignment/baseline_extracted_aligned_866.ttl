@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Aami> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Aami" ;
    onto:hasPublicationDate "2018-02-09"^^xsd:date .

<http://example.org/entity/Bitch_Slap> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Bitch Slap" ;
    onto:hasPublicationDate "2009"^^xsd:gYear .

