@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:margaret_countess_of_anjou_1272 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Margaret, Countess of Anjou" ;
    onto:hasSpouse data:charles_of_valois_1270 .

data:charles_of_valois_1270 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Charles of Valois" .

