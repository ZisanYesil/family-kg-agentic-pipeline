@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Charles_of_Valois a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:France ;
    ex:hasCountry entity:France ;
    ex:hasSpouse entity:Margaret_Countess_of_Anjou .

entity:Margaret_Countess_of_Anjou a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Charles_of_Valois .

entity:France a ex:Country,
        ex:Place .

