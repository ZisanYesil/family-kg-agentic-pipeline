@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Margaret_Countess_of_Anjou> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Margaret, Countess of Anjou" ;
    onto:hasSpouse <http://example.org/entity/Charles_of_Valois> .

<http://example.org/entity/Charles_of_Valois> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Charles of Valois" .

