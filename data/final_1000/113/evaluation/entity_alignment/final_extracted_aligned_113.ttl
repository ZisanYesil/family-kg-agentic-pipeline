@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/A_Rough_Passage> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Franklyn_Barrett> ;
    ex:hasDirector <http://example.org/entity/Franklyn_Barrett> .

<http://example.org/entity/The_Green_God_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Paul_Scardon> ;
    ex:hasDirector <http://example.org/entity/Paul_Scardon> .

<http://example.org/entity/Australian> a ex:Country,
        ex:Place .

<http://example.org/entity/Franklyn_Barrett> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Australian> ;
    ex:hasNationality <http://example.org/entity/Australian> .

<http://example.org/entity/Paul_Scardon> a ex:Agent,
        ex:Person .

