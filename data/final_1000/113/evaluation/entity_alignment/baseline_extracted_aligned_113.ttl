@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/A_Rough_Passage> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Rough Passage" ;
    onto:hasDirector <http://example.org/entity/Franklyn_Barrett> .

<http://example.org/entity/The_Green_God_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Green God" ;
    onto:hasDirector <http://example.org/entity/Paul_Scardon> .

<http://example.org/entity/Australian> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Australia" ;
    skos:altLabel "Australian" .

<http://example.org/entity/Franklyn_Barrett> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Franklyn Barrett" ;
    onto:hasNationality <http://example.org/entity/Australian> .

<http://example.org/entity/Paul_Scardon> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Paul Scardon" .

