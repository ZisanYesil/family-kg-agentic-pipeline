@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:A_Rough_Passage a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Franklyn_Barrett .

entity:The_Green_God_film a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Paul_Scardon .

entity:Franklyn_Barrett a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:Australian .

entity:Paul_Scardon a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:Australian .

entity:Australian a ex:Country,
        ex:Place .

