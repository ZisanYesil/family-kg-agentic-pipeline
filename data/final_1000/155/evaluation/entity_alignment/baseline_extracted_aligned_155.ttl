@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Camera_Notes> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Camera Notes" ;
    onto:hasEditor <http://example.org/entity/Alfred_Stieglitz> .

<http://example.org/entity/Alfred_Stieglitz> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alfred Stieglitz" ;
    onto:hasSpouse <http://example.org/entity/Georgia_O_Keeffe> .

<http://example.org/entity/Georgia_O_Keeffe> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Georgia O'Keeffe" .

