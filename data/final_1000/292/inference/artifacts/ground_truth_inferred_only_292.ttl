@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Ferrara a ex:Place .

entity:Ginevra_d_Este a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Niccolò_III_d_Este .

entity:Niccolò_III_d_Este a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Ginevra_d_Este .

