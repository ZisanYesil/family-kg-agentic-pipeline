@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:ginevra_d_este a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ginevra d'Este" ;
    onto:hasFather data:niccolo_iii_d_este ;
    skos:altLabel "Ginevra d'Este" .

data:niccolo_iii_d_este a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Niccolò III d'Este" ;
    skos:altLabel "Niccolò III d'Este" .

