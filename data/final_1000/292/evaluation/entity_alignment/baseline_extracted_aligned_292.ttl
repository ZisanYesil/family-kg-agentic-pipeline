@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Ginevra_d_Este> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ginevra d'Este" ;
    onto:hasFather <http://example.org/entity/Niccolò_III_d_Este> ;
    skos:altLabel "Ginevra d'Este" .

<http://example.org/entity/Niccolò_III_d_Este> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Niccolò III d'Este" ;
    skos:altLabel "Niccolò III d'Este" .

