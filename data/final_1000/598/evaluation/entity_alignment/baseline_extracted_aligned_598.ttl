@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Cup_tie_Honeymoon> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Cup-Tie Honeymoon" ;
    onto:hasPublicationDate "1948"^^xsd:gYear .

<http://example.org/entity/Run_the_Race> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Run the Race" ;
    onto:hasPublicationDate "2019-02-22"^^xsd:date .

