@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:alex_matthiessen a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alex Matthiessen" ;
    onto:hasFather data:peter_matthiessen .

data:acute_leukemia a onto:CauseOfDeath,
        owl:NamedIndividual ;
    rdfs:label "acute leukemia" .

data:peter_matthiessen a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Peter Matthiessen" ;
    onto:hasCauseOfDeath data:acute_leukemia .

