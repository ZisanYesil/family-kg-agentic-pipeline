@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Alex_Matthiessen> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Peter_Matthiessen> ;
    ex:hasParent <http://example.org/entity/Peter_Matthiessen> .

<http://example.org/entity/leukemia> a ex:CauseOfDeath .

<http://example.org/entity/Peter_Matthiessen> a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath <http://example.org/entity/leukemia> ;
    ex:hasChild <http://example.org/entity/Alex_Matthiessen> .

