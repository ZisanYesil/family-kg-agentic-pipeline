@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Alex_Matthiessen> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alex Matthiessen" ;
    onto:hasFather <http://example.org/entity/Peter_Matthiessen> .

<http://example.org/entity/Peter_Matthiessen> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Peter Matthiessen" ;
    onto:hasCauseOfDeath <http://example.org/entity/leukemia> .

<http://example.org/entity/leukemia> a onto:CauseOfDeath,
        owl:NamedIndividual ;
    rdfs:label "acute leukemia" .

