@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/K_9_P_I> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "K-9: P.I." ;
    onto:hasDirector <http://example.org/entity/Richard_J_Lewis> .

<http://example.org/entity/Richard_J_Lewis> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Richard J. Lewis" ;
    onto:hasBirthPlace <http://example.org/entity/Toronto_Ontario> .

<http://example.org/entity/Toronto_Ontario> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Toronto, Ontario, Canada" .

