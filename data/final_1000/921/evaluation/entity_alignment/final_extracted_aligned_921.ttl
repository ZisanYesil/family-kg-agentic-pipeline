@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/K_9_P_I> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Richard_J_Lewis> ;
    ex:hasDirector <http://example.org/entity/Richard_J_Lewis> .

<http://example.org/entity/Toronto_Ontario> a ex:Place .

<http://example.org/entity/Richard_J_Lewis> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Toronto_Ontario> .

