@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Agnes_Ballard> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1877-09-14"^^xsd:date ;
    ex:hasDeathDate "1969-11-24"^^xsd:date .

<http://example.org/entity/William_Reginald_Morse> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1874-08-30"^^xsd:date ;
    ex:hasDeathDate "1939-11-11"^^xsd:date .

