@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Agnes_Ballard> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Agnes Ballard" ;
    onto:hasBirthDate "1877-09-14"^^xsd:date ;
    onto:hasDeathDate "1969-11-24"^^xsd:date .

<http://example.org/entity/William_Reginald_Morse> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William Reginald Morse" ;
    onto:hasBirthDate "1874-08-30"^^xsd:date ;
    onto:hasDeathDate "1939-11-11"^^xsd:date .

