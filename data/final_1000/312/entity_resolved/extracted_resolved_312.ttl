@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:national_contest_journal a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "National Contest Journal" ;
    onto:hasPublisher data:american_radio_relay_league .

data:american_radio_relay_league a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "American Radio Relay League" ;
    onto:hasInception "1914-04-06"^^xsd:date ;
    skos:altLabel "ARRL" .

