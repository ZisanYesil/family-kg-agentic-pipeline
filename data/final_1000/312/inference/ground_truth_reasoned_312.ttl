@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:National_Contest_Journal a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher entity:American_Radio_Relay_League .

entity:American_Radio_Relay_League a ex:Agent,
        ex:Organization ;
    ex:hasInception "1914"^^xsd:gYear .

