@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/National_Contest_Journal> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "National Contest Journal" ;
    onto:hasPublisher <http://example.org/entity/American_Radio_Relay_League> .

<http://example.org/entity/American_Radio_Relay_League> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "American Radio Relay League" ;
    onto:hasInception "1914-04-06"^^xsd:date ;
    skos:altLabel "ARRL" .

