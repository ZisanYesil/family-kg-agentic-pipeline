@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/prince_albert> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/extracted/friedrich_duke> ;
    ex:hasParent <http://example.org/extracted/friedrich_duke> .

<http://example.org/extracted/louise_caroline> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/extracted/friedrich_duke> .

