@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Prince_Albert_of_Schleswig_Holstein_Sonderburg_Glücksburg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Prince Albert of Schleswig-Holstein-Sonderburg-Glücksburg" ;
    onto:hasFather <http://example.org/entity/Friedrich_Duke_of_Schleswig_Holstein_Sonderburg_Glücksburg> .

<http://example.org/entity/Friedrich_Duke_of_Schleswig_Holstein_Sonderburg_Glücksburg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Friedrich, Duke of Schleswig-Holstein-Sonderburg-Glücksburg" ;
    onto:hasMother <http://example.org/entity/Princess_Louise_Caroline_of_Hesse_Kassel> .

<http://example.org/entity/Princess_Louise_Caroline_of_Hesse_Kassel> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Princess Louise Caroline of Hesse-Kassel" .

