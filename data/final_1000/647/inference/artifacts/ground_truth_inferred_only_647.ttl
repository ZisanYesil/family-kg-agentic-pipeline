@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:California_Institute_of_the_Arts a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Search_and_Destroy a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:David_Salle .

entity:David_Salle a ex:Agent,
        ex:Person .

