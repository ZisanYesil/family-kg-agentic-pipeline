@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Search_and_Destroy> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Search and Destroy (1995 film)" ;
    onto:hasDirector <http://example.org/entity/David_Salle> .

<http://example.org/entity/California_Institute_of_the_Arts> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "California Institute of the Arts" .

<http://example.org/entity/David_Salle> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "David Salle" ;
    onto:hasEducatedAt <http://example.org/entity/California_Institute_of_the_Arts> .

