@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Search_and_Destroy> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/David_Salle> ;
    ex:hasDirector <http://example.org/entity/David_Salle> .

<http://example.org/entity/California_Institute_of_the_Arts> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/David_Salle> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/California_Institute_of_the_Arts> .

