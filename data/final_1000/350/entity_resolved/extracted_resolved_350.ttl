@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:team_red_bull_nascar_team a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Team Red Bull (NASCAR team)" ;
    onto:hasFounder data:dietrich_mateschitz .

data:austria a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Austria" ;
    skos:altLabel "Austrian" .

data:dietrich_mateschitz a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Dietrich Mateschitz" ;
    onto:hasNationality data:austria .

