@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Red_Bull_Racing_Team a ex:Agent,
        ex:Organization ;
    ex:hasFounder entity:Dietrich_Mateschitz .

entity:Dietrich_Mateschitz a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:Austrian ;
    ex:hasCountry entity:Austrian .

entity:Austrian a ex:Country,
        ex:Place .

