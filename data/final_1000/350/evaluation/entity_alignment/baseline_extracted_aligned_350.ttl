@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Red_Bull_Racing_Team> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Team Red Bull (NASCAR team)" ;
    onto:hasFounder <http://example.org/entity/Dietrich_Mateschitz> .

<http://example.org/entity/Austrian> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Austria" ;
    skos:altLabel "Austrian" .

<http://example.org/entity/Dietrich_Mateschitz> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Dietrich Mateschitz" ;
    onto:hasNationality <http://example.org/entity/Austrian> .

