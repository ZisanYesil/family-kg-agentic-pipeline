@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Red_Bull_Racing_Team> a ex:Agent,
        ex:Organization ;
    ex:hasFounder <http://example.org/entity/Dietrich_Mateschitz> .

<http://example.org/entity/Dietrich_Mateschitz> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Austrian> ;
    ex:hasNationality <http://example.org/entity/Austrian> .

<http://example.org/entity/Austrian> a ex:Country,
        ex:Place .

