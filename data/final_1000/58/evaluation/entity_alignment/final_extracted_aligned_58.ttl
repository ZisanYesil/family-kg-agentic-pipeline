@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Andrzej_Markowski> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1924-08-22"^^xsd:date ;
    ex:hasDeathDate "1986-10-30"^^xsd:date .

<http://example.org/entity/François_Missoffe> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1919-10-13"^^xsd:date ;
    ex:hasDeathDate "2003-08-28"^^xsd:date .

