@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:andrzej_markowski a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Andrzej Markowski" ;
    onto:hasBirthDate "1924-08-22"^^xsd:date ;
    onto:hasDeathDate "1986-10-30"^^xsd:date .

data:francois_missoffe a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "François Missoffe" ;
    onto:hasBirthDate "1919-10-13"^^xsd:date ;
    onto:hasDeathDate "2003-08-28"^^xsd:date .

