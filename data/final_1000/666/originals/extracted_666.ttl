@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:hearts_in_exile_1915_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Hearts in Exile (1915 film)" ;
    onto:hasDirector data:james_young_person .

data:sunshine_sally_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Sunshine Sally" ;
    onto:hasDirector data:lawson_harris_person .

data:james_young_person a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "James Young" ;
    onto:hasNationality data:united_states_country .

data:lawson_harris_person a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lawson Harris" ;
    onto:hasNationality data:united_states_country ;
    skos:altLabel "William Lawson Harris" .

data:united_states_country a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

