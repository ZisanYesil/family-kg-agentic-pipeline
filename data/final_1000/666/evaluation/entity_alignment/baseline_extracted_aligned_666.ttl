@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Hearts_in_Exile_1915_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Hearts in Exile (1915 film)" ;
    onto:hasDirector <http://example.org/entity/James_Young> .

<http://example.org/entity/Sunshine_Sally> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Sunshine Sally" ;
    onto:hasDirector <http://example.org/entity/Lawson_Harris> .

<http://example.org/entity/James_Young> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "James Young" ;
    onto:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/Lawson_Harris> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lawson Harris" ;
    onto:hasNationality <http://example.org/entity/American> ;
    skos:altLabel "William Lawson Harris" .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

