@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Don_t_Let_Me_Down> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Leona_Lewis> ;
    ex:hasPerformer <http://example.org/entity/Leona_Lewis> .

<http://example.org/entity/London> a ex:Place .

<http://example.org/entity/Leona_Lewis> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/London> .

