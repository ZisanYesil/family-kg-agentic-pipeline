@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Sancha_of_Castile_Queen_of_Aragon> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sancha of Castile, Queen of Aragon" ;
    onto:hasSpouse <http://example.org/entity/Alfonso_II_of_Aragon> ;
    skos:altLabel "Sancha of Castile" .

<http://example.org/entity/Alfonso_II_of_Aragon> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alfonso II of Aragon" ;
    onto:hasFather <http://example.org/entity/Ramon_Berenguer_IV> ;
    skos:altLabel "Alfonso II" .

<http://example.org/entity/Ramon_Berenguer_IV> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ramon Berenguer IV of Barcelona" ;
    skos:altLabel "Count Ramon Berenguer IV of Barcelona" .

