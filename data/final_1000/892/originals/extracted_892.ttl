@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:leopoldo_alfredo_bravo a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Leopoldo Alfredo Bravo" ;
    onto:hasDeathDate "2010-10-30"^^xsd:date .

data:marcel_dassault a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Marcel Dassault" ;
    onto:hasDeathDate "1986-04-17"^^xsd:date .

