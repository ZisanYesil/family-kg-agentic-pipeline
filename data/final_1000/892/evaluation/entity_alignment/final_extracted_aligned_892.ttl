@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Leopoldo_Alfredo_Bravo> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2010-10-30"^^xsd:date .

