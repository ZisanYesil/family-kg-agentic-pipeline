@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Anne_Castles> a ex:Agent,
        ex:Person ;
    ex:hasOccupation <http://example.org/entity/cognitive_scientist> .

<http://example.org/entity/Colin_Will> a ex:Agent,
        ex:Person ;
    ex:hasOccupation <http://example.org/entity/poet>,
        <http://example.org/entity/publisher> .

<http://example.org/entity/cognitive_scientist> a ex:Occupation .

<http://example.org/entity/poet> a ex:Occupation .

<http://example.org/entity/publisher> a ex:Occupation .

