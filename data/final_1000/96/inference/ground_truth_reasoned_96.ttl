@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Anne_Castles a ex:Agent,
        ex:Person ;
    ex:hasOccupation entity:cognitive_scientist .

entity:Colin_Will a ex:Agent,
        ex:Person ;
    ex:hasOccupation entity:librarian,
        entity:poet,
        entity:publisher .

entity:cognitive_scientist a ex:Occupation .

entity:librarian a ex:Occupation .

entity:poet a ex:Occupation .

entity:publisher a ex:Occupation .

