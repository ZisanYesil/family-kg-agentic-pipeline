@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Veslefrekk a ex:Agent,
        ex:Organization ;
    ex:hasMember entity:Ståle_Storløkken .

entity:Dombås_Norway a ex:Place .

entity:Ståle_Storløkken a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Dombås_Norway .

