@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Veslefrekk> a ex:Agent,
        ex:Organization ;
    ex:hasMember <http://example.org/entity/Ståle_Storløkken> .

<http://example.org/entity/Dombås_Norway> a ex:Place .

<http://example.org/entity/Ståle_Storløkken> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Dombås_Norway> .

