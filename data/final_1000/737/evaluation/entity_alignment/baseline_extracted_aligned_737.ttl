@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/A_Prussian_Love_Story> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Prussian Love Story" ;
    onto:hasPublicationDate "1938"^^xsd:gYear .

<http://example.org/entity/The_Call_of_the_Canyon> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Call of the Canyon" ;
    onto:hasPublicationDate "1923"^^xsd:gYear .

