@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:a_prussian_love_story a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Prussian Love Story" ;
    onto:hasPublicationDate "1938"^^xsd:gYear .

data:the_call_of_the_canyon a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Call of the Canyon" ;
    onto:hasPublicationDate "1923"^^xsd:gYear .

