@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/A_Place_of_Rage> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Pratibha_Parmar> ;
    ex:hasDirector <http://example.org/entity/Pratibha_Parmar> .

<http://example.org/extracted/lifetime_achievement_award_san_francisco_frameline> a ex:Award .

<http://example.org/extracted/visionary_award_one_in_ten_film_festival> a ex:Award .

<http://example.org/entity/Pratibha_Parmar> a ex:Agent,
        ex:Person ;
