@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:A_Place_of_Rage a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Pratibha_Parmar ;
    ex:hasDirector entity:Pratibha_Parmar .

entity:100_Women a ex:Award .

entity:Pratibha_Parmar a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived entity:100_Women .

