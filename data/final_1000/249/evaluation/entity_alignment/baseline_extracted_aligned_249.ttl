@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Clarence_Moore_businessman> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Clarence Moore" ;
    onto:hasBirthDate "1865-03-01"^^xsd:date ;
    onto:hasDeathDate "1912-04-15"^^xsd:date .

<http://example.org/entity/Wilhelmine_Schröder_Devrient> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Wilhelmine Schröder-Devrient" ;
    onto:hasBirthDate "1804-12-06"^^xsd:date ;
    onto:hasDeathDate "1860-01-26"^^xsd:date ;
    skos:altLabel "Wilhelmine Schröder" .

