@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Clarence_Moore_businessman> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1865-03-01"^^xsd:date ;
    ex:hasDeathDate "1912-04-15"^^xsd:date .

<http://example.org/entity/Wilhelmine_Schröder_Devrient> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1804-12-06"^^xsd:date ;
    ex:hasDeathDate "1860-01-26"^^xsd:date .

