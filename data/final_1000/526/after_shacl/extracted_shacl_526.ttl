@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:zhangsun a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Empress Zhangsun" ;
    onto:hasMother data:gao_zong .

data:gao_zong a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Emperor Gaozong of Tang" ;
    onto:hasFather data:li_zhong ;
    skos:altLabel "Li Zhi" .

data:li_zhong a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Li Zhong" .

