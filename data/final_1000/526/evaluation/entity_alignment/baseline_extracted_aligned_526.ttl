@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Empress_Zhangsun> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Empress Zhangsun" ;
    onto:hasMother <http://example.org/entity/Gaozong> .

<http://example.org/entity/Gaozong> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Emperor Gaozong of Tang" ;
    onto:hasFather <http://example.org/entity/Li_Zhong> ;
    skos:altLabel "Li Zhi" .

<http://example.org/entity/Li_Zhong> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Li Zhong" .

