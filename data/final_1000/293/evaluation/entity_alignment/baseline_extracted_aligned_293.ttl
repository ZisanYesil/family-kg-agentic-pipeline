@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Beauty_and_the_Bastard> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Beauty and the Bastard" ;
    onto:hasPublicationDate "2005"^^xsd:gYear .

<http://example.org/entity/Crazy_on_the_Outside> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Crazy on the Outside" ;
    onto:hasPublicationDate "2010"^^xsd:gYear .

