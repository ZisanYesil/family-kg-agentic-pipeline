@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:beauty_and_the_bastard a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Beauty and the Bastard" ;
    onto:hasPublicationDate "2005"^^xsd:gYear .

data:crazy_on_the_outside a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Crazy on the Outside" ;
    onto:hasPublicationDate "2010"^^xsd:gYear .

