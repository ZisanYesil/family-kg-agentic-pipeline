@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Morgans_Hotel_Group a ex:Agent,
        ex:Organization ;
    ex:hasFounder entity:Ian_Schrager .

entity:Ian_Schrager a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:American ;
    ex:hasCountry entity:American .

entity:American a ex:Country,
        ex:Place .

