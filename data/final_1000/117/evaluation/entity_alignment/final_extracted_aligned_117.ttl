@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Morgans_Hotel_Group> a ex:Agent,
        ex:Organization ;
    ex:hasFounder <http://example.org/entity/Ian_Schrager> .

<http://example.org/entity/Ian_Schrager> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

