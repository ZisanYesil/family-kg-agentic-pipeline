@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:School_in_the_Mailbox a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Stanley_Hawes ;
    ex:hasDirector entity:Stanley_Hawes .

entity:National_Film_Board a ex:Agent,
        ex:Organization .

entity:Stanley_Hawes a ex:Agent,
        ex:Person ;
    ex:hasEmployer entity:National_Film_Board .

