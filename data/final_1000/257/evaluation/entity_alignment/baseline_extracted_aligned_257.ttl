@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Archduke_Carl_Christian_of_Austria> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Archduke Carl Christian of Austria" ;
    onto:hasFather <http://example.org/entity/Archduke_Carl_Ludwig_of_Austria> .

<http://example.org/entity/Archduke_Carl_Ludwig_of_Austria> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Archduke Carl Ludwig of Austria" ;
    onto:hasDeathPlace <http://example.org/entity/Brussels> .

<http://example.org/entity/Brussels> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Brussels" .

