@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Brussels a ex:Place .

entity:Archduke_Carl_Christian_of_Austria a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Archduke_Carl_Ludwig_of_Austria .

entity:Archduke_Carl_Ludwig_of_Austria a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Archduke_Carl_Christian_of_Austria .

