@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Tel_Aviv_University> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Tel Aviv University" .

<http://example.org/entity/Working_Woman> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Working Woman" ;
    onto:hasDirector <http://example.org/entity/Michal_Aviad> .

<http://example.org/entity/Michal_Aviad> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Michal Aviad" .

