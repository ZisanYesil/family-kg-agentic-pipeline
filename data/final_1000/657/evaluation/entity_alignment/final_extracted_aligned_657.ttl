@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Tel_Aviv_University> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Working_Woman> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Michal_Aviad> ;
    ex:hasDirector <http://example.org/entity/Michal_Aviad> .

<http://example.org/entity/Michal_Aviad> a ex:Agent,
        ex:Person .

