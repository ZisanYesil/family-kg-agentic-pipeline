@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:tel_aviv_university a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Tel Aviv University" .

data:working_woman_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Working Woman" ;
    onto:hasDirector data:michal_aviad .

data:michal_aviad a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Michal Aviad" .

