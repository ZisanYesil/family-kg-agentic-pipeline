@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Working_Woman a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Michal_Aviad ;
    ex:hasDirector entity:Michal_Aviad .

entity:Tel_Aviv_University a ex:Agent,
        ex:Organization .

entity:Michal_Aviad a ex:Agent,
        ex:Person ;
    ex:hasEmployer entity:Tel_Aviv_University .

