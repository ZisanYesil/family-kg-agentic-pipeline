@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:sybil_b_g_eysenck a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sybil Bianca Giuliett Eysenck" ;
    onto:hasSpouse data:hans_eysenck ;
    skos:altLabel "Sybil B. G. Eysenck" .

data:hans_eysenck a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hans Jürgen Eysenck" ;
    skos:altLabel "Hans Eysenck" .

