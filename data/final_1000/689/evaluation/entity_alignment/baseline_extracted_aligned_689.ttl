@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Sybil_Bianca_Giuliett_Eysenck> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sybil Bianca Giuliett Eysenck" ;
    onto:hasSpouse <http://example.org/entity/Hans_Eysenck> ;
    skos:altLabel "Sybil B. G. Eysenck" .

<http://example.org/entity/Hans_Eysenck> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hans Jürgen Eysenck" ;
    skos:altLabel "Hans Eysenck" .

