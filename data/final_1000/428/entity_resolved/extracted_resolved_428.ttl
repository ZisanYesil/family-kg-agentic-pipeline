@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:amun_her_khepeshef_20 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Amun-her-khepeshef" ;
    onto:hasMother data:nefertari ;
    skos:altLabel "Amun-her-khepeshef (son of Ramesses II)" .

data:nefertari a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Nefertari" ;
    onto:hasBurialPlace data:qv66 ;
    skos:altLabel "Nefertari Meritmut" .

data:qv66 a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "QV66 (Valley of the Queens)" .

