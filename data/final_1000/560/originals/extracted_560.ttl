@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:teresa_pamies a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Teresa Pàmies" ;
    onto:hasSpouse data:gregorio_lopez_raimundo .

data:gregorio_lopez_raimundo a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gregorio López Raimundo" .

