@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Teresa_Pàmies_i_Bertran> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Teresa Pàmies" ;
    onto:hasSpouse <http://example.org/entity/Gregorio_López_Raimundo> .

<http://example.org/entity/Gregorio_López_Raimundo> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gregorio López Raimundo" .

