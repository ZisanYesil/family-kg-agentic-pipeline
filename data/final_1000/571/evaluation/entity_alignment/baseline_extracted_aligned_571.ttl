@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Henry_III> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Henry III, Holy Roman Emperor" ;
    onto:hasFather <http://example.org/entity/Conrad_II> .

<http://example.org/entity/Conrad_II> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Conrad II" .

