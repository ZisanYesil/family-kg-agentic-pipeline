@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Henry_III> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Conrad_II> ;
    ex:hasParent <http://example.org/entity/Conrad_II> .

<http://example.org/entity/Conrad_II> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Henry_III> .

