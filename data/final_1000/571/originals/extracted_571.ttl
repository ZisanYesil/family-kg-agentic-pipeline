@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:henry_iii_hre a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Henry III, Holy Roman Emperor" ;
    onto:hasFather data:conrad_ii_hre .

data:conrad_ii_hre a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Conrad II" .

