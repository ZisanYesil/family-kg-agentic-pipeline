@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:jacques_victor_henry a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jacques-Victor Henry" ;
    onto:hasFather data:henri_christophe .

data:henri_christophe a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Henri Christophe" .

