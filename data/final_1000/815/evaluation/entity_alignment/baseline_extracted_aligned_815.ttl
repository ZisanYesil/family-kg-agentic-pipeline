@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Jacques_Victor_Henry_Prince_Royal_of_Haiti> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jacques-Victor Henry" ;
    onto:hasFather <http://example.org/entity/Henri_Christophe> .

<http://example.org/entity/Henri_Christophe> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Henri Christophe" .

