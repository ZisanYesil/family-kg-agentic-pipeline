@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Louise_Linton> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Louise Linton" ;
    onto:hasSpouse <http://example.org/entity/Steven_Mnuchin> .

<http://example.org/entity/Steven_Mnuchin> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Steven Mnuchin" ;
    onto:hasEmployer data:us_treasury_department .

data:us_treasury_department a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "United States Department of the Treasury" ;
    skos:altLabel "U.S. Treasury" .

