@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:the_job_newspaper a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "The Job" ;
    onto:hasPublisher data:square_one_publishing .

data:square_one_publishing a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Square One Publishing" .

