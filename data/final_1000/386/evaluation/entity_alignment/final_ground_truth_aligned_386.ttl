@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Job a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher entity:Metropolitan_Police_Service .

entity:Metropolitan_Police_Service a ex:Agent,
        ex:Organization ;
    ex:hasCountry entity:United_Kingdom .

entity:United_Kingdom a ex:Country,
        ex:Place .

