@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Baree_Son_of_Kazan> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Baree, Son Of Kazan (1918 film)" ;
    onto:hasDirector <http://example.org/entity/David_Smith> .

<http://example.org/entity/David_Smith> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "David Smith" ;
    onto:hasDeathPlace <http://example.org/entity/Santa_Barbara_California> .

<http://example.org/entity/Santa_Barbara_California> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Santa Barbara, California" .

