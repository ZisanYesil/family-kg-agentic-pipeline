@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Baree_Son_of_Kazan> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/David_Smith> ;
    ex:hasDirector <http://example.org/entity/David_Smith> .

<http://example.org/entity/Santa_Barbara_California> a ex:Place .

<http://example.org/entity/David_Smith> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Santa_Barbara_California> .

