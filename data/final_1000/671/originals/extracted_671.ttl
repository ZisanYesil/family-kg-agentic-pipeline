@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:baree_son_of_kazan_1918_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Baree, Son Of Kazan (1918 film)" ;
    onto:hasDirector data:david_smith_director .

data:david_smith_director a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "David Smith" ;
    onto:hasDeathPlace data:santa_barbara_california .

data:santa_barbara_california a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Santa Barbara, California" .

