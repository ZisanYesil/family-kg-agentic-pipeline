@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Gold_Cure a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:W_P_Kellino ;
    ex:hasDirector entity:W_P_Kellino .

entity:London a ex:Place .

entity:W_P_Kellino a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:London .

