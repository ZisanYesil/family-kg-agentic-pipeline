@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_Gold_Cure> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/W_P_Kellino> ;
    ex:hasDirector <http://example.org/entity/W_P_Kellino> .

<http://example.org/entity/London> a ex:Place .

<http://example.org/entity/W_P_Kellino> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/London> .

