@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/The_Gold_Cure> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Gold Cure (1925 film)" ;
    onto:hasDirector <http://example.org/entity/W_P_Kellino> .

<http://example.org/entity/London> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "London, England" .

<http://example.org/entity/W_P_Kellino> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "W.P. Kellino" ;
    onto:hasBirthPlace <http://example.org/entity/London> ;
    skos:altLabel "W.P. Kellino",
        "William Philip Gislingham" .

