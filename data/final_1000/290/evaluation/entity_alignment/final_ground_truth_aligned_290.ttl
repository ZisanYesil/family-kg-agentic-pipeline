@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Come_Over_to_My_Place a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Davina ;
    ex:hasPerformer entity:Davina .

entity:Detroit a ex:Place .

entity:Davina a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Detroit .

