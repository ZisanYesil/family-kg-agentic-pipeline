@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:come_over_to_my_place a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Come Over To My Place" ;
    onto:hasPerformer data:davina .

data:davina a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Davina" ;
    skos:altLabel "Davina Bussey" .

