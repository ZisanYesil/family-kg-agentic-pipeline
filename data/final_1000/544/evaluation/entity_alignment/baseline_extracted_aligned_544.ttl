@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Gottfried_Baist> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gottfried Baist" ;
    onto:hasBirthDate "1853-02-28"^^xsd:date ;
    onto:hasDeathDate "1920-10-22"^^xsd:date .

<http://example.org/entity/Mignon_McLaughlin> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mignon McLaughlin" ;
    onto:hasBirthDate "1913-06-06"^^xsd:date ;
    onto:hasDeathDate "1983-12-20"^^xsd:date .

