@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Christopher_Columbus_The_Enigma> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Manoel_de_Oliveira> ;
    ex:hasDirector <http://example.org/entity/Manoel_de_Oliveira> .

<http://example.org/entity/Porto> a ex:Place .

<http://example.org/entity/Manoel_de_Oliveira> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Porto> .

