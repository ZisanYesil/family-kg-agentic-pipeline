@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Christopher_Columbus_The_Enigma> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Christopher Columbus – The Enigma" ;
    onto:hasDirector <http://example.org/entity/Manoel_de_Oliveira> ;
    skos:altLabel "Cristóvão Colombo - O Enigma" .

<http://example.org/entity/Manoel_de_Oliveira> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Manoel de Oliveira" ;
    onto:hasBirthPlace <http://example.org/entity/Porto> ;
    skos:altLabel "Manoel Cândido Pinto de Oliveira" .

<http://example.org/entity/Porto> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Cedofeita, Porto" .

