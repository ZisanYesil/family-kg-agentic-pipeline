@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Christopher_Columbus_The_Enigma a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Manoel_de_Oliveira ;
    ex:hasDirector entity:Manoel_de_Oliveira .

entity:Porto a ex:Place .

entity:Manoel_de_Oliveira a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Porto .

