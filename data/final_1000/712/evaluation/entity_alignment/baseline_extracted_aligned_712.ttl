@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Cancún_International_Airport> a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Cancún International Airport" ;
    onto:hasCountry <http://example.org/entity/Mexico> .

<http://example.org/entity/Ciudad_Juárez_International_Airport> a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Ciudad Juárez International Airport" ;
    onto:hasCountry <http://example.org/entity/Mexico> ;
    skos:altLabel "Abraham González International Airport" .

<http://example.org/entity/Mexico> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Mexico" .

