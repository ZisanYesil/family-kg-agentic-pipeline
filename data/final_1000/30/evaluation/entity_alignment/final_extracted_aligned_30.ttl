@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Los_Motivos_de_Luz> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Felipe_Cazals> ;
    ex:hasDirector <http://example.org/entity/Felipe_Cazals> .

<http://example.org/extracted/place_mexico_df> a ex:Place .

<http://example.org/entity/Felipe_Cazals> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/extracted/place_mexico_df> .

