@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Los_Motivos_de_Luz a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Felipe_Cazals ;
    ex:hasDirector entity:Felipe_Cazals .

entity:France a ex:Place .

entity:Felipe_Cazals a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:France .

