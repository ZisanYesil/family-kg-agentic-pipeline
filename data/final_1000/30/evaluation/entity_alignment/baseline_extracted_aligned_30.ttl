@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Los_Motivos_de_Luz> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Los Motivos de Luz" ;
    onto:hasDirector <http://example.org/entity/Felipe_Cazals> .

<http://example.org/entity/Felipe_Cazals> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Felipe Cazals" ;
    onto:hasBirthPlace data:place_mexico_df .

data:place_mexico_df a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Mexico, D.F." ;
    skos:altLabel "Mexico D.F.",
        "Mexico, D.F." .

