@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_companeros_de_aventuras a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Compañeros de aventuras" ;
    onto:hasPublicationDate "1948"^^xsd:gYear ;
    skos:altLabel "Compañeros de aventuras" .

data:film_yateem a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Yateem" ;
    onto:hasPublicationDate "1988"^^xsd:gYear ;
    skos:altLabel "Yateem" .

