@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Dry_Summer> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Dry Summer" ;
    onto:hasPublicationDate "1964"^^xsd:gYear .

<http://example.org/entity/La_segretaria_per_tutti> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "La segretaria per tutti" ;
    onto:hasPublicationDate "1933"^^xsd:gYear .

