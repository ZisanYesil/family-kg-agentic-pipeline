@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:dry_summer_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Dry Summer" ;
    onto:hasPublicationDate "1964"^^xsd:gYear .

data:la_segretaria_per_tutti_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "La segretaria per tutti" ;
    onto:hasPublicationDate "1933"^^xsd:gYear .

