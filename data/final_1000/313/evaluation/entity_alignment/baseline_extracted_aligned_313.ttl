@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/En_sømand_går_i_land> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "En sømand går i land" ;
    onto:hasPublicationDate "1954"^^xsd:gYear .

<http://example.org/entity/Kaaka_Muttai> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Kaaka Muttai" ;
    onto:hasPublicationDate "2015-06-05"^^xsd:date .

