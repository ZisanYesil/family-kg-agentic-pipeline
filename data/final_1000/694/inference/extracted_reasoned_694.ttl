@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/fredegund> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "0597-12-08"^^xsd:date ;
    ex:hasSpouse <http://example.org/extracted/chilperic_i> .

<http://example.org/extracted/aregumd> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/extracted/chilperic_i> .

<http://example.org/extracted/chilperic_i> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/extracted/aregumd> ;
    ex:hasParent <http://example.org/extracted/aregumd> ;
    ex:hasSpouse <http://example.org/extracted/fredegund> .

