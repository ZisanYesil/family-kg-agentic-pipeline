@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:fredegund a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Fredegund" ;
    onto:hasDeathDate "0597-12-08"^^xsd:date ;
    onto:hasSpouse data:chilperic_i ;
    skos:altLabel "Fredegund",
        "Fredegunda" .

data:aregumd a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Aregund" ;
    skos:altLabel "Aregund" .

data:chilperic_i a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Chilperic I" ;
    onto:hasMother data:aregumd ;
    skos:altLabel "Chilperic I" .

