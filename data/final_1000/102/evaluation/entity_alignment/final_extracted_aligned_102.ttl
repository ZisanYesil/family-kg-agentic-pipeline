@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Hurlingham_Reggae_Band> a ex:Agent,
        ex:Organization ;
    ex:hasMember <http://example.org/entity/Luca_Prodan> .

<http://example.org/entity/Luca_Prodan> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Italian_Scottish>,
        <http://example.org/extracted/italy> ;
    ex:hasNationality <http://example.org/entity/Italian_Scottish>,
        <http://example.org/extracted/italy> .

<http://example.org/entity/Italian_Scottish> a ex:Country,
        ex:Place .

<http://example.org/extracted/italy> a ex:Country,
        ex:Place .

