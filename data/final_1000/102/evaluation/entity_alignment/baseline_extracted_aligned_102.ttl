@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Hurlingham_Reggae_Band> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Hurlingham Reggae Band" ;
    onto:hasMember <http://example.org/entity/Luca_Prodan> .

<http://example.org/entity/Italian_Scottish> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Scotland" .

<http://example.org/entity/Luca_Prodan> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Luca Prodan" ;
    onto:hasNationality <http://example.org/entity/Italian_Scottish>,
        data:italy .

data:italy a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Italy" .

