@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_Diary_of_Evelyn_Lau> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Sturla_Gunnarsson> ;
    ex:hasDirector <http://example.org/entity/Sturla_Gunnarsson> .

<http://example.org/entity/National_Film_Board> a ex:Agent,
        ex:Organization .

<http://example.org/entity/Sturla_Gunnarsson> a ex:Agent,
        ex:Person ;
    ex:hasEmployer <http://example.org/entity/National_Film_Board> .

