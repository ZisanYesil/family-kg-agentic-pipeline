@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Diary_of_Evelyn_Lau a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Sturla_Gunnarsson ;
    ex:hasDirector entity:Sturla_Gunnarsson .

entity:National_Film_Board a ex:Agent,
        ex:Organization .

entity:Sturla_Gunnarsson a ex:Agent,
        ex:Person ;
    ex:hasEmployer entity:National_Film_Board .

