<http://example.org/extracted/thrace> a ex:Place .

<http://example.org/extracted/macrianus_major> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/extracted/macrianus_minor> ;
    ex:hasDeathPlace <http://example.org/extracted/thrace> .

