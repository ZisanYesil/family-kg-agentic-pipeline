@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Macrianus_Minor> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Macrianus_Major> ;
    ex:hasParent <http://example.org/entity/Macrianus_Major> .

<http://example.org/entity/Thrace> a ex:Place .

<http://example.org/entity/Macrianus_Major> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Macrianus_Minor> ;
    ex:hasDeathPlace <http://example.org/entity/Thrace> .

