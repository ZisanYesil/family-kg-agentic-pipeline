@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:festival_in_cannes_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Festival in Cannes" ;
    onto:hasPublicationDate "2001"^^xsd:gYear ;
    skos:altLabel "Festival in Cannes" .

data:petria_s_wreath_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Petria's Wreath" ;
    onto:hasPublicationDate "1980"^^xsd:gYear ;
    skos:altLabel "Petria's Wreath" .

