@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Festival_in_Cannes a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublicationDate "2001"^^xsd:gYear .

entity:Petria_s_Wreath a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublicationDate "1980"^^xsd:gYear .

