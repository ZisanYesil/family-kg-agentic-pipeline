@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Jack_the_Bear> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Jack The Bear" ;
    onto:hasPublicationDate "1993"^^xsd:gYear .

<http://example.org/entity/Nattukku_Oru_Nallavan> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Nattukku Oru Nallavan" ;
    onto:hasPublicationDate "1991"^^xsd:gYear .

