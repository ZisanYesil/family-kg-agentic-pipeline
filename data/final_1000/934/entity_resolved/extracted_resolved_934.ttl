@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:jack_the_bear_1993 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Jack The Bear" ;
    onto:hasPublicationDate "1993"^^xsd:gYear .

data:nattukku_1991 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Nattukku Oru Nallavan" ;
    onto:hasPublicationDate "1991"^^xsd:gYear .

