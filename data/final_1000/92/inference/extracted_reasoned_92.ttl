@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/film_angel_square> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/anne_wheeler> ;
    ex:hasDirector <http://example.org/extracted/anne_wheeler> .

<http://example.org/extracted/gemini_award> a ex:Award .

<http://example.org/extracted/leo_award> a ex:Award .

<http://example.org/extracted/anne_wheeler> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/extracted/gemini_award>,
        <http://example.org/extracted/leo_award> .

