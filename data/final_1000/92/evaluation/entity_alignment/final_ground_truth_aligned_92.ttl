@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Angel_Square a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Anne_Wheeler ;
    ex:hasDirector entity:Anne_Wheeler .

entity:Officer_of_the_Order_of_Canada a ex:Award .

entity:Anne_Wheeler a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived entity:Officer_of_the_Order_of_Canada .

