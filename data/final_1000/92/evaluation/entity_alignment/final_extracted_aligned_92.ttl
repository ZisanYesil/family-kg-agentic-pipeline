@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Angel_Square> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Anne_Wheeler> ;
    ex:hasDirector <http://example.org/entity/Anne_Wheeler> .

<http://example.org/extracted/gemini_award> a ex:Award .

<http://example.org/extracted/leo_award> a ex:Award .

<http://example.org/entity/Anne_Wheeler> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/extracted/gemini_award>,
        <http://example.org/extracted/leo_award> .

