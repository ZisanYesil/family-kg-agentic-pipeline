@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:suicide_social a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Suicide social" ;
    onto:hasPerformer data:orelsan .

data:alencon_orne a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Alençon, Orne" .

data:orelsan a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Orelsan" ;
    onto:hasBirthPlace data:alencon_orne ;
    skos:altLabel "Aurélien Cotentin" .

