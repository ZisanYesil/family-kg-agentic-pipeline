@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Suicide_social a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Orelsan ;
    ex:hasPerformer entity:Orelsan .

entity:Alençon a ex:Place .

entity:Orelsan a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Alençon .

