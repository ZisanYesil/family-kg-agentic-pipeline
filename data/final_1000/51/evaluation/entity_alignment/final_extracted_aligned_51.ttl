@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Suicide_social> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Orelsan> ;
    ex:hasPerformer <http://example.org/entity/Orelsan> .

<http://example.org/entity/Alençon> a ex:Place .

<http://example.org/entity/Orelsan> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Alençon> .

