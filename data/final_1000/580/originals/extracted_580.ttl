@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:eigil_helland_hansen a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Eigil Helland-Hansen" ;
    onto:hasFather data:bjorn_helland_hansen .

data:bergen_museum a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Bergen Museum" .

data:bjorn_helland_hansen a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bjørn Helland-Hansen" ;
    onto:hasEmployer data:bergen_museum .

