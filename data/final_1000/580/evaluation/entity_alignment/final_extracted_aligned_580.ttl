@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Eigil_Helland_Hansen> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Bjørn_Helland_Hansen> ;
    ex:hasParent <http://example.org/entity/Bjørn_Helland_Hansen> .

<http://example.org/entity/University_of_Bergen> a ex:Agent,
        ex:Organization .

<http://example.org/entity/Bjørn_Helland_Hansen> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Eigil_Helland_Hansen> ;
    ex:hasEmployer <http://example.org/entity/University_of_Bergen> .

