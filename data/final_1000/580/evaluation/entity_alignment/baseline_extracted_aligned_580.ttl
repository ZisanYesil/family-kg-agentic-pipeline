@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Eigil_Helland_Hansen> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Eigil Helland-Hansen" ;
    onto:hasFather <http://example.org/entity/Bjørn_Helland_Hansen> .

<http://example.org/entity/Bjørn_Helland_Hansen> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bjørn Helland-Hansen" ;
    onto:hasEmployer <http://example.org/entity/University_of_Bergen> .

<http://example.org/entity/University_of_Bergen> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Bergen Museum" .

