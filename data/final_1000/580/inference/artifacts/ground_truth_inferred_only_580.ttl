@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:University_of_Bergen a ex:Agent,
        ex:Organization .

entity:Bjørn_Helland_Hansen a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Eigil_Helland_Hansen .

entity:Eigil_Helland_Hansen a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Bjørn_Helland_Hansen .

