@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:hermann_muthesius a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hermann Muthesius" ;
    onto:hasBirthDate "1861-04-20"^^xsd:date ;
    onto:hasDeathDate "1927-10-29"^^xsd:date .

data:kiril_makedonski a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Kiril Makedonski" ;
    onto:hasBirthDate "1925-01-19"^^xsd:date ;
    onto:hasDeathDate "1984-06-02"^^xsd:date .

