@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/SuperTex> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "SuperTex" ;
    onto:hasPublicationDate "2003"^^xsd:gYear .

<http://example.org/entity/The_Forbidden_Path> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Forbidden Path" ;
    onto:hasPublicationDate "1918"^^xsd:gYear .

