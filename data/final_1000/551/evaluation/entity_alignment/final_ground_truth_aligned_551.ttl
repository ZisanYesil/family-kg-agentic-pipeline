@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:SuperTex a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublicationDate "2003"^^xsd:gYear .

entity:The_Forbidden_Path a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublicationDate "1918"^^xsd:gYear .

