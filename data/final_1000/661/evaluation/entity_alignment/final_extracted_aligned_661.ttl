@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/It_s_Only_TV> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Cyril_Hanouna> .

<http://example.org/entity/Cyril_Hanouna> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1974-09-23"^^xsd:date ;
    ex:hasBirthPlace <http://example.org/entity/Paris> .

<http://example.org/entity/Paris> a ex:Place .

