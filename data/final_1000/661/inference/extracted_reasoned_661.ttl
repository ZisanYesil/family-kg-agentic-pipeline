@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/its_only_tv> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/extracted/cyril_hanouna> .

<http://example.org/extracted/cyril_hanouna> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1974-09-23"^^xsd:date ;
    ex:hasBirthPlace <http://example.org/extracted/paris> .

<http://example.org/extracted/paris> a ex:Place .

