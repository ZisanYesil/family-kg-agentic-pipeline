@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:far_away_and_long_ago_1978 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Far Away and Long Ago" ;
    onto:hasPublicationDate "1978"^^xsd:gYear .

data:i_always_loved_you_1953 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "I Always Loved You" ;
    onto:hasPublicationDate "1953"^^xsd:gYear .

