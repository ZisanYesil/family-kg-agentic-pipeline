@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Far_Away_and_Long_Ago> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Far Away and Long Ago" ;
    onto:hasPublicationDate "1978"^^xsd:gYear .

<http://example.org/entity/I_Always_Loved_You> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "I Always Loved You" ;
    onto:hasPublicationDate "1953"^^xsd:gYear .

