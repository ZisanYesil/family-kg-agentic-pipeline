@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Mapy_Cortés a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Fernando_Cortés .

entity:The_Phantom_of_the_Operetta a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Fernando_Cortés .

entity:Fernando_Cortés a ex:Agent,
        ex:Person .

