@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:lover_prayer_2001_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Lover's Prayer" ;
    onto:hasCountryOfOrigin data:united_kingdom,
        data:united_states ;
    skos:altLabel "Lover's Prayer" .

data:make_up_1937_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Make-Up (1937 film)" ;
    onto:hasCountryOfOrigin data:united_kingdom ;
    skos:altLabel "Make-Up (1937 film)" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

data:united_kingdom a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

