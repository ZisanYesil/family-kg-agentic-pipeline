@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Lover_s_Prayer a ex:Artifact ;
    ex:hasCountry entity:American,
        entity:British ;
    ex:hasCountryOfOrigin entity:American,
        entity:British .

entity:Make_Up_1937_film a ex:Artifact ;
    ex:hasCountry entity:British ;
    ex:hasCountryOfOrigin entity:British .

entity:American a ex:Country,
        ex:Place .

entity:British a ex:Country,
        ex:Place .

