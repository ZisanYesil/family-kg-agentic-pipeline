@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Lover_s_Prayer> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Lover's Prayer" ;
    onto:hasCountryOfOrigin <http://example.org/entity/American>,
        <http://example.org/entity/British> ;
    skos:altLabel "Lover's Prayer" .

<http://example.org/entity/Make_Up_1937_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Make-Up (1937 film)" ;
    onto:hasCountryOfOrigin <http://example.org/entity/British> ;
    skos:altLabel "Make-Up (1937 film)" .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

<http://example.org/entity/British> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

