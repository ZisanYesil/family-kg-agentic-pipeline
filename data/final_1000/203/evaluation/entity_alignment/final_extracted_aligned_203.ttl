@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Lover_s_Prayer> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/American>,
        <http://example.org/entity/British> ;
    ex:hasCountryOfOrigin <http://example.org/entity/American>,
        <http://example.org/entity/British> .

<http://example.org/entity/Make_Up_1937_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/British> ;
    ex:hasCountryOfOrigin <http://example.org/entity/British> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/British> a ex:Country,
        ex:Place .

