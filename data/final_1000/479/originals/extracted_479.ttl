@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:anthony_crosland a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Anthony Crosland" ;
    onto:hasBirthDate "1918-08-29"^^xsd:date ;
    onto:hasDeathDate "1977-02-19"^^xsd:date ;
    skos:altLabel "C. A. R. Crosland",
        "Charles Anthony Raven Crosland",
        "Tony Crosland" .

data:douglas_vautin a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Douglas Vautin" ;
    onto:hasBirthDate "1896-07-26"^^xsd:date ;
    onto:hasDeathDate "1976-01-11"^^xsd:date .

