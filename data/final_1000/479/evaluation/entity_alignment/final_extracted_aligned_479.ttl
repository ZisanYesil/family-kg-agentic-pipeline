@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Anthony_Crosland> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1918-08-29"^^xsd:date ;
    ex:hasDeathDate "1977-02-19"^^xsd:date .

<http://example.org/entity/Douglas_Vautin> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1896-07-26"^^xsd:date ;
    ex:hasDeathDate "1976-01-11"^^xsd:date .

