@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Sigismund_II_Augustus> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sigismund II Augustus" ;
    onto:hasMother <http://example.org/entity/Bona_Sforza> .

<http://example.org/entity/Bona_Sforza> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bona Sforza" ;
    onto:hasNationality data:italy .

data:italy a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Italy" ;
    skos:altLabel "Italian" .

