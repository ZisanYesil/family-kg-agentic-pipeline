@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:sigismund_ii_augustus a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sigismund II Augustus" ;
    onto:hasMother data:bona_sforza .

data:bona_sforza a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bona Sforza" ;
    onto:hasNationality data:italy .

data:italy a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Italy" ;
    skos:altLabel "Italian" .

