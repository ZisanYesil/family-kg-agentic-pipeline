@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_Roadhouse_Murder> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/J_Walter_Ruben> ;
    ex:hasDirector <http://example.org/entity/J_Walter_Ruben> .

<http://example.org/entity/Forest_Lawn_Memorial_Park> a ex:Place .

<http://example.org/entity/J_Walter_Ruben> a ex:Agent,
        ex:Person ;
    ex:hasBurialPlace <http://example.org/entity/Forest_Lawn_Memorial_Park> .

