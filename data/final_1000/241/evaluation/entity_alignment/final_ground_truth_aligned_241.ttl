@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Roadhouse_Murder a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:J_Walter_Ruben ;
