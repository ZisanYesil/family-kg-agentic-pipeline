@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Strangers_of_the_Evening> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Strangers of the Evening" ;
    onto:hasPublicationDate "1932"^^xsd:gYear .

<http://example.org/entity/Watch_Your_Stern> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Watch Your Stern" ;
    onto:hasPublicationDate "1960"^^xsd:gYear .

