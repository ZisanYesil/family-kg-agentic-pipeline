@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:strangers_of_the_evening_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Strangers of the Evening" ;
    onto:hasPublicationDate "1932"^^xsd:gYear .

data:watch_your_stern_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Watch Your Stern" ;
    onto:hasPublicationDate "1960"^^xsd:gYear .

