@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Come_Rain_or_Shine> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Come Rain or Shine" ;
    onto:hasPublicationDate "1992"^^xsd:gYear .

<http://example.org/entity/The_Harrad_Experiment> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Harrad Experiment" ;
    onto:hasPublicationDate "1973"^^xsd:gYear .

