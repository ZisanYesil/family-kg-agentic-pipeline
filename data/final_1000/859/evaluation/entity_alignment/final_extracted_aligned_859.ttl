@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/The_Crime_Doctor_s_Courage> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/George_Sherman> ;
    ex:hasDirector <http://example.org/entity/George_Sherman> .

<http://example.org/entity/Vasantha_Sena_1967_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/B_S_Ranga> ;
    ex:hasDirector <http://example.org/entity/B_S_Ranga> .

<http://example.org/entity/B_S_Ranga> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2010-12-12"^^xsd:date .

<http://example.org/entity/George_Sherman> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1991-03-15"^^xsd:date .

