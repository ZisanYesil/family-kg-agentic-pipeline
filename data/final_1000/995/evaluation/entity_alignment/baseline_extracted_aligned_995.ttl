@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Killing_on_Adrenaline> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Killing on Adrenaline" ;
    onto:hasPublicationDate "1998"^^xsd:gYear .

<http://example.org/entity/The_Notorious_K_I_M> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "The Notorious K.I.M." ;
    onto:hasPublicationDate "2000-06-27"^^xsd:date .

