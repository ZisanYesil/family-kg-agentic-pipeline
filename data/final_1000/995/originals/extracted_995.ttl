@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:killing_on_adrenaline a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Killing on Adrenaline" ;
    onto:hasPublicationDate "1998"^^xsd:gYear .

data:the_notorious_kim a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "The Notorious K.I.M." ;
    onto:hasPublicationDate "2000-06-27"^^xsd:date .

