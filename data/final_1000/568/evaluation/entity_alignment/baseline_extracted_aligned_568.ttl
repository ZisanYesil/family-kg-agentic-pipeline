@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Lucknow_Airpark> a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Lucknow Airpark" ;
    onto:hasCountry <http://example.org/entity/Canada> .

<http://example.org/entity/Valleyview_Airport> a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Valleyview Airport" ;
    onto:hasCountry <http://example.org/entity/Canada> .

<http://example.org/entity/Canada> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" .

