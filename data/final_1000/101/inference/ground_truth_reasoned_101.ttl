@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Mission_Impossible_2 a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:John_Woo ;
    ex:hasDirector entity:John_Woo .

entity:Hong_Kong a ex:Country,
        ex:Place .

entity:John_Woo a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:Hong_Kong ;
    ex:hasCountry entity:Hong_Kong .

