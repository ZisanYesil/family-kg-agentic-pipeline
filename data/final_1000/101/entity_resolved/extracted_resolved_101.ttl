@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:mission_impossible_2 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Mission: Impossible 2" ;
    onto:hasDirector data:john_woo .

data:hong_kong a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Hong Kong" ;
    skos:altLabel "Hong Kong" .

data:john_woo a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Woo" ;
    onto:hasNationality data:hong_kong .

