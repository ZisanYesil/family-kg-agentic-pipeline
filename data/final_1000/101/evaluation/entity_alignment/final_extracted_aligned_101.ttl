@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Mission_Impossible_2> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/John_Woo> ;
    ex:hasDirector <http://example.org/entity/John_Woo> .

<http://example.org/entity/Hong_Kong> a ex:Country,
        ex:Place .

<http://example.org/entity/John_Woo> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Hong_Kong> ;
    ex:hasNationality <http://example.org/entity/Hong_Kong> .

