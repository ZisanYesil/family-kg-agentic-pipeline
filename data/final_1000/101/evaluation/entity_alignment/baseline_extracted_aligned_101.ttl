@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Mission_Impossible_2> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Mission: Impossible 2" ;
    onto:hasDirector <http://example.org/entity/John_Woo> .

<http://example.org/entity/Hong_Kong> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Hong Kong" ;
    skos:altLabel "Hong Kong" .

<http://example.org/entity/John_Woo> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Woo" ;
    onto:hasNationality <http://example.org/entity/Hong_Kong> .

