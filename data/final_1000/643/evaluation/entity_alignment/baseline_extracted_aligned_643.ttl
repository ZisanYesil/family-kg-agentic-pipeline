@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Namma_Ooru_Nayagan> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Namma Ooru Nayagan" .

<http://example.org/entity/Rajesh_Khanna> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Rajesh Khanna" ;
    onto:hasSpouse <http://example.org/entity/Dimple_Kapadia> ;
    skos:altLabel "Jatin Khanna" .

<http://example.org/entity/Dimple_Kapadia> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Dimple Kapadia" .

