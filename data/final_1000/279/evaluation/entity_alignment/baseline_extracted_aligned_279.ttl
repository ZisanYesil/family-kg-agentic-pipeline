@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Uday_Tikekar> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Uday Tikekar" ;
    onto:hasSpouse <http://example.org/entity/Arati_Ankalikar_Tikekar> ;
    skos:altLabel "Uday Tikekar" .

<http://example.org/entity/Arati_Ankalikar_Tikekar> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Arati Ankalikar-Tikekar" ;
    skos:altLabel "Arati Ankalikar-Tikekar" .

