@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Arati_Ankalikar_Tikekar a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Swanandi_Tikekar .

entity:Swanandi_Tikekar a ex:Agent,
        ex:Person ;
    ex:hasFather entity:Uday_Tikekar ;
    ex:hasParent entity:Arati_Ankalikar_Tikekar,
        entity:Uday_Tikekar .

entity:Uday_Tikekar a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Swanandi_Tikekar .

