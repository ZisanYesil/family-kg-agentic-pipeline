@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Brand_New_Immortals> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Brand New Immortals" ;
    onto:hasFounder <http://example.org/entity/David_Ryan_Harris> .

<http://example.org/entity/David_Ryan_Harris> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "David Ryan Harris" ;
    onto:hasBirthPlace <http://example.org/entity/Evanston_Illinois> .

<http://example.org/entity/Evanston_Illinois> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Evanston, Illinois" .

