@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Me_and_Liza> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Rufus_Wainwright> ;
    ex:hasPerformer <http://example.org/entity/Rufus_Wainwright> .

<http://example.org/entity/Loudon_Wainwright_III> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Rufus_Wainwright> .

<http://example.org/entity/Rufus_Wainwright> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Loudon_Wainwright_III> ;
    ex:hasParent <http://example.org/entity/Loudon_Wainwright_III> .

