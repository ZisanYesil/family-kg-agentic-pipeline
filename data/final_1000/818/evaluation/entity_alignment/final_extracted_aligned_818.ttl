@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Beautiful_Mexico> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Ramón_Pereda> ;
    ex:hasDirector <http://example.org/entity/Ramón_Pereda> .

<http://example.org/entity/María_Antonieta_Pons> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Ramón_Pereda> .

<http://example.org/extracted/adriana_lamar_person> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Ramón_Pereda> .

<http://example.org/entity/Ramón_Pereda> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/María_Antonieta_Pons>,
        <http://example.org/extracted/adriana_lamar_person> .

