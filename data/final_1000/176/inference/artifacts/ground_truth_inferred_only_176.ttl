@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Just_Off_Broadway a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Edmund_Mortimer .

entity:New_York a ex:Place .

entity:Edmund_Mortimer a ex:Agent,
        ex:Person .

