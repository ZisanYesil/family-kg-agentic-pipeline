@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Just_Off_Broadway> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Just Off Broadway" ;
    onto:hasDirector <http://example.org/entity/Edmund_Mortimer> .

<http://example.org/entity/Edmund_Mortimer> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Edmund Mortimer" ;
    onto:hasBirthPlace <http://example.org/entity/New_York> .

<http://example.org/entity/New_York> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "New York, New York" .

