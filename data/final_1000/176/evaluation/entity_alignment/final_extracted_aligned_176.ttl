@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Just_Off_Broadway> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Edmund_Mortimer> ;
    ex:hasDirector <http://example.org/entity/Edmund_Mortimer> .

<http://example.org/entity/New_York> a ex:Place .

<http://example.org/entity/Edmund_Mortimer> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/New_York> .

