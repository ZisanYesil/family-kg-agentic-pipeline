@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:charles_wheatstone a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Charles Wheatstone" ;
    onto:hasBirthDate "1802-02-06"^^xsd:date ;
    onto:hasDeathDate "1875-10-19"^^xsd:date .

data:jean_claude_lauzon a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jean-Claude Lauzon" ;
    onto:hasBirthDate "1953-09-29"^^xsd:date ;
    onto:hasDeathDate "1997-08-10"^^xsd:date .

