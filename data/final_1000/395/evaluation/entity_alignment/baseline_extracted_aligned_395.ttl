@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Seven_Days_to_Noon> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Seven Days To Noon" ;
    onto:hasCountryOfOrigin <http://example.org/entity/British> .

<http://example.org/entity/The_Holding> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Holding" ;
    onto:hasCountryOfOrigin <http://example.org/entity/British> .

<http://example.org/entity/British> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

