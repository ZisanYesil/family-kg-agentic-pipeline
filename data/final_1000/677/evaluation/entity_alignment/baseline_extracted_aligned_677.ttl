@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Theobald_II_Count_of_Champagne> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Theobald II, Count of Champagne" ;
    onto:hasSpouse <http://example.org/entity/Matilda_of_Carinthia> ;
    skos:altLabel "Theobald the Great",
        "Thibaut de Blois" .

<http://example.org/entity/Matilda_of_Carinthia> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Matilda of Carinthia" ;
    onto:hasMother <http://example.org/entity/Uta_of_Passau> ;
    skos:altLabel "Mathilde of Sponheim" .

<http://example.org/entity/Uta_of_Passau> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Uta of Passau" .

