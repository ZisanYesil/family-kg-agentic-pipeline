@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Dharti> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Dharti" ;
    onto:hasPublicationDate "1970"^^xsd:gYear .

<http://example.org/entity/Karla_s_World> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Karla's World" ;
    onto:hasPublicationDate "2007"^^xsd:gYear .

