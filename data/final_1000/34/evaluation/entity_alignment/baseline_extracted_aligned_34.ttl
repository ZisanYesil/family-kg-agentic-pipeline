@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/BESIX> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "BESIX" ;
    onto:hasInception "1909"^^xsd:gYear ;
    skos:altLabel "BESIX Group" .

<http://example.org/entity/Circus_Herman_Renz> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Circus Herman Renz" ;
    onto:hasInception "1911"^^xsd:gYear .

