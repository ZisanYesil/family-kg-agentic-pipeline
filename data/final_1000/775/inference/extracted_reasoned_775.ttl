@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/you_were_made_for_me_song> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/extracted/sam_cooke> ;
    ex:hasPerformer <http://example.org/extracted/sam_cooke> .

<http://example.org/extracted/los_angeles> a ex:Place .

