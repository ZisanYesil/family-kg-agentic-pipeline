@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Los_Angeles_California a ex:Place .

entity:You_Were_Made_for_Me a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Sam_Cooke .

entity:Sam_Cooke a ex:Agent,
        ex:Person .

