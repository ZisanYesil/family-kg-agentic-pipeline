@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/You_Were_Made_for_Me> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Sam_Cooke> ;
    ex:hasPerformer <http://example.org/entity/Sam_Cooke> .

<http://example.org/entity/Los_Angeles_California> a ex:Place .

<http://example.org/entity/Sam_Cooke> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Los_Angeles_California> .

