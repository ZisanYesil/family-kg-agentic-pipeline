@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:francesca_ridgway a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Francesca Ridgway" ;
    onto:hasSpouse data:david_ridgway ;
    skos:altLabel "Francesca Romana Serra Ridgway" .

data:david_ridgway a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "David Ridgway" .

