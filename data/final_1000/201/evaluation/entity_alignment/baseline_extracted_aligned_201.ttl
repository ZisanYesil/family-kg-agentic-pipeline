@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Francesca_Romana_Serra_Ridgway> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Francesca Ridgway" ;
    onto:hasSpouse <http://example.org/entity/David_Ridgway> ;
    skos:altLabel "Francesca Romana Serra Ridgway" .

<http://example.org/entity/David_Ridgway> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "David Ridgway" .

