@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Athens a ex:Place .

entity:David_Ridgway a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Athens ;
    ex:hasSpouse entity:Francesca_Romana_Serra_Ridgway .

entity:Francesca_Romana_Serra_Ridgway a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:David_Ridgway .

