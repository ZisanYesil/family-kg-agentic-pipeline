@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/American_Scientist> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher <http://example.org/entity/Sigma_Xi> .

<http://example.org/entity/Sigma_Xi> a ex:Agent,
        ex:Organization ;
    ex:hasInception "1886"^^xsd:gYear .

