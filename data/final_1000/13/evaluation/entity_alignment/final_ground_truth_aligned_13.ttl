@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:American_Scientist a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPublisher entity:Sigma_Xi .

entity:Sigma_Xi a ex:Agent,
        ex:Organization ;
    ex:hasInception "1886"^^xsd:gYear .

