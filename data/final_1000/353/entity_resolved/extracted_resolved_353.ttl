@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:donne_con_le_gonne_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Donne con le gonne" ;
    onto:hasPublicationDate "1991"^^xsd:gYear .

data:hot_saturday_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Hot Saturday" ;
    onto:hasPublicationDate "1932"^^xsd:gYear .

