@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Donne_con_le_gonne> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Donne con le gonne" ;
    onto:hasPublicationDate "1991"^^xsd:gYear .

<http://example.org/entity/Hot_Saturday> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Hot Saturday" ;
    onto:hasPublicationDate "1932"^^xsd:gYear .

