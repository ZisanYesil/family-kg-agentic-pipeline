@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Amir_Hossein_Arman a ex:Agent,
        ex:Person ;
    ex:hasOccupation entity:actor,
        entity:model,
        entity:singer .

entity:Inbakavi a ex:Agent,
        ex:Person ;
    ex:hasOccupation entity:dramatist,
        entity:poet .

entity:actor a ex:Occupation .

entity:dramatist a ex:Occupation .

entity:model a ex:Occupation .

entity:poet a ex:Occupation .

entity:singer a ex:Occupation .

