@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Amir_Hossein_Arman> a ex:Agent,
        ex:Person ;
    ex:hasOccupation <http://example.org/entity/actor>,
        <http://example.org/entity/model>,
        <http://example.org/entity/singer> .

<http://example.org/entity/Inbakavi> a ex:Agent,
        ex:Person ;
    ex:hasOccupation <http://example.org/entity/dramatist>,
        <http://example.org/entity/poet> .

<http://example.org/entity/actor> a ex:Occupation .

<http://example.org/entity/dramatist> a ex:Occupation .

<http://example.org/entity/model> a ex:Occupation .

<http://example.org/entity/poet> a ex:Occupation .

<http://example.org/entity/singer> a ex:Occupation .

