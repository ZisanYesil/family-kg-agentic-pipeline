@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_Extraordinary_Adventures_of_Adèle_Blanc_Sec> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Luc_Besson> ;
    ex:hasDirector <http://example.org/entity/Luc_Besson> .

<http://example.org/entity/César_Award_for_Best_Director> a ex:Award .

<http://example.org/extracted/award_best_french_director> a ex:Award .

<http://example.org/entity/Luc_Besson> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/entity/César_Award_for_Best_Director>,
        <http://example.org/extracted/award_best_french_director> .

