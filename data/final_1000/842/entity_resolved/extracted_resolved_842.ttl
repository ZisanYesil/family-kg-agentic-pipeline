@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:deh_baneh_ye_eslamabad a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Deh Baneh-ye Eslamabad" ;
    onto:hasCountry data:iran ;
    skos:altLabel "Deh Baneh-ye Eslamabad" .

data:satau a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Satau" ;
    onto:hasCountry data:botswana ;
    skos:altLabel "Satau" .

data:botswana a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Botswana" ;
    skos:altLabel "Botswana" .

data:iran a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Iran" ;
    skos:altLabel "Iran" .

