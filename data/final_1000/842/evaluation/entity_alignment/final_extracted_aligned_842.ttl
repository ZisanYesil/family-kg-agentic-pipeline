@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Deh_Baneh_ye_Eslamabad> a ex:Place ;
    ex:hasCountry <http://example.org/entity/Iran> .

<http://example.org/entity/Satau> a ex:Place ;
    ex:hasCountry <http://example.org/entity/Botswana> .

<http://example.org/entity/Botswana> a ex:Country,
        ex:Place .

<http://example.org/entity/Iran> a ex:Country,
        ex:Place .

