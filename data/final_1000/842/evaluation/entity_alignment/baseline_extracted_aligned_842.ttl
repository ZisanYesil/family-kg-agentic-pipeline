@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Deh_Baneh_ye_Eslamabad> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Deh Baneh-ye Eslamabad" ;
    onto:hasCountry <http://example.org/entity/Iran> ;
    skos:altLabel "Deh Baneh-ye Eslamabad" .

<http://example.org/entity/Satau> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Satau" ;
    onto:hasCountry <http://example.org/entity/Botswana> ;
    skos:altLabel "Satau" .

<http://example.org/entity/Botswana> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Botswana" ;
    skos:altLabel "Botswana" .

<http://example.org/entity/Iran> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Iran" ;
    skos:altLabel "Iran" .

