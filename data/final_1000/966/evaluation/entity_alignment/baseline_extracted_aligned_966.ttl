@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Louis_IX_Landgrave_of_Hesse_Darmstadt> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Louis IX, Landgrave of Hesse-Darmstadt" ;
    onto:hasDeathPlace <http://example.org/entity/Pirmasens> ;
    onto:hasFather <http://example.org/entity/Caroline_of_Hesse_Darmstadt> ;
    skos:altLabel "Louis IX" .

<http://example.org/entity/Caroline_of_Hesse_Darmstadt> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Caroline of Hesse-Darmstadt" ;
    skos:altLabel "Princess Caroline of Hesse-Darmstadt" .

<http://example.org/entity/Pirmasens> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Pirmasens" .

