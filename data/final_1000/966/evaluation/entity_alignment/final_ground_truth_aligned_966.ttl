@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Caroline_of_Hesse_Darmstadt a ex:Agent,
        ex:Person ;
    ex:hasFather entity:Louis_IX_Landgrave_of_Hesse_Darmstadt ;
    ex:hasParent entity:Louis_IX_Landgrave_of_Hesse_Darmstadt .

entity:Pirmasens a ex:Place .

entity:Louis_IX_Landgrave_of_Hesse_Darmstadt a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Caroline_of_Hesse_Darmstadt ;
    ex:hasDeathPlace entity:Pirmasens .

