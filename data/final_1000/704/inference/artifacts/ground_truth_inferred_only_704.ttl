@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:American_Academy_of_Dramatic_Arts a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Hero_at_Large a ex:Artifact,
        ex:CreativeWork,
