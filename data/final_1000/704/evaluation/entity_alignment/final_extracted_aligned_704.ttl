@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Hero_at_Large> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Martin_Davidson> ;
    ex:hasDirector <http://example.org/entity/Martin_Davidson> .

<http://example.org/entity/American_Academy_of_Dramatic_Arts> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Martin_Davidson> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/American_Academy_of_Dramatic_Arts> .

