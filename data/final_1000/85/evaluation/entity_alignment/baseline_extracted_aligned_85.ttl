@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Alexandre_Berthier_3rd_Prince_of_Wagram> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alexandre Berthier, 3rd Prince of Wagram" ;
    onto:hasFather <http://example.org/entity/Napoléon_Alexandre_Berthier> ;
    skos:altLabel "Louis Philippe Marie \"Alexandre\" Berthier" .

<http://example.org/entity/Duchess_Maria_Elisabeth_in_Bavaria> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Duchess Maria Elisabeth in Bavaria" .

<http://example.org/entity/Napoléon_Alexandre_Berthier> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Napoléon Alexandre Berthier" ;
    onto:hasMother <http://example.org/entity/Duchess_Maria_Elisabeth_in_Bavaria> ;
    skos:altLabel "Napoléon Alexandre Louis Joseph Berthier" .

