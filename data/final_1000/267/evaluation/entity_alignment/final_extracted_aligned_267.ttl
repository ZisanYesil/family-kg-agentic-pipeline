@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Jihad> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Slayer> ;
    ex:hasPerformer <http://example.org/entity/Slayer> .

<http://example.org/entity/Grammy_Award> a ex:Award .

<http://example.org/entity/Slayer> a ex:Agent,
        ex:Organization ;
    ex:hasAwardReceived <http://example.org/entity/Grammy_Award> .

