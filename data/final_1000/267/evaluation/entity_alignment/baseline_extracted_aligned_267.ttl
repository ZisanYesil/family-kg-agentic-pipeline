@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Jihad> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Jihad" ;
    onto:hasPerformer <http://example.org/entity/Slayer> .

<http://example.org/entity/Grammy_Award> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Grammy Award" .

<http://example.org/entity/Slayer> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Slayer" ;
    onto:hasAwardReceived <http://example.org/entity/Grammy_Award> .

