@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Miklós_László> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Miklos László" ;
    onto:hasBirthDate "1903-05-20"^^xsd:date ;
    onto:hasDeathDate "1973-04-19"^^xsd:date ;
    skos:altLabel "Miklos Laszlo" .

<http://example.org/entity/Xu_Yulan> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Xu Yulan" ;
    onto:hasBirthDate "1921-12-27"^^xsd:date ;
    onto:hasDeathDate "2017-04-19"^^xsd:date ;
    skos:altLabel "Xu Yulan" .

