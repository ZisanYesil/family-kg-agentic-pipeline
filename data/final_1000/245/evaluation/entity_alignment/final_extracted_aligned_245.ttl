@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Miklós_László> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1903-05-20"^^xsd:date ;
    ex:hasDeathDate "1973-04-19"^^xsd:date .

<http://example.org/entity/Xu_Yulan> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1921-12-27"^^xsd:date ;
    ex:hasDeathDate "2017-04-19"^^xsd:date .

