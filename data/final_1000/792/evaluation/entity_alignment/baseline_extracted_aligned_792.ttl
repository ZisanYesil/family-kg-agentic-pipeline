@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Gang_Up> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Gang Up" ;
    onto:hasPublicationDate "2017-03-24"^^xsd:date ;
    skos:altLabel "Gang Up" .

<http://example.org/entity/Occidentali_s_Karma> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Occidentali's Karma" ;
    onto:hasPublicationDate "2017-02-10"^^xsd:date ;
    skos:altLabel "Occidentali's Karma" .

