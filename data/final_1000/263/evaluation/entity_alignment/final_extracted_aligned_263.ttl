@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_Lantern> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Karel_Lamač> ;
    ex:hasDirector <http://example.org/entity/Karel_Lamač> .

<http://example.org/entity/Hamburg_Germany> a ex:Place .

<http://example.org/entity/Karel_Lamač> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/Hamburg_Germany> .

