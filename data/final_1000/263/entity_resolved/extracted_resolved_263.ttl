@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_the_lantern_1938 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Lantern" ;
    onto:hasDirector data:person_karel_lamac ;
    skos:altLabel "The Lantern" .

data:person_karel_lamac a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Karel Lamač" ;
    onto:hasDeathPlace data:place_hamburg_germany ;
    skos:altLabel "Karel Lamač" .

data:place_hamburg_germany a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Hamburg, Germany" ;
    skos:altLabel "Hamburg",
        "Hamburg, Germany" .

