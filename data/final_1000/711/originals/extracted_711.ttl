@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:philip_carteret_frs a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sir Philip Carteret, FRS" ;
    onto:hasSpouse data:jemima_montagu ;
    skos:altLabel "Philip Carteret" .

data:jemima_montagu a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jemima Montagu" .

