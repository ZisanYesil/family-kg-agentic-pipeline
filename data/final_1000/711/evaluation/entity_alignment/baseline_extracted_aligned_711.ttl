@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Sir_Philip_Carteret_FRS> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sir Philip Carteret, FRS" ;
    onto:hasSpouse <http://example.org/entity/Lady_Jemima_Montagu> ;
    skos:altLabel "Philip Carteret" .

<http://example.org/entity/Lady_Jemima_Montagu> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Jemima Montagu" .

