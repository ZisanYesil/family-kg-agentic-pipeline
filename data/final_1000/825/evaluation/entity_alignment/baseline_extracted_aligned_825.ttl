@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Empress_Ren> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Empress Ren" ;
    onto:hasSpouse <http://example.org/entity/Li_Xiong> .

<http://example.org/entity/Li_Xiong> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Li Xiong" .

