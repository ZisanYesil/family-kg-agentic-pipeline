@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:stanislaw_koniecpolski a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Stanisław Koniecpolski" ;
    onto:hasNationality data:poland ;
    onto:hasSon data:alexander_koniecpolski_1620 .

data:alexander_koniecpolski_1620 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Aleksander Koniecpolski (1620–1659)" .

data:poland a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Poland" ;
    skos:altLabel "Polish" .

