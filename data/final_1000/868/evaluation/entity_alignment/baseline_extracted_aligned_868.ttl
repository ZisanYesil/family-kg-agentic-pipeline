@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Stanisław_Koniecpolski> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Stanisław Koniecpolski" ;
    onto:hasNationality <http://example.org/entity/Polish_Lithuanian_Commonwealth> ;
    onto:hasSon <http://example.org/entity/Aleksander_Koniecpolski> .

<http://example.org/entity/Aleksander_Koniecpolski> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Aleksander Koniecpolski (1620–1659)" .

<http://example.org/entity/Polish_Lithuanian_Commonwealth> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Poland" ;
    skos:altLabel "Polish" .

