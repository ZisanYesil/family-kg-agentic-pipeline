@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:capousacataca_river a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Capousacataca River" ;
    onto:hasCountry data:canada .

data:iroquois_river a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Iroquois River (Saint John River tributary)" ;
    onto:hasCountry data:canada .

data:canada a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" .

