@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Capousacataca_River> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Capousacataca River" ;
    onto:hasCountry <http://example.org/entity/Canada> .

<http://example.org/entity/Iroquois_River_Saint_John_River_tributary> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Iroquois River (Saint John River tributary)" ;
    onto:hasCountry <http://example.org/entity/Canada> .

<http://example.org/entity/Canada> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" .

