@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/The_University_of_Los_Andes> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "University of Los Andes (Colombia)" ;
    onto:hasFounder <http://example.org/entity/Mario_Laserna_Pinzón> .

<http://example.org/entity/Mario_Laserna_Pinzón> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mario Laserna Pinzón" ;
    onto:hasBirthPlace <http://example.org/entity/Paris> .

<http://example.org/entity/Paris> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Paris" .

