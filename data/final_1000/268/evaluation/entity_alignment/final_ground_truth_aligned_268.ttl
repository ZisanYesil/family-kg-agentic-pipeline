@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_University_of_Los_Andes a ex:Agent,
        ex:Organization ;
    ex:hasFounder entity:Mario_Laserna_Pinzón .

entity:Mario_Laserna_Pinzón a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Paris .

entity:Paris a ex:Place .

