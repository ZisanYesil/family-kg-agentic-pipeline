@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Inn_of_the_Damned> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Inn of the Damned" ;
    onto:hasPublicationDate "1975"^^xsd:gYear .

<http://example.org/entity/The_Assigned_Servant> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Assigned Servant" ;
    onto:hasPublicationDate "1911"^^xsd:gYear .

