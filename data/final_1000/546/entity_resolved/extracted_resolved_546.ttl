@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:inn_of_the_damned a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Inn of the Damned" ;
    onto:hasPublicationDate "1975"^^xsd:gYear .

data:the_assigned_servant a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Assigned Servant" ;
    onto:hasPublicationDate "1911"^^xsd:gYear .

