@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Duchess_Maria_Dorothea_of_Württemberg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Duchess Maria Dorothea of Württemberg" ;
    onto:hasFather <http://example.org/entity/Duke_Louis_of_Württemberg> ;
    skos:altLabel "Maria Dorothea Luise Wilhelmine Caroline" .

<http://example.org/entity/Duke_Louis_of_Württemberg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Duke Louis of Württemberg" ;
    onto:hasDeathPlace <http://example.org/entity/Kirchheim_unter_Teck> ;
    skos:altLabel "Louis Friedrich Alexander" .

<http://example.org/entity/Kirchheim_unter_Teck> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Kirchheim unter Teck" .

