@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Angel> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasCreator <http://example.org/entity/Sarah_Brightman> ;
    ex:hasPerformer <http://example.org/entity/Sarah_Brightman> .

<http://example.org/entity/Andrew_Lloyd_Webber> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Sarah_Brightman> .

<http://example.org/entity/Sarah_Brightman> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Andrew_Lloyd_Webber> .

