@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:angel_song a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Angel" ;
    onto:hasPerformer data:sarah_brightman .

data:andrew_lloyd_webber a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Andrew Lloyd Webber" .

data:sarah_brightman a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sarah Brightman" ;
    onto:hasSpouse data:andrew_lloyd_webber .

