@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Angel a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Sarah_Brightman ;
    ex:hasPerformer entity:Sarah_Brightman .

entity:Andrew_Lloyd_Webber a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Sarah_Brightman .

entity:Sarah_Brightman a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Andrew_Lloyd_Webber .

