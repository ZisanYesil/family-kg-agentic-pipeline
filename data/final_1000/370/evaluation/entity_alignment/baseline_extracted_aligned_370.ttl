@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Gretchen_am_Spinnrade> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Gretchen am Spinnrade" ;
    onto:hasComposer <http://example.org/entity/Franz_Schubert> ;
    skos:altLabel "Gretchen am Spinnrade" .

<http://example.org/entity/Antonio_Salieri> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Antonio Salieri" ;
    skos:altLabel "Antonio Salieri" .

<http://example.org/entity/Franz_Schubert> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Franz Schubert" ;
    onto:hasStudentOf <http://example.org/entity/Antonio_Salieri> ;
    skos:altLabel "Franz Peter Schubert",
        "Franz Schubert" .

