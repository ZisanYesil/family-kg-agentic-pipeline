@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/song_gretchen_am_spinnrade> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasComposer <http://example.org/extracted/person_franz_schubert> ;
    ex:hasCreator <http://example.org/extracted/person_franz_schubert> .

<http://example.org/extracted/person_antonio_salieri> a ex:Agent,
        ex:Person .

<http://example.org/extracted/person_franz_schubert> a ex:Agent,
        ex:Person ;
    ex:hasStudentOf <http://example.org/extracted/person_antonio_salieri> .

