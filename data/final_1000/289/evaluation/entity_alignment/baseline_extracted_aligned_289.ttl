@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Red_Opps> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Red Opps" ;
    onto:hasPerformer <http://example.org/entity/21_Savage> .

<http://example.org/entity/21_Savage> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "21 Savage" ;
    onto:hasCitizenship <http://example.org/entity/United_Kingdom> ;
    skos:altLabel "Shéyaa Bin Abraham-Joseph" .

<http://example.org/entity/United_Kingdom> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" .

