@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:red_opps a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Red Opps" ;
    onto:hasPerformer data:twenty_one_savage .

data:twenty_one_savage a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "21 Savage" ;
    onto:hasCitizenship data:united_kingdom ;
    skos:altLabel "Shéyaa Bin Abraham-Joseph" .

data:united_kingdom a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" .

