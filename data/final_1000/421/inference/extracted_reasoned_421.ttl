@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/bob_graham_center> a ex:Agent,
        ex:Organization .

<http://example.org/extracted/gwen_graham> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/extracted/bob_graham> ;
    ex:hasParent <http://example.org/extracted/bob_graham> .

<http://example.org/extracted/bob_graham> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/extracted/gwen_graham> ;
    ex:hasEmployer <http://example.org/extracted/bob_graham_center> .

