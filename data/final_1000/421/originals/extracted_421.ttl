@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:gwen_graham a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gwendolyn Graham" ;
    onto:hasFather data:bob_graham ;
    skos:altLabel "Gwen Graham" .

data:bob_graham a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bob Graham" ;
    onto:hasEmployer data:bob_graham_center .

data:bob_graham_center a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Bob Graham Center for Public Service" .

