@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:the_coastline_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Coastline" ;
    onto:hasPublicationDate "1983"^^xsd:gYear .

data:un_elefante_color_ilusion_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Un Elefante color ilusión" ;
    onto:hasPublicationDate "1970"^^xsd:gYear .

