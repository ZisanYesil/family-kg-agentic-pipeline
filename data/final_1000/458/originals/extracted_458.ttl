@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:a_summer_you_will_never_forget_1959 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Summer You Will Never Forget" ;
    onto:hasCountry data:germany .

data:alfred_von_ingelheim_dramatic_life_1921 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Alfred von Ingelheim's Dramatic Life" ;
    onto:hasCountry data:germany .

data:germany a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Germany" ;
    skos:altLabel "German",
        "West German" .

