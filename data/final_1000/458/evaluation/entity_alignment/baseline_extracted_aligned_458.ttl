@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/A_Summer_You_Will_Never_Forget> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Summer You Will Never Forget" ;
    onto:hasCountry <http://example.org/entity/German> .

<http://example.org/entity/Alfred_von_Ingelheim_s_Dramatic_Life> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Alfred von Ingelheim's Dramatic Life" ;
    onto:hasCountry <http://example.org/entity/German> .

<http://example.org/entity/German> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Germany" ;
    skos:altLabel "German",
        "West German" .

