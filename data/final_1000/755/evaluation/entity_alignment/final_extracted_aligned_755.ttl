@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Before_the_Streets> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/Canadian> ;
    ex:hasCountryOfOrigin <http://example.org/entity/Canadian> .

<http://example.org/entity/Buchanan_Rides_Alone> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasCountryOfOrigin <http://example.org/entity/American> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/Canadian> a ex:Country,
        ex:Place .

