@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Before_the_Streets> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Before the Streets" ;
    onto:hasCountryOfOrigin <http://example.org/entity/Canadian> .

<http://example.org/entity/Buchanan_Rides_Alone> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Buchanan Rides Alone" ;
    onto:hasCountryOfOrigin <http://example.org/entity/American> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

<http://example.org/entity/Canadian> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" ;
    skos:altLabel "Canadian" .

