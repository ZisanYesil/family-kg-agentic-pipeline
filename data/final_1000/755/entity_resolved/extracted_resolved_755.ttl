@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:before_the_streets_2016 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Before the Streets" ;
    onto:hasCountryOfOrigin data:canada .

data:buchanan_rides_alone_1958 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Buchanan Rides Alone" ;
    onto:hasCountryOfOrigin data:united_states .

data:canada a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" ;
    skos:altLabel "Canadian" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

