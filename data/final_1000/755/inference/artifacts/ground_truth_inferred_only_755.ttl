@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Before_the_Streets a ex:Artifact ;
    ex:hasCountry entity:Canadian .

entity:Buchanan_Rides_Alone a ex:Artifact ;
    ex:hasCountry entity:American .

entity:American a ex:Country,
        ex:Place .

entity:Canadian a ex:Country,
        ex:Place .

