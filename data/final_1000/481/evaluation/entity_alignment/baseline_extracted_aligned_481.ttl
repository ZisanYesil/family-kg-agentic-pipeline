@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Come_and_See> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Come And See" ;
    onto:hasCountryOfOrigin <http://example.org/entity/Soviet> .

<http://example.org/entity/The_Diplomatic_Pouch> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Diplomatic Pouch" ;
    onto:hasCountryOfOrigin <http://example.org/entity/Soviet> .

<http://example.org/entity/Soviet> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Soviet Union" ;
    skos:altLabel "Soviet" .

