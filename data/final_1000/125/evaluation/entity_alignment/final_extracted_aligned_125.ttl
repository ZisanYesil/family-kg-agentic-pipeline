@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Summer_Is_Over> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Rolan_Bykov> ;
    ex:hasDirector <http://example.org/entity/Rolan_Bykov> .

<http://example.org/entity/High_Courses_for_Scriptwriters_and_Film_Directors> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Rolan_Bykov> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/High_Courses_for_Scriptwriters_and_Film_Directors> .

