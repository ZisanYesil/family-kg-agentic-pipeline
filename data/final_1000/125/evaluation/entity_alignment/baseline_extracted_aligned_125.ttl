@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Summer_Is_Over> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Summer Is Over" ;
    onto:hasDirector <http://example.org/entity/Rolan_Bykov> ;
    skos:altLabel "Summer Is Over (film)" .

<http://example.org/entity/High_Courses_for_Scriptwriters_and_Film_Directors> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "High Courses for Scriptwriters and Film Directors" .

<http://example.org/entity/Rolan_Bykov> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Rolan Bykov" ;
    onto:hasEducatedAt <http://example.org/entity/High_Courses_for_Scriptwriters_and_Film_Directors> ;
    skos:altLabel "Rolan Antonovich Bykov" .

