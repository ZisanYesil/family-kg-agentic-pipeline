@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Summer_Is_Over a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Rolan_Bykov ;
    ex:hasDirector entity:Rolan_Bykov .

entity:High_Courses_for_Scriptwriters_and_Film_Directors a ex:Agent,
        ex:Organization .

entity:Rolan_Bykov a ex:Agent,
        ex:Person ;
    ex:hasEmployer entity:High_Courses_for_Scriptwriters_and_Film_Directors .

