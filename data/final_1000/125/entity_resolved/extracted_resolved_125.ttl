@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:summer_is_over_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Summer Is Over" ;
    onto:hasDirector data:rolan_bykov ;
    skos:altLabel "Summer Is Over (film)" .

data:high_courses_for_scriptwriters_and_film_directors a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "High Courses for Scriptwriters and Film Directors" .

data:rolan_bykov a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Rolan Bykov" ;
    onto:hasEducatedAt data:high_courses_for_scriptwriters_and_film_directors ;
    skos:altLabel "Rolan Antonovich Bykov" .

