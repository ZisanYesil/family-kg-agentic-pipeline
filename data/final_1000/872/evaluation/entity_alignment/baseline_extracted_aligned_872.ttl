@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Sol_Niger_Within> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Sol Niger Within" ;
    onto:hasPublicationDate "1997"^^xsd:gYear .

<http://example.org/entity/The_Magic_Place> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "The Magic Place" ;
    onto:hasPublicationDate "2011-02-21"^^xsd:date .

