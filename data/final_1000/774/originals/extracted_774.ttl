@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:go_for_sisters a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Go for Sisters" ;
    onto:hasPublicationDate "2013"^^xsd:gYear .

data:jive_junction a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Jive Junction" ;
    onto:hasPublicationDate "1943-12-16"^^xsd:date .

