@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Go_for_Sisters> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Go for Sisters" ;
    onto:hasPublicationDate "2013"^^xsd:gYear .

<http://example.org/entity/Jive_Junction> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Jive Junction" ;
    onto:hasPublicationDate "1943-12-16"^^xsd:date .

