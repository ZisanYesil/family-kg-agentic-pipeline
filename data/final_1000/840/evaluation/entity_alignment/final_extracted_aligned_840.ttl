@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Manoranjan> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Shammi_Kapoor> ;
    ex:hasDirector <http://example.org/entity/Shammi_Kapoor> .

<http://example.org/entity/Filmfare_Award> a ex:Award .

<http://example.org/extracted/filmfare_best_supporting_actor_award_1982> a ex:Award .

<http://example.org/entity/Shammi_Kapoor> a ex:Agent,
