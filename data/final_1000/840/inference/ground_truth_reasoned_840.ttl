@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Manoranjan a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Shammi_Kapoor ;
    ex:hasDirector entity:Shammi_Kapoor .

entity:Filmfare_Award a ex:Award .

entity:Shammi_Kapoor a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived entity:Filmfare_Award .

