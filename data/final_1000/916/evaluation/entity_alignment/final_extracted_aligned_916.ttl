@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Hospital_Massacre> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Boaz_Davidson> ;
    ex:hasDirector <http://example.org/entity/Boaz_Davidson> .

<http://example.org/entity/Searching_for_Monica> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/José_María_Forqué> ;
    ex:hasDirector <http://example.org/entity/José_María_Forqué> .

<http://example.org/entity/Boaz_Davidson> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1943-11-08"^^xsd:date .

<http://example.org/entity/José_María_Forqué> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1923-03-08"^^xsd:date .

