@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Hospital_Massacre> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Hospital Massacre" ;
    onto:hasDirector <http://example.org/entity/Boaz_Davidson> .

<http://example.org/entity/Searching_for_Monica> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Searching for Monica" ;
    onto:hasDirector <http://example.org/entity/José_María_Forqué> ;
    skos:altLabel "Buscando a Mónica" .

<http://example.org/entity/Boaz_Davidson> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Boaz Davidson" ;
    onto:hasBirthDate "1943-11-08"^^xsd:date .

<http://example.org/entity/José_María_Forqué> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "José María Forqué" ;
    onto:hasBirthDate "1923-03-08"^^xsd:date ;
    skos:altLabel "José María Forqué Galindo" .

