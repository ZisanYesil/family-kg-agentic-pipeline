@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_hospital_massacre> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_boaz_davidson> ;
    ex:hasDirector <http://example.org/extracted/person_boaz_davidson> .

<http://example.org/extracted/film_searching_for_monica> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_jose_maria_forque> ;
    ex:hasDirector <http://example.org/extracted/person_jose_maria_forque> .

<http://example.org/extracted/person_boaz_davidson> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1943-11-08"^^xsd:date .

<http://example.org/extracted/person_jose_maria_forque> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1923-03-08"^^xsd:date .

