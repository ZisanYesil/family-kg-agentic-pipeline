@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Hospital_Massacre a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Boaz_Davidson ;
    ex:hasDirector entity:Boaz_Davidson .

entity:Searching_for_Monica a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:José_María_Forqué ;
    ex:hasDirector entity:José_María_Forqué .

entity:Boaz_Davidson a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1943-11-08"^^xsd:date .

entity:José_María_Forqué a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1923-03-08"^^xsd:date .

