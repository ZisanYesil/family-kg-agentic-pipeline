@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_hospital_massacre a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Hospital Massacre" ;
    onto:hasDirector data:person_boaz_davidson .

data:film_searching_for_monica a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Searching for Monica" ;
    onto:hasDirector data:person_jose_maria_forque ;
    skos:altLabel "Buscando a Mónica" .

data:person_boaz_davidson a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Boaz Davidson" ;
    onto:hasBirthDate "1943-11-08"^^xsd:date .

data:person_jose_maria_forque a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "José María Forqué" ;
    onto:hasBirthDate "1923-03-08"^^xsd:date ;
    skos:altLabel "José María Forqué Galindo" .

