@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:la_marca_de_satanas a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "La Marca de Satanás" ;
    onto:hasPublicationDate "1957"^^xsd:gYear .

data:sofias_last_ambulance a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Sofia's Last Ambulance" ;
    onto:hasPublicationDate "2012"^^xsd:gYear .

