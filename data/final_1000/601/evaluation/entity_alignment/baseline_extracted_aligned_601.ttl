@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Japan_Coast_Guard_Museum_Yokohama> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Japan Coast Guard Museum Yokohama" ;
    onto:hasInception "2004-12-10"^^xsd:date .

<http://example.org/entity/Tain_District_Museum> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Tain & District Museum" ;
    onto:hasInception "1966"^^xsd:gYear .

