@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:japan_coast_guard_museum_yokohama a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Japan Coast Guard Museum Yokohama" ;
    onto:hasInception "2004-12-10"^^xsd:date .

data:tain_district_museum a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Tain & District Museum" ;
    onto:hasInception "1966"^^xsd:gYear .

