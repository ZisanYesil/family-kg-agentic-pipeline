@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:fabia_eudokia a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Fabia Eudokia" ;
    onto:hasSpouse data:heraclius ;
    skos:altLabel "Fabia" .

data:theodore a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Theodore" ;
    onto:hasBrother data:heraclius .

data:heraclius a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Heraclius" .

