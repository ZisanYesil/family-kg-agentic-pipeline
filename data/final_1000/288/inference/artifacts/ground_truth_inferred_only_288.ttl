@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Theodore a ex:Agent,
        ex:Person ;
    ex:hasSibling entity:Heraclius .

entity:Eudokia a ex:Agent,
        ex:Person .

entity:Heraclius a ex:Agent,
        ex:Person ;
