@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/The_Seagull> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Michael_Mayer> ;
    ex:hasDirector <http://example.org/entity/Michael_Mayer> .

<http://example.org/entity/Tony_Award_for_Best_Direction_of_a_Musical> a ex:Award .

<http://example.org/entity/Michael_Mayer> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/entity/Tony_Award_for_Best_Direction_of_a_Musical> .

