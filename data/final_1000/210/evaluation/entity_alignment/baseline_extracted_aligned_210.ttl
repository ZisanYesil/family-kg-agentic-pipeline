@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/The_Seagull> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Seagull (2018 film)" ;
    onto:hasDirector <http://example.org/entity/Michael_Mayer> .

<http://example.org/entity/Michael_Mayer> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Michael Mayer" ;
    onto:hasAwardReceived <http://example.org/entity/Tony_Award_for_Best_Direction_of_a_Musical> .

<http://example.org/entity/Tony_Award_for_Best_Direction_of_a_Musical> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Tony Award for Best Direction of a Musical" .

