@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Seagull a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Michael_Mayer ;
    ex:hasDirector entity:Michael_Mayer .

entity:Tony_Award_for_Best_Direction_of_a_Musical a ex:Award .

entity:Michael_Mayer a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived entity:Tony_Award_for_Best_Direction_of_a_Musical .

