@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Bilthoven> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Bilthoven" ;
    onto:hasCountry <http://example.org/entity/Dutch> .

<http://example.org/entity/Herveld> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Herveld" ;
    onto:hasCountry <http://example.org/entity/Dutch> .

<http://example.org/entity/Dutch> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Netherlands" ;
    skos:altLabel "Dutch" .

