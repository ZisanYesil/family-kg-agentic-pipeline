@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:otto_i_guelders a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Otto I of Guelders" ;
    onto:hasSpouse data:richardis_of_bavaria ;
    skos:altLabel "Otto I, Count of Guelders" .

data:kelheim a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Kelheim" .

data:richardis_of_bavaria a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Richardis of Bavaria" ;
    onto:hasBirthPlace data:kelheim .

