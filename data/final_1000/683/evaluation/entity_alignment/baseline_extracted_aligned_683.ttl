@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Alfons_Zitterbacke> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Alfons Zitterbacke" ;
    onto:hasCountryOfOrigin data:country_east_germany .

<http://example.org/entity/The_Almighty_Dollar_1923_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Almighty Dollar (1923 film)" ;
    onto:hasCountryOfOrigin <http://example.org/entity/German> .

<http://example.org/entity/German> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Germany" ;
    skos:altLabel "German" .

data:country_east_germany a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "East Germany" ;
    skos:altLabel "East German" .

