@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Sheykhian_Mari> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Sheykhian Mari" ;
    onto:hasCountry <http://example.org/entity/Iran> ;
    skos:altLabel "Sheykheyān",
        "Sheykhīyan",
        "Sheykhīān" .

<http://example.org/entity/Surog_Charmil> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Surog Charmil" ;
    onto:hasCountry <http://example.org/entity/Iran> ;
    skos:altLabel "Sūrog",
        "Sūrog Charmīl" .

<http://example.org/entity/Iran> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Iran" .

