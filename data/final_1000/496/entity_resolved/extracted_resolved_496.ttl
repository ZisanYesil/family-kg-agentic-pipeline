@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:sheykhian_mari a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Sheykhian Mari" ;
    onto:hasCountry data:iran ;
    skos:altLabel "Sheykheyān",
        "Sheykhīyan",
        "Sheykhīān" .

data:surog_charmil a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Surog Charmil" ;
    onto:hasCountry data:iran ;
    skos:altLabel "Sūrog",
        "Sūrog Charmīl" .

data:iran a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Iran" .

