@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Por_una_Cabeza> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Por una Cabeza" ;
    onto:hasComposer <http://example.org/entity/Carlos_Gardel> .

<http://example.org/entity/Argentine> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Argentina" ;
    skos:altLabel "Argentine" .

<http://example.org/entity/Carlos_Gardel> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Carlos Gardel" ;
    onto:hasNationality <http://example.org/entity/Argentine>,
        data:country_france ;
    skos:altLabel "Carlos Gardel" .

data:country_france a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

