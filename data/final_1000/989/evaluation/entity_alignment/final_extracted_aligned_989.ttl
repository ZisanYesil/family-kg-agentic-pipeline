@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Por_una_Cabeza> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasComposer <http://example.org/entity/Carlos_Gardel> ;
    ex:hasCreator <http://example.org/entity/Carlos_Gardel> .

<http://example.org/entity/Argentine> a ex:Country,
        ex:Place .

<http://example.org/entity/Carlos_Gardel> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Argentine>,
        <http://example.org/extracted/country_france> ;
    ex:hasNationality <http://example.org/entity/Argentine>,
        <http://example.org/extracted/country_france> .

<http://example.org/extracted/country_france> a ex:Country,
        ex:Place .

