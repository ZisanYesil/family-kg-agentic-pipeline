@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Por_una_Cabeza a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Carlos_Gardel .

entity:Argentine a ex:Country,
        ex:Place .

entity:Carlos_Gardel a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:Argentine .

