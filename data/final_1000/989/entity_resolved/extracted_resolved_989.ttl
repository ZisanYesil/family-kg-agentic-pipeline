@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:musicalwork_por_una_cabeza a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Por una Cabeza" ;
    onto:hasComposer data:person_carlos_gardel .

data:country_argentina a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Argentina" ;
    skos:altLabel "Argentine" .

data:country_france a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    skos:altLabel "French" .

data:person_carlos_gardel a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Carlos Gardel" ;
    onto:hasNationality data:country_argentina,
        data:country_france ;
    skos:altLabel "Carlos Gardel" .

