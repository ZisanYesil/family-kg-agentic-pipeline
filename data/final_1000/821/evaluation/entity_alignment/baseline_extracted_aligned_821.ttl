@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Harald_III_of_Denmark> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Harald III of Denmark" ;
    onto:hasSpouse <http://example.org/entity/Margareta_Hasbjörnsdatter> ;
    skos:altLabel "Harald III",
        "Harald the Whetstone" .

<http://example.org/entity/Margareta_Hasbjörnsdatter> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Margareta Hasbjørnsdatter" ;
    onto:hasBurialPlace <http://example.org/entity/Roskilde_Cathedral> ;
    skos:altLabel "Estrid",
        "Margareta Asbjørnsdatter" .

<http://example.org/entity/Roskilde_Cathedral> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Roskilde Cathedral" .

