@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Olivier_Long a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1915-10-11"^^xsd:date ;
    ex:hasDeathDate "2003-03-19"^^xsd:date .

