@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:olivier_long a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Olivier Long" ;
    onto:hasBirthDate "1915-10-11"^^xsd:date ;
    onto:hasDeathDate "2003-03-19"^^xsd:date .

data:robert_ernest_cheesman a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Robert Ernest Cheesman" ;
    onto:hasBirthDate "1878"^^xsd:gYear ;
    onto:hasDeathDate "1962-02-13"^^xsd:date .

