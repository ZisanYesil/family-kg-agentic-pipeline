@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Olivier_Long> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1915-10-11"^^xsd:date ;
    ex:hasDeathDate "2003-03-19"^^xsd:date .

<http://example.org/entity/Robert_Ernest_Cheesman> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1878"^^xsd:gYear ;
    ex:hasDeathDate "1962-02-13"^^xsd:date .

