@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Olivier_Long> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Olivier Long" ;
    onto:hasBirthDate "1915-10-11"^^xsd:date ;
    onto:hasDeathDate "2003-03-19"^^xsd:date .

<http://example.org/entity/Robert_Ernest_Cheesman> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Robert Ernest Cheesman" ;
    onto:hasBirthDate "1878"^^xsd:gYear ;
    onto:hasDeathDate "1962-02-13"^^xsd:date .

