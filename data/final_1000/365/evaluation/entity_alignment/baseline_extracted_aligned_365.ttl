@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Capetinga_River> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Capetinga River" ;
    onto:hasCountry <http://example.org/entity/Brazil> .

<http://example.org/entity/Jabiberi_River> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Jabiberi River" ;
    onto:hasCountry <http://example.org/entity/Brazil> .

<http://example.org/entity/Brazil> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Brazil" .

