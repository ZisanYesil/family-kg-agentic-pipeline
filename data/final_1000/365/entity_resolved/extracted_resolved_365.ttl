@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:capetinga_river a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Capetinga River" ;
    onto:hasCountry data:brazil .

data:jabiberi_river a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Jabiberi River" ;
    onto:hasCountry data:brazil .

data:brazil a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Brazil" .

