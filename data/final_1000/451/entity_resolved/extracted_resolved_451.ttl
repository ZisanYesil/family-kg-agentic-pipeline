@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:humagun_anmogaldi a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Huma Gun Anmogaldi" ;
    onto:hasPublicationDate "1942"^^xsd:gYear .

data:this_night_is_still_ours a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "This Night Is Still Ours" ;
    onto:hasPublicationDate "2008"^^xsd:gYear .

