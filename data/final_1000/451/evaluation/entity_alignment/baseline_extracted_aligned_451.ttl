@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Huma_Gun_Anmogaldi> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Huma Gun Anmogaldi" ;
    onto:hasPublicationDate "1942"^^xsd:gYear .

<http://example.org/entity/This_Night_Is_Still_Ours> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "This Night Is Still Ours" ;
    onto:hasPublicationDate "2008"^^xsd:gYear .

