@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:katanda a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Katanda" ;
    onto:hasCountry data:russia .

data:novochesnokovo a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Novochesnokovo" ;
    onto:hasCountry data:russia .

data:russia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Russia" .

