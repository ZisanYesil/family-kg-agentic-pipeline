@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:chou_meng_tieh a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Chou Meng-Tieh" ;
    onto:hasBirthDate "1921-12-29"^^xsd:date ;
    onto:hasDeathDate "2014-05-01"^^xsd:date .

data:fredy_schmidtke a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Fredy Schmidtke" ;
    onto:hasBirthDate "1961-07-01"^^xsd:date ;
    onto:hasDeathDate "2017-12-01"^^xsd:date .

