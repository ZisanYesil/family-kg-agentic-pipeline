@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Love a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:John_Lennon ;
    ex:hasPerformer entity:John_Lennon .

entity:Liverpool a ex:Place .

entity:John_Lennon a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Liverpool .

