@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Love> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/John_Lennon> ;
    ex:hasPerformer <http://example.org/entity/John_Lennon> .

<http://example.org/entity/Liverpool> a ex:Place .

<http://example.org/entity/John_Lennon> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Liverpool> .

