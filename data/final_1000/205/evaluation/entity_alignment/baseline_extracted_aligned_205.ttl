@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Love> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Love (John Lennon song)" ;
    onto:hasPerformer <http://example.org/entity/John_Lennon> ;
    skos:altLabel "Love" .

<http://example.org/entity/John_Lennon> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Lennon" ;
    onto:hasBirthPlace <http://example.org/entity/Liverpool> ;
    skos:altLabel "John Winston Ono Lennon" .

<http://example.org/entity/Liverpool> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Liverpool" .

