@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Campbell_Stephen> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Dorothy_Jewson> .

<http://example.org/entity/Dorothy_Jewson> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/Girton_College_Cambridge> ;
    ex:hasSpouse <http://example.org/entity/Campbell_Stephen> .

<http://example.org/entity/Girton_College_Cambridge> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

