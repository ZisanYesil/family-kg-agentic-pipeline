@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:eleonora_luisa_gonzaga a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Eleonora Luisa Gonzaga" ;
    onto:hasFather data:vincenzo_gonzaga .

data:andrea_gonzaga a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Andrea Gonzaga" ;
    skos:altLabel "Andrea Gonzaga, Count of San Paolo" .

data:vincenzo_gonzaga a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Vincenzo Gonzaga" ;
    onto:hasFather data:andrea_gonzaga ;
    skos:altLabel "Vincenzo Gonzaga, Duke of Guastalla" .

