@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:magnus_ii_brunswick_luneburg a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Magnus II, Duke of Brunswick-Lüneburg" ;
    onto:hasDaughter data:catherine_elisabeth_brunswick_luneburg .

data:catherine_elisabeth_brunswick_luneburg a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Catherine Elisabeth of Brunswick-Lüneburg" ;
    onto:hasDaughter data:helvig_of_schauenburg .

data:helvig_of_schauenburg a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Helvig of Schauenburg" .

