@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Magnus_II_Duke_of_Brunswick_Lüneburg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Magnus II, Duke of Brunswick-Lüneburg" ;
    onto:hasDaughter <http://example.org/entity/Catherine_Elisabeth_of_Brunswick_Lüneburg> .

<http://example.org/entity/Catherine_Elisabeth_of_Brunswick_Lüneburg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Catherine Elisabeth of Brunswick-Lüneburg" ;
    onto:hasDaughter <http://example.org/entity/Helvig_of_Schauenburg> .

<http://example.org/entity/Helvig_of_Schauenburg> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Helvig of Schauenburg" .

