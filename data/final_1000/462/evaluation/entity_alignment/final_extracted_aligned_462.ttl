@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Hong_Ra_hee> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Lee_Kun_hee> .

<http://example.org/entity/Lee_Byung_chul> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Lee_Kun_hee> ;
    ex:hasSon <http://example.org/entity/Lee_Kun_hee> .

<http://example.org/entity/Lee_Kun_hee> a ex:Agent,
        ex:Person ;
    ex:hasParent <http://example.org/entity/Lee_Byung_chul> ;
    ex:hasSpouse <http://example.org/entity/Hong_Ra_hee> ;
    ex:isSonOf <http://example.org/entity/Lee_Byung_chul> .

