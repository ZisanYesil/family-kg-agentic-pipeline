@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Hong_Ra_hee> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hong Ra-hee" ;
    onto:hasSpouse <http://example.org/entity/Lee_Kun_hee> .

<http://example.org/entity/Lee_Byung_chul> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lee Byung-chul" ;
    onto:hasSon <http://example.org/entity/Lee_Kun_hee> .

<http://example.org/entity/Lee_Kun_hee> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lee Kun-hee" .

