@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:hong_ra_hee a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hong Ra-hee" ;
    onto:hasSpouse data:lee_kun_hee .

data:lee_byung_chul a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lee Byung-chul" ;
    onto:hasSon data:lee_kun_hee .

data:lee_kun_hee a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lee Kun-hee" .

