@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Andrzeja_Górska> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1917-02-02"^^xsd:date ;
    ex:hasDeathDate "2007-12-15"^^xsd:date .

<http://example.org/entity/John_Chilton> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1932-07-16"^^xsd:date ;
    ex:hasDeathDate "2016-02-25"^^xsd:date .

