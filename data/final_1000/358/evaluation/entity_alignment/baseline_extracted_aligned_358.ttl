@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Andrzeja_Górska> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Andrzeja Górska" ;
    onto:hasBirthDate "1917-02-02"^^xsd:date ;
    onto:hasDeathDate "2007-12-15"^^xsd:date ;
    skos:altLabel "Andrzeja Górska",
        "Maria Stefania Górska" .

<http://example.org/entity/John_Chilton> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Chilton" ;
    onto:hasBirthDate "1932-07-16"^^xsd:date ;
    onto:hasDeathDate "2016-02-25"^^xsd:date ;
    skos:altLabel "John Chilton",
        "John James Chilton" .

