@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_long_arm_of_the_godfather a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Long Arm of the Godfather" ;
    onto:hasPublicationDate "1972"^^xsd:gYear .

data:film_virineya a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Virineya" ;
    onto:hasPublicationDate "1968"^^xsd:gYear .

