@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Long_Arm_of_the_Godfather> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Long Arm of the Godfather" ;
    onto:hasPublicationDate "1972"^^xsd:gYear .

<http://example.org/entity/Virineya> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Virineya" ;
    onto:hasPublicationDate "1968"^^xsd:gYear .

