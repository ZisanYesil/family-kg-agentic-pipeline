@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Mariamne> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Herod_Agrippa> ;
    ex:hasParent <http://example.org/entity/Herod_Agrippa> .

<http://example.org/entity/Aristobulus_IV> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Herod_Agrippa> .

<http://example.org/entity/Herod_Agrippa> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Mariamne> ;
    ex:hasFather <http://example.org/entity/Aristobulus_IV> ;
    ex:hasParent <http://example.org/entity/Aristobulus_IV> .

