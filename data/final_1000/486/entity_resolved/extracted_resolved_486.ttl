@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:bianca_riario a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bianca Riario" ;
    onto:hasMother data:caterina_sforza .

data:caterina_sforza a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Caterina Sforza" ;
    onto:hasFather data:galeazzo_maria_sforza .

data:galeazzo_maria_sforza a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Galeazzo Maria Sforza" .

