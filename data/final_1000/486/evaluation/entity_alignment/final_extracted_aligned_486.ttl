@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Bianca_Riario> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Caterina_Sforza> ;
    ex:hasParent <http://example.org/entity/Caterina_Sforza> .

<http://example.org/entity/Galeazzo_Maria_Sforza> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Caterina_Sforza> .

<http://example.org/entity/Caterina_Sforza> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Bianca_Riario> ;
    ex:hasFather <http://example.org/entity/Galeazzo_Maria_Sforza> ;
    ex:hasParent <http://example.org/entity/Galeazzo_Maria_Sforza> .

