@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Bianca_Riario> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bianca Riario" ;
    onto:hasMother <http://example.org/entity/Caterina_Sforza> .

<http://example.org/entity/Caterina_Sforza> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Caterina Sforza" ;
    onto:hasFather <http://example.org/entity/Galeazzo_Maria_Sforza> .

<http://example.org/entity/Galeazzo_Maria_Sforza> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Galeazzo Maria Sforza" .

