@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Bianca_Riario a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Caterina_Sforza .

entity:Galeazzo_Maria_Sforza a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Caterina_Sforza .

entity:Caterina_Sforza a ex:Agent,
        ex:Person ;
