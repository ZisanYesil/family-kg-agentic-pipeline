@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:the_next_list a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "The Next List" ;
    onto:hasPresenter data:sanjay_gupta .

data:cnn a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "CNN" .

data:sanjay_gupta a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sanjay Gupta" ;
    onto:hasEmployer data:cnn .

