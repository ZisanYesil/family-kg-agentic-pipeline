@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:The_Next_List a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPresenter entity:Sanjay_Gupta .

entity:Emory_University a ex:Agent,
        ex:Organization .

entity:Sanjay_Gupta a ex:Agent,
        ex:Person ;
    ex:hasEmployer entity:Emory_University .

