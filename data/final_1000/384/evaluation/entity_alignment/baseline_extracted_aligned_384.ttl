@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Princess_Anna_of_Saxony_1836_1859> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Princess Anna of Saxony (1836–1859)" ;
    onto:hasMother <http://example.org/entity/Amalie_Auguste_of_Bavaria> .

<http://example.org/entity/Amalie_Auguste_of_Bavaria> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Amalie Auguste of Bavaria" ;
    onto:hasBirthPlace <http://example.org/entity/Munich> .

<http://example.org/entity/Munich> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Munich" .

