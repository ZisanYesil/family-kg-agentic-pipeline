@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_butterfly_on_a_wheel> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/extracted/person_william_morrissey> .

<http://example.org/extracted/film_reach_the_rock> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/extracted/person_john_hughes> .

<http://example.org/extracted/person_john_hughes> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1950-02-18"^^xsd:date .

<http://example.org/extracted/person_william_morrissey> a ex:Agent,
        ex:Person .

