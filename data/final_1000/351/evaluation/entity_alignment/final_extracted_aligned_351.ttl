@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Butterfly_on_a_Wheel> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/extracted/person_william_morrissey> .

<http://example.org/entity/Reach_the_Rock> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/John_Hughes> .

<http://example.org/entity/John_Hughes> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1950-02-18"^^xsd:date .

<http://example.org/extracted/person_william_morrissey> a ex:Agent,
        ex:Person .

