@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Joseph_Boyer a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1848"^^xsd:gYear ;
    ex:hasDeathDate "1930-10-24"^^xsd:date .

entity:Max_Finkelstein a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1884-03-05"^^xsd:date ;
    ex:hasDeathDate "1940-05-03"^^xsd:date .

