@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:joseph_boyer_jr a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Joseph Boyer, Jr." ;
    onto:hasBirthDate "1890-05-30"^^xsd:date ;
    onto:hasDeathDate "1924-09-02"^^xsd:date ;
    skos:altLabel "Joe Boyer" .

data:max_finkelstein a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Max Finkelstein" ;
    onto:hasBirthDate "1884-03-05"^^xsd:date ;
    onto:hasDeathDate "1940-05-03"^^xsd:date .

