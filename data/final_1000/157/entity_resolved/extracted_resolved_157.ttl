@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:dias_de_ilusion_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Días de ilusión" ;
    onto:hasCountry data:argentina_country .

data:los_peores_del_barrio_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Los Peores del barrio" ;
    onto:hasCountry data:argentina_country .

data:argentina_country a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Argentina" ;
    skos:altLabel "Argentine" .

