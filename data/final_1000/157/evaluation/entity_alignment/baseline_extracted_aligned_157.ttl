@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Días_de_ilusión> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Días de ilusión" ;
    onto:hasCountry <http://example.org/entity/Argentine> .

<http://example.org/entity/Los_Peores_del_barrio> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Los Peores del barrio" ;
    onto:hasCountry <http://example.org/entity/Argentine> .

<http://example.org/entity/Argentine> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Argentina" ;
    skos:altLabel "Argentine" .

