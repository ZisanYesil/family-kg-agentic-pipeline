@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:One_Day_in_Europe a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Hannes_Stöhr ;
    ex:hasDirector entity:Hannes_Stöhr .

entity:Deutsche_Film_und_Fernsehakademie_Berlin a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Hannes_Stöhr a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt entity:Deutsche_Film_und_Fernsehakademie_Berlin .

