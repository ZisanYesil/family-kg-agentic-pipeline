@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/One_Day_in_Europe> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Hannes_Stöhr> ;
    ex:hasDirector <http://example.org/entity/Hannes_Stöhr> .

<http://example.org/entity/Deutsche_Film_und_Fernsehakademie_Berlin> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

<http://example.org/entity/Hannes_Stöhr> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/entity/Deutsche_Film_und_Fernsehakademie_Berlin> .

