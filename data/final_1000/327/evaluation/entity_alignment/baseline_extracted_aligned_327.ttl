@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Folly_to_Be_Wise> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Folly to Be Wise" ;
    onto:hasDirector <http://example.org/entity/Frank_Launder> .

<http://example.org/entity/Bernadette_O_Farrell> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bernadette O'Farrell" .

<http://example.org/entity/Frank_Launder> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Frank Launder" ;
    onto:hasSpouse <http://example.org/entity/Bernadette_O_Farrell> .

