@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:folly_to_be_wise_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Folly to Be Wise" ;
    onto:hasDirector data:frank_launder .

data:bernadette_ofarrell a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Bernadette O'Farrell" .

data:frank_launder a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Frank Launder" ;
    onto:hasSpouse data:bernadette_ofarrell .

