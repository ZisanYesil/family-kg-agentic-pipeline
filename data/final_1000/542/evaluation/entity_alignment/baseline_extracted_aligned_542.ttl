@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Inthasom> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Chao Inthasom" ;
    onto:hasBrother <http://example.org/entity/Kingkitsarat> ;
    onto:hasSon <http://example.org/entity/Anurutha> .

<http://example.org/entity/Anurutha> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Chao Anurutha" ;
    skos:altLabel "Anouruttha",
        "Anurathurat",
        "Anurutha" .

<http://example.org/entity/Kingkitsarat> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Kingkitsarat" .

