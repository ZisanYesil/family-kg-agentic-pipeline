@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Anaukpetlun a ex:Agent,
        ex:Person ;
    ex:hasSibling entity:Thalun .

entity:Pye_Min a ex:Agent,
        ex:Person ;
    ex:hasFather entity:Thalun ;
    ex:hasParent entity:Thalun .

entity:Thalun a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Pye_Min ;
    ex:hasSibling entity:Anaukpetlun .

