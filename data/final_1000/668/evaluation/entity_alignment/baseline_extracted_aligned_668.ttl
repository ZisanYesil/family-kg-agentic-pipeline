@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Franz_Schubert> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Franz Schubert" ;
    onto:hasStudentOf <http://example.org/entity/Antonio_Salieri> .

<http://example.org/entity/Prometheus> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Prometheus (art song)" .

<http://example.org/entity/Antonio_Salieri> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Antonio Salieri" .

