@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Prometheus> a ex:Artifact,
        ex:CreativeWork,
        ex:MusicalWork ;
    ex:hasComposer <http://example.org/entity/Franz_Schubert> ;
    ex:hasCreator <http://example.org/entity/Franz_Schubert> .

<http://example.org/entity/Antonio_Salieri> a ex:Agent,
        ex:Person .

<http://example.org/entity/Franz_Schubert> a ex:Agent,
        ex:Person ;
    ex:hasStudentOf <http://example.org/entity/Antonio_Salieri> .

