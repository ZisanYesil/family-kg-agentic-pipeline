@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Adolphe_de_Leuven a ex:Agent,
        ex:Person ;
    ex:hasFather entity:Adolph_Ribbing ;
    ex:hasParent entity:Adolph_Ribbing .

entity:Stockholm a ex:Place .

entity:Adolph_Ribbing a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Stockholm ;
    ex:hasChild entity:Adolphe_de_Leuven .

