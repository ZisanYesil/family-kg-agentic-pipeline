@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Adolphe_de_Leuven> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Adolph_Ribbing> ;
    ex:hasParent <http://example.org/entity/Adolph_Ribbing> .

<http://example.org/entity/Stockholm> a ex:Place .

<http://example.org/entity/Adolph_Ribbing> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Stockholm> ;
    ex:hasChild <http://example.org/entity/Adolphe_de_Leuven> .

