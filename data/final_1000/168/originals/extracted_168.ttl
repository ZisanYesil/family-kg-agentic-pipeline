@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_con_mi_mujer_no_puedo a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Con mi mujer no puedo" ;
    onto:hasPublicationDate "1978"^^xsd:gYear .

data:film_corridors_of_blood a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Corridors of Blood" ;
    onto:hasPublicationDate "1958"^^xsd:gYear .

