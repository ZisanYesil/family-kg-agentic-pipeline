@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Con_mi_mujer_no_puedo> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Con mi mujer no puedo" ;
    onto:hasPublicationDate "1978"^^xsd:gYear .

<http://example.org/entity/Corridors_of_Blood> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Corridors of Blood" ;
    onto:hasPublicationDate "1958"^^xsd:gYear .

