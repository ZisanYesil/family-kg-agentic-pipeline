@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Charles_Willoughby_10th_Baron_Willoughby_of_Parham> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Charles Willoughby, 10th Baron Willoughby of Parham" ;
    onto:hasFather <http://example.org/entity/William_Willoughby> .

<http://example.org/entity/Lady_Frances_Manners> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Frances Manners" .

<http://example.org/entity/William_Willoughby> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William Willoughby, 6th Baron Willoughby of Parham" ;
    onto:hasMother <http://example.org/entity/Lady_Frances_Manners> .

