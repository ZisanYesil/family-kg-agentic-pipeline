@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:American_Academy_of_Dramatic_Arts a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

entity:Louise_Tracy a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Spencer_Tracy .

entity:Spencer_Tracy a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt entity:American_Academy_of_Dramatic_Arts ;
    ex:hasSpouse entity:Louise_Tracy .

