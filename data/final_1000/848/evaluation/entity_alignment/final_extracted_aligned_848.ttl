@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Louise_Tracy> a ex:Agent,
        ex:Person ;
    ex:hasSpouse <http://example.org/entity/Spencer_Tracy> .

<http://example.org/entity/Spencer_Tracy> a ex:Agent,
        ex:Person ;
    ex:hasEducatedAt <http://example.org/extracted/ripon_college> ;
    ex:hasSpouse <http://example.org/entity/Louise_Tracy> .

<http://example.org/extracted/ripon_college> a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization .

