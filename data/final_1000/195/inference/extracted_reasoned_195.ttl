@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/mystery_plane> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/extracted/united_states> .

<http://example.org/extracted/to_kill_a_dragon> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/extracted/germany>,
        <http://example.org/extracted/soviet_union> .

<http://example.org/extracted/germany> a ex:Country,
        ex:Place .

<http://example.org/extracted/soviet_union> a ex:Country,
        ex:Place .

<http://example.org/extracted/united_states> a ex:Country,
        ex:Place .

