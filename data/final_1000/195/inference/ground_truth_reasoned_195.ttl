@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Mystery_Plane a ex:Artifact ;
    ex:hasCountry entity:American ;
    ex:hasCountryOfOrigin entity:American .

entity:To_Kill_a_Dragon a ex:Artifact ;
    ex:hasCountry entity:German,
        entity:Soviet ;
    ex:hasCountryOfOrigin entity:German,
        entity:Soviet .

entity:American a ex:Country,
        ex:Place .

entity:German a ex:Country,
        ex:Place .

entity:Soviet a ex:Country,
        ex:Place .

