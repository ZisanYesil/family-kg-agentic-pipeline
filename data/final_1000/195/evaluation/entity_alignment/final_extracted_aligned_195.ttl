@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Mystery_Plane> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/American> .

<http://example.org/entity/To_Kill_a_Dragon> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCountry <http://example.org/entity/German>,
        <http://example.org/entity/Soviet> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/German> a ex:Country,
        ex:Place .

<http://example.org/entity/Soviet> a ex:Country,
        ex:Place .

