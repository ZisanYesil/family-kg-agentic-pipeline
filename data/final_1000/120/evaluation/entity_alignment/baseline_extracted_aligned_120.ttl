@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Mahisente_Habte_Mariam> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mahisente Habte Mariam" ;
    onto:hasSpouse <http://example.org/entity/Prince_Sahle_Selassie> .

<http://example.org/entity/Menen_Asfaw> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Empress Menen Asfaw" .

<http://example.org/entity/Prince_Sahle_Selassie> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Prince Sahle Selassie" ;
    onto:hasMother <http://example.org/entity/Menen_Asfaw> .

