@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Karl_von_Habsburg a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:Austria ;
    ex:hasSpouse entity:Francesca_von_Habsburg .

