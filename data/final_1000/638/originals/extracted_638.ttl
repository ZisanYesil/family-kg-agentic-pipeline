@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:francesca_von_habsburg a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Francesca von Habsburg" ;
    onto:hasSpouse data:karl_von_habsburg .

data:austria a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Austria" ;
    skos:altLabel "Austrian" .

data:karl_von_habsburg a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Karl von Habsburg" ;
    onto:hasNationality data:austria .

