@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:attock_city_junction_railway_station a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Attock City Junction railway station" ;
    onto:hasCountry data:pakistan .

data:badah_railway_station a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Badah railway station" ;
    onto:hasCountry data:pakistan .

data:pakistan a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Pakistan" .

