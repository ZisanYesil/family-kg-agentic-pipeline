@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Attock_City_Junction_railway_station> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Attock City Junction railway station" ;
    onto:hasCountry <http://example.org/entity/Pakistan> .

<http://example.org/entity/Badah_railway_station> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Badah railway station" ;
    onto:hasCountry <http://example.org/entity/Pakistan> .

<http://example.org/entity/Pakistan> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Pakistan" .

