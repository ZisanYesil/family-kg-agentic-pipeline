@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Crime_in_the_Streets> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Crime In The Streets" ;
    onto:hasPublicationDate "1956"^^xsd:gYear .

<http://example.org/entity/The_Remains_of_Nothing> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Remains Of Nothing" ;
    onto:hasPublicationDate "2004"^^xsd:gYear .

