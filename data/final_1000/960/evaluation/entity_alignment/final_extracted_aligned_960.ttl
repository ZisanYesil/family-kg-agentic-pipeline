@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Crime_in_the_Streets> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasPublicationDate "1956"^^xsd:gYear .

<http://example.org/entity/The_Remains_of_Nothing> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasPublicationDate "2004"^^xsd:gYear .

