@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:crime_in_the_streets_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Crime In The Streets" ;
    onto:hasPublicationDate "1956"^^xsd:gYear .

data:the_remains_of_nothing_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Remains Of Nothing" ;
    onto:hasPublicationDate "2004"^^xsd:gYear .

