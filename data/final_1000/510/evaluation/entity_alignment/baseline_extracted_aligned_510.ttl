@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Antoine_Joseph_Jobert_de_Lamballe> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Antoine Joseph Jobert de Lamballe" ;
    onto:hasBirthDate "1799-12-17"^^xsd:date ;
    onto:hasDeathDate "1867-04-19"^^xsd:date .

<http://example.org/entity/James_Henry_Dickey_Henderson> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "James Henry Dickey Henderson" ;
    onto:hasBirthDate "1810-07-23"^^xsd:date ;
    onto:hasDeathDate "1885-12-13"^^xsd:date .

