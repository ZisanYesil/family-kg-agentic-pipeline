@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:David_Butler_director a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:American ;
    ex:hasCountry entity:American .

entity:It_s_a_Great_Feeling a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:David_Butler ;
    ex:hasDirector entity:David_Butler .

entity:Oklahoma_1999_film a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Trevor_Nunn ;
    ex:hasDirector entity:Trevor_Nunn .

entity:American a ex:Country,
        ex:Place .

entity:British a ex:Country,
        ex:Place .

entity:David_Butler a ex:Agent,
        ex:Person .

entity:Trevor_Nunn a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:British ;
    ex:hasCountry entity:British .

