@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/film_its_a_great_feeling> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_david_butler> ;
