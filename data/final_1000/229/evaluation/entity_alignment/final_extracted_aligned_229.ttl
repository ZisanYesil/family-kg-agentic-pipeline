@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/It_s_a_Great_Feeling> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/David_Butler> ;
    ex:hasDirector <http://example.org/entity/David_Butler> .

<http://example.org/entity/Oklahoma_1999_film> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Trevor_Nunn> ;
    ex:hasDirector <http://example.org/entity/Trevor_Nunn> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/British> a ex:Country,
        ex:Place .

<http://example.org/entity/David_Butler> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/American> ;
    ex:hasNationality <http://example.org/entity/American> .

<http://example.org/entity/Trevor_Nunn> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/British> ;
    ex:hasNationality <http://example.org/entity/British> .

