@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Heart_Attack a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Enrique_Iglesias .

entity:Enrique_Iglesias a ex:Agent,
        ex:Person ;
    ex:hasCountry entity:Spanish .

entity:Spanish a ex:Country,
        ex:Place .

