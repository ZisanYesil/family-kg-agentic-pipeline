@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/song_heart_attack> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/extracted/performer_enrique_iglesias> ;
    ex:hasPerformer <http://example.org/extracted/performer_enrique_iglesias> .

<http://example.org/extracted/country_philippines> a ex:Country,
        ex:Place .

<http://example.org/extracted/country_spain> a ex:Country,
        ex:Place .

<http://example.org/extracted/performer_enrique_iglesias> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/extracted/country_philippines>,
        <http://example.org/extracted/country_spain> ;
    ex:hasNationality <http://example.org/extracted/country_philippines>,
        <http://example.org/extracted/country_spain> .

