@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Heart_Attack> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Enrique_Iglesias> ;
    ex:hasPerformer <http://example.org/entity/Enrique_Iglesias> .

<http://example.org/entity/Enrique_Iglesias> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Spanish>,
        <http://example.org/extracted/country_philippines> ;
    ex:hasNationality <http://example.org/entity/Spanish>,
        <http://example.org/extracted/country_philippines> .

<http://example.org/entity/Spanish> a ex:Country,
        ex:Place .

<http://example.org/extracted/country_philippines> a ex:Country,
        ex:Place .

