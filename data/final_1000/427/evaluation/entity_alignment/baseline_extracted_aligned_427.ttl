@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Heart_Attack> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Heart Attack (Enrique Iglesias song)" ;
    onto:hasPerformer <http://example.org/entity/Enrique_Iglesias> .

<http://example.org/entity/Enrique_Iglesias> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Enrique Iglesias" ;
    onto:hasNationality <http://example.org/entity/Spanish>,
        data:country_philippines .

<http://example.org/entity/Spanish> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Spain" ;
    skos:altLabel "Spanish" .

data:country_philippines a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Philippines" ;
    skos:altLabel "Filipino" .

