@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/god_song> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/extracted/john_lennon> ;
    ex:hasPerformer <http://example.org/extracted/john_lennon> .

<http://example.org/extracted/liverpool> a ex:Place .

<http://example.org/extracted/john_lennon> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/extracted/liverpool> .

