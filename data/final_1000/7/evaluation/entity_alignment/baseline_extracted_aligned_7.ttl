@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/God> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "God" ;
    onto:hasPerformer <http://example.org/entity/John_Lennon> .

<http://example.org/entity/John_Lennon> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Lennon" ;
    onto:hasBirthPlace <http://example.org/entity/Liverpool> .

<http://example.org/entity/Liverpool> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Liverpool" .

