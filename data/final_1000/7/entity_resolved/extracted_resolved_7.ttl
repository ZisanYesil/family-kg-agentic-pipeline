@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:god_song a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "God" ;
    onto:hasPerformer data:john_lennon .

data:john_lennon a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Lennon" ;
    onto:hasBirthPlace data:liverpool .

data:liverpool a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Liverpool" .

