@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Daddy_Come_Home> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Daddy, Come Home" ;
    onto:hasPerformer <http://example.org/entity/Billy_Murray> .

<http://example.org/entity/Billy_Murray> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Billy Murray" ;
    onto:hasNationality <http://example.org/entity/United_States> ;
    skos:altLabel "William Thomas \"Billy\" Murray" .

<http://example.org/entity/United_States> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

