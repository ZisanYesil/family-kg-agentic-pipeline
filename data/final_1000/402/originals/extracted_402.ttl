@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:basilica_st_lucia_timotes a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Basilica of St. Lucia, Timotes" ;
    onto:hasCountry data:venezuela .

data:saint_augustine_by_the_sea a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Saint Augustine by the Sea Catholic Church" ;
    onto:hasCountry data:united_states .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "United States" .

data:venezuela a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Venezuela" ;
    skos:altLabel "Venezuela" .

