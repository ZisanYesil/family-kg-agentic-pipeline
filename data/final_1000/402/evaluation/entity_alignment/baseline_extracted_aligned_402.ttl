@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Basilica_of_St_Lucia_Timotes> a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Basilica of St. Lucia, Timotes" ;
    onto:hasCountry <http://example.org/entity/Venezuela> .

<http://example.org/entity/Saint_Augustine_by_the_Sea_Catholic_Church> a onto:Artifact,
        owl:NamedIndividual ;
    rdfs:label "Saint Augustine by the Sea Catholic Church" ;
    onto:hasCountry <http://example.org/entity/United_States> .

<http://example.org/entity/United_States> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "United States" .

<http://example.org/entity/Venezuela> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Venezuela" ;
    skos:altLabel "Venezuela" .

