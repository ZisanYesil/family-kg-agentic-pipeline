@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:little_papa_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Little Papa" ;
    onto:hasDirector data:gus_meins .

data:germany a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Germany" ;
    skos:altLabel "German" .

data:gus_meins a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gus Meins" ;
    onto:hasNationality data:germany,
        data:united_states .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

