@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Little_Papa> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Little Papa" ;
    onto:hasDirector <http://example.org/entity/Gus_Meins> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

<http://example.org/entity/Gus_Meins> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gus Meins" ;
    onto:hasNationality <http://example.org/entity/American>,
        data:germany .

data:germany a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Germany" ;
    skos:altLabel "German" .

