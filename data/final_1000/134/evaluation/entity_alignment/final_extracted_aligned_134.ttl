@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Little_Papa> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Gus_Meins> ;
    ex:hasDirector <http://example.org/entity/Gus_Meins> .

<http://example.org/entity/American> a ex:Country,
        ex:Place .

<http://example.org/entity/Gus_Meins> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/American>,
        <http://example.org/extracted/germany> ;
    ex:hasNationality <http://example.org/entity/American>,
        <http://example.org/extracted/germany> .

<http://example.org/extracted/germany> a ex:Country,
        ex:Place .

