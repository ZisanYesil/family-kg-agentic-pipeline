@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/The_Trap> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Trap (1959 film)" ;
    onto:hasDirector <http://example.org/entity/Norman_Panama> .

<http://example.org/entity/Norman_Panama> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Norman Panama" ;
    onto:hasCauseOfDeath <http://example.org/entity/Parkinson> .

<http://example.org/entity/Parkinson> a onto:CauseOfDeath,
        owl:NamedIndividual ;
    rdfs:label "complications of Parkinson's disease" .

