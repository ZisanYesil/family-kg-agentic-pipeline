@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Ambition> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/James_Vincent> ;
    ex:hasDirector <http://example.org/entity/James_Vincent> .

<http://example.org/entity/New_York> a ex:Place .

<http://example.org/entity/James_Vincent> a ex:Agent,
        ex:Person ;
    ex:hasDeathPlace <http://example.org/entity/New_York> .

