@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/XYZ> a ex:Agent,
        ex:Organization ;
    ex:hasMember <http://example.org/entity/Chris_Squire> .

<http://example.org/entity/Chris_Squire> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Kingsbury_London> .

<http://example.org/entity/Kingsbury_London> a ex:Place .

