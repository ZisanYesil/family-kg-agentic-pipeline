@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:XYZ a ex:Agent,
        ex:Organization ;
    ex:hasMember entity:Chris_Squire .

entity:Chris_Squire a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Kingsbury_London .

entity:Kingsbury_London a ex:Place .

