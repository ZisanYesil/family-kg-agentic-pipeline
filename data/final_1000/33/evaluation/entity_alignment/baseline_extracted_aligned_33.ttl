@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/XYZ> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "XYZ" ;
    onto:hasMember <http://example.org/entity/Chris_Squire> ;
    skos:altLabel "XYZ (English band)" .

<http://example.org/entity/Chris_Squire> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Chris Squire" ;
    onto:hasBirthPlace <http://example.org/entity/Kingsbury_London> ;
    skos:altLabel "Christopher Russell Edward Squire" .

<http://example.org/entity/Kingsbury_London> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Kingsbury, London" .

