@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Abla_Ki_Shakti> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Abla Ki Shakti" ;
    onto:hasPublicationDate "1940"^^xsd:gYear .

<http://example.org/entity/L_affittacamere> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "L'affittacamere" ;
    onto:hasPublicationDate "1976"^^xsd:gYear .

