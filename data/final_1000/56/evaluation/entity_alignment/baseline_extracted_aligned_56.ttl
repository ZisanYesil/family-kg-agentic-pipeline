@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/In_My_Mind> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "In My Mind (Heather Headley song)" ;
    onto:hasPerformer <http://example.org/entity/Heather_Headley> .

<http://example.org/entity/Heather_Headley> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Heather Headley" ;
    onto:hasAwardReceived <http://example.org/entity/Tony_Award_for_Best_Actress_in_a_Musical> .

<http://example.org/entity/Tony_Award_for_Best_Actress_in_a_Musical> a onto:Award,
        owl:NamedIndividual ;
    rdfs:label "Tony Award for Best Actress in a Musical" .

