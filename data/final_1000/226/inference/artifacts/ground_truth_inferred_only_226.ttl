@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Gunhild_of_Wenden a ex:Agent,
        ex:Person ;
    ex:hasChild entity:Harald_II_of_Denmark ;
    ex:hasCountry entity:Polish .

entity:Harald_II_of_Denmark a ex:Agent,
        ex:Person ;
    ex:hasParent entity:Gunhild_of_Wenden .

entity:Polish a ex:Country,
        ex:Place .

