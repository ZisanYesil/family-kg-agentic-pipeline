@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Harald_II_of_Denmark> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Gunhild_of_Wenden> ;
    ex:hasParent <http://example.org/entity/Gunhild_of_Wenden> .

<http://example.org/entity/Gunhild_of_Wenden> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Harald_II_of_Denmark> ;
    ex:hasCountry <http://example.org/entity/Polish> ;
    ex:hasNationality <http://example.org/entity/Polish> .

<http://example.org/entity/Polish> a ex:Country,
        ex:Place .

