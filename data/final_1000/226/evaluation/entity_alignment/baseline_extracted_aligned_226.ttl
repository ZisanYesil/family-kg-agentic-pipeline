@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Harald_II_of_Denmark> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Harald II of Denmark" ;
    onto:hasMother <http://example.org/entity/Gunhild_of_Wenden> .

<http://example.org/entity/Gunhild_of_Wenden> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gunhild of Wenden" ;
    onto:hasNationality <http://example.org/entity/Polish> ;
    skos:altLabel "Gunhilda of Wenden" .

<http://example.org/entity/Polish> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Poland" ;
    skos:altLabel "Polish" .

