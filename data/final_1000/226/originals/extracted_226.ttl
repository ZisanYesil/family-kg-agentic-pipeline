@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:harald_ii_of_denmark a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Harald II of Denmark" ;
    onto:hasMother data:gunhild_of_wenden .

data:gunhild_of_wenden a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gunhild of Wenden" ;
    onto:hasNationality data:poland ;
    skos:altLabel "Gunhilda of Wenden" .

data:poland a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Poland" ;
    skos:altLabel "Polish" .

