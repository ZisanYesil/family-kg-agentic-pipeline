@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Cage_of_Gold> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Basil_Dearden> ;
    ex:hasDirector <http://example.org/entity/Basil_Dearden> .

<http://example.org/entity/Face_of_a_Fugitive> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Paul_Wendkos> ;
    ex:hasDirector <http://example.org/entity/Paul_Wendkos> .

<http://example.org/entity/Basil_Dearden> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1971-03-23"^^xsd:date .

<http://example.org/entity/Paul_Wendkos> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2009-11-12"^^xsd:date .

