@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Cage_of_Gold> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Cage of Gold" ;
    onto:hasDirector <http://example.org/entity/Basil_Dearden> .

<http://example.org/entity/Face_of_a_Fugitive> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Face of a Fugitive" ;
    onto:hasDirector <http://example.org/entity/Paul_Wendkos> .

<http://example.org/entity/Basil_Dearden> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Basil Dearden" ;
    onto:hasDeathDate "1971-03-23"^^xsd:date .

<http://example.org/entity/Paul_Wendkos> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Paul Wendkos" ;
    onto:hasDeathDate "2009-11-12"^^xsd:date .

