@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_cage_of_gold> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_basil_dearden> ;
    ex:hasDirector <http://example.org/extracted/person_basil_dearden> .

<http://example.org/extracted/film_face_of_a_fugitive> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_paul_wendkos> ;
    ex:hasDirector <http://example.org/extracted/person_paul_wendkos> .

<http://example.org/extracted/person_basil_dearden> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1971-03-23"^^xsd:date .

<http://example.org/extracted/person_paul_wendkos> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2009-11-12"^^xsd:date .

