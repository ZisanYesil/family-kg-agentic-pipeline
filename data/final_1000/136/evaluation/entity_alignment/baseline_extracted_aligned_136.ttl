@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Dekha_Pyar_Tumhara> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Dekha Pyar Tumhara" ;
    onto:hasPublicationDate "1985"^^xsd:gYear .

<http://example.org/entity/Lucky_Journey> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Lucky Journey" ;
    onto:hasPublicationDate "1947"^^xsd:gYear .

