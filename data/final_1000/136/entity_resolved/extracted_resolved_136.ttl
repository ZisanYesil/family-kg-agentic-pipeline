@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:dekha_pyar_tumhara a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Dekha Pyar Tumhara" ;
    onto:hasPublicationDate "1985"^^xsd:gYear .

data:lucky_journey a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Lucky Journey" ;
    onto:hasPublicationDate "1947"^^xsd:gYear .

