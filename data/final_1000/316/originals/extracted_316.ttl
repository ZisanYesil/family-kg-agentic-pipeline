@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:hollywood_shuffle_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Hollywood Shuffle" ;
    onto:hasPublicationDate "1987"^^xsd:gYear ;
    skos:altLabel "Hollywood Shuffle" .

data:thelma_louise_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Thelma & Louise" ;
    onto:hasPublicationDate "1991"^^xsd:gYear ;
    skos:altLabel "Thelma & Louise" .

