@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:investors_chronicle a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Investors Chronicle" ;
    onto:hasPublicationDate "1860"^^xsd:gYear .

data:the_new_american a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "The New American" ;
    onto:hasPublicationDate "1985"^^xsd:gYear .

