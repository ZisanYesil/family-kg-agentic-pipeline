@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Investors_Chronicle a ex:Agent,
        ex:Organization ;
    ex:hasInception "1860"^^xsd:gYear .

entity:The_New_American a ex:Agent,
        ex:Organization ;
    ex:hasInception "1985"^^xsd:gYear .

