@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:ernst_dullberg a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ernst Düllberg" ;
    onto:hasBirthDate "1913-03-28"^^xsd:date ;
    onto:hasDeathDate "1984-07-27"^^xsd:date .

data:louis_antoine_ranvier a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Louis-Antoine Ranvier" ;
    onto:hasBirthDate "1835-10-02"^^xsd:date ;
    onto:hasDeathDate "1922-03-22"^^xsd:date .

