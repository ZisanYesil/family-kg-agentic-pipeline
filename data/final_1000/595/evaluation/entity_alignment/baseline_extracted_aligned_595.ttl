@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Road_Tasted> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Road Tasted" ;
    onto:hasCreator <http://example.org/entity/Gordon_Elliott> .

<http://example.org/entity/Australian> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Australia" ;
    skos:altLabel "Australian" .

<http://example.org/entity/Gordon_Elliott> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gordon Elliott" ;
    onto:hasNationality <http://example.org/entity/Australian>,
        data:united_kingdom .

data:united_kingdom a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

