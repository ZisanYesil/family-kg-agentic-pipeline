@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Road_Tasted> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/entity/Gordon_Elliott> .

<http://example.org/entity/Gordon_Elliott> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Australian>,
        <http://example.org/extracted/united_kingdom> ;
    ex:hasNationality <http://example.org/entity/Australian>,
        <http://example.org/extracted/united_kingdom> .

<http://example.org/entity/Australian> a ex:Country,
        ex:Place .

<http://example.org/extracted/united_kingdom> a ex:Country,
        ex:Place .

