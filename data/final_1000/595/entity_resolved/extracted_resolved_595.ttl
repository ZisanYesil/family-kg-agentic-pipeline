@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:road_tasted a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Road Tasted" ;
    onto:hasCreator data:gordon_elliott .

data:australia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Australia" ;
    skos:altLabel "Australian" .

data:gordon_elliott a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gordon Elliott" ;
    onto:hasNationality data:australia,
        data:united_kingdom .

data:united_kingdom a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

