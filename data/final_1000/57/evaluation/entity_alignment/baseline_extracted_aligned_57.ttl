@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Giuseppe_Diotti> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Giuseppe Diotti" ;
    onto:hasBirthDate "1779-03-01"^^xsd:date ;
    onto:hasDeathDate "1846-01-30"^^xsd:date .

<http://example.org/entity/Gustav_Philipp_Mörl> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gustav Philipp Mörl" ;
    onto:hasBirthDate "1673-12-26"^^xsd:date ;
    onto:hasDeathDate "1750-05-07"^^xsd:date .

