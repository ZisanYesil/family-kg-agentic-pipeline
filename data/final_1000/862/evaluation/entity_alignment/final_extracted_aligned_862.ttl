@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Guilty_of_Treason> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Felix_E_Feist> ;
    ex:hasDirector <http://example.org/entity/Felix_E_Feist> .

<http://example.org/entity/New_York> a ex:Place .

<http://example.org/entity/Felix_E_Feist> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/New_York> .

