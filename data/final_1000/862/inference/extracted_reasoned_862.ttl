@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/film_guilty_of_treason> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_felix_e_feist> ;
    ex:hasDirector <http://example.org/extracted/person_felix_e_feist> .

<http://example.org/extracted/place_new_york_city> a ex:Place .

<http://example.org/extracted/person_felix_e_feist> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/extracted/place_new_york_city> .

