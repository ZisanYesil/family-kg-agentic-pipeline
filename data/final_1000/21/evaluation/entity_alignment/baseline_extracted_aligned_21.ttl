@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Anna_Liisa> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Anna-Liisa" ;
    onto:hasPublicationDate "1922"^^xsd:gYear ;
    skos:altLabel "Anna-Liisa" .

<http://example.org/entity/Children_Underground> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Children Underground" ;
    onto:hasPublicationDate "2001"^^xsd:gYear ;
    skos:altLabel "Children Underground" .

