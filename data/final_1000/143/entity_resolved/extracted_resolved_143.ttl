@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:after_the_apocalypse a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "After the Apocalypse" ;
    onto:hasPublicationDate "2004"^^xsd:gYear .

data:idol_on_parade a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Idol on Parade" ;
    onto:hasPublicationDate "1959"^^xsd:gYear .

