@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/After_the_Apocalypse> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "After the Apocalypse" ;
    onto:hasPublicationDate "2004"^^xsd:gYear .

<http://example.org/entity/Idol_on_Parade> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Idol on Parade" ;
    onto:hasPublicationDate "1959"^^xsd:gYear .

