@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:crockett_johnson a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Crockett Johnson" ;
    onto:hasBirthDate "1906-10-20"^^xsd:date ;
    onto:hasDeathDate "1975-07-11"^^xsd:date ;
    skos:altLabel "David Johnson Leisk" .

data:sven_olof_lundgren a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sven-Olof Lundgren" ;
    onto:hasBirthDate "1908-11-03"^^xsd:date ;
    onto:hasDeathDate "1946-03-26"^^xsd:date .

