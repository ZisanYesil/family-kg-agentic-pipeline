@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:eager_bodies a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Eager Bodies" ;
    onto:hasPublicationDate "2003"^^xsd:gYear .

data:we_dive_at_dawn a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "We Dive at Dawn" ;
    onto:hasPublicationDate "1943"^^xsd:gYear .

