@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Eager_Bodies> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Eager Bodies" ;
    onto:hasPublicationDate "2003"^^xsd:gYear .

<http://example.org/entity/We_Dive_at_Dawn> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "We Dive at Dawn" ;
    onto:hasPublicationDate "1943"^^xsd:gYear .

