@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Elizabeth_Fitzalan_Duchess_of_Norfolk> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Elizabeth Fitzalan, Duchess of Norfolk" ;
    onto:hasSpouse <http://example.org/entity/Thomas_de_Mowbray_1st_Duke_of_Norfolk> .

<http://example.org/entity/Thomas_de_Mowbray_1st_Duke_of_Norfolk> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Thomas Mowbray, 1st Duke of Norfolk" ;
    onto:hasDeathPlace <http://example.org/entity/Venice> .

<http://example.org/entity/Venice> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Venice" .

