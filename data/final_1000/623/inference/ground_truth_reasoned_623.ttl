@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Dweepa a ex:Artifact,
        ex:CreativeWork ;
    ex:hasProducer entity:Soundarya .

entity:Kalank a ex:Artifact,
        ex:CreativeWork ;
    ex:hasProducer entity:Karan_Johar .

entity:Karan_Johar a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1972-05-25"^^xsd:date .

entity:Soundarya a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1972-07-18"^^xsd:date .

