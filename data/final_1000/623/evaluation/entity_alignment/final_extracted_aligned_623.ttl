@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Dweepa> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/Soundarya> ;
    ex:hasPublicationDate "2002"^^xsd:gYear .

<http://example.org/entity/Kalank> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasProducer <http://example.org/entity/Karan_Johar> ;
    ex:hasPublicationDate "2019"^^xsd:gYear .

<http://example.org/entity/Karan_Johar> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1972-05-25"^^xsd:date .

<http://example.org/entity/Soundarya> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1972-07-18"^^xsd:date ;
    ex:hasDeathDate "2004-04-17"^^xsd:date .

