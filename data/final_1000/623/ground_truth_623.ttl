inst:Soundarya ex:hasBirthDate "1972-07-18"^^xsd:date .  # date of birth -> "18 July 1972"
inst:Karan_Johar ex:hasBirthDate "1972-05-25"^^xsd:date .  # date of birth -> "25 May 1972"
