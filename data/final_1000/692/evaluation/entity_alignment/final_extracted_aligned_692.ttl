@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Tibiyo_TakaNgwane> a ex:Agent,
        ex:Organization ;
    ex:hasFounder <http://example.org/entity/Sobhuza_II> .

<http://example.org/entity/Ngwane_V> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Sobhuza_II> .

<http://example.org/entity/Sobhuza_II> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Ngwane_V> ;
    ex:hasParent <http://example.org/entity/Ngwane_V> .

