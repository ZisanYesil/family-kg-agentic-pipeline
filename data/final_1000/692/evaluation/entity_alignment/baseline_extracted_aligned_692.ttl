@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Tibiyo_TakaNgwane> a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Tibiyo TakaNgwane" ;
    onto:hasFounder <http://example.org/entity/Sobhuza_II> .

<http://example.org/entity/Ngwane_V> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ngwane V" .

<http://example.org/entity/Sobhuza_II> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sobhuza II" ;
    onto:hasFather <http://example.org/entity/Ngwane_V> .

