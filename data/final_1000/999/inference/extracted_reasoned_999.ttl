@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_collector_malathy> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_m_krishnan_nair> ;
    ex:hasDirector <http://example.org/extracted/person_m_krishnan_nair> .

<http://example.org/extracted/film_the_locket_1946> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_john_brahm> ;
    ex:hasDirector <http://example.org/extracted/person_john_brahm> .

<http://example.org/extracted/person_john_brahm> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1893-08-17"^^xsd:date ;
    ex:hasDeathDate "1982-10-12"^^xsd:date .

<http://example.org/extracted/person_m_krishnan_nair> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1926-11-02"^^xsd:date ;
    ex:hasDeathDate "2001-05-10"^^xsd:date .

