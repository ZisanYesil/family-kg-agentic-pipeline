@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Collector_Malathy> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Collector Malathy" ;
    onto:hasDirector <http://example.org/entity/M_Krishnan_Nair> .

<http://example.org/entity/The_Locket> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Locket" ;
    onto:hasDirector <http://example.org/entity/John_Brahm> .

<http://example.org/entity/John_Brahm> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "John Brahm" ;
    onto:hasBirthDate "1893-08-17"^^xsd:date ;
    onto:hasDeathDate "1982-10-12"^^xsd:date .

<http://example.org/entity/M_Krishnan_Nair> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "M. Krishnan Nair" ;
    onto:hasBirthDate "1926-11-02"^^xsd:date ;
    onto:hasDeathDate "2001-05-10"^^xsd:date .

