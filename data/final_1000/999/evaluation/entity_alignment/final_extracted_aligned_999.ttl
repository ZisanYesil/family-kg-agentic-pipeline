@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Collector_Malathy> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/M_Krishnan_Nair> ;
    ex:hasDirector <http://example.org/entity/M_Krishnan_Nair> .

<http://example.org/entity/The_Locket> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/John_Brahm> ;
    ex:hasDirector <http://example.org/entity/John_Brahm> .

<http://example.org/entity/John_Brahm> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1893-08-17"^^xsd:date ;
    ex:hasDeathDate "1982-10-12"^^xsd:date .

<http://example.org/entity/M_Krishnan_Nair> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1926-11-02"^^xsd:date ;
    ex:hasDeathDate "2001-05-10"^^xsd:date .

