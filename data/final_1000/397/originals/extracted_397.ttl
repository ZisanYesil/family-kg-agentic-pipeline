@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:hans_rosling_1948 a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hans Rosling" ;
    onto:hasBirthDate "1948-07-27"^^xsd:date ;
    onto:hasDeathDate "2017-02-07"^^xsd:date .

data:k%C4%B1nar_s%C4%B1vac%C4%B1yan_1876 a onto:Person,
        owl:NamedIndividual ;
