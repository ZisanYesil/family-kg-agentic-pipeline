@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Hans_Rosling> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Hans Rosling" ;
    onto:hasBirthDate "1948-07-27"^^xsd:date ;
    onto:hasDeathDate "2017-02-07"^^xsd:date .

<http://example.org/entity/Kınar_Sıvacıyan> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Kınar Sıvacıyan" ;
    onto:hasBirthDate "1876"^^xsd:gYear ;
    onto:hasDeathDate "1950-08-13"^^xsd:date ;
    skos:altLabel "Kınar Hanım" .

