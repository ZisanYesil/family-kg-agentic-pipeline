@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Beauties_on_Motor_Scooters> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Beauties on Motor Scooters" ;
    onto:hasPublicationDate "1952"^^xsd:gYear .

<http://example.org/entity/Mama_s_Little_Pirate> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Mama's Little Pirate" ;
    onto:hasPublicationDate "1934"^^xsd:gYear .

