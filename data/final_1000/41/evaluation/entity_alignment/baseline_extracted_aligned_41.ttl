@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Æthelwald_died_962_was_ealdorman_of_East_Anglia> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Æthelwald" ;
    onto:hasSpouse <http://example.org/entity/Ælfthryth> .

<http://example.org/entity/English> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "England" ;
    skos:altLabel "English" .

<http://example.org/entity/Ælfthryth> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ælfthryth" ;
    onto:hasNationality <http://example.org/entity/English> .

