@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:aethelwald a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Æthelwald" ;
    onto:hasSpouse data:aelfthryth .

data:aelfthryth a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ælfthryth" ;
    onto:hasNationality data:england .

data:england a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "England" ;
    skos:altLabel "English" .

