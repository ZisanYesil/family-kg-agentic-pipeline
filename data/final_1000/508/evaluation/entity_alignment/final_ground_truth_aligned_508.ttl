@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Cam_Pact a ex:Artifact ;
    ex:hasCountry entity:Australian ;
    ex:hasCountryOfOrigin entity:Australian .

entity:M3_band a ex:Artifact ;
    ex:hasCountry entity:American ;
    ex:hasCountryOfOrigin entity:American .

entity:American a ex:Country,
        ex:Place .

entity:Australian a ex:Country,
        ex:Place .

