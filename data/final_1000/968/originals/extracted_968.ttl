@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:ben_witherington_iii a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ben Witherington III" ;
    onto:hasBirthDate "1951-12-30"^^xsd:date .

data:tra_deon_hollins a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Tra-Deon Hollins" ;
    onto:hasBirthDate "1995-08-22"^^xsd:date .

