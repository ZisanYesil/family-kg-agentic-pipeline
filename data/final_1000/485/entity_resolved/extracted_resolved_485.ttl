@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:kogas_org a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Korea Gas Corporation" ;
    onto:hasInception "1983"^^xsd:gYear ;
    skos:altLabel "KOGAS",
        "Korea Gas Corporation" .

data:philips_org a onto:Organization,
        owl:NamedIndividual ;
    rdfs:label "Philips" ;
    onto:hasInception "1891"^^xsd:gYear ;
    skos:altLabel "Koninklijke Philips N.V.",
        "Philips" .

