@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Korea_Gas_Corporation a ex:Agent,
        ex:Organization ;
    ex:hasInception "1983"^^xsd:gYear .

entity:Philips a ex:Agent,
        ex:Organization ;
    ex:hasInception "1891"^^xsd:gYear .

