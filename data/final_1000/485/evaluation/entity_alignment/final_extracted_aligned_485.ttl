@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Korea_Gas_Corporation> a ex:Agent,
        ex:Organization ;
    ex:hasInception "1983"^^xsd:gYear .

<http://example.org/entity/Philips> a ex:Agent,
        ex:Organization ;
    ex:hasInception "1891"^^xsd:gYear .

