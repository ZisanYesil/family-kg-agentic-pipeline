@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Dance_with_a_Stranger> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasPublicationDate "1985"^^xsd:gYear .

<http://example.org/entity/Miley_Naa_Miley_Hum> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasPublicationDate "2011-11-04"^^xsd:date .

