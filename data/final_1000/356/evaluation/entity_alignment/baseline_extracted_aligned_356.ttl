@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Dance_with_a_Stranger> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Dance with a Stranger" ;
    onto:hasPublicationDate "1985"^^xsd:gYear .

<http://example.org/entity/Miley_Naa_Miley_Hum> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Miley Naa Miley Hum" ;
    onto:hasPublicationDate "2011-11-04"^^xsd:date .

