@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Istanbul a ex:Place .

entity:Kamures_Kadın a ex:Agent,
        ex:Person ;
    ex:hasSpouse entity:Mehmed_V .

entity:Mehmed_V a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Istanbul ;
    ex:hasSpouse entity:Kamures_Kadın .

