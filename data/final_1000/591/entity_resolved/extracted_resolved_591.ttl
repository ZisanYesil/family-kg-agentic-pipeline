@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:kamures_kadin a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Kamures Kadın" ;
    onto:hasSpouse data:mehmed_v .

data:mehmed_v a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mehmed V" ;
    skos:altLabel "Mehmed V Reşâd" .

