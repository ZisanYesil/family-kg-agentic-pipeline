@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extracted/film_sexy_toto> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_mario_amendola> ;
    ex:hasDirector <http://example.org/extracted/person_mario_amendola> .

<http://example.org/extracted/film_two_mules_for_sister_sara> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/extracted/person_don_siegel> ;
    ex:hasDirector <http://example.org/extracted/person_don_siegel> .

<http://example.org/extracted/person_don_siegel> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1991-04-20"^^xsd:date .

<http://example.org/extracted/person_mario_amendola> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1993-12-22"^^xsd:date .

