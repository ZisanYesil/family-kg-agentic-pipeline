@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Sexy_Toto> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Mario_Amendola> ;
    ex:hasDirector <http://example.org/entity/Mario_Amendola> .

<http://example.org/entity/Two_Mules_for_Sister_Sara> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Don_Siegel> ;
    ex:hasDirector <http://example.org/entity/Don_Siegel> .

<http://example.org/entity/Don_Siegel> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1991-04-20"^^xsd:date .

<http://example.org/entity/Mario_Amendola> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1993-12-22"^^xsd:date .

