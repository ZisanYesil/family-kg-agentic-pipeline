@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:film_sexy_toto a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Sexy Toto" ;
    onto:hasDirector data:person_mario_amendola .

data:film_two_mules_for_sister_sara a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Two Mules for Sister Sara" ;
    onto:hasDirector data:person_don_siegel .

data:person_don_siegel a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Don Siegel" ;
    onto:hasDeathDate "1991-04-20"^^xsd:date ;
    skos:altLabel "Donald Siegel" .

data:person_mario_amendola a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mario Amendola" ;
    onto:hasDeathDate "1993-12-22"^^xsd:date .

