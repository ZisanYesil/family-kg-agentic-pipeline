@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Song_of_Arizona> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Frank_McDonald> ;
    ex:hasDirector <http://example.org/entity/Frank_McDonald> .

<http://example.org/entity/Texas_Terrors> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/George_Sherman> ;
    ex:hasDirector <http://example.org/entity/George_Sherman> .

<http://example.org/entity/Frank_McDonald> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1899-11-09"^^xsd:date ;
    ex:hasDeathDate "1980-03-08"^^xsd:date .

<http://example.org/entity/George_Sherman> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1908-07-14"^^xsd:date ;
    ex:hasDeathDate "1991-03-15"^^xsd:date .

