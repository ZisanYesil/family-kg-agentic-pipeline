@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Charles_L_Biedenbach> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Charles L. Biedenbach" ;
    onto:hasBirthDate "1865-01-13"^^xsd:date ;
    onto:hasDeathDate "1942-09-15"^^xsd:date .

<http://example.org/entity/Merle_Tottenham> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Merle Tottenham" ;
    onto:hasBirthDate "1901-01-22"^^xsd:date ;
    onto:hasDeathDate "1958-07-18"^^xsd:date .

