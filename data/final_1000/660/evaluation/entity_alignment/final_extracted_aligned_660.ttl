@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Charles_L_Biedenbach> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1865-01-13"^^xsd:date ;
    ex:hasDeathDate "1942-09-15"^^xsd:date .

<http://example.org/entity/Merle_Tottenham> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1901-01-22"^^xsd:date ;
    ex:hasDeathDate "1958-07-18"^^xsd:date .

