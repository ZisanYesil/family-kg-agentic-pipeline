@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:philippe_solari a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Philippe Solari" ;
    onto:hasBirthDate "1840-05-02"^^xsd:date ;
    onto:hasDeathDate "1906-01-20"^^xsd:date .

data:stephen_jurika a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Stephen Jurika Jr." ;
    onto:hasBirthDate "1910-12-09"^^xsd:date ;
    onto:hasDeathDate "1993-07-15"^^xsd:date ;
    skos:altLabel "Stephen Jurika" .

