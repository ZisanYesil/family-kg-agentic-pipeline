@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Lucy_Beall_Candler_Owens_Heinz_Leide> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lucy Beall Candler Owens Heinz Leide" ;
    onto:hasFather <http://example.org/entity/Asa_Griggs_Candler> .

<http://example.org/entity/Asa_Griggs_Candler> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Asa Griggs Candler" .

