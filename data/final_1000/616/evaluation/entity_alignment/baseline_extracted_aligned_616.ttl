@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Aansoo_Ban_Gaye_Phool> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Aansoo Ban Gaye Phool" ;
    onto:hasPublicationDate "1969"^^xsd:gYear .

<http://example.org/entity/The_First_7th_Night> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The First 7th Night" ;
    onto:hasPublicationDate "2009"^^xsd:gYear .

