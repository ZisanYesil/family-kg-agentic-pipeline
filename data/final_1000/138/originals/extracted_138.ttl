@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:film_heart_of_stone_1950 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Heart of Stone (1950 film)" ;
    onto:hasCountryOfOrigin data:country_east_germany .

data:film_plaything_of_broadway a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Plaything of Broadway" ;
    onto:hasCountryOfOrigin data:country_united_states .

data:country_east_germany a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "East Germany" ;
    skos:altLabel "East German" .

data:country_united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

