@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Heart_of_Stone_1950_film> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Heart of Stone (1950 film)" ;
    onto:hasCountryOfOrigin <http://example.org/entity/German> .

<http://example.org/entity/The_Plaything_of_Broadway> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Plaything of Broadway" ;
    onto:hasCountryOfOrigin <http://example.org/entity/American> .

<http://example.org/entity/American> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "American" .

<http://example.org/entity/German> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "East Germany" ;
    skos:altLabel "East German" .

