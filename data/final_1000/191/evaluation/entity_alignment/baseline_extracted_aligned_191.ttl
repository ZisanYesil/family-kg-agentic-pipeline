@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Adieu_Blaireau> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Adieu Blaireau" ;
    onto:hasPublicationDate "1985"^^xsd:gYear .

<http://example.org/entity/Afterschool> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Afterschool" ;
    onto:hasPublicationDate "2008"^^xsd:gYear .

