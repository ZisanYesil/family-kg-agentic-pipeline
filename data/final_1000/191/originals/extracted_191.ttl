@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:adieu_blaireau_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Adieu Blaireau" ;
    onto:hasPublicationDate "1985"^^xsd:gYear .

data:afterschool_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Afterschool" ;
    onto:hasPublicationDate "2008"^^xsd:gYear .

