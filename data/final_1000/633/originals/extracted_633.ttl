@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:chaohu_university a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Chaohu University" ;
    onto:hasCountry data:china .

data:shanghai_normal_university a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Shanghai Normal University" ;
    onto:hasCountry data:china .

data:china a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "China" ;
    skos:altLabel "People's Republic of China" .

