@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Chaohu_University> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Chaohu University" ;
    onto:hasCountry <http://example.org/entity/Chinese> .

<http://example.org/entity/Shanghai_Normal_University> a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Shanghai Normal University" ;
    onto:hasCountry <http://example.org/entity/Chinese> .

<http://example.org/entity/Chinese> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "China" ;
    skos:altLabel "People's Republic of China" .

