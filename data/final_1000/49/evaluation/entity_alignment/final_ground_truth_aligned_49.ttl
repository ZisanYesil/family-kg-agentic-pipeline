@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Count_Your_Blessings a ex:Artifact,
        ex:CreativeWork ;
    ex:hasComposer entity:Franz_Waxman ;
    ex:hasCreator entity:Franz_Waxman .

entity:Franz_Waxman a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:German ;
    ex:hasCountry entity:German .

entity:German a ex:Country,
        ex:Place .

