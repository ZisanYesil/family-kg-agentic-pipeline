@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Count_Your_Blessings> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasComposer <http://example.org/entity/Franz_Waxman> ;
    ex:hasCreator <http://example.org/entity/Franz_Waxman> .

<http://example.org/entity/Franz_Waxman> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/German>,
        <http://example.org/extracted/united_states> ;
    ex:hasNationality <http://example.org/entity/German>,
        <http://example.org/extracted/united_states> .

<http://example.org/entity/German> a ex:Country,
        ex:Place .

<http://example.org/extracted/united_states> a ex:Country,
        ex:Place .

