@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/fine_by_me_song> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator <http://example.org/extracted/chris_brown> ;
    ex:hasPerformer <http://example.org/extracted/chris_brown> .

<http://example.org/extracted/bet_award> a ex:Award .

<http://example.org/extracted/billboard_music_award> a ex:Award .

<http://example.org/extracted/grammy_award> a ex:Award .

<http://example.org/extracted/soul_train_award> a ex:Award .

<http://example.org/extracted/chris_brown> a ex:Agent,
        ex:Person ;
    ex:hasAwardReceived <http://example.org/extracted/bet_award>,
        <http://example.org/extracted/billboard_music_award>,
        <http://example.org/extracted/grammy_award>,
        <http://example.org/extracted/soul_train_award> .

