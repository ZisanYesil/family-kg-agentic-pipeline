@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Lucio_Dalla> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Lucio Dalla" ;
    onto:hasDeathDate "2012-03-01"^^xsd:date .

<http://example.org/entity/The_Sparrow_s_Fluttering> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Sparrow's Fluttering" ;
    onto:hasPublicationDate "1988"^^xsd:gYear .

