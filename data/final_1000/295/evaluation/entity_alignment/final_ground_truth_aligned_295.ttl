@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:The_Sparrow_s_Fluttering a ex:Artifact,
        ex:CreativeWork ;
    ex:hasComposer entity:Lucio_Dalla ;
    ex:hasCreator entity:Lucio_Dalla .

entity:Lucio_Dalla a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "2012-03-01"^^xsd:date .

