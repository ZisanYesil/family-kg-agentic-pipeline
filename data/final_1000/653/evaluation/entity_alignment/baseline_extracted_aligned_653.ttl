@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Mansur_ad_Din_of_Adal> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mansur ad-Din" ;
    onto:hasFather <http://example.org/entity/Sa_ad_ad_Din_II> .

<http://example.org/entity/Haqq_ad_Din_II> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Haqq ad-Din II" .

<http://example.org/entity/Sa_ad_ad_Din_II> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sa'ad ad-Din II" ;
    onto:hasBrother <http://example.org/entity/Haqq_ad_Din_II> .

