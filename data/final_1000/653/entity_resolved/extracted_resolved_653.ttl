@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:mansur_ad_din_adal a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mansur ad-Din" ;
    onto:hasFather data:saad_ad_din_ii .

data:haqq_ad_din_ii a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Haqq ad-Din II" .

data:saad_ad_din_ii a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sa'ad ad-Din II" ;
    onto:hasBrother data:haqq_ad_din_ii .

