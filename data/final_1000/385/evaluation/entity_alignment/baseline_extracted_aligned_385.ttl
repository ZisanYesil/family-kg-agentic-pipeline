@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Let_asfaltového_holuba> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Let asfaltového holuba" ;
    onto:hasCreator <http://example.org/entity/Vladimír_Godár> .

<http://example.org/entity/Slovak> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Slovakia" ;
    skos:altLabel "Slovak" .

<http://example.org/entity/Vladimír_Godár> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Vladimír Godár" ;
    onto:hasNationality <http://example.org/entity/Slovak> .

