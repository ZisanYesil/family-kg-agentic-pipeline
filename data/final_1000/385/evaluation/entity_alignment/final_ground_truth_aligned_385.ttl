@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Let_asfaltového_holuba a ex:Artifact,
        ex:CreativeWork ;
    ex:hasComposer entity:Vladimír_Godár ;
    ex:hasCreator entity:Vladimír_Godár .

entity:Slovak a ex:Country,
        ex:Place .

entity:Vladimír_Godár a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:Slovak ;
    ex:hasCountry entity:Slovak .

