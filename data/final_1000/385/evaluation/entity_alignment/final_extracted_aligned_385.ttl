@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Let_asfaltového_holuba> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Vladimír_Godár> .

<http://example.org/entity/Vladimír_Godár> a ex:Agent,
        ex:Person ;
    ex:hasCountry <http://example.org/entity/Slovak> ;
    ex:hasNationality <http://example.org/entity/Slovak> .

<http://example.org/entity/Slovak> a ex:Country,
        ex:Place .

