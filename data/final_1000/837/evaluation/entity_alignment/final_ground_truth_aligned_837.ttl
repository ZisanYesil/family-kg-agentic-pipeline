@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Nicht_nachmachen a ex:Artifact,
        ex:CreativeWork ;
    ex:hasPresenter entity:Wigald_Boning .

entity:Wigald_Boning a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Wildeshausen .

entity:Wildeshausen a ex:Place .

