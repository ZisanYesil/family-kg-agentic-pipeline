@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Nicht_nachmachen> a onto:CreativeWork,
        owl:NamedIndividual ;
    rdfs:label "Nicht nachmachen!" ;
    onto:hasPresenter <http://example.org/entity/Wigald_Boning> ;
    skos:altLabel "Don't Imitate!" .

<http://example.org/entity/Wigald_Boning> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Wigald Boning" ;
    onto:hasBirthPlace <http://example.org/entity/Wildeshausen> .

<http://example.org/entity/Wildeshausen> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Wildeshausen" .

