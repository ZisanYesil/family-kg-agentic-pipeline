@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Arthur_Plantagenet_1st_Viscount_Lisle> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Arthur Plantagenet, 1st Viscount Lisle" ;
    onto:hasFather <http://example.org/entity/Edward_IV> .

<http://example.org/entity/Edward_IV> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Edward IV of England" ;
    onto:hasSpouse <http://example.org/entity/Elizabeth_Woodville> .

<http://example.org/entity/Elizabeth_Woodville> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Elizabeth Woodville" .

