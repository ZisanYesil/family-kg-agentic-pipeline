@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:alfonso_xi_of_castile a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alfonso XI of Castile" ;
    onto:hasFather data:ferdinand_iv_of_castile .

data:ferdinand_iv_of_castile a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ferdinand IV of Castile" ;
    onto:hasDeathPlace data:jaen .

data:jaen a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Jaén" .

