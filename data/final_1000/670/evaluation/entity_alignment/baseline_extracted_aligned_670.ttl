@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Alfonso_XI_of_Castile> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alfonso XI of Castile" ;
    onto:hasFather <http://example.org/entity/Ferdinand_IV_of_Castile> .

<http://example.org/entity/Ferdinand_IV_of_Castile> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Ferdinand IV of Castile" ;
    onto:hasDeathPlace <http://example.org/entity/Jaén> .

<http://example.org/entity/Jaén> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Jaén" .

