@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Alfonso_XI_of_Castile a ex:Agent,
        ex:Person ;
    ex:hasFather entity:Ferdinand_IV_of_Castile ;
