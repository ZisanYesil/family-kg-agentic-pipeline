@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/The_Bounce_Back> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Bounce Back" ;
    onto:hasPublicationDate "2016-12-09"^^xsd:date .

<http://example.org/entity/The_Sick_Stockrider> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Sick Stockrider" ;
    onto:hasPublicationDate "1913"^^xsd:gYear .

