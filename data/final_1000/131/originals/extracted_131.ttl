@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:the_bounce_back_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Bounce Back" ;
    onto:hasPublicationDate "2016-12-09"^^xsd:date .

data:the_sick_stockrider_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Sick Stockrider" ;
    onto:hasPublicationDate "1913"^^xsd:gYear .

