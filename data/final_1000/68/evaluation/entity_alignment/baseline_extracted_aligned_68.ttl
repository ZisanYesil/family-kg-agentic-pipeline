@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Princess_Marie_of_Waldeck_and_Pyrmont> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Princess Marie of Waldeck and Pyrmont" ;
    onto:hasMother <http://example.org/entity/Princess_Helena_of_Nassau> ;
    skos:altLabel "Georgine Henriette Marie" .

<http://example.org/entity/Princess_Helena_of_Nassau> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Princess Helena of Nassau" ;
    onto:hasFather <http://example.org/entity/William_Duke_of_Nassau> .

<http://example.org/entity/William_Duke_of_Nassau> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "William, Duke of Nassau" .

