@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:china_bound a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "China Bound" ;
    onto:hasPublicationDate "1929"^^xsd:gYear .

data:return_of_the_jedi a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Return of the Jedi" ;
    onto:hasPublicationDate "1983-05-25"^^xsd:date .

