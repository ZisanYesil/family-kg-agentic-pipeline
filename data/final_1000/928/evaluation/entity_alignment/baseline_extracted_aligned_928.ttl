@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/China_Bound> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "China Bound" ;
    onto:hasPublicationDate "1929"^^xsd:gYear .

<http://example.org/entity/Return_of_the_Jedi> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Return of the Jedi" ;
    onto:hasPublicationDate "1983-05-25"^^xsd:date .

