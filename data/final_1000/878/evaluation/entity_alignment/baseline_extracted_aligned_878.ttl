@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Sancha_of_Castile_Queen_of_Navarre> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Sancha of Castile" ;
    onto:hasMother <http://example.org/entity/Berengaria_of_Barcelona> ;
    skos:altLabel "Sancha of Castile" .

<http://example.org/entity/Berengaria_of_Barcelona> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Berengaria of Barcelona" ;
    onto:hasDeathPlace <http://example.org/entity/Palencia> ;
    skos:altLabel "Berengaria of Barcelona",
        "Berenguela de Barcelona" .

<http://example.org/entity/Palencia> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Palencia" ;
    skos:altLabel "Palencia" .

