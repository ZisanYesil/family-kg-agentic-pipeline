@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Palencia> a ex:Place .

<http://example.org/entity/Sancha_of_Castile_Queen_of_Navarre> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Berengaria_of_Barcelona> ;
    ex:hasParent <http://example.org/entity/Berengaria_of_Barcelona> .

<http://example.org/entity/Berengaria_of_Barcelona> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/entity/Sancha_of_Castile_Queen_of_Navarre> ;
    ex:hasDeathPlace <http://example.org/entity/Palencia> .

