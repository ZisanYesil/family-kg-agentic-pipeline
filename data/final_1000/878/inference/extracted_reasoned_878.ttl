@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/extracted/palencia> a ex:Place .

<http://example.org/extracted/sancha_of_castile> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/extracted/berengaria_of_barcelona> ;
    ex:hasParent <http://example.org/extracted/berengaria_of_barcelona> .

<http://example.org/extracted/berengaria_of_barcelona> a ex:Agent,
        ex:Person ;
    ex:hasChild <http://example.org/extracted/sancha_of_castile> ;
    ex:hasDeathPlace <http://example.org/extracted/palencia> .

