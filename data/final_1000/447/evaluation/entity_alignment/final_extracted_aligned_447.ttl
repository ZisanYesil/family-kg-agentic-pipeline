@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Dexter_Scott_King> a ex:Agent,
        ex:Person ;
    ex:hasMother <http://example.org/entity/Coretta_Scott_King> ;
    ex:hasParent <http://example.org/entity/Coretta_Scott_King> .

<http://example.org/extracted/king_center> a ex:Place .

<http://example.org/entity/Coretta_Scott_King> a ex:Agent,
        ex:Person ;
    ex:hasBurialPlace <http://example.org/extracted/king_center> ;
    ex:hasChild <http://example.org/entity/Dexter_Scott_King> .

