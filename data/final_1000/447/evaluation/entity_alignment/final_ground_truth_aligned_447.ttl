@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Dexter_Scott_King a ex:Agent,
        ex:Person ;
    ex:hasMother entity:Coretta_Scott_King ;
    ex:hasParent entity:Coretta_Scott_King .

entity:Georgia a ex:Place .

entity:Coretta_Scott_King a ex:Agent,
        ex:Person ;
    ex:hasBurialPlace entity:Georgia ;
    ex:hasChild entity:Dexter_Scott_King .

