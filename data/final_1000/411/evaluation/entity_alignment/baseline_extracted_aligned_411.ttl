@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Amin_al_Hindi> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Amin al-Hindi" ;
    onto:hasBirthDate "1940"^^xsd:gYear ;
    onto:hasDeathDate "2010-08-17"^^xsd:date .

<http://example.org/entity/János_Horvay> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "János Horvay" ;
    onto:hasBirthDate "1874-05-29"^^xsd:date ;
    onto:hasDeathDate "1944-11-19"^^xsd:date .

