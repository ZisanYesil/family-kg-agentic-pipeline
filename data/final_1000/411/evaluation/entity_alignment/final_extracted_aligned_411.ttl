@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Amin_al_Hindi> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1940"^^xsd:gYear ;
    ex:hasDeathDate "2010-08-17"^^xsd:date .

<http://example.org/entity/János_Horvay> a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1874-05-29"^^xsd:date ;
    ex:hasDeathDate "1944-11-19"^^xsd:date .

