@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:absalom_baird a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Absalom Baird" ;
    onto:hasBirthDate "1824-08-20"^^xsd:date ;
    onto:hasDeathDate "1905-06-14"^^xsd:date .

data:david_ashkenazi a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "David Vladimirovitch Ashkenazi" ;
    onto:hasBirthDate "1915-12-25"^^xsd:date ;
    onto:hasDeathDate "1997-02-19"^^xsd:date ;
    skos:altLabel "David Ashkenazi" .

