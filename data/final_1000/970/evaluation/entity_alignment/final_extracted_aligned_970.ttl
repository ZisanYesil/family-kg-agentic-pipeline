@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Geography_Club> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Gary_Entin> ;
    ex:hasDirector <http://example.org/entity/Gary_Entin> .

<http://example.org/entity/Miami_Florida> a ex:Place .

<http://example.org/entity/Gary_Entin> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Miami_Florida> .

