@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Geography_Club> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Geography Club" ;
    onto:hasDirector <http://example.org/entity/Gary_Entin> .

<http://example.org/entity/Gary_Entin> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Gary Entin" ;
    onto:hasBirthPlace <http://example.org/entity/Miami_Florida> .

<http://example.org/entity/Miami_Florida> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Miami, Florida" .

