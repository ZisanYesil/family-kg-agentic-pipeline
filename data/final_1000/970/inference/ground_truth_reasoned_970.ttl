@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Geography_Club a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Gary_Entin ;
    ex:hasDirector entity:Gary_Entin .

entity:Miami_Florida a ex:Place .

entity:Gary_Entin a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Miami_Florida .

