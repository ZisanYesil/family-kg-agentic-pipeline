@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Pirate_Master a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Mark_Burnett .

entity:Mark_Burnett a ex:Agent,
        ex:Person ;
    ex:hasCitizenship entity:British ;
    ex:hasCountry entity:British .

entity:British a ex:Country,
        ex:Place .

