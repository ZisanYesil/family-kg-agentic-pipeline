@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:A_Very_Moral_Night a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator entity:Károly_Makk ;
    ex:hasDirector entity:Károly_Makk .

entity:Berettyóújfalu a ex:Place .

entity:Károly_Makk a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace entity:Berettyóújfalu .

