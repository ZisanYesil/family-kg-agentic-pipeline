@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/A_Very_Moral_Night> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasCreator <http://example.org/entity/Károly_Makk> ;
    ex:hasDirector <http://example.org/entity/Károly_Makk> .

<http://example.org/entity/Berettyóújfalu> a ex:Place .

<http://example.org/entity/Károly_Makk> a ex:Agent,
        ex:Person ;
    ex:hasBirthPlace <http://example.org/entity/Berettyóújfalu> .

