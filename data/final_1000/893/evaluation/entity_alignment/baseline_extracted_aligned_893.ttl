@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/A_Very_Moral_Night> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "A Very Moral Night" ;
    onto:hasDirector <http://example.org/entity/Károly_Makk> .

<http://example.org/entity/Berettyóújfalu> a onto:Place,
        owl:NamedIndividual ;
    rdfs:label "Berettyóújfalu" .

<http://example.org/entity/Károly_Makk> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Károly Makk" ;
    onto:hasBirthPlace <http://example.org/entity/Berettyóújfalu> .

