@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/entity/Kunigunde_of_Poland> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Kunigunde of Poland" ;
    onto:hasFather <http://example.org/entity/Władysław_I_the_Elbow_high> .

<http://example.org/entity/Władysław_I_the_Elbow_high> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Władysław I Łokietek" ;
    skos:altLabel "Władysław I the Elbow-high",
        "Władysław I Łokietek" .

