@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

data:kunigunde_of_poland a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Kunigunde of Poland" ;
    onto:hasFather data:wladyslaw_i_lokietek .

data:wladyslaw_i_lokietek a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Władysław I Łokietek" ;
    skos:altLabel "Władysław I the Elbow-high",
        "Władysław I Łokietek" .

