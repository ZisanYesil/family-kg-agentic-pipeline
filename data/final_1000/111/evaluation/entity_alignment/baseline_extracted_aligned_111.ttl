@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/M_B_Sreenivasan> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "M. B. Sreenivasan" ;
    onto:hasDeathDate "1988-03-09"^^xsd:date .

<http://example.org/entity/Oomana_Thinkal> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Oomana Thinkal" .

