@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Oomana_Thinkal> a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasComposer <http://example.org/entity/M_B_Sreenivasan> ;
    ex:hasCreator <http://example.org/entity/M_B_Sreenivasan> .

<http://example.org/entity/M_B_Sreenivasan> a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1988-03-09"^^xsd:date .

