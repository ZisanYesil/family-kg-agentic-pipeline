@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Oomana_Thinkal a ex:Artifact,
        ex:CreativeWork ;
    ex:hasComposer entity:M_B_Sreenivasan ;
    ex:hasCreator entity:M_B_Sreenivasan .

entity:M_B_Sreenivasan a ex:Agent,
        ex:Person ;
    ex:hasDeathDate "1988-03-09"^^xsd:date .

