@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:constantia_eriksdotter a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Constantia Eriksdotter" ;
    onto:hasFather data:eric_xiv_of_sweden .

data:arsenic_poisoning a onto:CauseOfDeath,
        owl:NamedIndividual ;
    rdfs:label "arsenic poisoning" .

data:eric_xiv_of_sweden a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Eric XIV of Sweden" ;
    onto:hasCauseOfDeath data:arsenic_poisoning .

