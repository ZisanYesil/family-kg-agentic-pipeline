@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/entity/Constantia_Eriksdotter> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Constantia Eriksdotter" ;
    onto:hasFather <http://example.org/entity/Eric_XIV_of_Sweden> .

<http://example.org/entity/Eric_XIV_of_Sweden> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Eric XIV of Sweden" ;
    onto:hasCauseOfDeath <http://example.org/entity/poisoning> .

<http://example.org/entity/poisoning> a onto:CauseOfDeath,
        owl:NamedIndividual ;
    rdfs:label "arsenic poisoning" .

