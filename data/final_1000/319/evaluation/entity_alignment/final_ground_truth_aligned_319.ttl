@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .

entity:Constantia_Eriksdotter a ex:Agent,
        ex:Person ;
    ex:hasFather entity:Eric_XIV_of_Sweden ;
    ex:hasParent entity:Eric_XIV_of_Sweden .

entity:poisoning a ex:CauseOfDeath .

entity:Eric_XIV_of_Sweden a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath entity:poisoning ;
    ex:hasChild entity:Constantia_Eriksdotter .

