@prefix ex: <http://example.org/2wiki-ontology#> .

<http://example.org/entity/Constantia_Eriksdotter> a ex:Agent,
        ex:Person ;
    ex:hasFather <http://example.org/entity/Eric_XIV_of_Sweden> ;
    ex:hasParent <http://example.org/entity/Eric_XIV_of_Sweden> .

<http://example.org/entity/poisoning> a ex:CauseOfDeath .

<http://example.org/entity/Eric_XIV_of_Sweden> a ex:Agent,
        ex:Person ;
    ex:hasCauseOfDeath <http://example.org/entity/poisoning> ;
    ex:hasChild <http://example.org/entity/Constantia_Eriksdotter> .

