@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/entity/Engal%20Aasan> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Engal Aasan" ;
    onto:hasPublicationDate "2009"^^xsd:gYear .

<http://example.org/entity/The%20Love%20Route> a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Love Route" ;
    onto:hasPublicationDate "1915-02-25"^^xsd:date .

