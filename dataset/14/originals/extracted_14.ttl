@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:anik_dutta a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Anik Dutta" ;
    owl:sameAs <http://www.wikidata.org/entity/Q4764595> .

data:bengali_language a onto:Agent,
        owl:NamedIndividual ;
    rdfs:label "Bengali language" .

data:borunbabur_bondhu a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Borunbabur Bondhu" ;
    onto:hasCountryOfOrigin data:india ;
    onto:hasPublicationDate "2019"^^xsd:gYear ;
    owl:sameAs <http://www.wikidata.org/entity/Q79781208> .

data:india a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "India" .

