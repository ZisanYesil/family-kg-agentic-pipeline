@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:charge_it_to_me a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Charge It to Me" ;
    onto:hasPublicationDate "1919"^^xsd:gYear ;
    owl:sameAs <http://www.wikidata.org/entity/Q62595406> ;
    skos:altLabel "Charge It to Me" .

data:danger_diabolik a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Danger: Diabolik" ;
    onto:hasPublicationDate "1968"^^xsd:gYear ;
    owl:sameAs <http://www.wikidata.org/entity/Q629819> ;
    skos:altLabel "Danger: Diabolik" .

data:mario_bava a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mario Bava" ;
    onto:hasBirthDate "1914-07-31"^^xsd:date ;
    onto:hasDeathDate "1980-04-27"^^xsd:date ;
    owl:sameAs <http://www.wikidata.org/entity/Q55438> ;
    skos:altLabel "Mario Bava" .

data:roy_william_neill a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Roy William Neill" ;
