@prefix entity: <http://example.org/entity/> .
@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entity:Charge%20It%20to%20Me a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Roy%20William%20Neill ;
    ex:hasDirector entity:Roy%20William%20Neill .

<http://example.org/entity/Danger:%20Diabolik> a ex:Artifact,
        ex:CreativeWork ;
    ex:hasCreator entity:Mario%20Bava ;
    ex:hasDirector entity:Mario%20Bava .

entity:Mario%20Bava a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1914-07-31"^^xsd:date .

entity:Roy%20William%20Neill a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1887-09-04"^^xsd:date .

