@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:wandering_fires a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Wandering Fires" ;
    onto:hasDirector data:maurice_campbell ;
    onto:hasPublicationDate "1925"^^xsd:gYear ;
    owl:sameAs <http://www.wikidata.org/entity/Q21869977> .

data:maurice_campbell a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Maurice Campbell" ;
    onto:hasBirthDate "1919-11-28"^^xsd:date ;
    onto:hasDeathDate "2014-07-04"^^xsd:date ;
    owl:sameAs <http://www.wikidata.org/entity/Q17353699> .

