@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:geza_von_bolvary a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Géza von Bolváry" ;
    onto:hasBirthDate "1897-12-26"^^xsd:date ;
    onto:hasDeathDate "1961-08-10"^^xsd:date ;
    owl:sameAs <http://www.wikidata.org/entity/Q40646> ;
    skos:altLabel "Géza Maria von Bolváry-Zahn" .

data:wedding_night_in_paradise_1950_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Wedding Night in Paradise (1950 film)" ;
    onto:hasPublicationDate "1950"^^xsd:gYear ;
    owl:sameAs <http://www.wikidata.org/entity/Q176135> .

