@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:bloody_birthday a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Bloody Birthday" ;
    onto:hasCountryOfOrigin data:united_states ;
    onto:hasPublicationDate "1981"^^xsd:gYear ;
    owl:sameAs <http://www.wikidata.org/entity/Q4345845> .

data:the_beckoning_silence a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Beckoning Silence" ;
    onto:hasCountryOfOrigin data:united_kingdom ;
    onto:hasPublicationDate "2007"^^xsd:gYear ;
    owl:sameAs <http://www.wikidata.org/entity/Q1255638> .

data:united_kingdom a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United Kingdom" ;
    skos:altLabel "British" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    skos:altLabel "America" .

