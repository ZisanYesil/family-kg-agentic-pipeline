@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.wikidata.org/entity/Q633> a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Neil Young" ;
    onto:hasBirthDate "1945-11-12"^^xsd:date ;
    onto:hasCitizenship <http://www.wikidata.org/entity/Q16> .

<http://www.wikidata.org/entity/Q7557270> a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Soldier (Neil Young song)" ;
    onto:hasPublicationDate "1972"^^xsd:gYear ;
    skos:altLabel "Soldier" .

<http://www.wikidata.org/entity/Q16> a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" .

