@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:neil_young a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Neil Young" ;
    onto:hasBirthDate "1945-11-12"^^xsd:date ;
    onto:hasCitizenship data:canada .

data:soldier_neil_young_song a onto:MusicalWork,
        owl:NamedIndividual ;
    rdfs:label "Soldier (Neil Young song)" ;
    onto:hasPublicationDate "1972"^^xsd:gYear ;
    skos:altLabel "Soldier" .

data:canada a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Canada" .

