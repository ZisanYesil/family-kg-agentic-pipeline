@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:alison_skipper a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Alison Skipper" ;
    owl:sameAs <http://www.wikidata.org/entity/Q22096841> .

data:diane_gilliam_fisher a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Diane Gilliam Fisher" ;
    onto:hasBirthDate "1957"^^xsd:gYear ;
    owl:sameAs <http://www.wikidata.org/entity/Q5271466> .

