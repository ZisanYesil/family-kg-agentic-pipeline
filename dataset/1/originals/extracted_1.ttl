@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:the_falcon_1981 a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Falcon (film)" ;
    onto:hasDirector data:vatroslav_mimica ;
    onto:hasPublicationDate "1981"^^xsd:gYear ;
    owl:sameAs <http://www.wikidata.org/entity/Q2083645> ;
    skos:altLabel "Banović Strahinja" .

data:valentin_the_good a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Valentin the Good" ;
    onto:hasDirector data:martin_fric ;
    onto:hasPublicationDate "1942"^^xsd:gYear ;
    owl:sameAs <http://www.wikidata.org/entity/Q7910840> .

data:czechoslovakia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Czechoslovakia" .

data:martin_fric a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Martin Frič" ;
    onto:hasBirthDate "1902-03-29"^^xsd:date ;
    onto:hasCitizenship data:czechoslovakia ;
    onto:hasDeathDate "1968-08-26"^^xsd:date ;
    owl:sameAs <http://www.wikidata.org/entity/Q769826> .

data:vatroslav_mimica a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Vatroslav Mimica" ;
    onto:hasBirthDate "1923-06-25"^^xsd:date ;
    onto:hasCitizenship data:yugoslavia ;
    owl:sameAs <http://www.wikidata.org/entity/Q530027> .

data:yugoslavia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Yugoslavia" .

