@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:k_v_mahadevan a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "K. V. Mahadevan" ;
    onto:hasBirthDate "1918-03-14"^^xsd:date ;
    onto:hasDeathDate "2001-06-21"^^xsd:date ;
    owl:sameAs <http://www.wikidata.org/entity/Q3536748> ;
    skos:altLabel "Krishnankoil Venkadachalam Mahadevan" .

data:sruthilayalu_film a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "Sruthilayalu" ;
    onto:hasPublicationDate "1987"^^xsd:gYear ;
    owl:sameAs <http://www.wikidata.org/entity/Q7504356> ;
    skos:altLabel "Isaikku Oru Koil" .

