@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:matraville_sports_high_school a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Matraville Sports High School" ;
    onto:hasCountry data:australia ;
    onto:hasInception "1960"^^xsd:gYear ;
    owl:sameAs <http://www.wikidata.org/entity/Q6787778> ;
    skos:altLabel "MSHS" .

data:wabash_high_school a onto:EducationalInstitution,
        owl:NamedIndividual ;
    rdfs:label "Wabash High School" ;
    onto:hasCountry data:united_states ;
    owl:sameAs <http://www.wikidata.org/entity/Q7958642> .

data:australia a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "Australia" .

data:united_states a onto:Country,
        owl:NamedIndividual ;
    rdfs:label "United States" ;
    owl:sameAs <http://www.wikidata.org/entity/Q30> .

