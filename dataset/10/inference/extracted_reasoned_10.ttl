@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wd:Q6787778 a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization ;
    ex:hasCountry wd:Q408 ;
    ex:hasInception "1960"^^xsd:gYear .

wd:Q7958642 a ex:Agent,
        ex:EducationalInstitution,
        ex:Organization ;
    ex:hasCountry wd:Q30 .

wd:Q30 a ex:Country,
        ex:Place .

wd:Q408 a ex:Country,
        ex:Place .

