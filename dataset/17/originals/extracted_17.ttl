@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:fatima_bint_mubarak_al_ketbi a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Fatima bint Mubarak Al Ketbi" ;
    onto:hasSpouse data:zayed_bin_sultan_al_nahyan ;
    owl:sameAs <http://www.wikidata.org/entity/Q4120127> .

data:zayed_bin_sultan_al_nahyan a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Zayed bin Sultan Al Nahyan" ;
    onto:hasBirthDate "1918-05-06"^^xsd:date ;
    onto:hasDeathDate "2004-11-02"^^xsd:date ;
    owl:sameAs <http://www.wikidata.org/entity/Q167846> ;
    skos:altLabel "Sheikh Zayed bin Sultan Al Nahyan" .

