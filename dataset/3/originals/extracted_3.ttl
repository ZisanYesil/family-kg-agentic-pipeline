@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:mina_gerhardsen a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Mina Gerhardsen" ;
    onto:hasBirthDate "1975-09-14"^^xsd:date ;
    onto:hasFather data:rune_gerhardsen ;
    owl:sameAs <http://www.wikidata.org/entity/Q4969243> .

data:rune_gerhardsen a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Rune Gerhardsen" ;
    onto:hasBirthDate "1946-06-13"^^xsd:date ;
    owl:sameAs <http://www.wikidata.org/entity/Q4968933> .

