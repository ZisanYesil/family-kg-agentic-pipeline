@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:luciano_salce a onto:Person,
        owl:NamedIndividual ;
    rdfs:label "Luciano Salce" ;
    onto:hasBirthDate "1922-09-25"^^xsd:date ;
    onto:hasBirthPlace data:rome ;
    onto:hasDeathDate "1989-12-17"^^xsd:date ;
    owl:sameAs <http://www.wikidata.org/entity/Q697834> ;
    skos:altLabel "Pilantra" .

data:the_fascist a onto:Film,
        owl:NamedIndividual ;
    rdfs:label "The Fascist" ;
    onto:hasPublicationDate "1961"^^xsd:gYear ;
    owl:sameAs <http://www.wikidata.org/entity/Q232190> .

data:rome a onto:GeographicLocation,
        owl:NamedIndividual ;
    rdfs:label "Rome" .

