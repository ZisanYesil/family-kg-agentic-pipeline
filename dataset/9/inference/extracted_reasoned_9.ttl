@prefix ex: <http://example.org/2wiki-ontology#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wd:Q232190 a ex:Artifact,
        ex:CreativeWork,
        ex:Film ;
    ex:hasPublicationDate "1961"^^xsd:gYear .

wd:Q697834 a ex:Agent,
        ex:Person ;
    ex:hasBirthDate "1922-09-25"^^xsd:date ;
    ex:hasBirthPlace wd:Q220 ;
    ex:hasDeathDate "1989-12-17"^^xsd:date .

wd:Q220 a ex:GeographicLocation,
        ex:Place .

