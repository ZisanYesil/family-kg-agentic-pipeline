@prefix data: <http://example.org/extracted/> .
@prefix onto: <http://example.org/2wiki-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:infopro_sdn_bhd a onto:Company,
        owl:NamedIndividual ;
    rdfs:label "Infopro Sdn Bhd" ;
    owl:sameAs <http://www.wikidata.org/entity/Q6030520> ;
    skos:altLabel "INFOPRO Sdn Bhd",
        "Infopro" .

data:vakifbank a onto:Company,
        owl:NamedIndividual ;
    rdfs:label "VakıfBank" ;
    onto:hasInception "1954-04-13"^^xsd:date ;
    owl:sameAs <http://www.wikidata.org/entity/Q1148521> ;
    skos:altLabel "VakıfBank" .

