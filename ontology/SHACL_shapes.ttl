    sh:property [
        sh:path ex:hasAwardReceived ;
        sh:nodeKind sh:IRI ;
        sh:name "has award received" ;
        sh:message "ex:hasAwardReceived value must be an IRI of the declared range/cardinality" ;
    ] .

