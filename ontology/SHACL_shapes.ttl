# 2. DATATYPE PROPERTY SHAPES (5)
# ------------------------------------------------------------------
ex:hasBirthDateShape
    a sh:NodeShape ;
    sh:targetSubjectsOf ex:hasBirthDate ;
    sh:property [
        sh:path ex:hasBirthDate ;
        sh:nodeKind sh:Literal ;
        sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:gYear ] ) ;
        sh:maxCount 1 ;
        sh:name "has birth date" ;
        sh:message "ex:hasBirthDate value must be a literal of the declared datatype/cardinality" ;
    ] .

ex:hasDeathDateShape
    a sh:NodeShape ;
    sh:targetSubjectsOf ex:hasDeathDate ;
